###
post: NPB MG on threads: the smoother and the residual as parallel loops
agent: claude

A port of NPB3.4's MG (MG/mg.f90). MG solves the discrete Poisson problem
`A u = v` on an n x n x n periodic grid, where v is zero except at ten points
set to +1 and ten set to -1 (the largest and smallest of a randlc field), with
`nit` V-cycles (`mg3P`): restrict the residual down to a 2 x 2 x 2 grid
(`rprj3`), smooth there (`psinv`), and on the way back up interpolate the
correction (`interp`), recompute the residual (`resid`) and smooth again.
Every operator is a 27-point stencil written as sums over the 4 face, 4 edge
and corner neighbors along lines, the way the Fortran does. NPB checks the
residual's 2-norm after the last cycle.

Each level is a record holding its correction u and residual r as 3-D arrays
with one ghost layer, indexed `[i3, i2, i1]` so that i1 is the fastest index,
as in the Fortran's column-major `u(i1, i2, i3)`. Indices here are the
Fortran's minus one.

This is mg.viv with the plane loops of `psinv` and `resid` made `parallel
for`, as NPB's OpenMP version does (`!$omp do` over i3). Each pass writes
only plane i3 of u (or r), and the line buffers r1/r2 (u1/u2), shared in
mg.viv, are made per pass. A `parallel for` has no `from`, so the pass p
works on plane p + 1.

Run a class with `--set CLASS='"W"'` (S, W, A).
###

from randlc import randlc, vranlc

CLASS = "S"
EPSILON = 1.0e-8
MM: Int = 10
A_RAND: Int = 1220703125
X_RAND: Int = 314159265

record Level {
    u: Arr
    r: Arr
}

# mg.f90: the grid size, the V-cycle count and the reference residual norm
private def mg_class(cls) {
    if cls == "S" {
        return 32, 4, 0.5307707005734e-04
    }
    if cls == "W" {
        return 128, 4, 0.6467329375339e-05
    }
    if cls == "A" {
        return 256, 4, 0.2433365309069e-05
    }
    if cls == "B" {
        return 256, 20, 0.1800564401355e-05
    }
    stop("MG: unknown class " + cls)
    return 0, 0, 0.0
}

# comm3: the periodic boundary, copied into the ghost layers
def comm3(u: Arr) {
    n3: Int = int(shape(u)[0])
    n2: Int = int(shape(u)[1])
    n1: Int = int(shape(u)[2])
    for i3 from 1 to n3 - 1 {
        for i2 from 1 to n2 - 1 {
            u[i3, i2, 0] = u[i3, i2, n1 - 2]
            u[i3, i2, n1 - 1] = u[i3, i2, 1]
        }
        for i1 to n1 {
            u[i3, 0, i1] = u[i3, n2 - 2, i1]
            u[i3, n2 - 1, i1] = u[i3, 1, i1]
        }
    }
    for i2 to n2 {
        for i1 to n1 {
            u[0, i2, i1] = u[n3 - 2, i2, i1]
            u[n3 - 1, i2, i1] = u[1, i2, i1]
        }
    }
}

# psinv: u = u + C r, the smoother
def psinv(r: Arr, u: Arr, c: Arr) {
    n3: Int = int(shape(r)[0])
    n2: Int = int(shape(r)[1])
    n1: Int = int(shape(r)[2])
    parallel for p to n3 - 2 {
        i3: Int = p + 1
        r1 = zeros(n1)
        r2 = zeros(n1)
        for i2 from 1 to n2 - 1 {
            for i1 to n1 {
                r1[i1] = r[i3, i2 - 1, i1] + r[i3, i2 + 1, i1] + r[i3 - 1, i2, i1] + r[i3 + 1, i2, i1]
                r2[i1] = (r[i3 - 1, i2 - 1, i1] + r[i3 - 1, i2 + 1, i1]
                    + r[i3 + 1, i2 - 1, i1] + r[i3 + 1, i2 + 1, i1])
            }
            for i1 from 1 to n1 - 1 {
                u[i3, i2, i1] = (u[i3, i2, i1]
                    + c[0] * r[i3, i2, i1]
                    + c[1] * (r[i3, i2, i1 - 1] + r[i3, i2, i1 + 1] + r1[i1])
                    + c[2] * (r2[i1] + r1[i1 - 1] + r1[i1 + 1]))
            }
        }
    }
    comm3(u)
}

# resid: r = v - A u (r and v may be the same array, as in mg3P)
def resid(u: Arr, v: Arr, r: Arr, a: Arr) {
    n3: Int = int(shape(u)[0])
    n2: Int = int(shape(u)[1])
    n1: Int = int(shape(u)[2])
    parallel for p to n3 - 2 {
        i3: Int = p + 1
        u1 = zeros(n1)
        u2 = zeros(n1)
        for i2 from 1 to n2 - 1 {
            for i1 to n1 {
                u1[i1] = u[i3, i2 - 1, i1] + u[i3, i2 + 1, i1] + u[i3 - 1, i2, i1] + u[i3 + 1, i2, i1]
                u2[i1] = (u[i3 - 1, i2 - 1, i1] + u[i3 - 1, i2 + 1, i1]
                    + u[i3 + 1, i2 - 1, i1] + u[i3 + 1, i2 + 1, i1])
            }
            for i1 from 1 to n1 - 1 {
                r[i3, i2, i1] = (v[i3, i2, i1]
                    - a[0] * u[i3, i2, i1]
                    - a[2] * (u2[i1] + u1[i1 - 1] + u1[i1 + 1])
                    - a[3] * (u2[i1 - 1] + u2[i1 + 1]))
            }
        }
    }
    comm3(r)
}

# rprj3: the fine residual r restricted to the coarse grid s
def rprj3(r: Arr, s: Arr) {
    m3k: Int = int(shape(r)[0])
    m2k: Int = int(shape(r)[1])
    m1k: Int = int(shape(r)[2])
    m3j: Int = int(shape(s)[0])
    m2j: Int = int(shape(s)[1])
    m1j: Int = int(shape(s)[2])
    d1: Int = 1
    if m1k == 3 {
        d1 = 2
    }
    d2: Int = 1
    if m2k == 3 {
        d2 = 2
    }
    d3: Int = 1
    if m3k == 3 {
        d3 = 2
    }
    x1 = zeros(m1k)
    y1 = zeros(m1k)
    for j3 from 1 to m3j - 1 {
        for j2 from 1 to m2j - 1 {
            i3: Int = 2 * j3 + 1 - d3
            i2: Int = 2 * j2 + 1 - d2
            for j1 from 1 to m1j {
                i1: Int = 2 * j1 + 1 - d1
                x1[i1 - 1] = (r[i3, i2 - 1, i1 - 1] + r[i3, i2 + 1, i1 - 1]
                    + r[i3 - 1, i2, i1 - 1] + r[i3 + 1, i2, i1 - 1])
                y1[i1 - 1] = (r[i3 - 1, i2 - 1, i1 - 1] + r[i3 + 1, i2 - 1, i1 - 1]
                    + r[i3 - 1, i2 + 1, i1 - 1] + r[i3 + 1, i2 + 1, i1 - 1])
            }
            for j1 from 1 to m1j - 1 {
                i1: Int = 2 * j1 + 1 - d1
                y2 = (r[i3 - 1, i2 - 1, i1] + r[i3 + 1, i2 - 1, i1]
                    + r[i3 - 1, i2 + 1, i1] + r[i3 + 1, i2 + 1, i1])
                x2 = r[i3, i2 - 1, i1] + r[i3, i2 + 1, i1] + r[i3 - 1, i2, i1] + r[i3 + 1, i2, i1]
                s[j3, j2, j1] = (0.5 * r[i3, i2, i1]
                    + 0.25 * (r[i3, i2, i1 - 1] + r[i3, i2, i1 + 1] + x2)
                    + 0.125 * (x1[i1 - 1] + x1[i1 + 1] + y2)
                    + 0.0625 * (y1[i1 - 1] + y1[i1 + 1]))
            }
        }
    }
    comm3(s)
}

# interp: the coarse correction z added to the fine one u, trilinearly
def interp(z: Arr, u: Arr) {
    mm3: Int = int(shape(z)[0])
    mm2: Int = int(shape(z)[1])
    mm1: Int = int(shape(z)[2])
    if shape(u)[0] == 3 or shape(u)[1] == 3 or shape(u)[2] == 3 {
        # mg.f90's branch for a fine grid 3 points wide, which no class
        # reaches: the coarsest grid is 4 wide with its ghosts
        stop("interp: a grid 3 points wide is not ported")
    }
    z1 = zeros(mm1)
    z2 = zeros(mm1)
    z3 = zeros(mm1)
    for i3 to mm3 - 1 {
        for i2 to mm2 - 1 {
            for i1 to mm1 {
                z1[i1] = z[i3, i2 + 1, i1] + z[i3, i2, i1]
                z2[i1] = z[i3 + 1, i2, i1] + z[i3, i2, i1]
                z3[i1] = z[i3 + 1, i2 + 1, i1] + z[i3 + 1, i2, i1] + z1[i1]
            }
            for i1 to mm1 - 1 {
                u[2 * i3, 2 * i2, 2 * i1] += z[i3, i2, i1]
                u[2 * i3, 2 * i2, 2 * i1 + 1] += 0.5 * (z[i3, i2, i1 + 1] + z[i3, i2, i1])
            }
            for i1 to mm1 - 1 {
                u[2 * i3, 2 * i2 + 1, 2 * i1] += 0.5 * z1[i1]
                u[2 * i3, 2 * i2 + 1, 2 * i1 + 1] += 0.25 * (z1[i1] + z1[i1 + 1])
            }
            for i1 to mm1 - 1 {
                u[2 * i3 + 1, 2 * i2, 2 * i1] += 0.5 * z2[i1]
                u[2 * i3 + 1, 2 * i2, 2 * i1 + 1] += 0.25 * (z2[i1] + z2[i1 + 1])
            }
            for i1 to mm1 - 1 {
                u[2 * i3 + 1, 2 * i2 + 1, 2 * i1] += 0.25 * z3[i1]
                u[2 * i3 + 1, 2 * i2 + 1, 2 * i1 + 1] += 0.125 * (z3[i1] + z3[i1 + 1])
            }
        }
    }
}

# norm2u3: the root-mean-square and the largest magnitude over the interior
def norm2u3(r: Arr, nx) {
    n3: Int = int(shape(r)[0])
    n2: Int = int(shape(r)[1])
    n1: Int = int(shape(r)[2])
    s = 0.0
    rnmu = 0.0
    for i3 from 1 to n3 - 1 {
        for i2 from 1 to n2 - 1 {
            for i1 from 1 to n1 - 1 {
                s = s + r[i3, i2, i1] ^ 2
                rnmu = max(rnmu, abs(r[i3, i2, i1]))
            }
        }
    }
    return sqrt(s / (nx * nx * nx)), rnmu
}

# power: a^n mod 2^46 by repeated squaring, through randlc
def power(a: Int, n: Int) -> Int {
    p: Int = 1
    nj: Int = n
    aj: Int = a
    while nj != 0 {
        if nj % 2 == 1 {
            p, _ = randlc(p, aj)
        }
        aj, _ = randlc(aj, aj)
        nj = nj // 2
    }
    return p
}

# bubble: move a new entry at the front of the ten-best list into place
# (ind 1 keeps the largest in ascending order, ind 0 the smallest descending)
def bubble(ten: Arr, j1: [Int], j2: [Int], j3: [Int], ind: Int) {
    for i to MM - 1 {
        p: Int = ind * MM + i
        out_of_order = ten[p] > ten[p + 1] if ind == 1 else ten[p] < ten[p + 1]
        if not out_of_order {
            break
        }
        t = ten[p + 1]
        ten[p + 1] = ten[p]
        ten[p] = t
        jt: Int = j1[p + 1]
        j1[p + 1] = j1[p]
        j1[p] = jt
        jt = j2[p + 1]
        j2[p + 1] = j2[p]
        j2[p] = jt
        jt = j3[p + 1]
        j3[p + 1] = j3[p]
        j3[p] = jt
    }
}

# zran3: a randlc field, then v = +1 at its ten largest points, -1 at its
# ten smallest, 0 elsewhere
def zran3(z: Arr, nx: Int) {
    n3: Int = int(shape(z)[0])
    n2: Int = int(shape(z)[1])
    n1: Int = int(shape(z)[2])
    a1 = power(A_RAND, nx)
    a2 = power(A_RAND, nx * nx)
    z[:] = 0.0
    x0: Int = X_RAND
    x0, _ = randlc(x0, power(A_RAND, 0))
    line = zeros(nx)
    starts = int_zeros(n3)
    for i3 from 1 to nx + 1 {
        starts[i3] = x0
        x0, _ = randlc(x0, a2)
    }
    for i3 from 1 to nx + 1 {
        x1: Int = starts[i3]
        for i2 from 1 to nx + 1 {
            x_line_end = vranlc(nx, x1, A_RAND, line)
            for i1 to nx {
                z[i3, i2, i1 + 1] = line[i1]
            }
            x1, _ = randlc(x1, a1)
        }
    }
    # ten[i + MM * ind]: ind 1 the largest values, ind 0 the smallest
    ten = zeros(2 * MM)
    j1 = int_zeros(2 * MM)
    j2 = int_zeros(2 * MM)
    j3 = int_zeros(2 * MM)
    for i to MM {
        ten[i] = 1.0
    }
    for i3 from 1 to n3 - 1 {
        for i2 from 1 to n2 - 1 {
            for i1 from 1 to n1 - 1 {
                if z[i3, i2, i1] > ten[MM] {
                    ten[MM] = z[i3, i2, i1]
                    j1[MM] = i1
                    j2[MM] = i2
                    j3[MM] = i3
                    bubble(ten, j1, j2, j3, 1)
                }
                if z[i3, i2, i1] < ten[0] {
                    ten[0] = z[i3, i2, i1]
                    j1[0] = i1
                    j2[0] = i2
                    j3[0] = i3
                    bubble(ten, j1, j2, j3, 0)
                }
            }
        }
    }
    # with one thread, mg.f90's jg table is the j tables as they stand
    z[:] = 0.0
    for i to MM reversed {
        z[j3[i], j2[i], j1[i]] = -1.0
    }
    for i to MM reversed {
        z[j3[MM + i], j2[MM + i], j1[MM + i]] = 1.0
    }
    comm3(z)
}

# mg3P: one V-cycle; levels[lt - 1] is the finest grid, whose residual
# r goes down to levels[0] and whose correction comes back up
def mg3p(levels: [Level], v: Arr, a: Arr, c: Arr) {
    lt = len(levels)
    for k from lt - 1 to 0 by -1 {
        rprj3(levels[k].r, levels[k - 1].r)
    }
    levels[0].u[:] = 0.0
    psinv(levels[0].r, levels[0].u, c)
    for k from 1 to lt - 1 {
        levels[k].u[:] = 0.0
        interp(levels[k - 1].u, levels[k].u)
        resid(levels[k].u, levels[k].r, levels[k].r, a)
        psinv(levels[k].r, levels[k].u, c)
    }
    interp(levels[lt - 2].u, levels[lt - 1].u)
    resid(levels[lt - 1].u, v, levels[lt - 1].r, a)
    psinv(levels[lt - 1].r, levels[lt - 1].u, c)
}

def mg_run(cls) {
    nx_num, nit_num, verify_value = mg_class(cls)
    nx: Int = int(nx_num)
    nit: Int = int(nit_num)
    a = [-8.0 / 3.0, 0.0, 1.0 / 6.0, 1.0 / 12.0]
    c = [-3.0 / 8.0, 1.0 / 32.0, -1.0 / 64.0, 0.0]
    # setup: level k (0 the coarsest) is 2^(k + 1) points a side plus ghosts
    levels = []
    n: Int = 2
    while n <= nx {
        levels = append(levels, Level { u: zeros(n + 2, n + 2, n + 2), r: zeros(n + 2, n + 2, n + 2) })
        n = 2 * n
    }
    lt = len(levels)
    v = zeros(nx + 2, nx + 2, nx + 2)

    # one V-cycle for free, as NPB does, then start again
    zran3(v, nx)
    resid(levels[lt - 1].u, v, levels[lt - 1].r, a)
    mg3p(levels, v, a, c)
    resid(levels[lt - 1].u, v, levels[lt - 1].r, a)
    levels[lt - 1].u[:] = 0.0
    zran3(v, nx)

    resid(levels[lt - 1].u, v, levels[lt - 1].r, a)
    for it to nit {
        mg3p(levels, v, a, c)
        resid(levels[lt - 1].u, v, levels[lt - 1].r, a)
    }
    rnm2, rnmu = norm2u3(levels[lt - 1].r, float(nx))
    return nx, nit, rnm2, verify_value
}

nx, nit, rnm2, verify_value = mg_run(CLASS)
rnm2_err = abs(rnm2 - verify_value) / verify_value
verified = rnm2_err <= EPSILON
print(f"MG class {CLASS}: {nx}^3 grid, {nit} V-cycles")
print(f"L2 norm = {rnm2:.13e}  error = {rnm2_err:.3e}")
status = "SUCCESSFUL" if verified else "UNSUCCESSFUL"
print(f"Verification = {status}")

test "MG's residual norm matches NPB's value for the class" {
    assert_true(verified)
}

