#! timing
# PolyBench/C 4.2.1 gesummv: y := alpha A x + beta B x.
# Reference: upstream/polybench-c-4.2.1/linear-algebra/blas/gesummv/gesummv.c
# The sizes are the MINI dataset; the harness gives the others with --set.
N = 30
DUMP = 1

from polybench import dump

def init() {
    x = [(i % N) / N for i to N]
    A = [[((i * j + 1) % N) / N for j to N] for i to N]
    B = [[((i * j + 2) % N) / N for j to N] for i to N]
    return A, B, x
}

def kernel(alpha, beta, A, B, x) {
    return alpha * (A @ x) + beta * (B @ x)
}

alpha = 1.5
beta = 1.2
A, B, x = init()
t0 = clock()
y = kernel(alpha, beta, A, B, x)
t1 = clock()
print("time", fmt(t1 - t0))
if DUMP == 1 {
    dump("y", y)
}

