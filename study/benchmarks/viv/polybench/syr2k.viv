#! timing
# PolyBench/C 4.2.1 syr2k: the lower triangle of C := alpha (A B^T + B A^T)
# + beta C; the upper triangle is left as it is.
# Reference: upstream/polybench-c-4.2.1/linear-algebra/blas/syr2k/syr2k.c
# The sizes are the MINI dataset; the harness gives the others with --set.
M = 20
N = 30
DUMP = 1

from polybench import dump

def init() {
    A = [[((i * j + 1) % N) / N for j to M] for i to N]
    B = [[((i * j + 2) % M) / M for j to M] for i to N]
    C = [[((i * j + 3) % N) / M for j to N] for i to N]
    return C, A, B
}

def kernel(alpha, beta, C, A, B) {
    P = A @ transpose(B)
    return tril(beta * C + alpha * (transpose(P) + P)) + triu(C, k=1)
}

alpha = 1.5
beta = 1.2
C, A, B = init()
t0 = clock()
C = kernel(alpha, beta, C, A, B)
t1 = clock()
print("time", fmt(t1 - t0))
if DUMP == 1 {
    dump("C", C)
}

