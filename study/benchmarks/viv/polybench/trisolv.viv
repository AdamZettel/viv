#! timing
# PolyBench/C 4.2.1 trisolv: solve L x = b by forward substitution, L lower
# triangular.
# Reference: upstream/polybench-c-4.2.1/linear-algebra/solvers/trisolv/trisolv.c
# The sizes are the MINI dataset; the harness gives the others with --set.
N = 40
DUMP = 1

from polybench import dump

def init() {
    b = [i for i to N]
    L = [[(i + N - j + 1) * 2 / N if j <= i else 0.0 for j to N] for i to N]
    return L, b
}

def kernel(L, b) {
    x = zeros(N)
    for i to N {
        x[i] = (b[i] - sum(L[i, j] * x[j] for j to i)) / L[i, i]
    }
    return x
}

L, b = init()
t0 = clock()
x = kernel(L, b)
t1 = clock()
print("time", fmt(t1 - t0))
if DUMP == 1 {
    dump("x", x)
}

