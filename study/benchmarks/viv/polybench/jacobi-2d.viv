#! timing
# PolyBench/C 4.2.1 jacobi-2d: the 5-point Jacobi stencil, alternating
# between A and B.
# Reference: upstream/polybench-c-4.2.1/stencils/jacobi-2d/jacobi-2d.c
# The sizes are the MINI dataset; the harness gives the others with --set.
TSTEPS = 20
N = 30
DUMP = 1

from polybench import dump

def init() {
    A = [[(i * (j + 2) + 2) / N for j to N] for i to N]
    B = [[(i * (j + 3) + 3) / N for j to N] for i to N]
    return A, B
}

# The interior of dst is a fifth of the sum of src at each point and its four
# neighbors, in the C's order (center, left, right, below, above).
def jacobi_step(src, dst) {
    dst[1:N - 1, 1:N - 1] = 0.2 * (src[1:N - 1, 1:N - 1] + src[1:N - 1, 0:N - 2] + src[1:N - 1, 2:N] + src[2:N, 1:N - 1] + src[0:N - 2, 1:N - 1])
}

def kernel(A, B) {
    for t to TSTEPS {
        jacobi_step(A, B)
        jacobi_step(B, A)
    }
    return A
}

A, B = init()
t0 = clock()
A = kernel(A, B)
t1 = clock()
print("time", fmt(t1 - t0))
if DUMP == 1 {
    dump("A", A)
}

