#! timing
# PolyBench/C 4.2.1 ludcmp: solve A x = b by A = L U without pivoting, then
# forward substitution (L y = b) and back substitution (U x = y).
# Reference: upstream/polybench-c-4.2.1/linear-algebra/solvers/ludcmp/ludcmp.c
# The sizes are the MINI dataset; the harness gives the others with --set.
N = 40
DUMP = 1

from polybench import dump

# As cholesky's: L0 L0^T with L0 lower triangular, 1 - j/N below the diagonal.
def init() {
    b = [(i + 1) / N / 2.0 + 4 for i to N]
    L0 = [[1.0 if j == i else (1.0 - j / N if j < i else 0.0) for j to N] for i to N]
    return L0 @ transpose(L0), b
}

def kernel(A, b) {
    step factor {
        for i to N {
            for j to i {
                A[i, j] = (A[i, j] - sum(A[i, k] * A[k, j] for k to j)) / A[j, j]
            }
            if i > 0 {
                A[i, i:N] = A[i, i:N] - A[i, 0:i] @ A[0:i, i:N]
            }
        }
    }
    y = zeros(N)
    step forward "L y = b, L with a unit diagonal" {
        for i to N {
            y[i] = b[i] - sum(A[i, j] * y[j] for j to i)
        }
    }
    x = zeros(N)
    step back "U x = y" {
        for i to N reversed {
            x[i] = (y[i] - sum(A[i, j] * x[j] for j from i + 1 to N)) / A[i, i]
        }
    }
    return x
}

A, b = init()
t0 = clock()
x = kernel(A, b)
t1 = clock()
print("time", fmt(t1 - t0))
if DUMP == 1 {
    dump("x", x)
}

