# What every PolyBench port shares: printing an output array the way
# PolyBench's -DPOLYBENCH_DUMP_ARRAYS does (between `begin dump: <name>` and
# `end   dump: <name>`), with every number at full precision (`fmt`, the
# shortest text that reads back as the same double) instead of two decimals.

# One row of a matrix, or a whole vector, per line.
def dump(name, X) {
    print("begin dump:", name)
    dims = shape(X)
    if len(dims) == 1 {
        print(join(" ", [fmt(x) for x in X]))
    }
    else {
        last = dims[len(dims) - 1]
        rows = reshape(X, numel(X) / last, last)
        for i to shape(rows)[0] {
            print(join(" ", [fmt(x) for x in rows[i, :]]))
        }
    }
    print("end   dump:", name)
}

