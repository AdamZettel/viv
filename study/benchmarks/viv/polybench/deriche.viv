#! timing
# PolyBench/C 4.2.1 deriche: Deriche's recursive edge-detection filter, a
# causal and an anticausal pass along each row, then along each column.
# Reference: upstream/polybench-c-4.2.1/medley/deriche/deriche.c
# The C computes in single precision (deriche.h's default); this port in
# double, so the two agree to float rounding.
# The sizes are the MINI dataset; the harness gives the others with --set.
W = 64
H = 64
DUMP = 1

from polybench import dump

# The image's values are hashed pixel positions scaled into [0, 1].
HASH_MOD = 65536
GRAY_MAX = 65535.0

def init() {
    return [[((313 * i + 991 * j) % HASH_MOD) / GRAY_MAX for j to H] for i to W]
}

# Each pass is a second-order recurrence along a line, so it is a loop. The
# coefficients are PolyBench's (b1 is 2^-alpha there, as here).
def kernel(alpha, img_in) {
    k = (1.0 - exp(-alpha)) * (1.0 - exp(-alpha)) / (1.0 + 2.0 * alpha * exp(-alpha) - exp(2.0 * alpha))
    a1 = k
    a2 = k * exp(-alpha) * (alpha - 1.0)
    a3 = k * exp(-alpha) * (alpha + 1.0)
    a4 = -k * exp(-2.0 * alpha)
    b1 = 2.0 ^ -alpha
    b2 = -exp(-2.0 * alpha)
    y1 = zeros(W, H)
    y2 = zeros(W, H)
    step rows "causal and anticausal passes along each row" {
        for i to W {
            ym1 = 0.0
            ym2 = 0.0
            xm1 = 0.0
            for j to H {
                y1[i, j] = a1 * img_in[i, j] + a2 * xm1 + b1 * ym1 + b2 * ym2
                xm1 = img_in[i, j]
                ym2 = ym1
                ym1 = y1[i, j]
            }
            yp1 = 0.0
            yp2 = 0.0
            xp1 = 0.0
            xp2 = 0.0
            for j to H reversed {
                y2[i, j] = a3 * xp1 + a4 * xp2 + b1 * yp1 + b2 * yp2
                xp2 = xp1
                xp1 = img_in[i, j]
                yp2 = yp1
                yp1 = y2[i, j]
            }
        }
    }
    img_out = y1 + y2
    step columns "the same two passes along each column of the row result" {
        for j to H {
            tm1 = 0.0
            ym1 = 0.0
            ym2 = 0.0
            for i to W {
                y1[i, j] = a1 * img_out[i, j] + a2 * tm1 + b1 * ym1 + b2 * ym2
                tm1 = img_out[i, j]
                ym2 = ym1
                ym1 = y1[i, j]
            }
            tp1 = 0.0
            tp2 = 0.0
            yp1 = 0.0
            yp2 = 0.0
            for i to W reversed {
                y2[i, j] = a3 * tp1 + a4 * tp2 + b1 * yp1 + b2 * yp2
                tp2 = tp1
                tp1 = img_out[i, j]
                yp2 = yp1
                yp1 = y2[i, j]
            }
        }
    }
    return y1 + y2
}

alpha = 0.25
img_in = init()
t0 = clock()
img_out = kernel(alpha, img_in)
t1 = clock()
print("time", fmt(t1 - t0))
if DUMP == 1 {
    dump("imgOut", img_out)
}

