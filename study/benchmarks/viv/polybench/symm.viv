#! timing
# PolyBench/C 4.2.1 symm: C := alpha A B + beta C, with A symmetric and only
# its lower triangle stored.
# Reference: upstream/polybench-c-4.2.1/linear-algebra/blas/symm/symm.c
# The sizes are the MINI dataset; the harness gives the others with --set.
M = 20
N = 30
DUMP = 1

from polybench import dump

# PolyBench fills the part of A that must not be read with this value.
UNUSED = -999.0

def init() {
    C = [[((i + j) % 100) / M for j to N] for i to M]
    B = [[((N + i - j) % 100) / M for j to N] for i to M]
    A = [[((i + j) % 100) / M if j <= i else UNUSED for j to M] for i to M]
    return C, A, B
}

def kernel(alpha, beta, C, A, B) {
    S = tril(A) + transpose(tril(A, k=-1))
    return alpha * (S @ B) + beta * C
}

alpha = 1.5
beta = 1.2
C, A, B = init()
t0 = clock()
C = kernel(alpha, beta, C, A, B)
t1 = clock()
print("time", fmt(t1 - t0))
if DUMP == 1 {
    dump("C", C)
}

