# Microbenchmarks: recursion_fibonacci. Reference: upstream/Microbenchmarks/julia/perf.jl
#   fib(n) = n < 2 ? n : fib(n - 1) + fib(n - 2)
#   @test fib(20) == 6765
#   @timeit fib(20) "recursion_fibonacci"
# The harness writes reps.txt; the timed work is `reps` calls of fib(20).

def fib(n) {
    if n < 2 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

reps = int(strip(read_text("reps.txt")))
if fib(20) != 6765 {
    stop("fib(20) != 6765")
}
acc = 0.0
for r to reps {
    acc = acc + fib(20)
}
print("fib ok", fmt(acc, "d"))

