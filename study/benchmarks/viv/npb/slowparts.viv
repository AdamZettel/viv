#pythran export slowparts(int, int, float [][][], float [][][], float [][], float [][], float [][][], float [][][], int)
def slowparts__fprime(x: Arr) {
    return 1 - py_apow(tanh(x), 2)
}
#| computes the linear algebra intensive part of the gradients of the grae
def slowparts(d, re_, preDz: Arr, preWz: Arr, SRW: Arr, RSW: Arr, yxV: Arr, xyU: Arr, resid) {
    partialDU = zeros(py_size(py_int(d + 1)), py_size(re_), py_size(py_int(2 * d)), py_size(d))
    for k to py_int(2 * d) {
        for i to d {
            partialDU[:, :, py_ix(k, shape(partialDU)[2]), py_ix(i, shape(partialDU)[3])] = py_bset(py_bmul(py_bmul(slowparts__fprime(slab(preDz, k)), slowparts__fprime(slab(preWz, i))) * (SRW[i, k] + RSW[i, k]), yxV[:, :, py_ix(i, shape(yxV)[2])]), partialDU[:, :, py_ix(k, shape(partialDU)[2]), py_ix(i, shape(partialDU)[3])])
        }
    }
    return partialDU
}
