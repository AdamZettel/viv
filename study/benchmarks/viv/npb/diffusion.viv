#| 0, 1, ..., n - 1.
def py_iota(n) {
    a = zeros(n)
    for i to n {
        a[i] = i
    }
    return a
}

#| Every entry of a real array, row-major, as a vector (a copy).
def py_flat(a: Arr) {
    return take(a, py_iota(numel(a)))
}

#| An int result, as Python's int: a -0.0 becomes 0 (an int has no sign on zero), and the run
#| stops at 2^53, past which a double no longer holds every integer (Python's int does).
def py_int(x) {
    if abs(x) >= 9007199254740992 {
        stop("py2viv: an integer reached 2^53; Python's int is exact there and a double is not")
    }
    return x + 0.0
}

#| NumPy's pairwise sum of f[lo], ..., f[lo + n - 1] (numpy/core/src/umath/loops_utils.h):
#| below 8 terms left to right from 0; to 128, eight running sums combined as a tree, then
#| the rest; above, the two halves (the first a multiple of 8 long) summed apart.
def py_pw(f: Arr, lo, n) {
    if n < 8 {
        s = 0.0
        for i to n {
            s += f[lo + i]
        }
        return s
    }
    if n <= 128 {
        r = zeros(8)
        for j to 8 {
            r[j] = f[lo + j]
        }
        i = 8
        while i < n - n % 8 {
            for j to 8 {
                r[j] += f[lo + i + j]
            }
            i += 8
        }
        s = ((r[0] + r[1]) + (r[2] + r[3])) + ((r[4] + r[5]) + (r[6] + r[7]))
        while i < n {
            s += f[lo + i]
            i += 1
        }
        return s
    }
    n2 = floor(n / 2)
    n2 = n2 - n2 % 8
    return py_pw(f, lo, n2) + py_pw(f, lo + n2, n - n2)
}

#| NumPy's sum of f[lo], ..., f[lo + n - 1] along one axis: from 0.0, a pairwise sum of each
#| block of NumPy's buffer size (8192 entries), added in order.
def py_blk(f: Arr, lo, n) {
    bufsize = 8192
    s = 0.0
    b = 0
    while b < n {
        s = s + py_pw(f, lo + b, min(bufsize, n - b))
        b += bufsize
    }
    return s
}

#| np.sum(a), a.sum() of a float array: NumPy's sum over the entries in row-major order (py_blk).
def py_npsum(a: Arr) {
    f = py_flat(a)
    return py_blk(f, 0, len(f))
}

#| A slice bound as Python reads it on an axis of length n: a negative one counts from the
#| end; the result is clamped to 0 ... n.
def py_lo(lo, n) {
    b = lo
    if b < 0 {
        b = b + n
        if b < 0 {
            b = 0
        }
    }
    if b > n {
        b = n
    }
    return b
}

#| The end of the slice lo:hi on an axis of length n, as Python reads it, and never before
#| the start (Python's slice is then empty).
def py_hi(lo, hi, n) {
    b = py_lo(hi, n)
    a = py_lo(lo, n)
    if b < a {
        b = a
    }
    return b
}

#| The flat indices, in row-major order of the shape e, of the entries of an array of shape d
#| that broadcasting to e reads (a length 1 of d is read again along that axis of e).
def py_bidx(d: Arr, e: Arr) {
    n = len(e)
    m = len(d)
    st = zeros(n)
    s = 1
    for k to m {
        j = m - 1 - k
        if d[j] != 1 {
            st[j + n - m] = s
        }
        s = s * d[j]
    }
    idx = zeros(1)
    for i to n {
        w = e[i]
        nxt = zeros(len(idx) * w)
        for p to len(idx) {
            for c to w {
                nxt[p * w + c] = idx[p] + c * st[i]
            }
        }
        idx = nxt
    }
    return idx
}

#| a broadcast to the shape e (a shape py_bdims gave for a and another array): a itself when
#| it has that shape, else a new array whose entries are copies of a's.
def py_bto(a: Arr, e: Arr) {
    d = shape(a)
    if len(d) == len(e) {
        if all(d == e) {
            return a
        }
    }
    return py_shaped(take(a, py_bidx(d, e)), e)
}

#| 1 when a value of shape dv broadcasts to exactly the shape e (each of its lengths,
#| aligned at the last axis, is e's or 1), else 0.
def py_bfits(dv: Arr, e: Arr) {
    n = len(e)
    m = len(dv)
    if m > n {
        return 0
    }
    for k to m {
        x = dv[m - 1 - k]
        if x != 1 and x != e[n - 1 - k] {
            return 0
        }
    }
    return 1
}

#| A value stored into a slice or a row of the shape of s: NumPy broadcasts it into that
#| shape, and raises ValueError where it cannot.
def py_bset(v: Arr, s: Arr) {
    if py_bfits(shape(v), shape(s)) == 0 {
        stop("ValueError: could not broadcast input array from shape")
    }
    return py_bto(v, shape(s))
}

#| The entries of f, row-major, as an array of shape e (a vector of 1 to 4 lengths).
def py_shaped(f: Arr, e: Arr) {
    if len(e) == 1 {
        return f
    }
    if len(e) == 2 {
        z = zeros(e[0], e[1])
    }
    else {
        if len(e) == 3 {
            z = zeros(e[0], e[1], e[2])
        }
        else {
            z = zeros(e[0], e[1], e[2], e[3])
        }
    }
    put(z, py_iota(numel(z)), f)
    return z
}

#| np.reshape(a, d) in row-major order: a's entries in the shape d, where one length may be
#| negative (NumPy 1.24 reads any negative length as -1: the one that makes the sizes agree).
#| NumPy raises ValueError where they cannot agree.
def py_reshape(a: Arr, d: Arr) {
    e = copy(d)
    known = 1
    free = -1
    for i to len(e) {
        if e[i] < 0 {
            if free >= 0 {
                stop("ValueError: can only specify one unknown dimension")
            }
            free = i
        }
        else {
            known = known * e[i]
        }
    }
    if free >= 0 {
        if known == 0 or numel(a) % known != 0 {
            stop("ValueError: cannot reshape the array into that shape")
        }
        e[free] = numel(a) / known
        known = numel(a)
    }
    if known != numel(a) {
        stop("ValueError: cannot reshape the array into that shape")
    }
    return py_shaped(py_flat(a), e)
}

#setup: import numpy as np;lx,ly=(2**7,2**7);u=np.zeros([lx,ly],dtype=np.double);u[lx//2,ly//2]=1000.0;tempU=np.zeros([lx,ly],dtype=np.double)
#run: diffusion(u,tempU,100)
#pythran export diffusion(float [][], float [][], int)
#| Apply Numpy matrix for the Forward-Euler Approximation
def diffusion(u: Arr, tempU: Arr, iterNum) {
    mu = 0.1
    for n to iterNum {
        tempU[py_lo(1, len(tempU)):py_hi(1, -1, len(tempU)), py_lo(1, shape(tempU)[1]):py_hi(1, -1, shape(tempU)[1])] = py_bset(u[py_lo(1, len(u)):py_hi(1, -1, len(u)), py_lo(1, shape(u)[1]):py_hi(1, -1, shape(u)[1])] + mu * (u[min(2, len(u)):, py_lo(1, shape(u)[1]):py_hi(1, -1, shape(u)[1])] - 2 * u[py_lo(1, len(u)):py_hi(1, -1, len(u)), py_lo(1, shape(u)[1]):py_hi(1, -1, shape(u)[1])] + u[py_lo(0, len(u)):py_hi(0, -2, len(u)), py_lo(1, shape(u)[1]):py_hi(1, -1, shape(u)[1])] + u[py_lo(1, len(u)):py_hi(1, -1, len(u)), min(2, shape(u)[1]):] - 2 * u[py_lo(1, len(u)):py_hi(1, -1, len(u)), py_lo(1, shape(u)[1]):py_hi(1, -1, shape(u)[1])] + u[py_lo(1, len(u)):py_hi(1, -1, len(u)), py_lo(0, shape(u)[1]):py_hi(0, -2, shape(u)[1])]), tempU[py_lo(1, len(tempU)):py_hi(1, -1, len(tempU)), py_lo(1, shape(tempU)[1]):py_hi(1, -1, shape(tempU)[1])])
        u[:, :] = py_bset(tempU[:, :], u[:, :])
        tempU[:, :] = 0.0
    }
}
