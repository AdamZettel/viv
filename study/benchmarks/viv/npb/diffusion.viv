py_s2 = split(read_text("in0.txt"))
py_l1 = zeros(len(py_s2))
for py_i3 to len(py_s2) {
    py_t4 = py_s2[py_i3]
    py_l1[py_i3] = float(py_t4)
}
_a0 = py_reshape(py_l1, [128, 128])
py_s6 = split(read_text("in1.txt"))
py_l5 = zeros(len(py_s6))
for py_i7 to len(py_s6) {
    py_t8 = py_s6[py_i7]
    py_l5[py_i7] = float(py_t8)
}
_a1 = py_reshape(py_l5, [128, 128])
_s2 = py_int(int(read_text("s2.txt")))
reps = py_int(int(read_text("reps.txt")))
diffusion(_a0, _a1, _s2)
print(fmt(py_npsum(_a0)))
print(fmt(py_npsum(_a0 * _a0)))
print(fmt(py_npsum(_a1)))
print(fmt(py_npsum(_a1 * _a1)))
_chk = 0.0
for _i to reps {
    diffusion(_a0, _a1, _s2)
    _chk = _chk + _a0[0, 0]
}
print(fmt(_chk))

