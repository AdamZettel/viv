#| 0, 1, ..., n - 1.
def py_iota(n) {
    a = zeros(n)
    for i to n {
        a[i] = i
    }
    return a
}

#| Every entry of a real array, row-major, as a vector (a copy).
def py_flat(a: Arr) {
    return take(a, py_iota(numel(a)))
}

#| An int result, as Python's int: a -0.0 becomes 0 (an int has no sign on zero), and the run
#| stops at 2^53, past which a double no longer holds every integer (Python's int does).
def py_int(x) {
    if abs(x) >= 9007199254740992 {
        stop("py2viv: an integer reached 2^53; Python's int is exact there and a double is not")
    }
    return x + 0.0
}

#| An integer-array result: every entry below 2^53 in size (NumPy's int64 is exact to 2^63).
def py_int_arr(a: Arr) {
    if max(abs(a)) >= 9007199254740992 {
        stop("py2viv: an integer array entry reached 2^53; NumPy's int64 is exact there and a double is not")
    }
    return a + 0.0
}

#| The sum of an integer array or list, exactly: every partial sum checked below 2^53.
def py_isum(a: Arr) {
    f = py_flat(a)
    s = 0
    for i to len(f) {
        s = py_int(s + f[i])
    }
    return s
}

#| A slice bound as Python reads it on an axis of length n: a negative one counts from the
#| end; the result is clamped to 0 ... n.
def py_lo(lo, n) {
    b = lo
    if b < 0 {
        b = b + n
        if b < 0 {
            b = 0
        }
    }
    if b > n {
        b = n
    }
    return b
}

#| The end of the slice lo:hi on an axis of length n, as Python reads it, and never before
#| the start (Python's slice is then empty).
def py_hi(lo, hi, n) {
    b = py_lo(hi, n)
    a = py_lo(lo, n)
    if b < a {
        b = a
    }
    return b
}

#| The shape NumPy broadcasts two shapes da and db to (aligned at the last axis, a length 1
#| stretched); the run stops where NumPy raises ValueError.
def py_bdims(da: Arr, db: Arr) {
    n = len(da)
    if len(db) > n {
        n = len(db)
    }
    e = zeros(n)
    for i to n {
        x = 1
        y = 1
        if i >= n - len(da) {
            x = da[i - n + len(da)]
        }
        if i >= n - len(db) {
            y = db[i - n + len(db)]
        }
        if x == y or y == 1 {
            e[i] = x
        }
        else {
            if x == 1 {
                e[i] = y
            }
            else {
                stop("ValueError: operands could not be broadcast together with shapes")
            }
        }
    }
    return e
}

#| The flat indices, in row-major order of the shape e, of the entries of an array of shape d
#| that broadcasting to e reads (a length 1 of d is read again along that axis of e).
def py_bidx(d: Arr, e: Arr) {
    n = len(e)
    m = len(d)
    st = zeros(n)
    s = 1
    for k to m {
        j = m - 1 - k
        if d[j] != 1 {
            st[j + n - m] = s
        }
        s = s * d[j]
    }
    idx = zeros(1)
    for i to n {
        w = e[i]
        nxt = zeros(len(idx) * w)
        for p to len(idx) {
            for c to w {
                nxt[p * w + c] = idx[p] + c * st[i]
            }
        }
        idx = nxt
    }
    return idx
}

#| a broadcast to the shape e (a shape py_bdims gave for a and another array): a itself when
#| it has that shape, else a new array whose entries are copies of a's.
def py_bto(a: Arr, e: Arr) {
    d = shape(a)
    if len(d) == len(e) {
        if all(d == e) {
            return a
        }
    }
    return py_shaped(take(a, py_bidx(d, e)), e)
}

#| a - b of two real arrays, broadcast.
def py_bsub(a: Arr, b: Arr) {
    e = py_bdims(shape(a), shape(b))
    return py_bto(a, e) - py_bto(b, e)
}

#| The entries of f, row-major, as an array of shape e (a vector of 1 to 4 lengths).
def py_shaped(f: Arr, e: Arr) {
    if len(e) == 1 {
        return f
    }
    if len(e) == 2 {
        z = zeros(e[0], e[1])
    }
    else {
        if len(e) == 3 {
            z = zeros(e[0], e[1], e[2])
        }
        else {
            z = zeros(e[0], e[1], e[2], e[3])
        }
    }
    put(z, py_iota(numel(z)), f)
    return z
}

#| np.reshape(a, d) in row-major order: a's entries in the shape d, where one length may be
#| negative (NumPy 1.24 reads any negative length as -1: the one that makes the sizes agree).
#| NumPy raises ValueError where they cannot agree.
def py_reshape(a: Arr, d: Arr) {
    e = copy(d)
    known = 1
    free = -1
    for i to len(e) {
        if e[i] < 0 {
            if free >= 0 {
                stop("ValueError: can only specify one unknown dimension")
            }
            free = i
        }
        else {
            known = known * e[i]
        }
    }
    if free >= 0 {
        if known == 0 or numel(a) % known != 0 {
            stop("ValueError: cannot reshape the array into that shape")
        }
        e[free] = numel(a) / known
        known = numel(a)
    }
    if known != numel(a) {
        stop("ValueError: cannot reshape the array into that shape")
    }
    return py_shaped(py_flat(a), e)
}

#from: http://stackoverflow.com/questions/2196693/improving-numpy-performance
#pythran export specialconvolve(uint32 [][])
#setup: import numpy as np ; r = np.arange(100*10000, dtype=np.uint32).reshape(1000,1000)
#run: specialconvolve(r)
def specialconvolve(a: Arr) {
    # sorry, you must pad the input yourself
    rowconvol = py_int_arr(py_int_arr(a[py_lo(1, len(a)):py_hi(1, -1, len(a)), :] + a[:py_lo(-2, len(a)), :]) + a[min(2, len(a)):, :])
    colconvol = py_int_arr(py_bsub(py_int_arr(py_int_arr(rowconvol[:, py_lo(1, shape(rowconvol)[1]):py_hi(1, -1, shape(rowconvol)[1])] + rowconvol[:, :py_lo(-2, shape(rowconvol)[1])]) + rowconvol[:, min(2, shape(rowconvol)[1]):]), py_int_arr(9 * a[py_lo(1, len(a)):py_hi(1, -1, len(a)), py_lo(1, shape(a)[1]):py_hi(1, -1, shape(a)[1])])))
    return colconvol
}
# ---- harness ----
py_s2 = split(read_text("in0.txt"))
py_l1 = zeros(len(py_s2))
for py_i3 to len(py_s2) {
    py_t4 = py_s2[py_i3]
    py_l1[py_i3] = py_int(int(py_t4))
}
_a0 = py_reshape(py_l1, [1000, 1000])
reps = py_int(int(read_text("reps.txt")))
res = specialconvolve(_a0)
print(fmt((py_isum(res)) + 0.0, "d"))
print(fmt((py_isum(py_int_arr(res * res))) + 0.0, "d"))
_chk = 0.0
for _i to reps {
    res = specialconvolve(_a0)
    _chk = _chk + res[0, 0]
}
print(fmt(_chk))

