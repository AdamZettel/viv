for py_i3 to len(py_s2) {
    py_t4 = py_s2[py_i3]
    py_l1[py_i3] = float(py_t4)
}
_a0 = py_l1
_s1 = float(read_text("s1.txt"))
_s2 = float(read_text("s2.txt"))
_s3 = float(read_text("s3.txt"))
_s4 = float(read_text("s4.txt"))
_s5 = float(read_text("s5.txt"))
_s6 = float(read_text("s6.txt"))
_s7 = float(read_text("s7.txt"))
reps = py_int(int(read_text("reps.txt")))
res = hasting(_a0, _s1, _s2, _s3, _s4, _s5, _s6, _s7)
print(fmt(py_npsum(res)))
print(fmt(py_npsum(res * res)))
_chk = 0.0
for _i to reps {
    res = hasting(_a0, _s1, _s2, _s3, _s4, _s5, _s6, _s7)
    _chk = _chk + res[0]
}
print(fmt(_chk))

