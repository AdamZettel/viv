#| 0, 1, ..., n - 1.
def py_iota(n) {
    a = zeros(n)
    for i to n {
        a[i] = i
    }
    return a
}

#| Every entry of a real array, row-major, as a vector (a copy).
def py_flat(a: Arr) {
    return take(a, py_iota(numel(a)))
}

#| np.diff(a) of a vector: a[i + 1] - a[i].
def py_diff(a: Arr) {
    d = zeros(len(a) - 1)
    for i to len(a) - 1 {
        d[i] = a[i + 1] - a[i]
    }
    return d
}

#| An int result, as Python's int: a -0.0 becomes 0 (an int has no sign on zero), and the run
#| stops at 2^53, past which a double no longer holds every integer (Python's int does).
def py_int(x) {
    if abs(x) >= 9007199254740992 {
        stop("py2viv: an integer reached 2^53; Python's int is exact there and a double is not")
    }
    return x + 0.0
}

#| An integer-array result: every entry below 2^53 in size (NumPy's int64 is exact to 2^63).
def py_int_arr(a: Arr) {
    if max(abs(a)) >= 9007199254740992 {
        stop("py2viv: an integer array entry reached 2^53; NumPy's int64 is exact there and a double is not")
    }
    return a + 0.0
}

#| The sum of an integer array or list, exactly: every partial sum checked below 2^53.
def py_isum(a: Arr) {
    f = py_flat(a)
    s = 0
    for i to len(f) {
        s = py_int(s + f[i])
    }
    return s
}

#| A slice bound as Python reads it on an axis of length n: a negative one counts from the
#| end; the result is clamped to 0 ... n.
def py_lo(lo, n) {
    b = lo
    if b < 0 {
        b = b + n
        if b < 0 {
            b = 0
        }
    }
    if b > n {
        b = n
    }
    return b
}

#| One entry of an integer index array on an axis of length n: a negative one counts from the
#| end; NumPy raises IndexError for one out of bounds.
def py_ixchk(i, n) {
    j = i
    if j < 0 {
        j = j + n
    }
    if j < 0 or j >= n {
        stop("IndexError: index")
    }
    return j
}

#| The flat indices of the nonzero entries of m, in order (a NaN is nonzero, -0.0 is zero).
def py_nzflat(m: Arr) {
    f = py_flat(m)
    c = 0
    for i to len(f) {
        if f[i] != 0 {
            c += 1
        }
    }
    r = zeros(c)
    c = 0
    for i to len(f) {
        if f[i] != 0 {
            r[c] = i
            c += 1
        }
    }
    return r
}

#| a with an integer index array idx on axis k (the other axes whole): the result's shape is
#| a's with axis k replaced by idx's shape; a negative index counts from the end.
def py_gath(a: Arr, idx: Arr, k) {
    s = py_ax(a, k)
    before = s[0]
    along = s[1]
    after = s[2]
    f = py_flat(idx)
    for q to len(f) {
        f[q] = py_ixchk(f[q], along)
    }
    src = zeros(before * len(f) * after)
    p = 0
    for o to before {
        for q to len(f) {
            for i to after {
                src[p] = (o * along + f[q]) * after + i
                p += 1
            }
        }
    }
    d = shape(a)
    di = shape(idx)
    e = []
    for t to k {
        e = append(e, d[t])
    }
    for t to len(di) {
        e = append(e, di[t])
    }
    for t from k + 1 to len(d) {
        e = append(e, d[t])
    }
    return py_shaped(take(a, src), e)
}

#| np.nonzero(a)[k]: for each nonzero entry of a, in row-major order, its index along axis k.
def py_nzax(a: Arr, k) {
    f = py_nzflat(a)
    d = shape(a)
    after = 1
    for i from k + 1 to len(d) {
        after = after * d[i]
    }
    r = zeros(len(f))
    for q to len(f) {
        r[q] = floor(f[q] / after) % d[k]
    }
    return r
}

#| The sizes around axis k of a (k = -1: every axis, the array flat): [before, along, after].
def py_ax(a: Arr, k) {
    d = shape(a)
    if k < 0 {
        return [1, numel(a), 1]
    }
    before = 1
    for i to k {
        before = before * d[i]
    }
    after = 1
    for i from k + 1 to len(d) {
        after = after * d[i]
    }
    return [before, d[k], after]
}

#| The entries of f, row-major, as an array of shape e (a vector of 1 to 4 lengths).
def py_shaped(f: Arr, e: Arr) {
    if len(e) == 1 {
        return f
    }
    if len(e) == 2 {
        z = zeros(e[0], e[1])
    }
    else {
        if len(e) == 3 {
            z = zeros(e[0], e[1], e[2])
        }
        else {
            z = zeros(e[0], e[1], e[2], e[3])
        }
    }
    put(z, py_iota(numel(z)), f)
    return z
}

#from: http://stackoverflow.com/questions/4651683/numpy-grouping-using-itertools-groupby-performance
#setup: import numpy as np ; N = 500000 ; np.random.seed(0); values = np.array(np.random.randint(0,3298,size=N),dtype='u4') ; values.sort()
#run: grouping(values)
#pythran export grouping(uint32 [])
def grouping(values: Arr) {
    diff = concat([1], py_int_arr(py_diff(values)))
    idx = concat(py_nzax(diff, 0), [len(values)])
    return py_gath(values, idx[:py_lo(-1, len(idx))], 0), py_int_arr(py_diff(idx))
}
# ---- harness ----
py_s2 = split(read_text("in0.txt"))
py_l1 = zeros(len(py_s2))
for py_i3 to len(py_s2) {
    py_t4 = py_s2[py_i3]
    py_l1[py_i3] = py_int(int(py_t4))
}
_a0 = py_l1
reps = py_int(int(read_text("reps.txt")))
res0, res1 = grouping(_a0)
print(fmt((py_isum(res0)) + 0.0, "d"))
print(fmt((py_isum(py_int_arr(res0 * res0))) + 0.0, "d"))
print(fmt((py_isum(res1)) + 0.0, "d"))
print(fmt((py_isum(py_int_arr(res1 * res1))) + 0.0, "d"))
_chk = 0.0
for _i to reps {
    res0, res1 = grouping(_a0)
    _chk = _chk + res0[0]
}
print(fmt(_chk))

