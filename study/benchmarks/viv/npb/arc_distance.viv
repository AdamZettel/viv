#| 0, 1, ..., n - 1.
def py_iota(n) {
    a = zeros(n)
    for i to n {
        a[i] = i
    }
    return a
}

#| Every entry of a real array, row-major, as a vector (a copy).
def py_flat(a: Arr) {
    return take(a, py_iota(numel(a)))
}

#| An int result, as Python's int: a -0.0 becomes 0 (an int has no sign on zero), and the run
#| stops at 2^53, past which a double no longer holds every integer (Python's int does).
def py_int(x) {
    if abs(x) >= 9007199254740992 {
        stop("py2viv: an integer reached 2^53; Python's int is exact there and a double is not")
    }
    return x + 0.0
}

#| NumPy's pairwise sum of f[lo], ..., f[lo + n - 1] (numpy/core/src/umath/loops_utils.h):
#| below 8 terms left to right from 0; to 128, eight running sums combined as a tree, then
#| the rest; above, the two halves (the first a multiple of 8 long) summed apart.
def py_pw(f: Arr, lo, n) {
    if n < 8 {
        s = 0.0
        for i to n {
            s += f[lo + i]
        }
        return s
    }
    if n <= 128 {
        r = zeros(8)
        for j to 8 {
            r[j] = f[lo + j]
        }
        i = 8
        while i < n - n % 8 {
            for j to 8 {
                r[j] += f[lo + i + j]
            }
            i += 8
        }
        s = ((r[0] + r[1]) + (r[2] + r[3])) + ((r[4] + r[5]) + (r[6] + r[7]))
        while i < n {
            s += f[lo + i]
            i += 1
        }
        return s
    }
    n2 = floor(n / 2)
    n2 = n2 - n2 % 8
    return py_pw(f, lo, n2) + py_pw(f, lo + n2, n - n2)
}

#| NumPy's sum of f[lo], ..., f[lo + n - 1] along one axis: from 0.0, a pairwise sum of each
#| block of NumPy's buffer size (8192 entries), added in order.
def py_blk(f: Arr, lo, n) {
    bufsize = 8192
    s = 0.0
    b = 0
    while b < n {
        s = s + py_pw(f, lo + b, min(bufsize, n - b))
        b += bufsize
    }
    return s
}

#| np.sum(a), a.sum() of a float array: NumPy's sum over the entries in row-major order (py_blk).
def py_npsum(a: Arr) {
    f = py_flat(a)
    return py_blk(f, 0, len(f))
}

#| a ^ y of an array: through this def, whose parameter is typed an array (Viv types `a ^ y`
#| of an array a def returned as a number).
def py_apow(a: Arr, y) {
    return a ^ y
}

#| np.arctan2 of two vectors, entry by entry (Viv's atan2 takes numbers).
def py_atan2v(y: Arr, x: Arr) {
    if len(y) != len(x) {
        stop("py2viv: np.arctan2 of vectors of different lengths (NumPy broadcasts them)")
    }
    r = zeros(len(y))
    for i to len(y) {
        r[i] = atan2(y[i], x[i])
    }
    return r
}

#| The shape NumPy broadcasts two shapes da and db to (aligned at the last axis, a length 1
#| stretched); the run stops where NumPy raises ValueError.
def py_bdims(da: Arr, db: Arr) {
    n = len(da)
    if len(db) > n {
        n = len(db)
    }
    e = zeros(n)
    for i to n {
        x = 1
        y = 1
        if i >= n - len(da) {
            x = da[i - n + len(da)]
        }
        if i >= n - len(db) {
            y = db[i - n + len(db)]
        }
        if x == y or y == 1 {
            e[i] = x
        }
        else {
            if x == 1 {
                e[i] = y
            }
            else {
                stop("ValueError: operands could not be broadcast together with shapes")
            }
        }
    }
    return e
}

#| The flat indices, in row-major order of the shape e, of the entries of an array of shape d
#| that broadcasting to e reads (a length 1 of d is read again along that axis of e).
def py_bidx(d: Arr, e: Arr) {
    n = len(e)
    m = len(d)
    st = zeros(n)
    s = 1
    for k to m {
        j = m - 1 - k
        if d[j] != 1 {
            st[j + n - m] = s
        }
        s = s * d[j]
    }
    idx = zeros(1)
    for i to n {
        w = e[i]
        nxt = zeros(len(idx) * w)
        for p to len(idx) {
            for c to w {
                nxt[p * w + c] = idx[p] + c * st[i]
            }
        }
        idx = nxt
    }
    return idx
}

#| a broadcast to the shape e (a shape py_bdims gave for a and another array): a itself when
#| it has that shape, else a new array whose entries are copies of a's.
def py_bto(a: Arr, e: Arr) {
    d = shape(a)
    if len(d) == len(e) {
        if all(d == e) {
            return a
        }
    }
    return py_shaped(take(a, py_bidx(d, e)), e)
}

#| a + b of two real arrays, broadcast as NumPy broadcasts them.
def py_badd(a: Arr, b: Arr) {
    e = py_bdims(shape(a), shape(b))
    return py_bto(a, e) + py_bto(b, e)
}

#| a - b of two real arrays, broadcast.
def py_bsub(a: Arr, b: Arr) {
    e = py_bdims(shape(a), shape(b))
    return py_bto(a, e) - py_bto(b, e)
}

#| a * b of two real arrays, broadcast.
def py_bmul(a: Arr, b: Arr) {
    e = py_bdims(shape(a), shape(b))
    return py_bto(a, e) * py_bto(b, e)
}

#| The entries of f, row-major, as an array of shape e (a vector of 1 to 4 lengths).
def py_shaped(f: Arr, e: Arr) {
    if len(e) == 1 {
        return f
    }
    if len(e) == 2 {
        z = zeros(e[0], e[1])
    }
    else {
        if len(e) == 3 {
            z = zeros(e[0], e[1], e[2])
        }
        else {
            z = zeros(e[0], e[1], e[2], e[3])
        }
    }
    put(z, py_iota(numel(z)), f)
    return z
}

#setup: N = 10000 ; import numpy as np ; np.random.seed(0); t0, p0, t1, p1 = np.random.randn(N), np.random.randn(N), np.random.randn(N), np.random.randn(N)
#run: arc_distance(t0, p0, t1, p1)
#pythran export arc_distance(float64 [], float64[], float64[], float64[])
#| Calculates the pairwise arc distance between all points in vector a and b.
def arc_distance(theta_1: Arr, phi_1: Arr, theta_2: Arr, phi_2: Arr) {
    temp = py_badd(py_apow(sin(py_bsub(theta_2, theta_1) / 2), 2), py_bmul(py_bmul(cos(theta_1), cos(theta_2)), py_apow(sin(py_bsub(phi_2, phi_1) / 2), 2)))
    distance_matrix = 2 * py_atan2v(sqrt(temp), sqrt(1 - temp))
    return distance_matrix
}
