#| 0, 1, ..., n - 1.
def py_iota(n) {
    a = zeros(n)
    for i to n {
        a[i] = i
    }
    return a
}

#| Every entry of a real array, row-major, as a vector (a copy).
def py_flat(a: Arr) {
    return take(a, py_iota(numel(a)))
}

#| An int result, as Python's int: a -0.0 becomes 0 (an int has no sign on zero), and the run
#| stops at 2^53, past which a double no longer holds every integer (Python's int does).
def py_int(x) {
    if abs(x) >= 9007199254740992 {
        stop("py2viv: an integer reached 2^53; Python's int is exact there and a double is not")
    }
    return x + 0.0
}

#| NumPy's pairwise sum of f[lo], ..., f[lo + n - 1] (numpy/core/src/umath/loops_utils.h):
#| below 8 terms left to right from 0; to 128, eight running sums combined as a tree, then
#| the rest; above, the two halves (the first a multiple of 8 long) summed apart.
def py_pw(f: Arr, lo, n) {
    if n < 8 {
        s = 0.0
        for i to n {
            s += f[lo + i]
        }
        return s
    }
    if n <= 128 {
        r = zeros(8)
        for j to 8 {
            r[j] = f[lo + j]
        }
        i = 8
        while i < n - n % 8 {
            for j to 8 {
                r[j] += f[lo + i + j]
            }
            i += 8
        }
        s = ((r[0] + r[1]) + (r[2] + r[3])) + ((r[4] + r[5]) + (r[6] + r[7]))
        while i < n {
            s += f[lo + i]
            i += 1
        }
        return s
    }
    n2 = floor(n / 2)
    n2 = n2 - n2 % 8
    return py_pw(f, lo, n2) + py_pw(f, lo + n2, n - n2)
}

#| NumPy's sum of f[lo], ..., f[lo + n - 1] along one axis: from 0.0, a pairwise sum of each
#| block of NumPy's buffer size (8192 entries), added in order.
def py_blk(f: Arr, lo, n) {
    bufsize = 8192
    s = 0.0
    b = 0
    while b < n {
        s = s + py_pw(f, lo + b, min(bufsize, n - b))
        b += bufsize
    }
    return s
}

#| np.sum(a), a.sum() of a float array: NumPy's sum over the entries in row-major order (py_blk).
def py_npsum(a: Arr) {
    f = py_flat(a)
    return py_blk(f, 0, len(f))
}

#| a ^ y of an array: through this def, whose parameter is typed an array (Viv types `a ^ y`
#| of an array a def returned as a number).
def py_apow(a: Arr, y) {
    return a ^ y
}

#| The shape NumPy broadcasts two shapes da and db to (aligned at the last axis, a length 1
#| stretched); the run stops where NumPy raises ValueError.
def py_bdims(da: Arr, db: Arr) {
    n = len(da)
    if len(db) > n {
        n = len(db)
    }
    e = zeros(n)
    for i to n {
        x = 1
        y = 1
        if i >= n - len(da) {
            x = da[i - n + len(da)]
        }
        if i >= n - len(db) {
            y = db[i - n + len(db)]
        }
        if x == y or y == 1 {
            e[i] = x
        }
        else {
            if x == 1 {
                e[i] = y
            }
            else {
                stop("ValueError: operands could not be broadcast together with shapes")
            }
        }
    }
    return e
}

#| The flat indices, in row-major order of the shape e, of the entries of an array of shape d
#| that broadcasting to e reads (a length 1 of d is read again along that axis of e).
def py_bidx(d: Arr, e: Arr) {
    n = len(e)
    m = len(d)
    st = zeros(n)
    s = 1
    for k to m {
        j = m - 1 - k
        if d[j] != 1 {
            st[j + n - m] = s
        }
        s = s * d[j]
    }
    idx = zeros(1)
    for i to n {
        w = e[i]
        nxt = zeros(len(idx) * w)
        for p to len(idx) {
            for c to w {
                nxt[p * w + c] = idx[p] + c * st[i]
            }
        }
        idx = nxt
    }
    return idx
}

#| a broadcast to the shape e (a shape py_bdims gave for a and another array): a itself when
#| it has that shape, else a new array whose entries are copies of a's.
def py_bto(a: Arr, e: Arr) {
    d = shape(a)
    if len(d) == len(e) {
        if all(d == e) {
            return a
        }
    }
    return py_shaped(take(a, py_bidx(d, e)), e)
}

#| a - b of two real arrays, broadcast.
def py_bsub(a: Arr, b: Arr) {
    e = py_bdims(shape(a), shape(b))
    return py_bto(a, e) - py_bto(b, e)
}

#| a with an axis of length 1 inserted at each position of k (ascending positions in the
#| result): NumPy's `a[None]`, `a[:, None]`, `a[:, np.newaxis, :]`.
def py_newax(a: Arr, k: Arr) {
    d = shape(a)
    e = zeros(len(d) + len(k))
    j = 0
    q = 0
    for i to len(e) {
        one = 0
        if q < len(k) {
            if k[q] == i {
                one = 1
            }
        }
        if one == 1 {
            e[i] = 1
            q += 1
        }
        else {
            e[i] = d[j]
            j += 1
        }
    }
    return py_shaped(py_flat(a), e)
}

#| The sizes around axis k of a (k = -1: every axis, the array flat): [before, along, after].
def py_ax(a: Arr, k) {
    d = shape(a)
    if k < 0 {
        return [1, numel(a), 1]
    }
    before = 1
    for i to k {
        before = before * d[i]
    }
    after = 1
    for i from k + 1 to len(d) {
        after = after * d[i]
    }
    return [before, d[k], after]
}

#| The shape of a reduction of a along axis k (k = -1: every axis): the axis dropped, or kept
#| with length 1 when keep is 1.
def py_rdims(a: Arr, k, keep) {
    d = shape(a)
    e = []
    for i to len(d) {
        if i == k or k < 0 {
            if keep == 1 {
                e = append(e, 1)
            }
        }
        else {
            e = append(e, d[i])
        }
    }
    return e
}

#| The entries of f, row-major, as an array of shape e (a vector of 1 to 4 lengths).
def py_shaped(f: Arr, e: Arr) {
    if len(e) == 1 {
        return f
    }
    if len(e) == 2 {
        z = zeros(e[0], e[1])
    }
    else {
        if len(e) == 3 {
            z = zeros(e[0], e[1], e[2])
        }
        else {
            z = zeros(e[0], e[1], e[2], e[3])
        }
    }
    put(z, py_iota(numel(z)), f)
    return z
}

#| NumPy's sums of f, a C-ordered array seen as [before, along, after] (s), along the middle:
#| py_blk when the axis is the last one, else the slabs added in order from 0.0.
def py_sum_fl(f: Arr, s: Arr) {
    before = s[0]
    along = s[1]
    after = s[2]
    r = zeros(before * after)
    for o to before {
        if after == 1 {
            r[o] = py_blk(f, o * along, along)
        }
        else {
            for i to after {
                t = 0.0
                for j to along {
                    t += f[(o * along + j) * after + i]
                }
                r[o * after + i] = t
            }
        }
    }
    return r
}

#| np.sum(a, axis=k, keepdims=keep) of a real array.
def py_sum_ax(a: Arr, k, keep) {
    return py_shaped(py_sum_fl(py_flat(a), py_ax(a, k)), py_rdims(a, k, keep))
}

#| np.reshape(a, d) in row-major order: a's entries in the shape d, where one length may be
#| negative (NumPy 1.24 reads any negative length as -1: the one that makes the sizes agree).
#| NumPy raises ValueError where they cannot agree.
def py_reshape(a: Arr, d: Arr) {
    e = copy(d)
    known = 1
    free = -1
    for i to len(e) {
        if e[i] < 0 {
            if free >= 0 {
                stop("ValueError: can only specify one unknown dimension")
            }
            free = i
        }
        else {
            known = known * e[i]
        }
    }
    if free >= 0 {
        if known == 0 or numel(a) % known != 0 {
            stop("ValueError: cannot reshape the array into that shape")
        }
        e[free] = numel(a) / known
        known = numel(a)
    }
    if known != numel(a) {
        stop("ValueError: cannot reshape the array into that shape")
    }
    return py_shaped(py_flat(a), e)
}

#from: http://people.duke.edu/~ccc14/sta-663-2016/03A_Numbers.html#Example:-Calculating-pairwise-distance-matrix-using-broadcasting-and-vectorization
#setup: import numpy as np ; X = np.linspace(0,10,20000).reshape(200,100)
#run: pairwise(X)
#pythran export pairwise(float [][])
def pairwise(pts: Arr) {
    return py_apow(py_sum_ax(py_apow(py_bsub(py_newax(pts, [0]), py_newax(pts, [1])), 2), 2, 0), 0.5)
}
# ---- harness ----
py_s2 = split(read_text("in0.txt"))
py_l1 = zeros(len(py_s2))
for py_i3 to len(py_s2) {
    py_t4 = py_s2[py_i3]
    py_l1[py_i3] = float(py_t4)
}
_a0 = py_reshape(py_l1, [200, 100])
reps = py_int(int(read_text("reps.txt")))
res = pairwise(_a0)
print(fmt(py_npsum(res)))
print(fmt(py_npsum(res * res)))
_chk = 0.0
for _i to reps {
    res = pairwise(_a0)
    _chk = _chk + res[0, 0]
}
print(fmt(_chk))

