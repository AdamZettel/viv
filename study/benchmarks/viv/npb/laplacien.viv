#| 0, 1, ..., n - 1.
def py_iota(n) {
    a = zeros(n)
    for i to n {
        a[i] = i
    }
    return a
}

#| Every entry of a real array, row-major, as a vector (a copy).
def py_flat(a: Arr) {
    return take(a, py_iota(numel(a)))
}

#| An int result, as Python's int: a -0.0 becomes 0 (an int has no sign on zero), and the run
#| stops at 2^53, past which a double no longer holds every integer (Python's int does).
def py_int(x) {
    if abs(x) >= 9007199254740992 {
        stop("py2viv: an integer reached 2^53; Python's int is exact there and a double is not")
    }
    return x + 0.0
}

#| NumPy's pairwise sum of f[lo], ..., f[lo + n - 1] (numpy/core/src/umath/loops_utils.h):
#| below 8 terms left to right from 0; to 128, eight running sums combined as a tree, then
#| the rest; above, the two halves (the first a multiple of 8 long) summed apart.
def py_pw(f: Arr, lo, n) {
    if n < 8 {
        s = 0.0
        for i to n {
            s += f[lo + i]
        }
        return s
    }
    if n <= 128 {
        r = zeros(8)
        for j to 8 {
            r[j] = f[lo + j]
        }
        i = 8
        while i < n - n % 8 {
            for j to 8 {
                r[j] += f[lo + i + j]
            }
            i += 8
        }
        s = ((r[0] + r[1]) + (r[2] + r[3])) + ((r[4] + r[5]) + (r[6] + r[7]))
        while i < n {
            s += f[lo + i]
            i += 1
        }
        return s
    }
    n2 = floor(n / 2)
    n2 = n2 - n2 % 8
    return py_pw(f, lo, n2) + py_pw(f, lo + n2, n - n2)
}

#| NumPy's sum of f[lo], ..., f[lo + n - 1] along one axis: from 0.0, a pairwise sum of each
#| block of NumPy's buffer size (8192 entries), added in order.
def py_blk(f: Arr, lo, n) {
    bufsize = 8192
    s = 0.0
    b = 0
    while b < n {
        s = s + py_pw(f, lo + b, min(bufsize, n - b))
        b += bufsize
    }
    return s
}

#| np.sum(a), a.sum() of a float array: NumPy's sum over the entries in row-major order (py_blk).
def py_npsum(a: Arr) {
    f = py_flat(a)
    return py_blk(f, 0, len(f))
}

#| np.max(a): NaN if any entry is NaN, else the largest (+0 over -0).
def py_npmax(a: Arr) {
    if any(a != a) {
        return 0.0 / 0.0
    }
    f = py_flat(a)
    m = f[0]
    for i from 1 to len(f) {
        m = py_zmax2(m, f[i])
    }
    return m
}

#| Python's max(a, b): b only if b > a.
def py_bmax2(a, b) {
    if b > a {
        return b
    }
    return a
}

#| The larger of two numbers that are not NaN, +0 over -0 (NumPy's rule; Viv's max of two
#| zeros differs between engines).
def py_zmax2(a, b) {
    if a > b {
        return a
    }
    if b > a {
        return b
    }
    if a == 0 {
        return a + b
    }
    return a
}

#| A slice bound as Python reads it on an axis of length n: a negative one counts from the
#| end; the result is clamped to 0 ... n.
def py_lo(lo, n) {
    b = lo
    if b < 0 {
        b = b + n
        if b < 0 {
            b = 0
        }
    }
    if b > n {
        b = n
    }
    return b
}

#| The end of the slice lo:hi on an axis of length n, as Python reads it, and never before
#| the start (Python's slice is then empty).
def py_hi(lo, hi, n) {
    b = py_lo(hi, n)
    a = py_lo(lo, n)
    if b < a {
        b = a
    }
    return b
}

#| The entries of f, row-major, as an array of shape e (a vector of 1 to 4 lengths).
def py_shaped(f: Arr, e: Arr) {
    if len(e) == 1 {
        return f
    }
    if len(e) == 2 {
        z = zeros(e[0], e[1])
    }
    else {
        if len(e) == 3 {
            z = zeros(e[0], e[1], e[2])
        }
        else {
            z = zeros(e[0], e[1], e[2], e[3])
        }
    }
    put(z, py_iota(numel(z)), f)
    return z
}

#| np.reshape(a, d) in row-major order: a's entries in the shape d, where one length may be
#| negative (NumPy 1.24 reads any negative length as -1: the one that makes the sizes agree).
#| NumPy raises ValueError where they cannot agree.
def py_reshape(a: Arr, d: Arr) {
    e = copy(d)
    known = 1
    free = -1
    for i to len(e) {
        if e[i] < 0 {
            if free >= 0 {
                stop("ValueError: can only specify one unknown dimension")
            }
            free = i
        }
        else {
            known = known * e[i]
        }
    }
    if free >= 0 {
        if known == 0 or numel(a) % known != 0 {
            stop("ValueError: cannot reshape the array into that shape")
        }
        e[free] = numel(a) / known
        known = numel(a)
    }
    if known != numel(a) {
        stop("ValueError: cannot reshape the array into that shape")
    }
    return py_shaped(py_flat(a), e)
}

#setup: import numpy as np ; np.random.seed(0); N = 500 ; X = np.random.randn(N,N,3)
#run: laplacien(X)
#pythran export laplacien(float64[][][3])
def laplacien(image: Arr) {
    out_image = abs(4 * image[py_lo(1, len(image)):py_hi(1, -1, len(image)), py_lo(1, shape(image)[1]):py_hi(1, -1, shape(image)[1])] - image[py_lo(0, len(image)):py_hi(0, -2, len(image)), py_lo(1, shape(image)[1]):py_hi(1, -1, shape(image)[1])] - image[min(2, len(image)):, py_lo(1, shape(image)[1]):py_hi(1, -1, shape(image)[1])] - image[py_lo(1, len(image)):py_hi(1, -1, len(image)), py_lo(0, shape(image)[1]):py_hi(0, -2, shape(image)[1])] - image[py_lo(1, len(image)):py_hi(1, -1, len(image)), min(2, shape(image)[1]):])
    valmax = py_npmax(out_image)
    valmax = py_bmax2(1.0, valmax) + 1e-09
    out_image /= valmax
    return out_image
}
# ---- harness ----
py_s2 = split(read_text("in0.txt"))
py_l1 = zeros(len(py_s2))
for py_i3 to len(py_s2) {
    py_t4 = py_s2[py_i3]
    py_l1[py_i3] = float(py_t4)
}
_a0 = py_reshape(py_l1, [500, 500, 3])
reps = py_int(int(read_text("reps.txt")))
res = laplacien(_a0)
print(fmt(py_npsum(res)))
print(fmt(py_npsum(res * res)))
_chk = 0.0
for _i to reps {
    res = laplacien(_a0)
    _chk = _chk + res[0, 0, 0]
}
print(fmt(_chk))

