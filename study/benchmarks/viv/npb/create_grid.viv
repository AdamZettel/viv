py_s2 = split(read_text("in0.txt"))
py_l1 = zeros(len(py_s2))
for py_i3 to len(py_s2) {
    py_t4 = py_s2[py_i3]
    py_l1[py_i3] = float(py_t4)
}
_a0 = py_l1
reps = py_int(int(read_text("reps.txt")))
res = create_grid(_a0)
print(fmt(py_npsum(res)))
print(fmt(py_npsum(res * res)))
_chk = 0.0
for _i to reps {
    res = create_grid(_a0)
    _chk = _chk + res[0, 0]
}
print(fmt(_chk))

