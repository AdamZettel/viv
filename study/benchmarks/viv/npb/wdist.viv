py_s2 = split(read_text("in0.txt"))
py_l1 = zeros(len(py_s2))
for py_i3 to len(py_s2) {
    py_t4 = py_s2[py_i3]
    py_l1[py_i3] = float(py_t4)
}
_a0 = py_reshape(py_l1, [70, 70])
py_s6 = split(read_text("in1.txt"))
py_l5 = zeros(len(py_s6))
for py_i7 to len(py_s6) {
    py_t8 = py_s6[py_i7]
    py_l5[py_i7] = float(py_t8)
}
_a1 = py_reshape(py_l5, [70, 70])
py_s10 = split(read_text("in2.txt"))
py_l9 = zeros(len(py_s10))
for py_i11 to len(py_s10) {
    py_t12 = py_s10[py_i11]
    py_l9[py_i11] = float(py_t12)
}
_a2 = py_reshape(py_l9, [70, 70])
reps = py_int(int(read_text("reps.txt")))
res = wdist(_a0, _a1, _a2)
print(fmt(py_npsum(res)))
print(fmt(py_npsum(res * res)))
_chk = 0.0
for _i to reps {
    res = wdist(_a0, _a1, _a2)
    _chk = _chk + res[0, 0]
}
print(fmt(_chk))

