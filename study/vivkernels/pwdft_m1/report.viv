# PROTOTYPE: the last file of the Si
# program for the M1 prototype. It prints the results the Python side reads,
# at full precision, so the native, interpreted and library runs can be
# compared as text, number for number.
print("RESULT ETOT", fmt(ETOT))
print("RESULT EFERMI", fmt(EFERMI))
print("RESULT GAP_EV", fmt(GAP))
print("RESULT ITER", fmt(ITER))

