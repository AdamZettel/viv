# PROTOTYPE kernel for `viv export`: y = a*x + y, written in place on y;
# returns the sum of the new y. Reads x out of bounds when len(y) > len(x).
def axpy(a, x, y) {
    for i to len(y) {
        y[i] = a * x[i] + y[i]
    }
    return sum(y)
}

x = [1.0, 2.0, 3.0]
y = [10.0, 20.0, 30.0]
print(axpy(2.0, x, y))
print(y)

