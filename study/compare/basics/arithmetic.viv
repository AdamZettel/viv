# @@ imports
PI = 3.141592653589793

# @@ variables and the four operations
a = 17
b = 5
print(a + b, a - b, a * b)
print(fmt(a / b))

# @@ floor division, remainder, power
print(a // b, a % b, -a // b, -a % b)
print(2 ^ 10, fmt(2 ^ -1), 2 ^ 3 ^ 2)

# @@ math functions
print(f"{sqrt(2.0):.6f} {exp(1.0):.6f} {PI:.6f}")
print(fmt(abs(-3.5)), max(a, b), min(a, b))
print(floor(-3.5), ceil(-3.5))

# @@ rounding a tie
print("round(2.5) =", round(2.5))

# @@ conditionals
def sign_word(x) {
    if x > 0 {
        return "positive"
    }
    else if x < 0 {
        return "negative"
    }
    else {
        return "zero"
    }
}

for x in [3, -2, 0] {
    print(x, sign_word(x))
}

# @@ a value chosen by a condition
parity = "even" if a % 2 == 0 else "odd"
print(a, "is", parity)
print("comparisons:", 0 < a and a < 20, a > 0 and b > 10, not a == b)

# @@ checks
test "arithmetic" {
    assert_true(a == (a // b) * b + a % b)
    assert_near(sqrt(2.0) ^ 2, 2.0, 1e-12)
}

