# @@ a function with a default argument
def greet_with(name, greeting) {
    "A greeting for one person."
    return f"{greeting}, {name}!"
}

def greet(name) {
    return greet_with(name, "hello")
}

print(greet("Ada"))
print(greet_with("Grace", "hi"))
print(greet_with("Alan", "good morning"))

# @@ several results
def min_max_mean(xs) {
    lo = min(xs)
    hi = max(xs)
    return lo, hi, sum(xs) / len(xs)
}

lo, hi, mean = min_max_mean([4.0, 1.0, 7.0, 2.0])
print(fmt(lo), fmt(hi), fmt(mean))

# @@ a function as an argument
def apply_twice(f, x) {
    return f(f(x))
}

def square(x) {
    return x * x
}

print(fmt(apply_twice(square, 3.0)))
print(fmt(apply_twice(fn(x) -> x + 10.0, 1.0)))

# @@ a lambda that captures a variable
scale = 2.5
scaled = fn(x) -> scale * x
print(fmt(scaled(4.0)))

# @@ checks
test "functions" {
    assert_true(greet("x") == "hello, x!")
    assert_true(apply_twice(square, 2.0) == 16.0)
}

