# @@ a count from zero
N = 5
line = ""
for i to N {
    line += f"{i:d} "
}
print(line)

# @@ a start, an end and a step
FIRST = 3
LAST = 20
STEP = 4
line = ""
for i from FIRST to LAST by STEP {
    line += f"{i:d} "
}
print(line)
TOP = 10
DOWN = -3
line = ""
for i from TOP to 0 by DOWN {
    line += f"{i:d} "
}
print(line)

# @@ reversed
line = ""
for i to N reversed {
    line += f"{i:d} "
}
print(line)

# @@ over the items of a list, with their index
primes = [2, 3, 5, 7, 11]
for k, p in enumerate(primes) {
    print(f"primes[{k:d}] = {p:d}")
}

# @@ two lists side by side
squares = [p * p for p in primes]
for p, s in zip(primes, squares) {
    print(p, s)
}

# @@ a while loop
n = 27
steps = 0
while n != 1 {
    n = n // 2 if n % 2 == 0 else 3 * n + 1
    steps += 1
}
print("Collatz steps from 27:", steps)

# @@ break and continue
LIMIT = 30
found = []
for k from 2 to LIMIT {
    if k % 2 == 0 {
        continue
    }
    if k * k > LIMIT {
        break
    }
    found = append(found, k)
}
print("odd k with k*k <= 30:", found)

# @@ nested loops
TABLE = 4
for r from 1 to TABLE {
    print(" ".join(f"{r * c:3d}" for c from 1 to TABLE))
}

# @@ checks
test "loops" {
    assert_true(steps == 111)
    assert_true(all(found == [3, 5]))
}

