# @@ imports
# nothing to import: test blocks and the assertions are part of the language

# @@ the code under test
def median(xs) {
    s = copy(xs)
    sort(s)
    n = len(s)
    mid = n // 2
    if n % 2 == 1 {
        return s[mid]
    }
    return 0.5 * (s[mid - 1] + s[mid])
}

def normalize(xs) {
    return xs / sum(xs)
}

# @@ one test per behavior
test "median of an odd count" {
    assert_true(median([3.0, 1.0, 2.0]) == 2.0)
}

test "median of an even count" {
    assert_true(median([4.0, 1.0, 3.0, 2.0]) == 2.5)
}

test "normalized weights sum to one" {
    w = normalize([0.1, 0.2, 0.3])
    assert_near(sum(w), 1.0, 1e-15)
    assert_true(all(w > 0))
}

test "a list may end with a comma" {
    xs = [
        1.0,
        2.0,
        3.0,
    ]
    assert_true(len(xs) == 3)
}

# @@ run them and report
# nothing to write: each test block runs where it stands and prints PASS or FAIL

