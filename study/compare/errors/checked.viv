# @@ a function that can fail
def parse_age(text) {
    body = text
    if text.startswith("-") {
        body = text[1:]
    }
    if not body.isdigit() {
        return false, 0, f"invalid literal for int() with base 10: {text!r}"
    }
    value = int(text)
    if value < 0 {
        return false, 0, f"age cannot be negative: {value:d}"
    }
    return true, value, ""
}

# @@ the caller handles the failure
for text in ["42", "-3", "abc", "7"] {
    ok, age, why = parse_age(text)
    if ok {
        print(f"{text!r}: age {age:d}")
    }
    else {
        print(f"{text!r}: refused ({why})")
    }
}

# @@ division by zero
def ratio(a, b) {
    if b == 0 {
        return float("nan")
    }
    return a / b
}

print(fmt(ratio(1.0, 4.0)), fmt(ratio(1.0, 0.0)))

# @@ a missing key
stock = map()
stock["apple"] = 3
stock["pear"] = 0
for item in ["apple", "plum"] {
    if item in stock {
        print(item, stock[item])
    }
    else {
        print(item, "not stocked")
    }
}

# @@ a check that should never fail
total = sum(values(stock))
if total != 3 {
    stop(f"stock total is {total:d}, expected 3")
}
print("stock total checked")

# @@ checks
test "parse" {
    ok, age, why = parse_age("42")
    assert_true(ok and age == 42)
}

