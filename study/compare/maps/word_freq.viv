# @@ the text
TEXT = "the cat sat on the mat and the dog sat on the log"

# @@ count each word
counts = map()
for w in TEXT.split() {
    counts[w] = get(counts, w, 0) + 1
}
print(counts)

# @@ read the map
print(len(counts), "distinct words")
print("the:", counts["the"], " zebra:", get(counts, "zebra", 0))
for w in ["dog", "zebra"] {
    print(w, "is a key" if w in counts else "is not a key")
}

# @@ the most frequent words
TOP = 3
ranked = sorted(sorted(keys(counts)), key=fn(w) -> -counts[w])
for w in ranked[:TOP] {
    print(f"{w:>4} {counts[w]:d}")
}

# @@ remove a key
n = remove(counts, "and")
print("removed and:", n, "left:", keys(counts))

# @@ checks
test "word counts" {
    assert_true(counts["sat"] == 2)
    assert_true(sum(values(counts)) == len(TEXT.split()) - 1)
}

