# @@ count the sums of two dice
SIDES = 6
sums = map()
for a from 1 to SIDES + 1 {
    for b from 1 to SIDES + 1 {
        sums[a + b] = get(sums, a + b, 0) + 1
    }
}
print(sums)

# @@ a bar per key, in key order
totals = keys(sums)
sort(totals)
for total in totals {
    print(f"{total:2d} {"#" * sums[total]}")
}

# @@ the most likely sum
best = max(keys(sums), key=fn(k) -> sums[k])
print("most likely:", best, "with", sums[best], "of", SIDES * SIDES)

# @@ first occurrence of each value
data = [4, 7, 4, 1, 7, 7, 9]
first_at = map()
for i, x in enumerate(data) {
    if x not in first_at {
        first_at[x] = i
    }
}
print(first_at)

# @@ a copy is a second map
backup = copy(first_at)
first_at[100] = 0
print(len(first_at), len(backup))

# @@ checks
test "counts" {
    assert_true(sum(values(sums)) == SIDES * SIDES)
    assert_true(first_at[7] == 1)
}

