# @@ imports
# nothing to import: grad and deriv are builtins

# @@ data: points near the line y = 1 + 2 x
X = [[1.0, 0.0], [1.0, 0.5], [1.0, 1.0], [1.0, 1.5], [1.0, 2.0]]
y = [1.1, 1.9, 3.2, 3.9, 5.1]

# @@ the loss
def loss(w, X, y) {
    r = X @ w - y
    return sum(r * r) / len(y)
}

# @@ its gradient
def loss_grad(w, X, y) {
    return grad(loss, w, X, y)
}

# @@ check the gradient at one point
w0 = [0.5, 0.5]
H = 1e-6
fd = zeros(len(w0))
for i to len(w0) {
    e = zeros(len(w0))
    e[i] = 1.0
    fd[i] = (loss(w0 + H * e, X, y) - loss(w0 - H * e, X, y)) / (2 * H)
}
g0 = loss_grad(w0, X, y)
print("gradient   ", f"{g0[0]:.6f} {g0[1]:.6f}")
print("differences", f"{fd[0]:.6f} {fd[1]:.6f}")

# @@ gradient descent
RATE = 0.1
STEPS = 500
REPORT = 100
w = copy(w0)
for step to STEPS {
    w = w - RATE * loss_grad(w, X, y)
    if (step + 1) % REPORT == 0 {
        print(f"step {step + 1:d}: loss {loss(w, X, y):.8f}")
    }
}
print(f"w = {w[0]:.6f}, {w[1]:.6f}")

# @@ a derivative of one variable
print(f"f'(1.3) = {deriv(fn(x) -> sin(x) * x * x, 1.3):.12f}")

# @@ checks
test "gradient" {
    assert_allclose(g0, fd, 1e-6)
}

