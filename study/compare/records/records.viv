# @@ imports
# nothing to import: `record` is part of the language

# @@ declare the type
record Vec2 {
    x: Num
    y: Num
}

# @@ functions on it
def norm(v: Vec2) -> Num {
    return sqrt(v.x * v.x + v.y * v.y)
}

def plus(a: Vec2, b: Vec2) -> Vec2 {
    return Vec2 { x: a.x + b.x, y: a.y + b.y }
}

def scaled(v: Vec2, k) -> Vec2 {
    return Vec2 { x: k * v.x, y: k * v.y }
}

# @@ build values and call the functions
p = Vec2 { x: 3.0, y: 4.0 }
q = Vec2 { x: 1.0, y: -2.0 }
r = p.plus(q.scaled(2.0))
print(f"p = ({p.x!r}, {p.y!r}), |p| = {p.norm()!r}")
print(f"r = ({r.x!r}, {r.y!r})")

# @@ a changed copy
moved = Vec2 { y: 0.0, ..p }
print(f"moved = ({moved.x!r}, {moved.y!r}), p unchanged: ({p.x!r}, {p.y!r})")

# @@ a record with an array field
record Body {
    name: Str
    mass: Num
    pos: Arr
}

earth = Body { name: "earth", mass: 5.97e24, pos: [1.0, 0.0] }
earth.pos[1] = 0.25
print(earth.name, fmt(earth.mass), fmt(earth.pos))

# @@ checks
test "records" {
    assert_true(p.norm() == 5.0)
    assert_true(r.x == 5.0 and r.y == 0.0)
}

