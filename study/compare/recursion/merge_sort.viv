# @@ merge two sorted lists
def merge(a, b) {
    out = []
    i = 0
    j = 0
    while i < len(a) and j < len(b) {
        if a[i] <= b[j] {
            out = append(out, a[i])
            i += 1
        }
        else {
            out = append(out, b[j])
            j += 1
        }
    }
    out = extend(out, a[i:])
    out = extend(out, b[j:])
    return out
}

# @@ split, sort each half, merge
def merge_sort(xs) {
    if len(xs) <= 1 {
        return xs
    }
    mid = len(xs) // 2
    return merge(merge_sort(xs[:mid]), merge_sort(xs[mid:]))
}

# @@ run it
data = [38, 27, 43, 3, 9, 82, 10, 3, 55, -4]
print(merge_sort(data))
print(data)

# @@ checks
test "merge sort" {
    expect = copy(data)
    sort(expect)
    assert_true(all(merge_sort(data) == expect))
    assert_true(len(merge_sort([])) == 0)
}

