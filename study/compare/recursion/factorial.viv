# @@ recursive
def factorial(n) {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

# @@ with a loop
def factorial_loop(n) {
    p = 1
    for k from 2 to n + 1 {
        p *= k
    }
    return p
}

# @@ a table
LAST = 20
STRIDE = 5
for n from 0 to LAST + 1 by STRIDE {
    print(f"{n:2d}! = {factorial(n):d}")
}

# @@ the number of digits of 20!
print(len(fmt(factorial(LAST), "d")), "digits")

# @@ checks
test "two factorials agree" {
    for n to LAST + 1 {
        assert_true(factorial(n) == factorial_loop(n))
    }
}

