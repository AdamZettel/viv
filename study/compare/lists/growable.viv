# @@ start empty and append
squares = []
N = 10
for i to N {
    squares = append(squares, i * i)
}
print(squares)

# @@ a comprehension with a condition
evens = [s for s in squares if s % 2 == 0]
print(evens, len(evens))

# @@ a comprehension that maps
HEAD = 4
halves = [s / 2 for s in squares[:HEAD]]
print(fmt(halves))

# @@ extend, and drop the last element
more = [100, 121]
squares = extend(squares, more)
print(len(squares), squares[-1])
squares = squares[:-1]
print(len(squares), squares[-1])

# @@ membership and sums
for v in [49, 50] {
    print(v, "is in the list" if v in squares else "is not in the list")
}
print(sum(squares), fmt(sum(squares) / len(squares)))

# @@ rows onto a table
table = []
ROWS = 4
for i from 1 to ROWS {
    table = append(table, [i, i * i, i ^ 3])
}
for row in rows(table) {
    print(row)
}

# @@ checks
test "growable" {
    assert_true(all(evens == [0, 4, 16, 36, 64]))
    assert_true(shape(table)[0] == 3 and shape(table)[1] == 3)
}

