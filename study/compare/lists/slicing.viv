# @@ imports
# nothing to import: arrays are part of the language

# @@ slices of an array
N = 10
STEP = 3
a = zeros(N)
for i to N {
    a[i] = i
}
print(fmt(a[2:5]), fmt(a[:3]), fmt(a[7:]), fmt(a[::STEP]))

# @@ the last elements
print(fmt(a[-1]), fmt(a[-3:]))

# @@ a slice is a view in NumPy and a copy in Viv
D = 4
d = zeros(D)
part = d[1:3]
part[0] = 99.0
print("d[1] after a write through the slice:", fmt(d[1]))

# @@ assignment shares the array
c = a
c[0] = -1.0
print(fmt(a[0]))

# @@ write into a slice
a[5:8] = 0.0
print(fmt(a))

# @@ where is the largest value
x = [3.0, 8.5, -2.0, 8.5, 1.0]
k = 0
for i to len(x) {
    if x[i] > x[k] {
        k = i
    }
}
print(k, fmt(x[k]))

# @@ running sums
running = zeros(len(x))
total = 0.0
for i to len(x) {
    total += x[i]
    running[i] = total
}
print(fmt(running))

# @@ checks
test "slices" {
    assert_true(a[0] == -1.0)
    assert_true(running[-1] == sum(x))
}

