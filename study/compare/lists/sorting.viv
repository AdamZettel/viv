# @@ a sorted copy
nums = [5.5, -1.0, 3.25, 9.0, 0.0, 3.25]
ordered = copy(nums)
sort(ordered)
print(fmt(ordered))
print(fmt(nums))

# @@ sort in place, largest first
nums = sorted(nums, reverse=true)
print(fmt(nums))

# @@ sort strings
words = ["pear", "Apple", "fig", "banana"]
print(sorted(words))

# @@ sort one list by another
names = ["ann", "bob", "cy", "dee"]
scores = [72, 95, 88, 72]
order = argsort(names, key=fn(name) -> name)
order = sorted(order, key=fn(i) -> -scores[i])
for i in order {
    print(f"{names[i]:4} {scores[i]:d}")
}

# @@ insertion sort by hand
def insertion_sort(a) {
    a = copy(a)
    for i from 1 to len(a) {
        v = a[i]
        j = i
        while j > 0 and a[j - 1] > v {
            a[j] = a[j - 1]
            j -= 1
        }
        a[j] = v
    }
    return a
}

print(insertion_sort([3, 1, 4, 1, 5, 9, 2, 6]))

# @@ checks
test "sorting" {
    expect = copy(nums)
    sort(expect)
    assert_true(all(insertion_sort(nums) == expect))
}

