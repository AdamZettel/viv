# @@ imports
# nothing to import: figure, plot and scatter are builtins

# @@ the data: a damped oscillation and its envelope
N = 400
t = linspace(0.0, 10.0, N)
x = exp(-t / 4.0) * cos(2.0 * t)
env = exp(-t / 4.0)

# @@ the peaks, where x is larger than both neighbors
pt = []
px = []
parts = []
for i from 1 to N - 1 {
    if x[i] > x[i - 1] and x[i] > x[i + 1] {
        pt = append(pt, t[i])
        px = append(px, x[i])
        parts = append(parts, f"{t[i]:.3f}")
    }
}
print("peaks at t =", join(" ", parts))

# @@ a figure with a title and axis labels
figure("A damped oscillation", "t", "x")

# @@ two lines and a set of points
plot(t, x, "x(t)")
plot(t, env, "envelope")
style("envelope", "dash")
scatter(pt, px, "peaks")

# @@ save it
# the figure is printed as records; the page, `viv plot` or a notebook draws them

# @@ checks
test "three peaks" {
    assert_true(len(pt) == 3)
}

