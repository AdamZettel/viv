# @@ imports
# nothing to import: read_text, read_lines and write_text are builtins

# @@ write a file
PATH = "compare_scores.csv"
rows = ["name,score", "ann,72", "bob,95", "cy,88"]
n = write_text(PATH, join("\n", rows) + "\n")
print("wrote", n, "characters")

# @@ read it back line by line
lines = read_lines(PATH)
print(len(lines), "lines; header:", lines[0])

# @@ parse the rows
names = []
scores = []
for line in lines[1:] {
    name, score = line.split(",")
    names = append(names, name)
    scores = append(scores, float(score))
}
best = max([k for k to len(scores)], key=fn(k) -> scores[k])
print(f"best: {names[best]} with {scores[best]:.0f}")

# @@ write a report
report = [f"{nm}: {"*" * (s // 10)}" for nm, s in zip(names, scores)]
write_text("compare_report.txt", join("\n", report) + "\n")
print(read_text("compare_report.txt").rstrip("\n"))

# @@ checks
test "files" {
    assert_true(read_text(PATH).count("\n") == len(rows))
}

