# @@ imports
# lib/gpt/gpt and the parts of lib/nn, lib/polar, lib/optim and lib/random it
# calls, copied into one file (the program is lib/gpt/story_gpt.viv with its
# imports expanded by hand), with the phrases those modules declare and
# use

# @@ config
record GptConfig {
    vocab: Num,
    context: Num,
    width: Num,
    heads: Num,
    layers: Num,
    hidden: Num,
    batch: Num,
}

# the optimizers' constants
MUON_LR, MUON_MOMENTUM = 0.05, 0.95
ADAM_LR, ADAM_BETA1, ADAM_BETA2, ADAM_EPS = 0.05, 0.9, 0.99, 1.0e-8
# the step size falls in a straight line to this fraction of its start
LR_FLOOR = 0.1
TEXT, PROMPT = "hello world! " * 5, "hello"
STEPS, SAMPLES = 30, 24
INIT_SEED, SAMPLE_SEED = 7, 11

# @@ random draws
pi = 3.141592653589793

def randn() {
    u1, u2 = rand(), rand()
    return sqrt(-2.0 * log(u1)) * cos(2.0 * pi * u2)
}

def randn_matrix(rows, cols) {
    return [[randn() for j to cols] for i to rows]
}

def choice(p: Arr) {
    u = rand()
    cum = 0.0
    for k to len(p) {
        cum += p[k]
        if u < cum {
            return k
        }
    }
    return len(p) - 1
}

# @@ parameters and init
record Head { Wq: Arr, Wk: Arr, Wv: Arr }
record Attention { heads: [Head], Wo: Arr }
record Mlp { up: Arr, down: Arr }
record Block { attn: Attention, mlp: Mlp }
record Gpt { tok: Arr, pos: Arr, blocks: [Block], unembed: Arr }

def init(rows, cols) {
    return (1.0 / sqrt(rows)) * randn_matrix(rows, cols)
}

def init_head(c: GptConfig) {
    hd = c.width / c.heads
    return Head { Wq: init(c.width, hd), Wk: init(c.width, hd), Wv: init(c.width, hd) }
}

def init_block(c: GptConfig) {
    attn = Attention { heads: [init_head(c) for h to c.heads], Wo: init(c.width, c.width) }
    mlp = Mlp { up: init(c.width, c.hidden), down: init(c.hidden, c.width) }
    return Block { attn: attn, mlp: mlp }
}

def init_gpt(c: GptConfig) {
    tok = randn_matrix(c.vocab, c.width)
    pos = randn_matrix(c.context, c.width)
    blocks = [init_block(c) for l to c.layers]
    return Gpt { tok: tok, pos: pos, blocks: blocks, unembed: zeros(c.width, c.vocab) }
}

def count_into(w: Arr, n: Arr) {
    n[0] += numel(w)
}

# @@ embedding
def embed(m: Gpt, tokens: Arr) {
    return take(m.tok, tokens, axis=0) + m.pos[0:shape(tokens)[-1], :]
}

# @@ attention
MASKED = -1.0e30

def softmax_rows(X: Arr) {
    e = exp(X - amax(X, axis=-1, keepdims=true))
    return e / sum(e, axis=-1, keepdims=true)
}

phrase "the attention scores of Q against K" -> (Q @ swapaxes(K, -1, -2)) * (1.0 / sqrt(1.0 * shape(Q)[-1]))
phrase "S masked where future" -> where(future, MASKED, S)

def attention(X: Arr, Wq: Arr, Wk: Arr, Wv: Arr) {
    T = shape(X)[-2]
    step project: Q, K, V = X @ Wq, X @ Wk, X @ Wv
    step scores: S = take the attention scores of Q against K
    step mask {
        future = take the causal mask of size T
        S = take S masked where future
    }
    step weights: A = take the softmax of each row of S
    step mix: Y = A @ V
    return Y
}

def self_attention(a: Attention, N: Arr) {
    hd = shape(N)[-1] / len(a.heads)
    Z = zeros_like(N)
    for i, h in enumerate(a.heads) {
        step head: Z[:, :, i * hd:(i + 1) * hd] = attention(N, h.Wq, h.Wk, h.Wv)
    }
    step project: Y = Z @ a.Wo
    return Y
}

# @@ block
NN_EPS = 1.0e-8

def row_rms(X: Arr) {
    return sqrt(mean(X * X, axis=-1, keepdims=true) + NN_EPS)
}

def rmsnorm(X: Arr) {
    return X / row_rms(X)
}

def relu2(X: Arr) {
    R = max(X, 0.0)
    return R * R
}

def block(b: Block, X: Arr) {
    step attention: X = X + self_attention(b.attn, rmsnorm(X))
    step mlp: X = X + relu2(rmsnorm(X) @ b.mlp.up) @ b.mlp.down
    return X
}

# @@ forward
def gpt_forward(m: Gpt, tokens: Arr) {
    step embed: X = embed(m, tokens)
    for b in m.blocks {
        step block: X = block(b, X)
    }
    step logits: logits = rmsnorm(X) @ m.unembed
    return logits
}

# @@ loss
def cross_entropy(logits: Arr, target: Arr) {
    classes = numel(logits) / numel(target)
    top = amax(logits, axis=-1, keepdims=true)
    logp = logits - top - log(sum(exp(logits - top), axis=-1, keepdims=true))
    return -mean(take(logp, arange(numel(target)) * classes + ravel(target)))
}

def sequence_loss(m: Gpt, x: Arr, y: Arr) {
    return take the cross-entropy of gpt_forward(m, x) against y
}

# @@ backward
# nothing: `train` calls `value_and_grad(sequence_loss, model, ...)`, and the
# compiler writes the backward pass from the forward pass above

# @@ optimizer
#| Muon's, from the nanogpt speedrun. Faster off the mark, and the fixed point
#| is not 1.
MUON_A, MUON_B, MUON_C = 3.4445, -4.775, 2.0315
#| Rounds of it Muon runs, as the speedrun does.
MUON_STEPS = 5

# the matrix's polar factor, approximately: its singular values pushed toward 1
def newton_schulz(A: Arr) {
    f = sqrt(sum(A * A))
    X = A if f == 0.0 else (1.0 / f) * A
    for k to MUON_STEPS {
        S = X @ transpose(X)
        X = MUON_A * X + MUON_B * (S @ X) + MUON_C * ((S @ S) @ X)
    }
    return X
}

def muon_matrix_direction(M: Arr) {
    if len(M) <= shape(M)[1] {
        return newton_schulz(M)
    }
    return transpose(newton_schulz(transpose(M)))
}

phrase "the step-size scale at step t of steps" -> 1.0 - (1.0 - LR_FLOOR) * t / steps

def muon_update(w: Arr, g: Arr, mom: Arr, lr_scale) {
    mom[:] = MUON_MOMENTUM * mom + g
    rows, cols = shape(w)
    size = MUON_LR * lr_scale * sqrt(max(1.0, rows / cols))
    w[:] = w - size * muon_matrix_direction(mom)
}

def adam_update(w: Arr, g: Arr, m: Arr, v: Arr, taken, lr_scale) {
    m[:] = ADAM_BETA1 * m + (1.0 - ADAM_BETA1) * g
    v[:] = ADAM_BETA2 * v + (1.0 - ADAM_BETA2) * g * g
    mean = m / (1.0 - pow(ADAM_BETA1, taken))
    spread = sqrt(v / (1.0 - pow(ADAM_BETA2, taken)))
    w[:] = w - ADAM_LR * lr_scale * mean / (spread + ADAM_EPS)
}

def optimizer_step(model: Gpt, g: Gpt, m: Gpt, v: Gpt, taken, lr_scale) {
    step muon: for_leaves(muon_update, model.blocks, g.blocks, m.blocks, lr_scale)
    step adam {
        adam_update(model.tok, g.tok, m.tok, v.tok, taken, lr_scale)
        adam_update(model.pos, g.pos, m.pos, v.pos, taken, lr_scale)
        adam_update(model.unembed, g.unembed, m.unembed, v.unembed, taken, lr_scale)
    }
}

# @@ training loop
def batch(tokens: Arr, c: GptConfig, t, shift) {
    starts = [mod(t * c.batch + b, len(tokens) - c.context) + shift for b to c.batch]
    return [tokens[s:s + c.context] for s in starts]
}

def train(model: Gpt, c: GptConfig, tokens: Arr, steps) {
    losses = zeros(steps)
    m, v = zeros_like(model), zeros_like(model)
    for t to steps {
        step batch: xs, ys = batch(tokens, c, t, 0), batch(tokens, c, t, 1)
        step forward_backward {
            loss, grad = value_and_grad(sequence_loss, model, xs, ys)
            losses[t] = loss
        }
        step measure: gnorm = sqrt(sum(grad * grad))
        step update {
            lr_scale = take the step-size scale at step t of steps
            optimizer_step(model, grad, m, v, t + 1, lr_scale)
        }
    }
    return losses
}

# @@ sampling
def sample(m: Gpt, prompt: Arr, count, seed) {
    srand(seed)
    out = prompt
    for k to count {
        step context: ctx = take the last len(m.pos) elements of out
        step probs: p = softmax_rows(gpt_forward(m, reshape(ctx, 1, len(ctx)))[0, len(ctx) - 1, :])
        step draw: out = append(out, choice(p))
    }
    return out
}

# @@ text as tokens
def encode(text: Str, vocab: [Str]) {
    stoi = {c: i for i, c in enumerate(vocab)}
    return [stoi[c] for c in text]
}

def decode(tokens: Arr, vocab: [Str]) {
    return join("", [vocab[i] for i in tokens])
}

# @@ run
vocab = unique(TEXT)
cfg = GptConfig {
    vocab: len(vocab),
    context: 8,
    width: 16,
    heads: 2,
    layers: 2,
    hidden: 64,
    batch: 4,
}
srand(INIT_SEED)
model = init_gpt(cfg)
count = [0.0]
for_leaves(count_into, model, count)
# story_gpt prints the four numbers bare; here every loss is printed, to six
# decimals, so the Python run can be compared with it line by line
print(f"{count[0]:d} parameters, {len(vocab):d} characters")
step train: losses = train(model, cfg, encode(TEXT, vocab), STEPS)
for t to STEPS {
    print(f"step {t + 1:d}: loss {losses[t]:.6f}")
}
step generate: written = decode(sample(model, encode(PROMPT, vocab), SAMPLES, SAMPLE_SEED), vocab)
print(written)

# @@ checks
test "the model has 6,560 parameters, and 9 characters make its vocabulary" {
    assert_true(count[0] == 6560 and len(vocab) == 9)
}

test "the first loss is log 9 exactly, because the output map starts at zero" {
    assert_near(losses[0], log(9.0), 1.0e-15)
}

test "thirty steps take the loss from 2.197 to 0.1991" {
    assert_near(losses[STEPS - 1], 0.199118, 1.0e-6)
}

test "from the prompt hello, the model writes the line on" {
    assert_true(written == "hello world! hello world! hel")
}

