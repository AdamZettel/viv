# @@ imports
# nothing to import: matrices are part of the language

# @@ build matrices
A = [[1.0, 2.0], [3.0, 4.0]]
B = [[2.0, 0.0], [0.0, 2.0]]
v = [1.0, -1.0]
print("A =", fmt(A))
rows, cols = shape(A)
print("shape (", rows, ", ", cols, ") size ", numel(A), sep="")

# @@ products
print("A @ B =", fmt(A @ B))
print("A * B =", fmt(A * B))
print("A @ v =", fmt(A @ v))
print("A^T   =", fmt(transpose(A)))

# @@ reductions along an axis
col_sums = sum(A, axis=0)
row_sums = sum(A, axis=1)
print("sum", fmt(sum(A)), "column sums", fmt(col_sums), "row sums", fmt(row_sums))

# @@ elementwise functions and masks
C = sqrt(A) * (A > 1.5)
print("C =", fmt(round(C * 1e6) / 1e6))

# @@ determinant and inverse of a 2 by 2
det = A[0, 0] * A[1, 1] - A[0, 1] * A[1, 0]
inv = [[A[1, 1], -A[0, 1]], [-A[1, 0], A[0, 0]]] / det
print("det", fmt(det), "inverse", fmt(inv))

# @@ checks
test "inverse" {
    assert_allclose(A @ inv, [[1.0, 0.0], [0.0, 1.0]], 1e-12)
}

