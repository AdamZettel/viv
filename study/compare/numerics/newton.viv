# @@ imports and constants
TOL = 1e-12
MAX_ITER = 50

# @@ Newton's method with a given derivative
def newton(f, df, x) {
    for k to MAX_ITER {
        step = f(x) / df(x)
        x -= step
        print(f"  step {k + 1:d}: x = {x:.12f}")
        if abs(step) < TOL {
            return x
        }
    }
    stop("Newton did not converge")
}

# @@ the square root of 2
root2 = newton(fn(x) -> x * x - 2.0, fn(x) -> 2.0 * x, 1.0)
print(f"sqrt(2) ~ {root2:.12f}")

# @@ where cos(x) = x
dottie = newton(fn(x) -> cos(x) - x, fn(x) -> -sin(x) - 1.0, 1.0)
print(f"cos(x) = x at {dottie:.12f}")

# @@ checks
test "roots" {
    assert_near(root2, sqrt(2.0), 1e-12)
    assert_near(cos(dottie), dottie, 1e-12)
}

