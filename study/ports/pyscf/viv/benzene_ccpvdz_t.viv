# timing: RHF cc-pvdz, benzene_ccpvdz, 114 AOs.
# Generated by `python3 study/ports/harness/port.py gen pyscf` from
# study/ports/pyscf/port.toml and oracle/benzene_ccpvdz.json. Do not edit.
#
# PySCF 2.5.0: scf.RHF(gto.M(atom, basis='cc-pvdz', charge=0, spin=0)) with
# init_guess "1e" and CDIIS over 8 Fock matrices from cycle 1.
# At conv_tol 1e-10 (conv_tol_grad sqrt(conv_tol)): E = -230.72082519861308 after 12 cycles.
# Viv: the core guess, CDIIS over 8 with diis_start 1, e_tol 1e-10, grad_tol 1e-05. The run must land within 1e-08 Eh of the
# verification energy, or its time does not count.
import basis.ccpvdz
from hf.mole import molecule
from hf.scf import scf_with
from hf.opts import scf_defaults, SCF_RHF, ScfOptions
from hf.guess import GS_CORE
from hf.jk_direct import INT_JK_DIRECT

PZ_E = -230.72082519861564

pz_mol0 = molecule("C -0.65830719 0.61123287 -0.00800148; C 0.73685281 0.61123287 -0.00800148; C 1.43439081 1.81898387 -0.00800148; C 0.73673681 3.02749287 -0.00920048; C -0.65808819 3.02741487 -0.00967948; C -1.35568919 1.81920887 -0.00868348; H -1.20806619 -0.34108413 -0.00755148; H 1.28636081 -0.34128013 -0.00668648; H 2.53407081 1.81906387 -0.00736748; H 1.28693681 3.97963587 -0.00925948; H -1.20821019 3.97969587 -0.01063248; H -2.45529319 1.81939187 -0.00886348", "cc-pvdz")
pz_mol = pz_mol0
pz_r = scf_with(pz_mol, ScfOptions { method: SCF_RHF, guess: GS_CORE, diis_start: 1, jk: INT_JK_DIRECT, e_tol: 1.0e-10, grad_tol: 1.0e-05, ..scf_defaults() })
print(f"energy {pz_r.energy:.17g}")
print(f"iterations {pz_r.iterations:d}")

test "benzene_ccpvdz, timing settings: within 1e-08 of PySCF's converged energy" {
    assert_near(pz_r.converged, 1.0, 0.0)
    assert_lt(abs(pz_r.energy - PZ_E), 1.0e-08)
}
