# verification: UHF 6-31g, watercat_631g_uhf, 13 AOs.
# Generated by `python3 study/ports/harness/port.py gen pyscf` from
# study/ports/pyscf/port.toml and oracle/watercat_631g_uhf.json. Do not edit.
#
# PySCF 2.5.0: scf.UHF(gto.M(atom, basis='6-31g', charge=1, spin=1)) with
# init_guess "1e" and CDIIS over 8 Fock matrices from cycle 1.
# At conv_tol 1e-12, conv_tol_grad 1e-08: E = -75.58051984404865 after 17 cycles.
# Viv: the same molecule and basis, the core guess (GS_CORE), CDIIS over 8
# from the second iteration (diis_start 1, as PySCF's diis_start_cycle 1),
# e_tol 1e-12, grad_tol 1e-09. Held to PySCF within 1e-10 Eh (energy) and 1e-08 Eh
# (orbital energies); the checks are steps of pz_check (viv/pzcheck.viv).
import basis.pople631g
from hf.mole import molecule
from hf.molecule import Molecule
from hf.scf import scf_with
from hf.opts import scf_defaults, SCF_UHF, ScfOptions
from hf.guess import GS_CORE
from study.ports.pyscf.viv.pzcheck import pz_check, pz_print

PZ_E = -75.58051984404865

#| PySCF's orbital energies, alpha then beta (hartree).
def pz_mo_alpha() {
    return [-21.14306420197653, -1.931184020268838, -1.2263110417572918, -1.1328255965888312, -1.0936093436050167, -0.13855890746835847, -0.046109597838042894, 0.643327420906285, 0.6612403397811086, 0.7260610077009716, 0.7912921640573967, 0.918495271488205, 1.2234050933999656]
}
def pz_mo_beta() {
    return [-21.097414605475727, -1.7720554366992445, -1.183942572958539, -1.0314850865984568, -0.322645058087337, -0.12419954578246782, -0.03551879712441937, 0.6557496631949749, 0.7487486009904343, 0.8090431017821452, 0.8371958530617692, 0.9458495836095285, 1.2696379255176347]
}

pz_mol0 = molecule("O 0 0 0; H 0 -0.757 0.587; H 0 0.757 0.587", "6-31g")
pz_mol = Molecule { charge: 1, spin: 1, ..pz_mol0 }
pz_r = scf_with(pz_mol, ScfOptions { method: SCF_UHF, guess: GS_CORE, diis_start: 1, e_tol: 1.0e-12, grad_tol: 1.0e-09, ..scf_defaults() })
pz_c = pz_check(pz_r, PZ_E, pz_mo_alpha(), pz_mo_beta())
pz_print(pz_r, pz_c)

test "watercat_631g_uhf: PySCF 2.5.0's energy -75.58051984404865 within 1e-10" {
    assert_near(pz_r.converged, 1.0, 0.0)
    assert_lt(pz_c.energy_gap, 1.0e-10)
}

test "watercat_631g_uhf: PySCF 2.5.0's orbital energies within 1e-08" {
    assert_lt(pz_c.mo_gap, 1.0e-08)
}
