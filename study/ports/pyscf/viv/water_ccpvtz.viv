# verification: RHF cc-pvtz, water_ccpvtz, 58 AOs.
# Generated by `python3 study/ports/harness/port.py gen pyscf` from
# study/ports/pyscf/port.toml and oracle/water_ccpvtz.json. Do not edit.
#
# PySCF 2.5.0: scf.RHF(gto.M(atom, basis='cc-pvtz', charge=0, spin=0)) with
# init_guess "1e" and CDIIS over 8 Fock matrices from cycle 1.
# At conv_tol 1e-12, conv_tol_grad 1e-08: E = -76.05711408311929 after 15 cycles.
# Viv: the same molecule and basis, the core guess (GS_CORE), CDIIS over 8
# from the second iteration (diis_start 1, as PySCF's diis_start_cycle 1),
# e_tol 1e-12, grad_tol 1e-09. Held to PySCF within 1e-10 Eh (energy) and 1e-08 Eh
# (orbital energies); the checks are steps of pz_check (viv/pzcheck.viv).
import basis.ccpvtz
from hf.mole import molecule
from hf.scf import scf_with
from hf.opts import scf_defaults, SCF_RHF, ScfOptions
from hf.guess import GS_CORE
from study.ports.pyscf.viv.pzcheck import pz_check, pz_print

PZ_E = -76.05711408311929

#| PySCF's orbital energies, alpha then beta (hartree).
def pz_mo_alpha() {
    return [-20.554904494364155, -1.3453780961504402, -0.7092278853589857, -0.5777758103968934, -0.5044501571513379, 0.14217836618659338, 0.20400794410031625, 0.5437751211145191, 0.6022235299356634, 0.6682770680061133, 0.7873728233440795, 0.8001732036261429, 0.8052758459329438, 0.861176565104926, 0.9547767954363727, 1.1323481030917386, 1.1969930258635395, 1.526150438248791, 1.565482281602263, 2.03708442108799, 2.0533278268345527, 2.0655637112368597, 2.1713134960895313, 2.234245572396201, 2.5893239045336127, 2.963591617287274, 3.3549645363680045, 3.490364376226521, 3.582285987217898, 3.6559805465701176, 3.800052718530048, 3.8782392818207523, 3.8850294767079823, 3.9616845252800994, 4.018957886175259, 4.075755976565198, 4.192079160780356, 4.312242708996825, 4.386283342657655, 4.584544690005338, 4.684552850090109, 4.864232217186983, 5.157030776141334, 5.251935952118754, 5.527522700594684, 6.051079846166343, 6.5694490602886, 6.922276626175278, 6.942076626332709, 7.002706676753741, 7.019989459372637, 7.060171440367455, 7.16817342091291, 7.236034505367683, 7.45522686695289, 7.793398027705043, 8.287424821267628, 12.866057625259355]
}
def pz_mo_beta() {
    return [-20.554904494364155, -1.3453780961504402, -0.7092278853589857, -0.5777758103968934, -0.5044501571513379, 0.14217836618659338, 0.20400794410031625, 0.5437751211145191, 0.6022235299356634, 0.6682770680061133, 0.7873728233440795, 0.8001732036261429, 0.8052758459329438, 0.861176565104926, 0.9547767954363727, 1.1323481030917386, 1.1969930258635395, 1.526150438248791, 1.565482281602263, 2.03708442108799, 2.0533278268345527, 2.0655637112368597, 2.1713134960895313, 2.234245572396201, 2.5893239045336127, 2.963591617287274, 3.3549645363680045, 3.490364376226521, 3.582285987217898, 3.6559805465701176, 3.800052718530048, 3.8782392818207523, 3.8850294767079823, 3.9616845252800994, 4.018957886175259, 4.075755976565198, 4.192079160780356, 4.312242708996825, 4.386283342657655, 4.584544690005338, 4.684552850090109, 4.864232217186983, 5.157030776141334, 5.251935952118754, 5.527522700594684, 6.051079846166343, 6.5694490602886, 6.922276626175278, 6.942076626332709, 7.002706676753741, 7.019989459372637, 7.060171440367455, 7.16817342091291, 7.236034505367683, 7.45522686695289, 7.793398027705043, 8.287424821267628, 12.866057625259355]
}

pz_mol0 = molecule("O 0 0 0; H 0 -0.757 0.587; H 0 0.757 0.587", "cc-pvtz")
pz_mol = pz_mol0
pz_r = scf_with(pz_mol, ScfOptions { method: SCF_RHF, guess: GS_CORE, diis_start: 1, e_tol: 1.0e-12, grad_tol: 1.0e-09, ..scf_defaults() })
pz_c = pz_check(pz_r, PZ_E, pz_mo_alpha(), pz_mo_beta())
pz_print(pz_r, pz_c)

test "water_ccpvtz: PySCF 2.5.0's energy -76.05711408311929 within 1e-10" {
    assert_near(pz_r.converged, 1.0, 0.0)
    assert_lt(pz_c.energy_gap, 1.0e-10)
}

test "water_ccpvtz: PySCF 2.5.0's orbital energies within 1e-08" {
    assert_lt(pz_c.mo_gap, 1.0e-08)
}
