# timing: UHF 6-31g, watercat_631g_uhf, 13 AOs.
# Generated by `python3 study/ports/harness/port.py gen pyscf` from
# study/ports/pyscf/port.toml and oracle/watercat_631g_uhf.json. Do not edit.
#
# PySCF 2.5.0: scf.UHF(gto.M(atom, basis='6-31g', charge=1, spin=1)) with
# init_guess "1e" and CDIIS over 8 Fock matrices from cycle 1.
# At conv_tol 1e-10 (conv_tol_grad sqrt(conv_tol)): E = -75.58051984404872 after 11 cycles.
# Viv: the core guess, CDIIS over 8 with diis_start 1, e_tol 1e-10, grad_tol 1e-05. The run must land within 1e-08 Eh of the
# verification energy, or its time does not count.
import basis.pople631g
from hf.mole import molecule
from hf.molecule import Molecule
from hf.scf import scf_with
from hf.opts import scf_defaults, SCF_UHF, ScfOptions
from hf.guess import GS_CORE

PZ_E = -75.58051984404865

pz_mol0 = molecule("O 0 0 0; H 0 -0.757 0.587; H 0 0.757 0.587", "6-31g")
pz_mol = Molecule { charge: 1, spin: 1, ..pz_mol0 }
pz_r = scf_with(pz_mol, ScfOptions { method: SCF_UHF, guess: GS_CORE, diis_start: 1, e_tol: 1.0e-10, grad_tol: 1.0e-05, ..scf_defaults() })
print(f"energy {pz_r.energy:.17g}")
print(f"iterations {pz_r.iterations:d}")

test "watercat_631g_uhf, timing settings: within 1e-08 of PySCF's converged energy" {
    assert_near(pz_r.converged, 1.0, 0.0)
    assert_lt(abs(pz_r.energy - PZ_E), 1.0e-08)
}
