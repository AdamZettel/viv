# verification: UHF cc-pvdz, watercat_ccpvdz_uhf, 24 AOs.
# Generated by `python3 study/ports/harness/port.py gen pyscf` from
# study/ports/pyscf/port.toml and oracle/watercat_ccpvdz_uhf.json. Do not edit.
#
# PySCF 2.5.0: scf.UHF(gto.M(atom, basis='cc-pvdz', charge=1, spin=1)) with
# init_guess "1e" and CDIIS over 8 Fock matrices from cycle 1.
# At conv_tol 1e-12, conv_tol_grad 1e-08: E = -75.63187060619029 after 17 cycles.
# Viv: the same molecule and basis, the core guess (GS_CORE), CDIIS over 8
# from the second iteration (diis_start 1, as PySCF's diis_start_cycle 1),
# e_tol 1e-12, grad_tol 1e-09. Held to PySCF within 1e-10 Eh (energy) and 1e-08 Eh
# (orbital energies); the checks are steps of pz_check (viv/pzcheck.viv).
import basis.ccpvdz
from hf.mole import molecule
from hf.molecule import Molecule
from hf.scf import scf_with
from hf.opts import scf_defaults, SCF_UHF, ScfOptions
from hf.guess import GS_CORE
from study.ports.pyscf.viv.pzcheck import pz_check, pz_print

PZ_E = -75.63187060619029

#| PySCF's orbital energies, alpha then beta (hartree).
def pz_mo_alpha() {
    return [-21.14016065232831, -1.9139397647259553, -1.2182434657417842, -1.1301945440838423, -1.09790362530878, -0.14173917876018136, -0.05834757280856906, 0.3925540890259036, 0.4473407529220071, 0.6724695903386018, 0.7148252726502962, 0.8271866592758016, 1.0241042265701579, 1.0398058963997021, 1.2383190492580018, 1.3849388117652857, 1.5319901069570254, 1.9956416714130047, 2.004269828839706, 2.722896524146663, 2.773233524462339, 3.0010203427259565, 3.3256366837053815, 3.653121734361867]
}
def pz_mo_beta() {
    return [-21.0950868338094, -1.7578847513697171, -1.180008049484618, -1.046015744833116, -0.31359894843006086, -0.12767654924321375, -0.05015570966002698, 0.39137618724690904, 0.4638322795749996, 0.736180175580946, 0.8445950255900623, 0.8700161654082006, 1.0349609618809286, 1.0702980208131319, 1.2686379814233693, 1.4375814224097216, 1.5289153985886565, 2.007228981045956, 2.0600029942726543, 2.826782633998166, 2.8778106738126255, 3.032692975517838, 3.404501865634916, 3.6708563697196737]
}

pz_mol0 = molecule("O 0 0 0; H 0 -0.757 0.587; H 0 0.757 0.587", "cc-pvdz")
pz_mol = Molecule { charge: 1, spin: 1, ..pz_mol0 }
pz_r = scf_with(pz_mol, ScfOptions { method: SCF_UHF, guess: GS_CORE, diis_start: 1, e_tol: 1.0e-12, grad_tol: 1.0e-09, ..scf_defaults() })
pz_c = pz_check(pz_r, PZ_E, pz_mo_alpha(), pz_mo_beta())
pz_print(pz_r, pz_c)

test "watercat_ccpvdz_uhf: PySCF 2.5.0's energy -75.63187060619029 within 1e-10" {
    assert_near(pz_r.converged, 1.0, 0.0)
    assert_lt(pz_c.energy_gap, 1.0e-10)
}

test "watercat_ccpvdz_uhf: PySCF 2.5.0's orbital energies within 1e-08" {
    assert_lt(pz_c.mo_gap, 1.0e-08)
}
