pz_mol0 = molecule("O 0.0 0.0 0.0; H 0.0 -0.757 0.587; H 0.0 0.757 0.587; O 3.0 0.0 0.0; H 3.0 -0.757 0.587; H 3.0 0.757 0.587; O 0.0 3.0 0.0; H 0.0 2.243 0.587; H 0.0 3.757 0.587; O 3.0 3.0 0.0; H 3.0 2.243 0.587; H 3.0 3.757 0.587", "6-31g*")
pz_mol = pz_mol0
pz_r = scf_with(pz_mol, ScfOptions { method: SCF_RHF, guess: GS_CORE, diis_start: 1, e_tol: 1.0e-12, grad_tol: 1.0e-09, ..scf_defaults() })
