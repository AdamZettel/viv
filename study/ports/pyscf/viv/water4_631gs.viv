test "water4_631gs: PySCF 2.5.0's energy -303.99398803770885 within 1e-10" {
    assert_near(pz_r.converged, 1.0, 0.0)
    assert_lt(pz_c.energy_gap, 1.0e-10)
}

test "water4_631gs: PySCF 2.5.0's orbital energies within 1e-08" {
    assert_lt(pz_c.mo_gap, 1.0e-08)
}
