# verification: RHF 6-31g*, water2_631gs, 36 AOs.
# Generated by `python3 study/ports/harness/port.py gen pyscf` from
# study/ports/pyscf/port.toml and oracle/water2_631gs.json. Do not edit.
#
# PySCF 2.5.0: scf.RHF(gto.M(atom, basis='6-31g*', charge=0, spin=0)) with
# init_guess "1e" and CDIIS over 8 Fock matrices from cycle 1.
# At conv_tol 1e-12, conv_tol_grad 1e-08: E = -152.0122289223226 after 14 cycles.
# Viv: the same molecule and basis, the core guess (GS_CORE), CDIIS over 8
# from the second iteration (diis_start 1, as PySCF's diis_start_cycle 1),
# e_tol 1e-12, grad_tol 1e-09. Held to PySCF within 1e-10 Eh (energy) and 1e-08 Eh
# (orbital energies); the checks are steps of pz_check (viv/pzcheck.viv).
import basis.pople631gs
from hf.mole import molecule
from hf.scf import scf_with
from hf.opts import scf_defaults, SCF_RHF, ScfOptions
from hf.guess import GS_CORE
from study.ports.pyscf.viv.pzcheck import pz_check, pz_print

PZ_E = -152.0122289223226

#| PySCF's orbital energies, alpha then beta (hartree).
def pz_mo_alpha() {
    return [-20.548662497727545, -20.548653857931086, -1.3369715378547082, -1.3330465668003695, -0.7027581133128877, -0.6981964523166083, -0.5664461300632073, -0.5613497997025028, -0.5056320983871131, -0.47357397107222293, 0.19086948211156116, 0.24816932244971304, 0.2822153267379728, 0.3313822132582009, 1.0040480208527478, 1.0553619360069268, 1.0571926430232044, 1.1585815044890357, 1.1741880128874305, 1.1897916016166694, 1.2261650161328257, 1.354189776763826, 1.372900267222376, 1.4028767410657668, 1.6400301996671744, 1.708791646958407, 2.025839572493252, 2.0327483501094425, 2.041152582932283, 2.0427901896887497, 2.074791655336707, 2.076900187317133, 2.6304811961169134, 2.6454328983713307, 2.9301045759631137, 2.97799693498885]
}
def pz_mo_beta() {
    return [-20.548662497727545, -20.548653857931086, -1.3369715378547082, -1.3330465668003695, -0.7027581133128877, -0.6981964523166083, -0.5664461300632073, -0.5613497997025028, -0.5056320983871131, -0.47357397107222293, 0.19086948211156116, 0.24816932244971304, 0.2822153267379728, 0.3313822132582009, 1.0040480208527478, 1.0553619360069268, 1.0571926430232044, 1.1585815044890357, 1.1741880128874305, 1.1897916016166694, 1.2261650161328257, 1.354189776763826, 1.372900267222376, 1.4028767410657668, 1.6400301996671744, 1.708791646958407, 2.025839572493252, 2.0327483501094425, 2.041152582932283, 2.0427901896887497, 2.074791655336707, 2.076900187317133, 2.6304811961169134, 2.6454328983713307, 2.9301045759631137, 2.97799693498885]
}

pz_mol0 = molecule("O 0.0 0.0 0.0; H 0.0 -0.757 0.587; H 0.0 0.757 0.587; O 3.0 0.0 0.0; H 3.0 -0.757 0.587; H 3.0 0.757 0.587", "6-31g*")
pz_mol = pz_mol0
pz_r = scf_with(pz_mol, ScfOptions { method: SCF_RHF, guess: GS_CORE, diis_start: 1, e_tol: 1.0e-12, grad_tol: 1.0e-09, ..scf_defaults() })
pz_c = pz_check(pz_r, PZ_E, pz_mo_alpha(), pz_mo_beta())
pz_print(pz_r, pz_c)

test "water2_631gs: PySCF 2.5.0's energy -152.0122289223226 within 1e-10" {
    assert_near(pz_r.converged, 1.0, 0.0)
    assert_lt(pz_c.energy_gap, 1.0e-10)
}

test "water2_631gs: PySCF 2.5.0's orbital energies within 1e-08" {
    assert_lt(pz_c.mo_gap, 1.0e-08)
}
