# baseline: RHF 6-31g*, water8_631gs, 144 AOs.
# Generated by `python3 study/ports/harness/port.py gen pyscf` from
# study/ports/pyscf/port.toml and oracle/water8_631gs.json. Do not edit.
#
# PySCF 2.5.0: scf.RHF(gto.M(atom, basis='6-31g*', charge=0, spin=0)) with
# init_guess "1e" and CDIIS over 8 Fock matrices from cycle 1.
# The timing baseline: the molecule is built and nothing else runs.
import basis.pople631gs
from hf.mole import molecule
from hf.molecule import mol_nao

pz_mol0 = molecule("O 0.0 0.0 0.0; H 0.0 -0.757 0.587; H 0.0 0.757 0.587; O 3.0 0.0 0.0; H 3.0 -0.757 0.587; H 3.0 0.757 0.587; O 0.0 3.0 0.0; H 0.0 2.243 0.587; H 0.0 3.757 0.587; O 3.0 3.0 0.0; H 3.0 2.243 0.587; H 3.0 3.757 0.587; O 0.0 0.0 3.0; H 0.0 -0.757 3.5869999999999997; H 0.0 0.757 3.5869999999999997; O 3.0 0.0 3.0; H 3.0 -0.757 3.5869999999999997; H 3.0 0.757 3.5869999999999997; O 0.0 3.0 3.0; H 0.0 2.243 3.5869999999999997; H 0.0 3.757 3.5869999999999997; O 3.0 3.0 3.0; H 3.0 2.243 3.5869999999999997; H 3.0 3.757 3.5869999999999997", "6-31g*")
pz_mol = pz_mol0
print(mol_nao(pz_mol))

test "water8_631gs: the molecule has PySCF's 144 functions" {
    assert_near(mol_nao(pz_mol), 144, 0.0)
}
