# baseline: RHF sto-3g, water_sto3g, 7 AOs.
# Generated by `python3 study/ports/harness/port.py gen pyscf` from
# study/ports/pyscf/port.toml and oracle/water_sto3g.json. Do not edit.
#
# PySCF 2.5.0: scf.RHF(gto.M(atom, basis='sto-3g', charge=0, spin=0)) with
# init_guess "1e" and CDIIS over 8 Fock matrices from cycle 1.
# The timing baseline: the molecule is built and nothing else runs.
import basis.sto3g
from hf.mole import molecule
from hf.molecule import mol_nao

pz_mol0 = molecule("O 0 0 0; H 0 -0.757 0.587; H 0 0.757 0.587", "sto-3g")
pz_mol = pz_mol0
print(mol_nao(pz_mol))

test "water_sto3g: the molecule has PySCF's 7 functions" {
    assert_near(mol_nao(pz_mol), 7, 0.0)
}
