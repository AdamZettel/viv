from params import param_add, param_declare, param_get, param_table, param_zeros
from optim import adam, optim_state, optim_step
model = param_table(2)
W = param_declare(model, 32, 32)
B = param_declare(model, 1, 32)
theta = param_zeros(model)
grad = param_zeros(model)
opt = adam(1.0e-3, 0.9, 0.999)
state = optim_state(model)
for k to 3000 {
    for r to 3 {
        M = param_get(theta, model, W)
        param_add(grad, model, W, M)
    }
    optim_step(opt, theta, grad, state, model)
}
show theta[0]

