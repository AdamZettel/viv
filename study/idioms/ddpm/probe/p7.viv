C = zeros(2000, 2)
P = zeros(512, 2)
fill(C, 0.5)
tot = 0.0
for i to 512 {
    best = 1.0e300
    for k to 2000 {
        dx = P[i, 0] - C[k, 0]
        dy = P[i, 1] - C[k, 1]
        best = min(best, dx * dx + dy * dy)
    }
    tot = tot + best
}
show tot

