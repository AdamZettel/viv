###
Backtracking, ported from TheAlgorithms/Python: backtracking/n_queens.py and
backtracking/all_permutations.py.
###
import seq

# ---------------------------------------------------------------- n-queens
#| n_queens.py is_safe: no queen above (row, column) in its column or on either
#| diagonal going up.
def is_safe(board: Arr, row, column) -> Bool {
    n = len(board)
    for i to row {
        if board[i, column] == 1.0 {
            return false
        }
    }
    i = row - 1.0
    j = column - 1.0
    while i >= 0.0 and j >= 0.0 {
        if board[i, j] == 1.0 {
            return false
        }
        i -= 1.0
        j -= 1.0
    }
    i = row - 1.0
    j = column + 1.0
    while i >= 0.0 and j < n {
        if board[i, j] == 1.0 {
            return false
        }
        i -= 1.0
        j += 1.0
    }
    return true
}

#| n_queens.py solve: place a queen in each safe column of this row and recurse.
#| Python appends each finished board to a global list; here solve returns how many
#| boards it finished, and copies board number `found` into solutions[found] while
#| there is room.
def solve(board: Arr, row, solutions: Arr, found) {
    n = len(board)
    if row >= n {
        if found < len(solutions) {
            setslab(solutions, found, board)
        }
        return 1.0
    }
    count = 0.0
    for i to n {
        if is_safe(board, row, i) {
            board[row, i] = 1.0
            count += solve(board, row + 1.0, solutions, found + count)
            board[row, i] = 0.0
        }
    }
    return count
}

# ---------------------------------------------------------------- permutations
#| all_permutations.py create_state_space_tree: extend the current sequence by each
#| unused item, recurse, then undo. Python appends to and pops a list; here position
#| `index` of a fixed-length array is overwritten. Returns how many it printed.
def create_state_space_tree(sequence: Arr, current: Arr, index, used: Arr, as_text: Bool) {
    if index == len(sequence) {
        if as_text {
            text(current)
        }
        else {
            show current
        }
        return 1.0
    }
    count = 0.0
    for i to len(sequence) {
        if used[i] == 0.0 {
            current[index] = sequence[i]
            used[i] = 1.0
            count += create_state_space_tree(sequence, current, index + 1.0, used, as_text)
            used[i] = 0.0
        }
    }
    return count
}

def generate_all_permutations(sequence: Arr, as_text: Bool) {
    n = len(sequence)
    return create_state_space_tree(sequence, zeros(n), 0.0, zeros(n), as_text)
}

# ---------------------------------------------------------------- runs
first = zeros(1, 8, 8)
solve(zeros(8, 8), 0.0, first, 0.0)
first_8_queens = slab(first, 0.0)
show first_8_queens
queens_counts = zeros(8)
for n to 8 {
    queens_counts[n] = solve(zeros(n + 1.0, n + 1.0), 0.0, zeros(0.0, n + 1.0, n + 1.0), 0.0)
}
show queens_counts

permutations_4 = generate_all_permutations([3.0, 1.0, 2.0, 4.0], false)
permutations_abc = generate_all_permutations(chars("ABC"), true)

test "n_queens: 92 boards for n = 8, and the known counts for n = 1 to 7" {
    assert_true(all(queens_counts == [1.0, 0.0, 0.0, 2.0, 10.0, 4.0, 40.0, 92.0]))
    assert_near(sum(first_8_queens), 8.0, 0.0)
}

test "all_permutations: n! sequences" {
    assert_near(permutations_4, 24.0, 0.0)
    assert_near(permutations_abc, 6.0, 0.0)
}

