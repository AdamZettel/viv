record Stack { data: Arr, n: Num }
def push(s: Stack, v) -> Stack {
    s.data[s.n] = v
    return Stack { data: s.data, n: s.n + 1.0 }
}
s = Stack { data: zeros(10.0), n: 0.0 }
s = push(s, 3.0)
s = push(s, 4.0)
show s.n

