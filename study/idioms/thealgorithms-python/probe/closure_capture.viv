def count_where(a: Arr, keep) {
    c = 0.0
    for i to len(a) {
        if keep(a[i]) { c = c + 1.0 }
    }
    return c
}
def select(a: Arr, keep) -> Arr {
    out = zeros(count_where(a, keep))
    k = 0.0
    for i to len(a) {
        if keep(a[i]) {
            out[k] = a[i]
            k = k + 1.0
        }
    }
    return out
}
def split_lt(a: Arr, p) -> Arr {
    return select(a, fn(x) -> x < p)
}
a = [3.0, 1.0, 4.0, 1.0, 5.0]
lo = split_lt(a, 3.0)
show lo
ev = select(a, fn(x) -> mod(x, 2.0) == 0.0)
show ev
F = zeros(3.0)
def setf(i) { F[i] = 7.0 }
setf(1.0)
show F
e = zeros(0.0)
show e
flag = true
show flag

