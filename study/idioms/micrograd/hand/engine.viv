###
micrograd's engine and its MLP loss, kept from `micrograd.viv` so that
`micrograd_ad.viv` can check its generated gradient against the hand-written
one. The engine is verbatim; the model's defs are renamed `tape_neuron`,
`tape_layer`, `tape_mlp` and `tape_loss`, because `micrograd_ad.viv` has its
own `neuron`, `layer`, `mlp` and `loss`.

Used with `import hand.engine`, after `import params` and `import moons`.
###

#| The ops a node can be. micrograd has four primitives; -, / and negation are
#| built from them exactly as engine.py builds them.
LEAF = 0
ADD = 1
MUL = 2
POW = 3
RELU = 4

#| Room for one training step's graph: about 650 nodes per sample at 16 hidden
#| units, plus the loss.
CAPACITY = 80000

#| The tape: six parallel arrays with one entry per node, and `n[0]`, the
#| number of nodes on it (a function cannot rebind a global number, so the
#| count lives in a one-element array).
record Tape { op: Arr, left: Arr, right: Arr, data: Arr, grad: Arr, expo: Arr, n: Arr }

tape = Tape {
    op: zeros(CAPACITY),
    left: zeros(CAPACITY),
    right: zeros(CAPACITY),
    data: zeros(CAPACITY),
    grad: zeros(CAPACITY),
    expo: zeros(CAPACITY),
    n: zeros(1),
}

def clear_tape() {
    tape.n[0] = 0.0
}

def node(kind, a, b, value, k) {
    i = tape.n[0]
    tape.op[i] = kind
    tape.left[i] = a
    tape.right[i] = b
    tape.data[i] = value
    tape.grad[i] = 0.0
    tape.expo[i] = k
    tape.n[0] = i + 1.0
    return i
}

def value(x) {
    return node(LEAF, 0.0, 0.0, x, 0.0)
}

def add(a, b) {
    return node(ADD, a, b, tape.data[a] + tape.data[b], 0.0)
}

def mul(a, b) {
    return node(MUL, a, b, tape.data[a] * tape.data[b], 0.0)
}

def power(a, k) {
    return node(POW, a, 0.0, pow(tape.data[a], k), k)
}

def relu(a) {
    return node(RELU, a, 0.0, max(tape.data[a], 0.0), 0.0)
}

def neg(a) {
    return mul(a, value(-1.0))
}

def sub(a, b) {
    return add(a, neg(b))
}

def div(a, b) {
    return mul(a, power(b, -1.0))
}

#| The chain rule, once per node, from the output back to the leaves.
def backward(out) {
    tape.grad[out] = 1.0
    i = out
    while i >= 0 {
        g = tape.grad[i]
        a = tape.left[i]
        b = tape.right[i]
        if tape.op[i] == ADD {
            tape.grad[a] = tape.grad[a] + g
            tape.grad[b] = tape.grad[b] + g
        }
        else if tape.op[i] == MUL {
            tape.grad[a] = tape.grad[a] + tape.data[b] * g
            tape.grad[b] = tape.grad[b] + tape.data[a] * g
        }
        else if tape.op[i] == POW {
            k = tape.expo[i]
            tape.grad[a] = tape.grad[a] + k * pow(tape.data[a], k - 1.0) * g
        }
        else if tape.op[i] == RELU {
            if tape.data[i] > 0.0 {
                tape.grad[a] = tape.grad[a] + g
            }
        }
        i = i - 1
    }
}

#| MLP(2, [HIDDEN, HIDDEN, 1]). Layer l is a matrix with one row per neuron:
#| the row holds the neuron's weights, then its bias, as nn.py orders
#| parameters().
model = param_table(3)
L1 = param_declare(model, HIDDEN, 3)
L2 = param_declare(model, HIDDEN, HIDDEN + 1)
L3 = param_declare(model, 1, HIDDEN + 1)
NPARAM = param_count(model)
theta = P0

#| One neuron: bias plus the weighted inputs, summed left to right the way
#| Python's sum(..., start) does, then ReLU unless it is the output layer.
def tape_neuron(w, x: Arr, nonlin: Bool) {
    nin = len(x)
    act = w + nin
    for i to nin {
        act = add(act, mul(w + i, x[i]))
    }
    if nonlin {
        return relu(act)
    }
    return act
}

def tape_layer(k, x: Arr, nonlin: Bool) {
    rows = param_rows(model, k)
    cols = param_cols(model, k)
    out = zeros(rows)
    for r to rows {
        out[r] = tape_neuron(param_offset(model, k) + r * cols, x, nonlin)
    }
    return out
}

def tape_mlp(x: Arr) {
    h = tape_layer(L1, x, true)
    h = tape_layer(L2, h, true)
    return tape_layer(L3, h, false)[0]
}

# ------------------------------------------------------ the loss (demo cell)

#| Put the parameters on the tape as its first NPARAM leaves, run the model on
#| every sample, and return the loss node. The accuracy goes in acc[0].
def tape_loss(acc: Arr) {
    clear_tape()
    for i to NPARAM {
        value(theta[i])
    }
    losses = zeros(N)
    hits = 0.0
    for s to N {
        xs = zeros(2)
        xs[0] = value(X[s, 0])
        xs[1] = value(X[s, 1])
        score = tape_mlp(xs)
        losses[s] = relu(add(value(1.0), mul(score, value(-Y[s]))))
        if (Y[s] > 0.0) == (tape.data[score] > 0.0) {
            hits = hits + 1.0
        }
    }
    data_loss = value(0.0)
    for s to N {
        data_loss = add(data_loss, losses[s])
    }
    data_loss = mul(data_loss, value(1.0 / N))
    reg = value(0.0)
    for i to NPARAM {
        reg = add(reg, mul(i, i))
    }
    acc[0] = hits / N
    return add(data_loss, mul(value(1.0e-4), reg))
}

