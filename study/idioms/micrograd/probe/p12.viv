record Tape { data: Arr, grad: Arr, n: Arr }
def mk(t: Tape, x) {
    i = t.n[0]
    t.data[i] = x
    t.n[0] = i + 1.0
    return i
}
t = Tape { data: zeros(8), grad: zeros(8), n: zeros(1) }
a = mk(t, 2.0)
show t.data

