m = zeros(2, 3)
show sum(m)
show shape(m)
v = tanh([0.1, 0.2])
show v
show exp([0.0, 1.0])
show log([1.0, 2.0])
w = [3.0, 1.0] * [2.0, 2.0]
show w
show max([1.0, 5.0], [2.0, 3.0])
show min(max([1.0, 5.0], 0.8), 1.2)

