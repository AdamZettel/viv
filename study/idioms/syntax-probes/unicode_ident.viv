###
Identifiers may use any letters, not only ASCII ones (the lexer read a
name byte by byte, so `Δx` stopped it).
###

Δx = 0.5
σ = 2
show Δx
def gaußian(x, σ) {
    return exp(-x * x / (2 * σ * σ))
}
show gaußian(1, σ)

test "a name with non-ASCII letters is a name" {
    Δt = 0.25
    assert_near(4 * Δt, 1, 0)
    assert_near(gaußian(0, σ), 1, 0)
}

