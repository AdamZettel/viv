###
Recursion has one limit in every engine (2500 nested calls of recursive
defs); past it the run stops with an error at the def. The interpreter used
to overflow its native stack near 2000 with no location.
###

def depth(n) {
    if n == 0.0 {
        return 0.0
    }
    return 1.0 + depth(n - 1.0)
}

def is_even(n) {
    if n == 0.0 {
        return true
    }
    return is_odd(n - 1.0)
}

def is_odd(n) {
    if n == 0.0 {
        return false
    }
    return is_even(n - 1.0)
}

show depth(2000)
show is_even(2400)

test "2000 deep, and every call's count comes back" {
    total = 0
    for k to 50 {
        total += depth(2000)
    }
    assert_near(total, 100000, 0)
    assert_true(is_odd(2401))
}

