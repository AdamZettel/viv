###
Engine differences that py2viv's generated rule tests found
(tools/py2viv/check_rules.py), each now the same in every engine:
`-c` and `c ^ 2.0` of an array a def returned stay arrays; max and min of
two zeros say +0 is the larger (wasm said max(-0.0, 0.0) = -0.0); negating a
complex array negates both parts (C and wasm scaled by -1 + 0i, which turns
the imaginary part of 0 + 0i into +0); erf of an infinity is 1 or -1 and
gamma of one is inf (both were nan). The stops (two arrays of different
shapes under * + @, a NaN given to eig_sym or spectrum_sym) are in
lang/viv/tests/semantics.rs, since a probe must run to the end.
###

def twice(a) {
    return a * 2.0
}
a = [1.0, 2.0]
c = twice(a)
b = -c
show b
d = twice(a) ^ 2.0
show d

zs = [-0.0, 0.0]
show 1.0 / max(-0.0, 0.0)
show 1.0 / min(0.0, -0.0)
show 1.0 / max(zs, 0.0)
show 1.0 / min(zs, -0.0)

z = czeros(2)
y = -z
show 1.0 / im(y)

inf = 1.0 / 0.0
show erf(inf)
show erf(-inf)
show gamma(inf)

test "the negation of a def's array is an array" {
    assert_allclose(b, [-2.0, -4.0], 0.0)
    assert_allclose(d, [4.0, 16.0], 0.0)
}

# atan of 1/x is pi/2 for +0 and -pi/2 for -0 (inf - inf is nan)
halfpi = 1.5707963267948966

test "+0 is larger than -0 in max and min" {
    assert_near(atan(1.0 / max(-0.0, 0.0)), halfpi, 1e-15)
    assert_near(atan(1.0 / min(0.0, -0.0)), -halfpi, 1e-15)
}

test "a negated complex zero has a negative zero imaginary part" {
    assert_near(atan(1.0 / im(y)[0]), -halfpi, 1e-15)
    assert_near(atan(1.0 / im(y)[1]), -halfpi, 1e-15)
}

test "erf and gamma at infinity" {
    assert_near(erf(inf), 1.0, 0.0)
    assert_near(erf(-inf), -1.0, 0.0)
    assert_near(atan(gamma(inf)), halfpi, 1e-15)
}

