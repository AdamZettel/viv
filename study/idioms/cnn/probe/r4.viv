A = zeros(2, 2, 2, 2)
A[1, 1, 0, 1] = -3.0
A[0, 1, 0, 1] = 2.0
R = max(A, 0.0)
show sum(R)
idx = zeros(2)
idx[0] = 5.0
idx[1] = 15.0
show take(A, idx)
put(A, idx, [7.0, 8.0])
show A[1, 1, 1, 1]
M = A > 0.0
show M

