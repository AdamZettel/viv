# A def returning two arrays, unpacked in a loop; the arrays must survive.
def two(k) {
    return zeros(4) + k, linspace(0.0, k, 4)
}
p = zeros(4)
q = zeros(4)
for k to NITER {
    p, q = two(k)
}
print(sum(p) + sum(q))

