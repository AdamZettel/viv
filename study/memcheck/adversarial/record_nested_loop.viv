# A record holding a record holding an array, rebuilt in a nested loop.
record In {
    xs: Arr
}
record Out {
    inner: In
    w: Num
}
o = Out { inner: In { xs: zeros(3) }, w: 0.0 }
for k to NITER {
    for j to 3 {
        o = Out { inner: In { xs: o.inner.xs + 1.0 }, w: k }
    }
}
print(sum(o.inner.xs))

