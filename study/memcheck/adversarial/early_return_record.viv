record Box {
    xs: Arr
    n: Num
}
def find(limit) {
    for k to 100 {
        t = zeros(8) + k
        if k >= limit {
            return Box { xs: t, n: k }
        }
    }
    return Box { xs: zeros(1), n: 0 - 1.0 }
}
s = 0.0
for k to NITER {
    b = find(3)
    s = s + sum(b.xs)
}
print(s)

