# Copies of a record that holds an array of records, each changed through
# its own name in a loop: every copy has storage of its own, and a pass's
# copies are freed when the pass ends.
record Cell { v: Arr }
record Grid { cells: [Cell], t: Num }

g = Grid { cells: [Cell { v: zeros(32) }, Cell { v: zeros(32) }], t: 0 }
last = g
for k to NITER {
    c = g
    c.cells[0].v = c.cells[0].v + 1.0
    c.t = k
    last = c
}
print(g.t, sum(g.cells[0].v), last.t, sum(last.cells[0].v))

