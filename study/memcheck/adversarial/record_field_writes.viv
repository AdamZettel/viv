# Writes into a model's fields and its array of records, every pass of a
# top-level loop: each write stores an array the pass made into a record made
# before the loop, which only the model's variable reaches.
record Lin { w: Arr, b: Arr }
record Model { layers: [Lin], steps: Num }

def lin(n) {
    return Lin { w: zeros(n, n) + 1.0, b: zeros(n) }
}

m = Model { layers: [lin(8), lin(8), lin(8)], steps: 0 }
for k to NITER {
    for l to len(m.layers) {
        m.layers[l].w = m.layers[l].w * 1.0
        m.layers[l].b = m.layers[l].b + 1.0
    }
    m.layers[1] = lin(8)
    m.steps = m.steps + 1
}
print(m.steps, m.layers[0].b[0], m.layers[1].b[0], sum(m.layers[2].w))

