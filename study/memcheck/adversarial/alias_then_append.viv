# An alias taken before a growing append: the alias must keep the old array.
a = []
for k to 8 {
    a = append(a, k * 1.0)
}
b = a
for k to NITER {
    a = append(a, 1.0)
}
b[0] = 99.0
print(len(b), a[0], len(a))

