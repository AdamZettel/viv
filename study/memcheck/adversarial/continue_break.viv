s = 0.0
keep = zeros(2)
for k to NITER {
    t = linspace(0.0, 1.0, 16)
    if k % 3 == 0 {
        continue
    }
    keep = t * 2.0
    j = 0
    while true {
        u = t + j
        j = j + 1
        if j > 3 {
            break
        }
    }
    s = s + sum(keep)
}
print(s)

