# A def that grows an array of records, writes into it in a loop and returns
# it, called once a pass: what it returns is kept, the rest of each call freed.
record Head { q: Arr, k: Arr }

def heads(n, passes) {
    hs = []
    for h to n {
        hs = append(hs, Head { q: zeros(16) + h, k: zeros(16) })
    }
    for s to passes {
        for h to len(hs) {
            hs[h].k = hs[h].k + hs[h].q
        }
    }
    return hs
}

total = 0.0
for k to NITER {
    hs = heads(4, 3)
    total = total + sum(hs[3].k)
}
print(total)

