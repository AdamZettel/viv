# The same parallel loop inside a def, and the def called NITER times: the def's
# return frees its own thread's arena, not the worker threads'.
def row(i) {
    return linspace(0.0, i, 64)
}
def sweep(n) {
    out = zeros(n)
    parallel for i to n {
        out[i] = sum(row(i))
    }
    return sum(out)
}
s = 0.0
for k to NITER {
    s = s + sweep(1000)
}
print(s)

