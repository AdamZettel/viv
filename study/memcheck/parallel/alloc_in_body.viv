# The body calls a def returning an array: on a worker thread it lands on that
# thread's arena.
def row(i) {
    return linspace(0.0, i, 64)
}
out = zeros(NITER)
parallel for i to NITER {
    out[i] = sum(row(i))
}
print(sum(out))

