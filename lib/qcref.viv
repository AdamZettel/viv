test "the water631g reference is internally consistent" {
    n = WATER631G_NBF
    S = water631g_S()
    G = water631g_ERI()
    # overlap is symmetric with a unit diagonal
    for i to n {
        assert_near(S[i * n + i], 1.0, 1.0e-13)
        for j to n {
            assert_near(S[i * n + j], S[j * n + i], 1.0e-14)
        }
    }
    # the two-electron integrals have the eightfold symmetry they must
    for a to n {
        for b to n {
            for c to n {
                for d to n {
                    x = G[((a * n + b) * n + c) * n + d]
                    assert_near(x, G[((b * n + a) * n + c) * n + d], 1.0e-14)
                    assert_near(x, G[((a * n + b) * n + d) * n + c], 1.0e-14)
                    assert_near(x, G[((c * n + d) * n + a) * n + b], 1.0e-14)
                }
            }
        }
    }
    # nuclei repel, and the electrons bind in spite of it
    assert_lt(0.0, WATER631G_ENUC)
    assert_lt(WATER631G_ERHF, 0.0)
}

