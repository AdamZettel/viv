LN_SQRT_2PI = 0.9189385332046728
SQRT_PI = 1.772453850905516
SQRT_2PI = 2.5066282746310007
SQRT_2 = 1.4142135623730951

test "the tables against closed forms" {
    # zeta(2) = pi^2 / 6 and zeta(4) = pi^4 / 90
    assert_near(ZETA_M1[0], pi * pi / 6.0 - 1.0, 4.0e-16)
    assert_near(ZETA_M1[2], pi * pi * pi * pi / 90.0 - 1.0, 4.0e-16)
    # the positive zero of digamma, 1.46163214496836234126... (OEIS A030169)
    assert_near(PSI_ROOT_HI + PSI_ROOT_LO, 1.4616321449683623, 4.0e-16)
    # sqrt(2 pi) and sqrt(2)
    assert_near(SQRT_2PI, sqrt(2.0 * pi), 1.0e-15)          # one rounding of 2 pi and one of the root
    assert_near(SQRT_2, sqrt(2.0), 0.0)
}

