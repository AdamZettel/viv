# What to check while the Casida matrices are built and solved.
# Nothing here prints; the watches and
# holds go into the story (`viv story scf/story_casida.viv`), and a failed
# hold fails the run.
casida_solve  @433df73f
  watch at build   nov
  hold at build    max(abs(A - transpose(A))) == 0.0 within 1e-12   "A is symmetric"
  hold at build    max(abs(B - transpose(B))) == 0.0 within 1e-12   "B is symmetric"
  watch at tda     lowest_tda
  watch at tdhf    lowest_tdhf
  hold at tdhf     lowest_tdhf <= lowest_tda                         "the lowest TDHF energy is not above the lowest TDA energy"

casida_tdhf  @af654937
  watch at stability  wmin
  hold at stability   wmin > 0.0                                    "A - B is positive definite: the ground state is stable against these rotations"
  hold at fold        max(abs(C - transpose(C))) == 0.0 within 1e-10 "the folded matrix is symmetric"
