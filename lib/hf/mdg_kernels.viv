#| The E table of one axis for powers up to `(2, 2)`, exponents `a` and `b`,
#| `X = A - B` on the axis: `herm_efill(E, 0, la, lb, a, b, X)` without the loops.
def mdg_e_22(E: Arr, a, b, X) {
    p = a + b
    o2p = 0.5 / p
    xax = -b * X / p
    xbx = a * X / p
    E[0] = exp(-a * b / p * X * X)
    E[15] = E[0] * xax
    t1 = E[0] * o2p
    E[16] = t1
    E[30] = E[16] + E[15] * xax
    t2 = E[15] * o2p
    E[31] = t2 + E[16] * xax
    t3 = E[16] * o2p
    E[32] = t3
    E[5] = E[0] * xbx
    E[6] = t1
    E[20] = E[16] + E[15] * xbx
    E[21] = t2 + E[16] * xbx
    E[22] = t3
    E[35] = E[31] + E[30] * xbx
    E[36] = 2.0 * E[32] + E[30] * o2p + E[31] * xbx
    E[37] = E[31] * o2p + E[32] * xbx
    E[38] = E[32] * o2p
    E[10] = E[6] + E[5] * xbx
    E[11] = E[5] * o2p + E[6] * xbx
    E[12] = E[6] * o2p
    E[25] = E[21] + E[20] * xbx
    E[26] = 2.0 * E[22] + E[20] * o2p + E[21] * xbx
    E[27] = E[21] * o2p + E[22] * xbx
    E[28] = E[22] * o2p
    E[40] = E[36] + E[35] * xbx
    E[41] = 2.0 * E[37] + E[35] * o2p + E[36] * xbx
    E[42] = 3.0 * E[38] + E[36] * o2p + E[37] * xbx
    E[43] = E[37] * o2p + E[38] * xbx
    E[44] = E[38] * o2p
    return 0
}

#| One primitive pair of a `(2, 2)` shell pair, exponents `a` and `b`, centers
#| `A - B = (X, Y, Z)`: `V[(i nb + j) nh + h] = N_i N_j E^x E^y E^z` for component `i` of
