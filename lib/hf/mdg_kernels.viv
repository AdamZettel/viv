#| The Hermite values of one primitive quartet with a ket pair of total order `0`,
#| signed and gathered for the ket contraction: for each bra Hermite function
#| `ha = (ta, ua, va)` of order up to `L1` and each ket one `h = (t, u, v)`,
#| `BR[o + h ncol + ha] = (-1)^(t+u+v) R(ta + t, ua + u, va + v)`, `R` the cube of side
#| `D` in `S` (`herm_rfill`'s layout). The ket offsets are constants; the bra ones
#| are Int arithmetic, where mdg_eri's general gather reads both from a table.
def mdg_gather_0(BR: Arr, o: Int, ncol: Int, S: Arr, L1: Int, D: Int) {
    D2 = D * D
    b = o
    for ta to L1 + 1 {
        for ua to L1 - ta + 1 {
            for va to L1 - ta - ua + 1 {
                oa = ta * D2 + ua * D + va
                BR[b] = S[oa]
                b = b + 1
            }
        }
    }
    return 0
}

#| The Hermite values of one primitive quartet with a ket pair of total order `1`,
#| signed and gathered for the ket contraction: for each bra Hermite function
#| `ha = (ta, ua, va)` of order up to `L1` and each ket one `h = (t, u, v)`,
#| `BR[o + h ncol + ha] = (-1)^(t+u+v) R(ta + t, ua + u, va + v)`, `R` the cube of side
#| `D` in `S` (`herm_rfill`'s layout). The ket offsets are constants; the bra ones
#| are Int arithmetic, where mdg_eri's general gather reads both from a table.
def mdg_gather_1(BR: Arr, o: Int, ncol: Int, S: Arr, L1: Int, D: Int) {
    D2 = D * D
    c1: Int = 1
    r1: Int = ncol
    c2: Int = D
    r2: Int = 2 * ncol
    c3: Int = D2
    r3: Int = 3 * ncol
    b = o
    for ta to L1 + 1 {
        for ua to L1 - ta + 1 {
            for va to L1 - ta - ua + 1 {
                oa = ta * D2 + ua * D + va
                BR[b] = S[oa]
                BR[b + r1] = -S[oa + c1]
                BR[b + r2] = -S[oa + c2]
                BR[b + r3] = -S[oa + c3]
                b = b + 1
            }
        }
    }
    return 0
}

