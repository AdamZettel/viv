    V[52] = t5 * EZ[8] * 0.5773502691896258
    return 0
}

#| The E table of one axis for powers up to `(2, 1)`, exponents `a` and `b`,
#| `X = A - B` on the axis: `herm_efill(E, 0, la, lb, a, b, X)` without the loops.
def mdg_e_21(E: Arr, a, b, X) {
    p = a + b
    o2p = 0.5 / p
    xax = -b * X / p
    xbx = a * X / p
    E[0] = exp(-a * b / p * X * X)
    E[8] = E[0] * xax
    t1 = E[0] * o2p
    E[9] = t1
    E[16] = E[9] + E[8] * xax
    t2 = E[8] * o2p
    E[17] = t2 + E[9] * xax
    t3 = E[9] * o2p
    E[18] = t3
    E[4] = E[0] * xbx
    E[5] = t1
    E[12] = E[9] + E[8] * xbx
    E[13] = t2 + E[9] * xbx
    E[14] = t3
    E[20] = E[17] + E[16] * xbx
    E[21] = 2.0 * E[18] + E[16] * o2p + E[17] * xbx
    E[22] = E[17] * o2p + E[18] * xbx
    E[23] = E[18] * o2p
    return 0
}

