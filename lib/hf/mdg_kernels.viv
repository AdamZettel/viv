#| The E table of one axis for powers up to `(1, 3)`, exponents `a` and `b`,
#| `X = A - B` on the axis: `herm_efill(E, 0, la, lb, a, b, X)` without the loops.
def mdg_e_13(E: Arr, a, b, X) {
    p = a + b
    o2p = 0.5 / p
    xax = -b * X / p
    xbx = a * X / p
    E[0] = exp(-a * b / p * X * X)
    E[20] = E[0] * xax
    t1 = E[0] * o2p
    E[21] = t1
    E[5] = E[0] * xbx
    E[6] = t1
    E[25] = E[21] + E[20] * xbx
    E[26] = E[20] * o2p + E[21] * xbx
    E[27] = E[21] * o2p
    E[10] = E[6] + E[5] * xbx
    E[11] = E[5] * o2p + E[6] * xbx
    E[12] = E[6] * o2p
    E[30] = E[26] + E[25] * xbx
    E[31] = 2.0 * E[27] + E[25] * o2p + E[26] * xbx
    E[32] = E[26] * o2p + E[27] * xbx
    E[33] = E[27] * o2p
    E[15] = E[11] + E[10] * xbx
    E[16] = 2.0 * E[12] + E[10] * o2p + E[11] * xbx
    E[17] = E[11] * o2p + E[12] * xbx
    E[18] = E[12] * o2p
    E[35] = E[31] + E[30] * xbx
    E[36] = 2.0 * E[32] + E[30] * o2p + E[31] * xbx
    E[37] = 3.0 * E[33] + E[31] * o2p + E[32] * xbx
    E[38] = E[32] * o2p + E[33] * xbx
    E[39] = E[33] * o2p
    return 0
}

