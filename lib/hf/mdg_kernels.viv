#| The E table of one axis for powers up to `(2, 0)`, exponents `a` and `b`,
#| `X = A - B` on the axis: `herm_efill(E, 0, la, lb, a, b, X)` without the loops.
def mdg_e_20(E: Arr, a, b, X) {
    p = a + b
    o2p = 0.5 / p
    xax = -b * X / p
    E[0] = exp(-a * b / p * X * X)
    E[3] = E[0] * xax
    E[4] = E[0] * o2p
    E[6] = E[4] + E[3] * xax
    E[7] = E[3] * o2p + E[4] * xax
    E[8] = E[4] * o2p
    return 0
}

#| One primitive pair of a `(2, 0)` shell pair, exponents `a` and `b`, centers
#| `A - B = (X, Y, Z)`: `V[(i nb + j) nh + h] = N_i N_j E^x E^y E^z` for component `i` of
#| the first shell, `j` of the second and Hermite function `h` of order `2`.
#| Entries no component pair reaches are left as they are (the caller zeroes `V`).
#| `EX`, `EY` and `EZ` are scratch for the E tables, `herm_esize(la, lb)` each.
def mdg_pair_20(V: Arr, EX: Arr, EY: Arr, EZ: Arr, a, b, X, Y, Z) {
    mdg_e_20(EX, a, b, X)
    mdg_e_20(EY, a, b, Y)
    mdg_e_20(EZ, a, b, Z)
    V[0] = EX[6] * EY[0] * EZ[0] * 0.5773502691896258
    V[6] = EX[7] * EY[0] * EZ[0] * 0.5773502691896258
    V[9] = EX[8] * EY[0] * EZ[0] * 0.5773502691896258
    V[10] = EX[3] * EY[3] * EZ[0]
    V[13] = EX[3] * EY[4] * EZ[0]
