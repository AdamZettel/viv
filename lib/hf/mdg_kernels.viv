def mdg_pair_00(V: Arr, EX: Arr, EY: Arr, EZ: Arr, a, b, X, Y, Z) {
    mdg_e_00(EX, a, b, X)
    mdg_e_00(EY, a, b, Y)
    mdg_e_00(EZ, a, b, Z)
    V[0] = EX[0] * EY[0] * EZ[0]
    return 0
}

