#| The E table of one axis for powers up to `(2, 3)`, exponents `a` and `b`,
#| `X = A - B` on the axis: `herm_efill(E, 0, la, lb, a, b, X)` without the loops.
def mdg_e_23(E: Arr, a, b, X) {
    p = a + b
    o2p = 0.5 / p
    xax = -b * X / p
    xbx = a * X / p
    E[0] = exp(-a * b / p * X * X)
    E[24] = E[0] * xax
    t1 = E[0] * o2p
    E[25] = t1
    E[48] = E[25] + E[24] * xax
    t2 = E[24] * o2p
    E[49] = t2 + E[25] * xax
    t3 = E[25] * o2p
    E[50] = t3
    E[6] = E[0] * xbx
    E[7] = t1
    E[30] = E[25] + E[24] * xbx
    E[31] = t2 + E[25] * xbx
    E[32] = t3
    E[54] = E[49] + E[48] * xbx
    E[55] = 2.0 * E[50] + E[48] * o2p + E[49] * xbx
    E[56] = E[49] * o2p + E[50] * xbx
    E[57] = E[50] * o2p
    E[12] = E[7] + E[6] * xbx
    E[13] = E[6] * o2p + E[7] * xbx
    E[14] = E[7] * o2p
    E[36] = E[31] + E[30] * xbx
    E[37] = 2.0 * E[32] + E[30] * o2p + E[31] * xbx
    E[38] = E[31] * o2p + E[32] * xbx
    E[39] = E[32] * o2p
    E[60] = E[55] + E[54] * xbx
    E[61] = 2.0 * E[56] + E[54] * o2p + E[55] * xbx
    E[62] = 3.0 * E[57] + E[55] * o2p + E[56] * xbx
    E[63] = E[56] * o2p + E[57] * xbx
    E[64] = E[57] * o2p
    E[18] = E[13] + E[12] * xbx
    E[19] = 2.0 * E[14] + E[12] * o2p + E[13] * xbx
    E[20] = E[13] * o2p + E[14] * xbx
    E[21] = E[14] * o2p
    E[42] = E[37] + E[36] * xbx
    E[43] = 2.0 * E[38] + E[36] * o2p + E[37] * xbx
    E[44] = 3.0 * E[39] + E[37] * o2p + E[38] * xbx
    E[45] = E[38] * o2p + E[39] * xbx
    E[46] = E[39] * o2p
    E[66] = E[61] + E[60] * xbx
    E[67] = 2.0 * E[62] + E[60] * o2p + E[61] * xbx
    E[68] = 3.0 * E[63] + E[61] * o2p + E[62] * xbx
    E[69] = 4.0 * E[64] + E[62] * o2p + E[63] * xbx
    E[70] = E[63] * o2p + E[64] * xbx
    E[71] = E[64] * o2p
    return 0
}

