    V[18] = EX[4] * EY[4] * EZ[0]
    t1 = EX[3] * EY[0]
    V[20] = t1 * EZ[3]
    V[21] = t1 * EZ[4]
    t2 = EX[4] * EY[0]
    V[26] = t2 * EZ[3]
    V[27] = t2 * EZ[4]
    V[30] = EX[0] * EY[6] * EZ[0] * 0.5773502691896258
    V[33] = EX[0] * EY[7] * EZ[0] * 0.5773502691896258
