#| `X = A - B` on the axis: `herm_efill(E, 0, la, lb, a, b, X)` without the loops.
def mdg_e_31(E: Arr, a, b, X) {
    p = a + b
    o2p = 0.5 / p
    xax = -b * X / p
    xbx = a * X / p
    E[0] = exp(-a * b / p * X * X)
    E[10] = E[0] * xax
    t1 = E[0] * o2p
    E[11] = t1
    E[20] = E[11] + E[10] * xax
    t2 = E[10] * o2p
    E[21] = t2 + E[11] * xax
    t3 = E[11] * o2p
    E[22] = t3
    E[30] = E[21] + E[20] * xax
    t4 = 2.0 * E[22]
    t5 = E[20] * o2p
    E[31] = t4 + t5 + E[21] * xax
    t6 = E[21] * o2p
    E[32] = t6 + E[22] * xax
    t7 = E[22] * o2p
    E[33] = t7
    E[5] = E[0] * xbx
    E[6] = t1
    E[15] = E[11] + E[10] * xbx
    E[16] = t2 + E[11] * xbx
    E[17] = t3
    E[25] = E[21] + E[20] * xbx
    E[26] = t4 + t5 + E[21] * xbx
    E[27] = t6 + E[22] * xbx
    E[28] = t7
    E[35] = E[31] + E[30] * xbx
    E[36] = 2.0 * E[32] + E[30] * o2p + E[31] * xbx
    E[37] = 3.0 * E[33] + E[31] * o2p + E[32] * xbx
    E[38] = E[32] * o2p + E[33] * xbx
    E[39] = E[33] * o2p
    return 0
}

