#| `pref R(0; t, u, v)` for `t + u + v <= 10` into `S` at `(t D + u) D + v`, `D = 11`:
#| `herm_rfill(S, 10, al, X, Y, Z, F, pref)` without the loops. `F` holds `F_0 .. F_10`.
def mdg_r_10(S: Arr, al, X, Y, Z, F: Arr, pref) {
    m2a = -2.0 * al
    r0 = pref * F[0]
    w1 = pref * m2a
    r1 = w1 * F[1]
    w2 = w1 * m2a
    r2 = w2 * F[2]
    w3 = w2 * m2a
    r3 = w3 * F[3]
    w4 = w3 * m2a
    r4 = w4 * F[4]
    w5 = w4 * m2a
    r5 = w5 * F[5]
    w6 = w5 * m2a
    r6 = w6 * F[6]
    w7 = w6 * m2a
    r7 = w7 * F[7]
    w8 = w7 * m2a
    r8 = w8 * F[8]
    w9 = w8 * m2a
    r9 = w9 * F[9]
    w10 = w9 * m2a
    r10 = w10 * F[10]
    q9_0_0_1 = Z * r10
    q9_0_1_0 = Y * r10
    q9_1_0_0 = X * r10
    q8_0_0_1 = Z * r9
    q8_0_0_2 = r9 + Z * q9_0_0_1
    q8_0_1_0 = Y * r9
    q8_0_1_1 = Y * q9_0_0_1
    q8_0_2_0 = r9 + Y * q9_0_1_0
    q8_1_0_0 = X * r9
    q8_1_0_1 = X * q9_0_0_1
    q8_1_1_0 = X * q9_0_1_0
    q8_2_0_0 = r9 + X * q9_1_0_0
    q7_0_0_1 = Z * r8
    q7_0_0_2 = r8 + Z * q8_0_0_1
    q7_0_0_3 = 2.0 * q8_0_0_1 + Z * q8_0_0_2
