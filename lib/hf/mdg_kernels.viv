#| `pref R(0; t, u, v)` for `t + u + v <= 6` into `S` at `(t D + u) D + v`, `D = 7`:
#| `herm_rfill(S, 6, al, X, Y, Z, F, pref)` without the loops. `F` holds `F_0 .. F_6`.
def mdg_r_6(S: Arr, al, X, Y, Z, F: Arr, pref) {
    m2a = -2.0 * al
    r0 = pref * F[0]
    w1 = pref * m2a
    r1 = w1 * F[1]
    w2 = w1 * m2a
    r2 = w2 * F[2]
    w3 = w2 * m2a
    r3 = w3 * F[3]
    w4 = w3 * m2a
    r4 = w4 * F[4]
    w5 = w4 * m2a
    r5 = w5 * F[5]
    w6 = w5 * m2a
    r6 = w6 * F[6]
    q5_0_0_1 = Z * r6
    q5_0_1_0 = Y * r6
    q5_1_0_0 = X * r6
    q4_0_0_1 = Z * r5
    q4_0_0_2 = r5 + Z * q5_0_0_1
    q4_0_1_0 = Y * r5
    q4_0_1_1 = Y * q5_0_0_1
    q4_0_2_0 = r5 + Y * q5_0_1_0
    q4_1_0_0 = X * r5
    q4_1_0_1 = X * q5_0_0_1
    q4_1_1_0 = X * q5_0_1_0
    q4_2_0_0 = r5 + X * q5_1_0_0
    q3_0_0_1 = Z * r4
    q3_0_0_2 = r4 + Z * q4_0_0_1
    q3_0_0_3 = 2.0 * q4_0_0_1 + Z * q4_0_0_2
    q3_0_1_0 = Y * r4
    q3_0_1_1 = Y * q4_0_0_1
    q3_0_1_2 = Y * q4_0_0_2
    q3_0_2_0 = r4 + Y * q4_0_1_0
    q3_0_2_1 = q4_0_0_1 + Y * q4_0_1_1
    q3_0_3_0 = 2.0 * q4_0_1_0 + Y * q4_0_2_0
    q3_1_0_0 = X * r4
    q3_1_0_1 = X * q4_0_0_1
    q3_1_0_2 = X * q4_0_0_2
    q3_1_1_0 = X * q4_0_1_0
    q3_1_1_1 = X * q4_0_1_1
    q3_1_2_0 = X * q4_0_2_0
    q3_2_0_0 = r4 + X * q4_1_0_0
