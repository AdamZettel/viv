#| The E table of one axis for powers up to `(3, 2)`, exponents `a` and `b`,
#| `X = A - B` on the axis: `herm_efill(E, 0, la, lb, a, b, X)` without the loops.
def mdg_e_32(E: Arr, a, b, X) {
    p = a + b
    o2p = 0.5 / p
    xax = -b * X / p
    xbx = a * X / p
    E[0] = exp(-a * b / p * X * X)
    E[18] = E[0] * xax
    t1 = E[0] * o2p
    E[19] = t1
    E[36] = E[19] + E[18] * xax
    t2 = E[18] * o2p
    E[37] = t2 + E[19] * xax
    t3 = E[19] * o2p
    E[38] = t3
    E[54] = E[37] + E[36] * xax
    t4 = 2.0 * E[38]
    t5 = E[36] * o2p
    E[55] = t4 + t5 + E[37] * xax
    t6 = E[37] * o2p
    E[56] = t6 + E[38] * xax
    t7 = E[38] * o2p
    E[57] = t7
    E[6] = E[0] * xbx
    E[7] = t1
    E[24] = E[19] + E[18] * xbx
    E[25] = t2 + E[19] * xbx
    E[26] = t3
    E[42] = E[37] + E[36] * xbx
    E[43] = t4 + t5 + E[37] * xbx
    E[44] = t6 + E[38] * xbx
    E[45] = t7
    E[60] = E[55] + E[54] * xbx
    E[61] = 2.0 * E[56] + E[54] * o2p + E[55] * xbx
    E[62] = 3.0 * E[57] + E[55] * o2p + E[56] * xbx
    E[63] = E[56] * o2p + E[57] * xbx
    E[64] = E[57] * o2p
    E[12] = E[7] + E[6] * xbx
    E[13] = E[6] * o2p + E[7] * xbx
    E[14] = E[7] * o2p
    E[30] = E[25] + E[24] * xbx
    E[31] = 2.0 * E[26] + E[24] * o2p + E[25] * xbx
    E[32] = E[25] * o2p + E[26] * xbx
    E[33] = E[26] * o2p
    E[48] = E[43] + E[42] * xbx
    E[49] = 2.0 * E[44] + E[42] * o2p + E[43] * xbx
    E[50] = 3.0 * E[45] + E[43] * o2p + E[44] * xbx
    E[51] = E[44] * o2p + E[45] * xbx
    E[52] = E[45] * o2p
    E[66] = E[61] + E[60] * xbx
    E[67] = 2.0 * E[62] + E[60] * o2p + E[61] * xbx
    E[68] = 3.0 * E[63] + E[61] * o2p + E[62] * xbx
    E[69] = 4.0 * E[64] + E[62] * o2p + E[63] * xbx
    E[70] = E[63] * o2p + E[64] * xbx
    E[71] = E[64] * o2p
    return 0
}

