from rv32.system import run_asm, STEP_LIMIT

SOURCE = """
.text
_start:
test_2:
li gp, 2
li ra, 0
jal x4, target_2
linkaddr_2:
nop
nop
j fail
target_2:
la x2, linkaddr_2
bne x2, x4, fail
test_3: li gp, 3
li ra, 1
jal x0, 1f
addi ra, ra, 1
addi ra, ra, 1
addi ra, ra, 1
addi ra, ra, 1
1: addi ra, ra, 1
addi ra, ra, 1
li x7, 3
bne ra, x7, fail
bne x0, gp, pass
fail: mv a0, gp
li a7, 93
ecall
pass: li gp, 1
li a7, 93
li a0, 0
ecall
.data
.data
"""

result = run_asm(SOURCE, STEP_LIMIT)
show "rv32ui-jal", result.exit_code, result.steps

test "rv32ui-jal passes every case" {
    assert_true(result.halted)
    assert_true(result.exit_code == 0)
}

