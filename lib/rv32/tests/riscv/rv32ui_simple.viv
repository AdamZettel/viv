from rv32.system import run_asm, STEP_LIMIT

SOURCE = """
.text
_start:
li gp, 1
li a7, 93
li a0, 0
ecall
.data
.data
"""

result = run_asm(SOURCE, STEP_LIMIT)
show "rv32ui-simple", result.exit_code, result.steps

test "rv32ui-simple passes every case" {
    assert_true(result.halted)
    assert_true(result.exit_code == 0)
}

