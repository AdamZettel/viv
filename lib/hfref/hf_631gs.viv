def hf_631gs_m() -> Arr {
    return hf_631gs_mat(hf_631gs_m_flat(), 17, 16)
}

#| One quarter transform with the indices rotated: x has shape (n1, n2, n3, nc),
#| and y[d, i, j, k] = sum_l x[i, j, k, l] M[l, d] has shape (ns, n1, n2, n3).
#| Four of these take (ij|kl) to (ab|cd) in the original index order.
def hf_631gs_quarter(x: Arr, m: Arr, n1, n2, n3, nc, ns) -> Arr {
    y = zeros(ns * n1 * n2 * n3)
    for i to n1 {
        for j to n2 {
            for k to n3 {
                base = ((i * n2 + j) * n3 + k) * nc
                for d to ns {
                    t = 0.0
                    for l to nc {
                        t = t + x[base + l] * m[l, d]
                    }
                    y[((d * n1 + i) * n2 + j) * n3 + k] = t
                }
            }
        }
    }
    return y
}

#| Packed-8 spherical ERIs from packed-8 unit-Cartesian ones:
#| (ab|cd)_sph = sum_ijkl M_ia M_jb M_kc M_ld (ij|kl)_unit.
def hf_631gs_eri8_m4(g: Arr, m: Arr, nc, ns) -> Arr {
    pr = hf_631gs_pair_table(nc)
    x = zeros(nc * nc * nc * nc)
    for i to nc {
        for j to nc {
            pij = pr[i, j]
            for k to nc {
                for l to nc {
                    pkl = pr[k, l]
                    a = max(pij, pkl)
                    b = min(pij, pkl)
                    x[((i * nc + j) * nc + k) * nc + l] = g[a * (a + 1) / 2 + b]
                }
            }
        }
    }
    x = hf_631gs_quarter(x, m, nc, nc, nc, nc, ns)
    x = hf_631gs_quarter(x, m, ns, nc, nc, nc, ns)
    x = hf_631gs_quarter(x, m, ns, ns, nc, nc, ns)
    x = hf_631gs_quarter(x, m, ns, ns, ns, nc, ns)
    npair = ns * (ns + 1) / 2
    out = zeros(npair * (npair + 1) / 2)
    for a to ns {
        for b to a + 1 {
            ab = a * (a + 1) / 2 + b
            for c to ns {
                for d to c + 1 {
                    cd = c * (c + 1) / 2 + d
                    if cd <= ab {
                        out[ab * (ab + 1) / 2 + cd] = x[((a * ns + b) * ns + c) * ns + d]
                    }
                }
            }
        }
    }
    return out
}

#| Largest |g[idx_k] - val_k| over the samples.
def hf_631gs_sample_dev(g: Arr, idx: Arr, val: Arr) {
    w = 0.0
    for k to len(idx) {
        w = max(w, abs(g[idx[k]] - val[k]))
    }
    return w
}

#| Every packed-8 spherical ERI, computed from the stored unit-Cartesian set as
#| M^4 (ij|kl): PySCF's spherical set agrees to 1e-13.
def hf_631gs_eri8_sph() -> Arr {
    return hf_631gs_eri8_m4(hf_631gs_eri8_cart(), hf_631gs_m(), 17, 16)
}

