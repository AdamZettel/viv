HF_631GS_E_RHF_STABLE_CART = -100.00286265223036
# 1: no restart from the stability orbitals lowers the minao state; 0: one does; -1: not analyzed (stability restart).
HF_631GS_RHF_IS_STABLE_CART = 1
HF_631GS_RHF_NALPHA_CART = 5
HF_631GS_RHF_NBETA_CART = 5

