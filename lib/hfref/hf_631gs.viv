def hf_631gs_rhf_d_cart() -> Arr {
    return hf_631gs_mat(hf_631gs_rhf_d_cart_flat(), 17, 17)
}

test "hf_631gs packs" {
    assert_near(hf_631gs_pack_bad(hf_631gs_shells(), HF_631GS_NSH, HF_631GS_NPRIMTOT, HF_631GS_NATOM), 0.0, 0.0)
    # nao_cart - nao_sph = sum over shells of ncart - nsph: 1 per d shell, 3 per f shell
    assert_near(HF_631GS_NAO_CART - HF_631GS_NAO_SPH, 1.0, 0.0)
    assert_near(len(hf_631gs_fc()), HF_631GS_NAO_CART, 0.0)
}

test "hf_631gs sph one-electron integrals are symmetric with a unit overlap diagonal" {
    assert_near(hf_631gs_asym(hf_631gs_s_sph(), 16), 0.0, 1.0e-14)
    assert_near(hf_631gs_asym(hf_631gs_t_sph(), 16), 0.0, 1.0e-14)
    assert_near(hf_631gs_asym(hf_631gs_v_sph(), 16), 0.0, 1.0e-14)
    assert_near(hf_631gs_diag_dev(hf_631gs_s_sph(), 16), 0.0, 1.0e-14)
}

test "hf_631gs sph sampled ERIs obey the Schwarz bound" {
    assert_near(len(hf_631gs_eri8_sph_idx()), 256.0, 0.0)
    assert_near(len(hf_631gs_eri8_sph_diag()), 136.0, 0.0)
    assert_lt(hf_631gs_sample_schwarz(hf_631gs_eri8_sph_idx(), hf_631gs_eri8_sph_val(), hf_631gs_eri8_sph_diag()), 1.0e-12)
    assert_lt(0.0, HF_631GS_ERI8_SPH_SUMSQ)
}

test "hf_631gs unit one-electron integrals are symmetric with a unit overlap diagonal" {
    assert_near(hf_631gs_asym(hf_631gs_s_unit(), 17), 0.0, 1.0e-14)
    assert_near(hf_631gs_asym(hf_631gs_t_unit(), 17), 0.0, 1.0e-14)
    assert_near(hf_631gs_asym(hf_631gs_v_unit(), 17), 0.0, 1.0e-14)
    assert_near(hf_631gs_diag_dev(hf_631gs_s_unit(), 17), 0.0, 1.0e-14)
}

test "hf_631gs unit packed ERIs match their checksums and the Schwarz bound" {
    assert_near(len(hf_631gs_eri8_cart()), HF_631GS_ERI8_CART_LEN, 0.0)
    assert_near(hf_631gs_sumsq(hf_631gs_eri8_cart()) / HF_631GS_ERI8_CART_SUMSQ, 1.0, 1.0e-12)
    assert_near(hf_631gs_wsum(hf_631gs_eri8_cart(), HF_631GS_SEED_WSUM), HF_631GS_ERI8_CART_WSUM, 1.0e-12 * HF_631GS_ERI8_CART_SUMSQ)
    assert_lt(hf_631gs_schwarz(hf_631gs_eri8_cart(), 17), 1.0e-12)
}

test "hf_631gs sph ERIs from M^4 of the Cartesian set match PySCF's checksums, diagonal and samples" {
    hf_631gs_g = hf_631gs_eri8_sph()
    assert_near(len(hf_631gs_g), HF_631GS_ERI8_SPH_LEN, 0.0)
    assert_near(hf_631gs_sumsq(hf_631gs_g) / HF_631GS_ERI8_SPH_SUMSQ, 1.0, 1.0e-12)
    assert_near(hf_631gs_wsum(hf_631gs_g, HF_631GS_SEED_WSUM), HF_631GS_ERI8_SPH_WSUM, 1.0e-12 * HF_631GS_ERI8_SPH_SUMSQ)
    assert_lt(hf_631gs_sample_dev(hf_631gs_g, hf_631gs_eri8_sph_idx(), hf_631gs_eri8_sph_val()), 1.0e-13)
    assert_lt(hf_631gs_schwarz(hf_631gs_g, 16), 1.0e-12)
    # the pair diagonal (ij|ij) sits at ij(ij+1)/2 + ij
    hf_631gs_gd = hf_631gs_eri8_sph_diag()
    hf_631gs_w = 0.0
    for hf_631gs_a to len(hf_631gs_gd) {
        hf_631gs_w = max(hf_631gs_w, abs(hf_631gs_g[hf_631gs_a * (hf_631gs_a + 1) / 2 + hf_631gs_a] - hf_631gs_gd[hf_631gs_a]))
    }
    assert_lt(hf_631gs_w, 1.0e-13)
}

test "hf_631gs M^T X_unit M is the spherical X" {
    assert_lt(hf_631gs_mtxm_dev(hf_631gs_m(), hf_631gs_s_unit(), hf_631gs_s_sph(), 17, 16), 1.0e-13)
    assert_lt(hf_631gs_mtxm_dev(hf_631gs_m(), hf_631gs_t_unit(), hf_631gs_t_sph(), 17, 16), 1.0e-13)
    assert_lt(hf_631gs_mtxm_dev(hf_631gs_m(), hf_631gs_v_unit(), hf_631gs_v_sph(), 17, 16), 1.0e-13)
}

test "hf_631gs rhf energies, labels and densities" {
    assert_lt(HF_631GS_E_RHF_STABLE, HF_631GS_E_RHF_DEFAULT + 1.0e-12)
    assert_lt(HF_631GS_RHF_SELF_STEP, 1.0e-10)
    assert_near(hf_631gs_asym(hf_631gs_rhf_d(), 16), 0.0, 1.0e-12)
    assert_near(hf_631gs_trace2(hf_631gs_rhf_d(), hf_631gs_s_sph(), 16), 10.0, 1.0e-10)
    assert_near(hf_631gs_e_elec(hf_631gs_t_sph() + hf_631gs_v_sph(), hf_631gs_eri8_sph(), hf_631gs_rhf_d() * 0.5, hf_631gs_rhf_d() * 0.5, 16) + HF_631GS_E_NUC, HF_631GS_E_RHF_DEFAULT, 1.0e-10)
}

test "hf_631gs rhf cart energies, labels and densities" {
    assert_lt(HF_631GS_E_RHF_STABLE_CART, HF_631GS_E_RHF_DEFAULT_CART + 1.0e-12)
    assert_lt(HF_631GS_RHF_SELF_STEP_CART, 1.0e-10)
    assert_near(hf_631gs_asym(hf_631gs_rhf_d_cart(), 17), 0.0, 1.0e-12)
    assert_near(hf_631gs_trace2(hf_631gs_rhf_d_cart(), hf_631gs_s_unit(), 17), 10.0, 1.0e-10)
    assert_near(hf_631gs_e_elec(hf_631gs_t_unit() + hf_631gs_v_unit(), hf_631gs_eri8_cart(), hf_631gs_rhf_d_cart() * 0.5, hf_631gs_rhf_d_cart() * 0.5, 17) + HF_631GS_E_NUC, HF_631GS_E_RHF_DEFAULT_CART, 1.0e-10)
}
