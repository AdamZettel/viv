        0.008042329883007607, -0.026510224697067236, -0.009980268388503442, 0.07610587528597651,
        0.03942393304181709]
}

def water631gs_cart_rhf_d() -> Arr {
    return water631gs_cart_mat(water631gs_cart_rhf_d_flat(), 19, 19)
}

test "water631gs_cart packs" {
    assert_near(water631gs_cart_pack_bad(water631gs_cart_shells(), WATER631GS_CART_NSH, WATER631GS_CART_NPRIMTOT, WATER631GS_CART_NATOM), 0.0, 0.0)
    # nao_cart - nao_sph = sum over shells of ncart - nsph: 1 per d shell, 3 per f shell
    assert_near(WATER631GS_CART_NAO_CART - WATER631GS_CART_NAO_SPH, 1.0, 0.0)
    assert_near(len(water631gs_cart_fc()), WATER631GS_CART_NAO_CART, 0.0)
}

test "water631gs_cart unit one-electron integrals are symmetric with a unit overlap diagonal" {
    assert_near(water631gs_cart_asym(water631gs_cart_s_unit(), 19), 0.0, 1.0e-14)
    assert_near(water631gs_cart_asym(water631gs_cart_t_unit(), 19), 0.0, 1.0e-14)
    assert_near(water631gs_cart_asym(water631gs_cart_v_unit(), 19), 0.0, 1.0e-14)
    assert_near(water631gs_cart_diag_dev(water631gs_cart_s_unit(), 19), 0.0, 1.0e-14)
}

test "water631gs_cart unit packed ERIs match their checksums and the Schwarz bound" {
    assert_near(len(water631gs_cart_eri8_cart()), WATER631GS_CART_ERI8_CART_LEN, 0.0)
    assert_near(water631gs_cart_sumsq(water631gs_cart_eri8_cart()) / WATER631GS_CART_ERI8_CART_SUMSQ, 1.0, 1.0e-12)
    assert_near(water631gs_cart_wsum(water631gs_cart_eri8_cart(), WATER631GS_CART_SEED_WSUM), WATER631GS_CART_ERI8_CART_WSUM, 1.0e-12 * WATER631GS_CART_ERI8_CART_SUMSQ)
    assert_lt(water631gs_cart_schwarz(water631gs_cart_eri8_cart(), 19), 1.0e-12)
}

test "water631gs_cart rhf energies, labels and densities" {
    assert_lt(WATER631GS_CART_E_RHF_STABLE, WATER631GS_CART_E_RHF_DEFAULT + 1.0e-12)
    assert_lt(WATER631GS_CART_RHF_SELF_STEP, 1.0e-10)
    assert_near(water631gs_cart_asym(water631gs_cart_rhf_d(), 19), 0.0, 1.0e-12)
    assert_near(water631gs_cart_trace2(water631gs_cart_rhf_d(), water631gs_cart_s_unit(), 19), 10.0, 1.0e-10)
    assert_near(water631gs_cart_e_elec(water631gs_cart_t_unit() + water631gs_cart_v_unit(), water631gs_cart_eri8_cart(), water631gs_cart_rhf_d() * 0.5, water631gs_cart_rhf_d() * 0.5, 19) + WATER631GS_CART_E_NUC, WATER631GS_CART_E_RHF_DEFAULT, 1.0e-10)
}
