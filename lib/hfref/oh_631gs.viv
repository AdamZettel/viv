def oh_631gs_rohf_db_cart() -> Arr {
    return oh_631gs_mat(oh_631gs_rohf_db_cart_flat(), 17, 17)
}

test "oh_631gs packs" {
    assert_near(oh_631gs_pack_bad(oh_631gs_shells(), OH_631GS_NSH, OH_631GS_NPRIMTOT, OH_631GS_NATOM), 0.0, 0.0)
    # nao_cart - nao_sph = sum over shells of ncart - nsph: 1 per d shell, 3 per f shell
    assert_near(OH_631GS_NAO_CART - OH_631GS_NAO_SPH, 1.0, 0.0)
    assert_near(len(oh_631gs_fc()), OH_631GS_NAO_CART, 0.0)
}

test "oh_631gs sph one-electron integrals are symmetric with a unit overlap diagonal" {
    assert_near(oh_631gs_asym(oh_631gs_s_sph(), 16), 0.0, 1.0e-14)
    assert_near(oh_631gs_asym(oh_631gs_t_sph(), 16), 0.0, 1.0e-14)
    assert_near(oh_631gs_asym(oh_631gs_v_sph(), 16), 0.0, 1.0e-14)
    assert_near(oh_631gs_diag_dev(oh_631gs_s_sph(), 16), 0.0, 1.0e-14)
}

test "oh_631gs sph sampled ERIs obey the Schwarz bound" {
    assert_near(len(oh_631gs_eri8_sph_idx()), 256.0, 0.0)
    assert_near(len(oh_631gs_eri8_sph_diag()), 136.0, 0.0)
    assert_lt(oh_631gs_sample_schwarz(oh_631gs_eri8_sph_idx(), oh_631gs_eri8_sph_val(), oh_631gs_eri8_sph_diag()), 1.0e-12)
    assert_lt(0.0, OH_631GS_ERI8_SPH_SUMSQ)
}

test "oh_631gs unit one-electron integrals are symmetric with a unit overlap diagonal" {
    assert_near(oh_631gs_asym(oh_631gs_s_unit(), 17), 0.0, 1.0e-14)
    assert_near(oh_631gs_asym(oh_631gs_t_unit(), 17), 0.0, 1.0e-14)
    assert_near(oh_631gs_asym(oh_631gs_v_unit(), 17), 0.0, 1.0e-14)
    assert_near(oh_631gs_diag_dev(oh_631gs_s_unit(), 17), 0.0, 1.0e-14)
}

test "oh_631gs unit packed ERIs match their checksums and the Schwarz bound" {
    assert_near(len(oh_631gs_eri8_cart()), OH_631GS_ERI8_CART_LEN, 0.0)
    assert_near(oh_631gs_sumsq(oh_631gs_eri8_cart()) / OH_631GS_ERI8_CART_SUMSQ, 1.0, 1.0e-12)
    assert_near(oh_631gs_wsum(oh_631gs_eri8_cart(), OH_631GS_SEED_WSUM), OH_631GS_ERI8_CART_WSUM, 1.0e-12 * OH_631GS_ERI8_CART_SUMSQ)
    assert_lt(oh_631gs_schwarz(oh_631gs_eri8_cart(), 17), 1.0e-12)
}

test "oh_631gs sph ERIs from M^4 of the Cartesian set match PySCF's checksums, diagonal and samples" {
    oh_631gs_g = oh_631gs_eri8_sph()
    assert_near(len(oh_631gs_g), OH_631GS_ERI8_SPH_LEN, 0.0)
    assert_near(oh_631gs_sumsq(oh_631gs_g) / OH_631GS_ERI8_SPH_SUMSQ, 1.0, 1.0e-12)
    assert_near(oh_631gs_wsum(oh_631gs_g, OH_631GS_SEED_WSUM), OH_631GS_ERI8_SPH_WSUM, 1.0e-12 * OH_631GS_ERI8_SPH_SUMSQ)
    assert_lt(oh_631gs_sample_dev(oh_631gs_g, oh_631gs_eri8_sph_idx(), oh_631gs_eri8_sph_val()), 1.0e-13)
    assert_lt(oh_631gs_schwarz(oh_631gs_g, 16), 1.0e-12)
    # the pair diagonal (ij|ij) sits at ij(ij+1)/2 + ij
    oh_631gs_gd = oh_631gs_eri8_sph_diag()
    oh_631gs_w = 0.0
    for oh_631gs_a to len(oh_631gs_gd) {
        oh_631gs_w = max(oh_631gs_w, abs(oh_631gs_g[oh_631gs_a * (oh_631gs_a + 1) / 2 + oh_631gs_a] - oh_631gs_gd[oh_631gs_a]))
    }
    assert_lt(oh_631gs_w, 1.0e-13)
}

test "oh_631gs M^T X_unit M is the spherical X" {
    assert_lt(oh_631gs_mtxm_dev(oh_631gs_m(), oh_631gs_s_unit(), oh_631gs_s_sph(), 17, 16), 1.0e-13)
    assert_lt(oh_631gs_mtxm_dev(oh_631gs_m(), oh_631gs_t_unit(), oh_631gs_t_sph(), 17, 16), 1.0e-13)
    assert_lt(oh_631gs_mtxm_dev(oh_631gs_m(), oh_631gs_v_unit(), oh_631gs_v_sph(), 17, 16), 1.0e-13)
}

test "oh_631gs uhf energies, labels and densities" {
    assert_lt(OH_631GS_E_UHF_STABLE, OH_631GS_E_UHF_DEFAULT + 1.0e-12)
    assert_lt(0.75 - 1.0e-10, OH_631GS_UHF_S2)
    assert_lt(0.75 - 1.0e-10, OH_631GS_UHF_S2_STABLE)
    assert_lt(OH_631GS_UHF_SELF_STEP, 1.0e-10)
    assert_near(oh_631gs_asym(oh_631gs_uhf_da(), 16) + oh_631gs_asym(oh_631gs_uhf_db(), 16), 0.0, 1.0e-12)
    assert_near(oh_631gs_trace2(oh_631gs_uhf_da(), oh_631gs_s_sph(), 16) + oh_631gs_trace2(oh_631gs_uhf_db(), oh_631gs_s_sph(), 16), 9.0, 1.0e-10)
    assert_near(oh_631gs_e_elec(oh_631gs_t_sph() + oh_631gs_v_sph(), oh_631gs_eri8_sph(), oh_631gs_uhf_da(), oh_631gs_uhf_db(), 16) + OH_631GS_E_NUC, OH_631GS_E_UHF_DEFAULT, 1.0e-10)
}

test "oh_631gs uhf cart energies, labels and densities" {
    assert_lt(OH_631GS_E_UHF_STABLE_CART, OH_631GS_E_UHF_DEFAULT_CART + 1.0e-12)
    assert_lt(0.75 - 1.0e-10, OH_631GS_UHF_S2_CART)
    assert_lt(0.75 - 1.0e-10, OH_631GS_UHF_S2_STABLE_CART)
    assert_lt(OH_631GS_UHF_SELF_STEP_CART, 1.0e-10)
    assert_near(oh_631gs_asym(oh_631gs_uhf_da_cart(), 17) + oh_631gs_asym(oh_631gs_uhf_db_cart(), 17), 0.0, 1.0e-12)
    assert_near(oh_631gs_trace2(oh_631gs_uhf_da_cart(), oh_631gs_s_unit(), 17) + oh_631gs_trace2(oh_631gs_uhf_db_cart(), oh_631gs_s_unit(), 17), 9.0, 1.0e-10)
    assert_near(oh_631gs_e_elec(oh_631gs_t_unit() + oh_631gs_v_unit(), oh_631gs_eri8_cart(), oh_631gs_uhf_da_cart(), oh_631gs_uhf_db_cart(), 17) + OH_631GS_E_NUC, OH_631GS_E_UHF_DEFAULT_CART, 1.0e-10)
}

test "oh_631gs rohf energies, labels and densities" {
    assert_lt(OH_631GS_E_ROHF_STABLE, OH_631GS_E_ROHF_DEFAULT + 1.0e-12)
    assert_lt(OH_631GS_ROHF_SELF_STEP, 1.0e-10)
    assert_near(oh_631gs_asym(oh_631gs_rohf_da(), 16) + oh_631gs_asym(oh_631gs_rohf_db(), 16), 0.0, 1.0e-12)
    assert_near(oh_631gs_trace2(oh_631gs_rohf_da(), oh_631gs_s_sph(), 16) + oh_631gs_trace2(oh_631gs_rohf_db(), oh_631gs_s_sph(), 16), 9.0, 1.0e-10)
    assert_near(oh_631gs_e_elec(oh_631gs_t_sph() + oh_631gs_v_sph(), oh_631gs_eri8_sph(), oh_631gs_rohf_da(), oh_631gs_rohf_db(), 16) + OH_631GS_E_NUC, OH_631GS_E_ROHF_DEFAULT, 1.0e-10)
}

test "oh_631gs rohf cart energies, labels and densities" {
    assert_lt(OH_631GS_E_ROHF_STABLE_CART, OH_631GS_E_ROHF_DEFAULT_CART + 1.0e-12)
    assert_lt(OH_631GS_ROHF_SELF_STEP_CART, 1.0e-10)
    assert_near(oh_631gs_asym(oh_631gs_rohf_da_cart(), 17) + oh_631gs_asym(oh_631gs_rohf_db_cart(), 17), 0.0, 1.0e-12)
    assert_near(oh_631gs_trace2(oh_631gs_rohf_da_cart(), oh_631gs_s_unit(), 17) + oh_631gs_trace2(oh_631gs_rohf_db_cart(), oh_631gs_s_unit(), 17), 9.0, 1.0e-10)
    assert_near(oh_631gs_e_elec(oh_631gs_t_unit() + oh_631gs_v_unit(), oh_631gs_eri8_cart(), oh_631gs_rohf_da_cart(), oh_631gs_rohf_db_cart(), 17) + OH_631GS_E_NUC, OH_631GS_E_ROHF_DEFAULT_CART, 1.0e-10)
}

test "oh_631gs E_uhf <= E_rohf" {
    assert_lt(OH_631GS_E_UHF_DEFAULT, OH_631GS_E_ROHF_DEFAULT + 1.0e-12)
    assert_lt(OH_631GS_E_UHF_STABLE, OH_631GS_E_ROHF_STABLE + 1.0e-12)
    assert_lt(OH_631GS_E_UHF_DEFAULT_CART, OH_631GS_E_ROHF_DEFAULT_CART + 1.0e-12)
    assert_lt(OH_631GS_E_UHF_STABLE_CART, OH_631GS_E_ROHF_STABLE_CART + 1.0e-12)
}
