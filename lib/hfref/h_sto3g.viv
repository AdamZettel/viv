###
post: One hydrogen atom, one electron
agent: claude

Generated by `tools/hf_reference.py` from PySCF 2.5.0. Do not edit; rerun the
generator. Settings: conv_tol 1e-12, init_guess minao, symmetry off, and each
molecule built with cart=False and with cart=True. Every stored density is
then re-converged from itself at conv_tol_grad 1e-10 or tighter, and its
`_SELF_STEP` constant says how far one PySCF step moves it (below 1e-10).

Conventions:

- atoms[natm,4] = (Z, x, y, z) in Bohr; shells[nsh,8] = (atom, l, nprim, p0,
  cart0, sph0, ncart, nsph); prims[nprim,2] = (exponent, raw bas_ctr_coeff).
  General contractions are split into segmented shells, and primitives whose
  coefficient is exactly zero are dropped.
- `_unit` matrices are unit-Cartesian: PySCF's Cartesian integrals divided by
  F_i F_j, so every component has self-overlap 1. `_sph` matrices are PySCF's
  spherical ones, and `_m()` is M with X_sph = M^T X_unit M.
- Packed-8 ERIs in chemist's notation: ij = i(i+1)/2 + j for i >= j, and
  ijkl = ij(ij+1)/2 + kl for ij >= kl. Full when the basis has at most 19
  functions; otherwise the pair diagonal and 256 seeded samples. Both carry
  _SUMSQ = sum Gp^2 and _WSUM = sum w_k Gp_k, where w_k = s_k / (2^31 - 1),
  s_k = 16807 s_(k-1) mod (2^31 - 1) and s_0 = the module's _SEED_WSUM (20260923).
- Energies: `_E_<CFG>_DEFAULT` is the state PySCF reaches from the minao
  guess, `_E_<CFG>_STABLE` the lowest state reached by restarting from the
  stability-analysis orbitals until the energy stops dropping, and `_E_<CFG>`
  repeats the default. Densities (total for RHF, alpha and beta otherwise) are
  in the same basis convention as the matrices beside them: a unit-Cartesian
  density is F_i F_j times PySCF's. A `_stable_` density appears only when the
  stable state differs from the default.
- In a module with both bases, spherical names carry no suffix and Cartesian
  ones end in `_cart` / `_CART`.
###

# Seed of the LCG weights in every _WSUM checksum.
H_STO3G_SEED_WSUM = 20260923

# ---- helpers for the tests below ----

#| Reshape a flat row-major vector into r x c.
def h_sto3g_mat(v: Arr, r, c) -> Arr {
    a = zeros(r, c)
    for i to r {
        for j to c {
            a[i, j] = v[i * c + j]
        }
    }
    return a
}

def h_sto3g_eye(n) -> Arr {
    a = zeros(n, n)
    for i to n {
        a[i, i] = 1.0
    }
    return a
}

#| Largest |A_ij - A_ji| / (1 + |A_ij|): a kinetic entry near 100 carries
#| rounding of about 1e-14, so the gap is measured relative to the entry.
def h_sto3g_asym(a: Arr, n) {
    w = 0.0
    for i to n {
        for j to n {
            w = max(w, abs(a[i, j] - a[j, i]) / (1.0 + abs(a[i, j])))
        }
    }
    return w
}

#| Largest |A_ii - 1|.
def h_sto3g_diag_dev(a: Arr, n) {
    w = 0.0
    for i to n {
        w = max(w, abs(a[i, i] - 1.0))
    }
    return w
}

#| sum_ij A_ij B_ij: Tr(D S) is the electron count.
def h_sto3g_trace2(a: Arr, b: Arr, n) {
    t = 0.0
    for i to n {
        for j to n {
            t = t + a[i, j] * b[i, j]
        }
    }
    return t
}

#| pr[i, j] = the packed pair index of (i, j), in either order.
def h_sto3g_pair_table(n) -> Arr {
    pr = zeros(n, n)
    for i to n {
        for j to i + 1 {
            pr[i, j] = i * (i + 1) / 2 + j
            pr[j, i] = pr[i, j]
        }
    }
    return pr
}

#| One- plus two-electron energy from spin densities and packed (ij|kl):
#| sum Dt h + 1/2 sum (ij|kl) [Dt_ij Dt_kl - Da_ik Da_jl - Db_ik Db_jl].
#| For RHF pass Da = Db = D/2. Written over all n^4 quartets because it is
#| a check, not a J/K build.
def h_sto3g_e_elec(h: Arr, g: Arr, da: Arr, db: Arr, n) {
    pr = h_sto3g_pair_table(n)
    e = 0.0
    for i to n {
        for j to n {
            e = e + (da[i, j] + db[i, j]) * h[i, j]
        }
    }
    e2 = 0.0
    for i to n {
        for j to n {
            pij = pr[i, j]
            dij = da[i, j] + db[i, j]
            for k to n {
                for l to n {
                    pkl = pr[k, l]
                    a = max(pij, pkl)
                    b = min(pij, pkl)
                    x = g[a * (a + 1) / 2 + b]
                    e2 = e2 + x * (dij * (da[k, l] + db[k, l]) - da[i, k] * da[j, l] - db[i, k] * db[j, l])
                }
            }
        }
    }
    return e + 0.5 * e2
}

def h_sto3g_sumsq(g: Arr) {
    t = 0.0
    for k to len(g) {
        t = t + g[k] * g[k]
    }
    return t
}

#| sum_k w_k g_k with w_k = s_k / (2^31 - 1), s_k = 16807 s_(k-1) mod (2^31 - 1),
#| s_0 = seed. Every product stays below 2^53, so the weights are exact.
def h_sto3g_wsum(g: Arr, seed) {
    s = seed
    t = 0.0
    for k to len(g) {
        s = mod(16807.0 * s, 2147483647.0)
        t = t + s / 2147483647.0 * g[k]
    }
    return t
}

#| Largest (ij|kl)^2 - (ij|ij)(kl|kl) over the packed set, relative to the
#| bound. Cauchy-Schwarz says it is at most 0.
def h_sto3g_schwarz(g: Arr, n) {
    npair = n * (n + 1) / 2
    w = -1.0
    for a to npair {
        for b to a + 1 {
            x = g[a * (a + 1) / 2 + b]
            q = g[a * (a + 1) / 2 + a] * g[b * (b + 1) / 2 + b]
            w = max(w, (x * x - q) / (q + 1.0e-300))
        }
    }
    return w
}

#| The same bound on sampled entries, with the pair diagonal given.
def h_sto3g_sample_schwarz(idx: Arr, val: Arr, gd: Arr) {
    w = -1.0
    for k to len(idx) {
        a = floor((sqrt(8.0 * idx[k] + 1.0) - 1.0) / 2.0)
        if a * (a + 1) / 2 > idx[k] {
            a = a - 1
        }
        if (a + 1) * (a + 2) / 2 <= idx[k] {
            a = a + 1
        }
        b = idx[k] - a * (a + 1) / 2
        q = gd[a] * gd[b]
        w = max(w, (val[k] * val[k] - q) / (q + 1.0e-300))
    }
    return w
}

#| Largest |M^T X M - Y|.
def h_sto3g_mtxm_dev(m: Arr, x: Arr, y: Arr, nc, ns) {
    w = 0.0
    for a to ns {
        for b to ns {
            t = 0.0
            for i to nc {
                for j to nc {
                    t = t + m[i, a] * x[i, j] * m[j, b]
                }
            }
            w = max(w, abs(t - y[a, b]))
        }
    }
    return w
}

#| Count what is wrong with a shells pack: offsets that do not run on, a
#| component count that does not match l, a primitive range out of bounds.
def h_sto3g_pack_bad(sh: Arr, nsh, nprim, natm) {
    bad = 0
    p0 = 0
    c0 = 0
    s0 = 0
    for k to nsh {
        l = sh[k, 1]
        if sh[k, 0] < 0 or sh[k, 0] >= natm {
            bad = bad + 1
        }
        if sh[k, 3] != p0 or sh[k, 4] != c0 or sh[k, 5] != s0 {
            bad = bad + 1
        }
        if sh[k, 6] != (l + 1) * (l + 2) / 2 or sh[k, 7] != 2 * l + 1 {
            bad = bad + 1
        }
        p0 = p0 + sh[k, 2]
        c0 = c0 + sh[k, 6]
        s0 = s0 + sh[k, 7]
    }
    if p0 != nprim {
        bad = bad + 1
    }
    return bad
}

# ======== H_STO3G: sto-3g, s and p only, so Cartesian = spherical ========

H_STO3G_NATOM = 1
H_STO3G_NSH = 1
H_STO3G_NPRIMTOT = 3
H_STO3G_NAO_CART = 1
H_STO3G_NAO_SPH = 1
H_STO3G_E_NUC = 0.0

#| (Z, x, y, z) in Bohr, one atom per row.
def h_sto3g_atoms_flat() -> Arr {
    return [1.0, 0.0, 0.0, 0.0]
}

def h_sto3g_atoms() -> Arr {
    return h_sto3g_mat(h_sto3g_atoms_flat(), 1, 4)
}

#| (atom, l, nprim, p0, cart0, sph0, ncart, nsph); general contractions split.
def h_sto3g_shells_flat() -> Arr {
    return [0, 0, 3, 0,
        0, 0, 1, 1]
}

def h_sto3g_shells() -> Arr {
    return h_sto3g_mat(h_sto3g_shells_flat(), 1, 8)
}

#| (exponent, raw bas_ctr_coeff).
def h_sto3g_prims_flat() -> Arr {
    return [3.42525091, 0.15432897070298393, 0.62391373, 0.5353281424384733,
        0.1688554, 0.44463454202535485]
}

def h_sto3g_prims() -> Arr {
    return h_sto3g_mat(h_sto3g_prims_flat(), 3, 2)
}

#| F per Cartesian AO: PySCF-Cartesian = F x unit-Cartesian.
def h_sto3g_fc() -> Arr {
    return [1.0]
}

#| Overlap, unit-Cartesian, [1,1].
def h_sto3g_s_unit_flat() -> Arr {
    return [1.0000000000000002]
}

def h_sto3g_s_unit() -> Arr {
    return h_sto3g_mat(h_sto3g_s_unit_flat(), 1, 1)
}

#| Kinetic energy, unit-Cartesian.
def h_sto3g_t_unit_flat() -> Arr {
    return [0.7600318835666091]
}

def h_sto3g_t_unit() -> Arr {
    return h_sto3g_mat(h_sto3g_t_unit_flat(), 1, 1)
}

#| Nuclear attraction, unit-Cartesian.
def h_sto3g_v_unit_flat() -> Arr {
    return [-1.2266137331238844]
}

def h_sto3g_v_unit() -> Arr {
    return h_sto3g_mat(h_sto3g_v_unit_flat(), 1, 1)
}

# Packed-8 length n(n+1)/2 (n(n+1)/2 + 1)/2 for n = 1.
H_STO3G_ERI8_CART_LEN = 1
# sum of Gp^2 (math.fsum).
H_STO3G_ERI8_CART_SUMSQ = 0.6000143683560358
# sum of w_k Gp_k with the LCG weights from H_STO3G_SEED_WSUM (math.fsum).
H_STO3G_ERI8_CART_WSUM = 0.44111092334176927
#| Every packed-8 two-electron integral, unit-Cartesian, chemist's notation.
def h_sto3g_eri8_cart() -> Arr {
    return [0.7746059439198978]
}

def h_sto3g_s_sph() -> Arr {
    return h_sto3g_s_unit()
}

def h_sto3g_t_sph() -> Arr {
    return h_sto3g_t_unit()
}

def h_sto3g_v_sph() -> Arr {
    return h_sto3g_v_unit()
}

#| Only s and p: the spherical and Cartesian sets are the same.
def h_sto3g_eri8_sph() -> Arr {
    return h_sto3g_eri8_cart()
}

def h_sto3g_m() -> Arr {
    return h_sto3g_eye(1)
}

# ---- H_STO3G UHF: nalpha 1, nbeta 0; default state is stable ----

H_STO3G_E_UHF = -0.46658184955727533
H_STO3G_E_UHF_DEFAULT = -0.46658184955727533
H_STO3G_E_UHF_STABLE = -0.46658184955727533
# 1: no restart from the stability orbitals lowers the minao state; 0: one does; -1: not analyzed (one electron: E is the lowest H_core level).
H_STO3G_UHF_IS_STABLE = 1
H_STO3G_UHF_NALPHA = 1
H_STO3G_UHF_NBETA = 0
# <S^2> of the default UHF state.
H_STO3G_UHF_S2 = 0.7500000000000002
H_STO3G_UHF_S2_STABLE = 0.7500000000000002

# Max |D' - D| after one PySCF step (get_fock, eig, get_occ, make_rdm1) from the default density below.
H_STO3G_UHF_SELF_STEP = 0.0
#| Converged alpha density, default state.
def h_sto3g_uhf_da_flat() -> Arr {
    return [1.0]
}

def h_sto3g_uhf_da() -> Arr {
    return h_sto3g_mat(h_sto3g_uhf_da_flat(), 1, 1)
}

#| Converged beta density, default state.
def h_sto3g_uhf_db_flat() -> Arr {
    return [0.0]
}

def h_sto3g_uhf_db() -> Arr {
    return h_sto3g_mat(h_sto3g_uhf_db_flat(), 1, 1)
}

# ---- H_STO3G ROHF: nalpha 1, nbeta 0; default state is stable ----

H_STO3G_E_ROHF = -0.46658184955727533
H_STO3G_E_ROHF_DEFAULT = -0.46658184955727533
H_STO3G_E_ROHF_STABLE = -0.46658184955727533
# 1: no restart from the stability orbitals lowers the minao state; 0: one does; -1: not analyzed (one electron: E is the lowest H_core level).
H_STO3G_ROHF_IS_STABLE = 1
H_STO3G_ROHF_NALPHA = 1
H_STO3G_ROHF_NBETA = 0

# Max |D' - D| after one PySCF step (get_fock, eig, get_occ, make_rdm1) from the default density below.
H_STO3G_ROHF_SELF_STEP = 0.0
#| Converged alpha density, default state.
def h_sto3g_rohf_da_flat() -> Arr {
    return [1.0]
}

def h_sto3g_rohf_da() -> Arr {
    return h_sto3g_mat(h_sto3g_rohf_da_flat(), 1, 1)
}

#| Converged beta density, default state.
def h_sto3g_rohf_db_flat() -> Arr {
    return [0.0]
}

def h_sto3g_rohf_db() -> Arr {
    return h_sto3g_mat(h_sto3g_rohf_db_flat(), 1, 1)
}

# ---- H_STO3G SPINM1_UHF: nalpha 0, nbeta 1; default state is stable ----

H_STO3G_E_SPINM1_UHF = -0.46658184955727533
H_STO3G_E_SPINM1_UHF_DEFAULT = -0.46658184955727533
H_STO3G_E_SPINM1_UHF_STABLE = -0.46658184955727533
# 1: no restart from the stability orbitals lowers the minao state; 0: one does; -1: not analyzed (one electron: E is the lowest H_core level).
H_STO3G_SPINM1_UHF_IS_STABLE = 1
H_STO3G_SPINM1_UHF_NALPHA = 0
H_STO3G_SPINM1_UHF_NBETA = 1
# <S^2> of the default UHF state.
H_STO3G_SPINM1_UHF_S2 = 0.7500000000000002
H_STO3G_SPINM1_UHF_S2_STABLE = 0.7500000000000002

# Max |D' - D| after one PySCF step (get_fock, eig, get_occ, make_rdm1) from the default density below.
H_STO3G_SPINM1_UHF_SELF_STEP = 0.0
#| Converged alpha density, default state.
def h_sto3g_spinm1_uhf_da_flat() -> Arr {
    return [0.0]
}

def h_sto3g_spinm1_uhf_da() -> Arr {
    return h_sto3g_mat(h_sto3g_spinm1_uhf_da_flat(), 1, 1)
