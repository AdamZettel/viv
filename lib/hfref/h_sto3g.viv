# Lowest eigenvalue of H_core C = S C e.
H_STO3G_EPS1E = -0.46658184955727533
test "h_sto3g packs" {
    assert_near(h_sto3g_pack_bad(h_sto3g_shells(), H_STO3G_NSH, H_STO3G_NPRIMTOT, H_STO3G_NATOM), 0.0, 0.0)
    # nao_cart - nao_sph = sum over shells of ncart - nsph: 1 per d shell, 3 per f shell
    assert_near(H_STO3G_NAO_CART - H_STO3G_NAO_SPH, 0.0, 0.0)
    assert_near(len(h_sto3g_fc()), H_STO3G_NAO_CART, 0.0)
}

test "h_sto3g unit one-electron integrals are symmetric with a unit overlap diagonal" {
    assert_near(h_sto3g_asym(h_sto3g_s_unit(), 1), 0.0, 1.0e-14)
    assert_near(h_sto3g_asym(h_sto3g_t_unit(), 1), 0.0, 1.0e-14)
    assert_near(h_sto3g_asym(h_sto3g_v_unit(), 1), 0.0, 1.0e-14)
    assert_near(h_sto3g_diag_dev(h_sto3g_s_unit(), 1), 0.0, 1.0e-14)
}

test "h_sto3g unit packed ERIs match their checksums and the Schwarz bound" {
    assert_near(len(h_sto3g_eri8_cart()), H_STO3G_ERI8_CART_LEN, 0.0)
    assert_near(h_sto3g_sumsq(h_sto3g_eri8_cart()) / H_STO3G_ERI8_CART_SUMSQ, 1.0, 1.0e-12)
    assert_near(h_sto3g_wsum(h_sto3g_eri8_cart(), H_STO3G_SEED_WSUM), H_STO3G_ERI8_CART_WSUM, 1.0e-12 * H_STO3G_ERI8_CART_SUMSQ)
    assert_lt(h_sto3g_schwarz(h_sto3g_eri8_cart(), 1), 1.0e-12)
}

test "h_sto3g uhf energies, labels and densities" {
    assert_lt(H_STO3G_E_UHF_STABLE, H_STO3G_E_UHF_DEFAULT + 1.0e-12)
    assert_lt(0.75 - 1.0e-10, H_STO3G_UHF_S2)
    assert_lt(0.75 - 1.0e-10, H_STO3G_UHF_S2_STABLE)
    assert_lt(H_STO3G_UHF_SELF_STEP, 1.0e-10)
    assert_near(h_sto3g_asym(h_sto3g_uhf_da(), 1) + h_sto3g_asym(h_sto3g_uhf_db(), 1), 0.0, 1.0e-12)
    assert_near(h_sto3g_trace2(h_sto3g_uhf_da(), h_sto3g_s_unit(), 1) + h_sto3g_trace2(h_sto3g_uhf_db(), h_sto3g_s_unit(), 1), 1.0, 1.0e-10)
    assert_near(h_sto3g_e_elec(h_sto3g_t_unit() + h_sto3g_v_unit(), h_sto3g_eri8_cart(), h_sto3g_uhf_da(), h_sto3g_uhf_db(), 1) + H_STO3G_E_NUC, H_STO3G_E_UHF_DEFAULT, 1.0e-10)
}

test "h_sto3g rohf energies, labels and densities" {
    assert_lt(H_STO3G_E_ROHF_STABLE, H_STO3G_E_ROHF_DEFAULT + 1.0e-12)
    assert_lt(H_STO3G_ROHF_SELF_STEP, 1.0e-10)
    assert_near(h_sto3g_asym(h_sto3g_rohf_da(), 1) + h_sto3g_asym(h_sto3g_rohf_db(), 1), 0.0, 1.0e-12)
    assert_near(h_sto3g_trace2(h_sto3g_rohf_da(), h_sto3g_s_unit(), 1) + h_sto3g_trace2(h_sto3g_rohf_db(), h_sto3g_s_unit(), 1), 1.0, 1.0e-10)
    assert_near(h_sto3g_e_elec(h_sto3g_t_unit() + h_sto3g_v_unit(), h_sto3g_eri8_cart(), h_sto3g_rohf_da(), h_sto3g_rohf_db(), 1) + H_STO3G_E_NUC, H_STO3G_E_ROHF_DEFAULT, 1.0e-10)
}

test "h_sto3g spinm1_uhf energies, labels and densities" {
    assert_lt(H_STO3G_E_SPINM1_UHF_STABLE, H_STO3G_E_SPINM1_UHF_DEFAULT + 1.0e-12)
    assert_lt(0.75 - 1.0e-10, H_STO3G_SPINM1_UHF_S2)
    assert_lt(0.75 - 1.0e-10, H_STO3G_SPINM1_UHF_S2_STABLE)
    assert_lt(H_STO3G_SPINM1_UHF_SELF_STEP, 1.0e-10)
    assert_near(h_sto3g_asym(h_sto3g_spinm1_uhf_da(), 1) + h_sto3g_asym(h_sto3g_spinm1_uhf_db(), 1), 0.0, 1.0e-12)
    assert_near(h_sto3g_trace2(h_sto3g_spinm1_uhf_da(), h_sto3g_s_unit(), 1) + h_sto3g_trace2(h_sto3g_spinm1_uhf_db(), h_sto3g_s_unit(), 1), 1.0, 1.0e-10)
    assert_near(h_sto3g_e_elec(h_sto3g_t_unit() + h_sto3g_v_unit(), h_sto3g_eri8_cart(), h_sto3g_spinm1_uhf_da(), h_sto3g_spinm1_uhf_db(), 1) + H_STO3G_E_NUC, H_STO3G_E_SPINM1_UHF_DEFAULT, 1.0e-10)
}

test "h_sto3g E_uhf <= E_rohf" {
    assert_lt(H_STO3G_E_UHF_DEFAULT, H_STO3G_E_ROHF_DEFAULT + 1.0e-12)
    assert_lt(H_STO3G_E_UHF_STABLE, H_STO3G_E_ROHF_STABLE + 1.0e-12)
}
