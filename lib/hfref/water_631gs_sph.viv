def water631gs_sph_rhf_d() -> Arr {
    return water631gs_sph_mat(water631gs_sph_rhf_d_flat(), 18, 18)
}

test "water631gs_sph packs" {
    assert_near(water631gs_sph_pack_bad(water631gs_sph_shells(), WATER631GS_SPH_NSH, WATER631GS_SPH_NPRIMTOT, WATER631GS_SPH_NATOM), 0.0, 0.0)
    # nao_cart - nao_sph = sum over shells of ncart - nsph: 1 per d shell, 3 per f shell
    assert_near(WATER631GS_SPH_NAO_CART - WATER631GS_SPH_NAO_SPH, 1.0, 0.0)
    assert_near(len(water631gs_sph_fc()), WATER631GS_SPH_NAO_CART, 0.0)
}

test "water631gs_sph sph one-electron integrals are symmetric with a unit overlap diagonal" {
    assert_near(water631gs_sph_asym(water631gs_sph_s_sph(), 18), 0.0, 1.0e-14)
    assert_near(water631gs_sph_asym(water631gs_sph_t_sph(), 18), 0.0, 1.0e-14)
    assert_near(water631gs_sph_asym(water631gs_sph_v_sph(), 18), 0.0, 1.0e-14)
    assert_near(water631gs_sph_diag_dev(water631gs_sph_s_sph(), 18), 0.0, 1.0e-14)
}

test "water631gs_sph sph packed ERIs match their checksums and the Schwarz bound" {
    assert_near(len(water631gs_sph_eri8_sph()), WATER631GS_SPH_ERI8_SPH_LEN, 0.0)
    assert_near(water631gs_sph_sumsq(water631gs_sph_eri8_sph()) / WATER631GS_SPH_ERI8_SPH_SUMSQ, 1.0, 1.0e-12)
    assert_near(water631gs_sph_wsum(water631gs_sph_eri8_sph(), WATER631GS_SPH_SEED_WSUM), WATER631GS_SPH_ERI8_SPH_WSUM, 1.0e-12 * WATER631GS_SPH_ERI8_SPH_SUMSQ)
    assert_lt(water631gs_sph_schwarz(water631gs_sph_eri8_sph(), 18), 1.0e-12)
}

test "water631gs_sph rhf energies, labels and densities" {
    assert_lt(WATER631GS_SPH_E_RHF_STABLE, WATER631GS_SPH_E_RHF_DEFAULT + 1.0e-12)
    assert_lt(WATER631GS_SPH_RHF_SELF_STEP, 1.0e-10)
    assert_near(water631gs_sph_asym(water631gs_sph_rhf_d(), 18), 0.0, 1.0e-12)
    assert_near(water631gs_sph_trace2(water631gs_sph_rhf_d(), water631gs_sph_s_sph(), 18), 10.0, 1.0e-10)
    assert_near(water631gs_sph_e_elec(water631gs_sph_t_sph() + water631gs_sph_v_sph(), water631gs_sph_eri8_sph(), water631gs_sph_rhf_d() * 0.5, water631gs_sph_rhf_d() * 0.5, 18) + WATER631GS_SPH_E_NUC, WATER631GS_SPH_E_RHF_DEFAULT, 1.0e-10)
}
