def h4_diffuse_s_sph() -> Arr {
    return h4_diffuse_s_unit()
}

def h4_diffuse_t_sph() -> Arr {
    return h4_diffuse_t_unit()
}

def h4_diffuse_v_sph() -> Arr {
    return h4_diffuse_v_unit()
}

#| Only s and p: the spherical and Cartesian sets are the same.
def h4_diffuse_eri8_sph() -> Arr {
    return h4_diffuse_eri8_cart()
}

def h4_diffuse_m() -> Arr {
    return h4_diffuse_eye(8)
}

# ---- H4_DIFFUSE RHF: nalpha 2, nbeta 2; default state not analyzed ----

H4_DIFFUSE_E_RHF = -1.6291001503056712
H4_DIFFUSE_E_RHF_DEFAULT = -1.6291001503056712
H4_DIFFUSE_E_RHF_STABLE = -1.6291001503056712
# 1: no restart from the stability orbitals lowers the minao state; 0: one does; -1: not analyzed (not analyzed: canonical orthogonalization drops a vector).
H4_DIFFUSE_RHF_IS_STABLE = -1
H4_DIFFUSE_RHF_NALPHA = 2
H4_DIFFUSE_RHF_NBETA = 2

# Max |D' - D| after one PySCF step (get_fock, eig, get_occ, make_rdm1) from the default density below.
H4_DIFFUSE_RHF_SELF_STEP = 5.819678072782608e-12
#| Converged total density (alpha + beta), default state.
def h4_diffuse_rhf_d_flat() -> Arr {
    return [0.8155210859839529, 0.5840386596523388, 0.6841708399667575, -0.53269449019856,
        -0.43004929974203854, -0.5589276325460679, -0.7192965925550897, 0.5054816383335906,
        0.5840386596523388, 6.17016176083301, 1.4671846872835166, -6.179379165500959,
        1.410155232512773, -6.180721863203361, 0.505481638234348, 6.166140953576964,
        0.6841708399667575, 1.4671846872835166, 0.7399988336768004, -1.4319232000191628,
        -0.06888324860052711, -1.4509674785090438, -0.4300492997420435, 1.4101552325348292,
        -0.53269449019856, -6.179379165500959, -1.4319232000191628, 6.192196816003629,
        -1.450967478624894, 6.19174843758623, -0.5589276324991996, -6.180721863784839,
        -0.43004929974203854, 1.410155232512773, -0.06888324860052711, -1.450967478624894,
        0.7399988336767482, -1.4319231997214124, 0.6841708399667408, 1.467184687123363,
        -0.5589276325460679, -6.180721863203361, -1.4509674785090438, 6.19174843758623,
        -1.4319231997214124, 6.192196814231214, -0.5326944899950794, -6.179379164313451,
        -0.7192965925550897, 0.505481638234348, -0.4300492997420435, -0.5589276324991996,
        0.6841708399667408, -0.5326944899950794, 0.8155210859839557, 0.5840386595008056,
        0.5054816383335906, 6.166140953576964, 1.4101552325348292, -6.180721863784839,
        1.467184687123363, -6.179379164313451, 0.5840386595008056, 6.170161760228101]
}

def h4_diffuse_rhf_d() -> Arr {
    return h4_diffuse_mat(h4_diffuse_rhf_d_flat(), 8, 8)
}

# Smallest overlap eigenvalue: below the 1e-8 threshold.
H4_DIFFUSE_S_MIN_EIG = 1.7058645923594027e-09
# Vectors canonical orthogonalization drops at threshold 1e-8.
H4_DIFFUSE_NDROP = 1
test "h4_diffuse packs" {
    assert_near(h4_diffuse_pack_bad(h4_diffuse_shells(), H4_DIFFUSE_NSH, H4_DIFFUSE_NPRIMTOT, H4_DIFFUSE_NATOM), 0.0, 0.0)
    # nao_cart - nao_sph = sum over shells of ncart - nsph: 1 per d shell, 3 per f shell
    assert_near(H4_DIFFUSE_NAO_CART - H4_DIFFUSE_NAO_SPH, 0.0, 0.0)
    assert_near(len(h4_diffuse_fc()), H4_DIFFUSE_NAO_CART, 0.0)
}

test "h4_diffuse unit one-electron integrals are symmetric with a unit overlap diagonal" {
    assert_near(h4_diffuse_asym(h4_diffuse_s_unit(), 8), 0.0, 1.0e-14)
    assert_near(h4_diffuse_asym(h4_diffuse_t_unit(), 8), 0.0, 1.0e-14)
    assert_near(h4_diffuse_asym(h4_diffuse_v_unit(), 8), 0.0, 1.0e-14)
    assert_near(h4_diffuse_diag_dev(h4_diffuse_s_unit(), 8), 0.0, 1.0e-14)
}

test "h4_diffuse unit packed ERIs match their checksums and the Schwarz bound" {
    assert_near(len(h4_diffuse_eri8_cart()), H4_DIFFUSE_ERI8_CART_LEN, 0.0)
    assert_near(h4_diffuse_sumsq(h4_diffuse_eri8_cart()) / H4_DIFFUSE_ERI8_CART_SUMSQ, 1.0, 1.0e-12)
    assert_near(h4_diffuse_wsum(h4_diffuse_eri8_cart(), H4_DIFFUSE_SEED_WSUM), H4_DIFFUSE_ERI8_CART_WSUM, 1.0e-12 * H4_DIFFUSE_ERI8_CART_SUMSQ)
    assert_lt(h4_diffuse_schwarz(h4_diffuse_eri8_cart(), 8), 1.0e-12)
}

test "h4_diffuse rhf energies, labels and densities" {
    assert_lt(H4_DIFFUSE_E_RHF_STABLE, H4_DIFFUSE_E_RHF_DEFAULT + 1.0e-12)
    assert_lt(H4_DIFFUSE_RHF_SELF_STEP, 1.0e-10)
    assert_near(h4_diffuse_asym(h4_diffuse_rhf_d(), 8), 0.0, 1.0e-12)
    assert_near(h4_diffuse_trace2(h4_diffuse_rhf_d(), h4_diffuse_s_unit(), 8), 4.0, 1.0e-10)
    assert_near(h4_diffuse_e_elec(h4_diffuse_t_unit() + h4_diffuse_v_unit(), h4_diffuse_eri8_cart(), h4_diffuse_rhf_d() * 0.5, h4_diffuse_rhf_d() * 0.5, 8) + H4_DIFFUSE_E_NUC, H4_DIFFUSE_E_RHF_DEFAULT, 1.0e-10)
}
