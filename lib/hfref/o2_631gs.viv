def o2_631gs_m() -> Arr {
    return o2_631gs_mat(o2_631gs_m_flat(), 30, 28)
}

# ---- O2_631GS UHF: nalpha 9, nbeta 7; default state is stable ----

O2_631GS_E_UHF = -149.61231729065165
O2_631GS_E_UHF_DEFAULT = -149.61231729065165
O2_631GS_E_UHF_STABLE = -149.61231729065165
# 1: no restart from the stability orbitals lowers the minao state; 0: one does; -1: not analyzed (stability restart).
O2_631GS_UHF_IS_STABLE = 1
O2_631GS_UHF_NALPHA = 9
O2_631GS_UHF_NBETA = 7
# <S^2> of the default UHF state.
O2_631GS_UHF_S2 = 2.03459426287655
O2_631GS_UHF_S2_STABLE = 2.03459426287655

# ---- O2_631GS UHF (cart): nalpha 9, nbeta 7; default state is stable ----

O2_631GS_E_UHF_CART = -149.6147866845606
O2_631GS_E_UHF_DEFAULT_CART = -149.6147866845606
O2_631GS_E_UHF_STABLE_CART = -149.6147866845606
# 1: no restart from the stability orbitals lowers the minao state; 0: one does; -1: not analyzed (stability restart).
O2_631GS_UHF_IS_STABLE_CART = 1
O2_631GS_UHF_NALPHA_CART = 9
O2_631GS_UHF_NBETA_CART = 7
# <S^2> of the default UHF state.
O2_631GS_UHF_S2_CART = 2.0346909055958804
O2_631GS_UHF_S2_STABLE_CART = 2.0346909055958804

# ---- O2_631GS ROHF: nalpha 9, nbeta 7; default state is not the lowest ----

O2_631GS_E_ROHF = -149.59185715618136
O2_631GS_E_ROHF_DEFAULT = -149.59185715618136
O2_631GS_E_ROHF_STABLE = -149.59202183229573
# 1: no restart from the stability orbitals lowers the minao state; 0: one does; -1: not analyzed (stability restart).
O2_631GS_ROHF_IS_STABLE = 0
O2_631GS_ROHF_NALPHA = 9
O2_631GS_ROHF_NBETA = 7

# ---- O2_631GS ROHF (cart): nalpha 9, nbeta 7; default state is not the lowest ----

O2_631GS_E_ROHF_CART = -149.5942826713319
O2_631GS_E_ROHF_DEFAULT_CART = -149.5942826713319
O2_631GS_E_ROHF_STABLE_CART = -149.5944658973972
# 1: no restart from the stability orbitals lowers the minao state; 0: one does; -1: not analyzed (stability restart).
O2_631GS_ROHF_IS_STABLE_CART = 0
O2_631GS_ROHF_NALPHA_CART = 9
O2_631GS_ROHF_NBETA_CART = 7

test "o2_631gs packs" {
    assert_near(o2_631gs_pack_bad(o2_631gs_shells(), O2_631GS_NSH, O2_631GS_NPRIMTOT, O2_631GS_NATOM), 0.0, 0.0)
    # nao_cart - nao_sph = sum over shells of ncart - nsph: 1 per d shell, 3 per f shell
    assert_near(O2_631GS_NAO_CART - O2_631GS_NAO_SPH, 2.0, 0.0)
    assert_near(len(o2_631gs_fc()), O2_631GS_NAO_CART, 0.0)
}

test "o2_631gs sph one-electron integrals are symmetric with a unit overlap diagonal" {
    assert_near(o2_631gs_asym(o2_631gs_s_sph(), 28), 0.0, 1.0e-14)
    assert_near(o2_631gs_asym(o2_631gs_t_sph(), 28), 0.0, 1.0e-14)
    assert_near(o2_631gs_asym(o2_631gs_v_sph(), 28), 0.0, 1.0e-14)
    assert_near(o2_631gs_diag_dev(o2_631gs_s_sph(), 28), 0.0, 1.0e-14)
}

test "o2_631gs sph sampled ERIs obey the Schwarz bound" {
    assert_near(len(o2_631gs_eri8_sph_idx()), 256.0, 0.0)
    assert_near(len(o2_631gs_eri8_sph_diag()), 406.0, 0.0)
    assert_lt(o2_631gs_sample_schwarz(o2_631gs_eri8_sph_idx(), o2_631gs_eri8_sph_val(), o2_631gs_eri8_sph_diag()), 1.0e-12)
    assert_lt(0.0, O2_631GS_ERI8_SPH_SUMSQ)
}

test "o2_631gs unit one-electron integrals are symmetric with a unit overlap diagonal" {
    assert_near(o2_631gs_asym(o2_631gs_s_unit(), 30), 0.0, 1.0e-14)
    assert_near(o2_631gs_asym(o2_631gs_t_unit(), 30), 0.0, 1.0e-14)
    assert_near(o2_631gs_asym(o2_631gs_v_unit(), 30), 0.0, 1.0e-14)
    assert_near(o2_631gs_diag_dev(o2_631gs_s_unit(), 30), 0.0, 1.0e-14)
}

test "o2_631gs unit sampled ERIs obey the Schwarz bound" {
    assert_near(len(o2_631gs_eri8_cart_idx()), 256.0, 0.0)
    assert_near(len(o2_631gs_eri8_cart_diag()), 465.0, 0.0)
    assert_lt(o2_631gs_sample_schwarz(o2_631gs_eri8_cart_idx(), o2_631gs_eri8_cart_val(), o2_631gs_eri8_cart_diag()), 1.0e-12)
    assert_lt(0.0, O2_631GS_ERI8_CART_SUMSQ)
}

test "o2_631gs M^T X_unit M is the spherical X" {
    assert_lt(o2_631gs_mtxm_dev(o2_631gs_m(), o2_631gs_s_unit(), o2_631gs_s_sph(), 30, 28), 1.0e-13)
    assert_lt(o2_631gs_mtxm_dev(o2_631gs_m(), o2_631gs_t_unit(), o2_631gs_t_sph(), 30, 28), 1.0e-13)
    assert_lt(o2_631gs_mtxm_dev(o2_631gs_m(), o2_631gs_v_unit(), o2_631gs_v_sph(), 30, 28), 1.0e-13)
}

test "o2_631gs uhf energies, labels and densities" {
    assert_lt(O2_631GS_E_UHF_STABLE, O2_631GS_E_UHF_DEFAULT + 1.0e-12)
    assert_lt(2.0 - 1.0e-10, O2_631GS_UHF_S2)
    assert_lt(2.0 - 1.0e-10, O2_631GS_UHF_S2_STABLE)
}

test "o2_631gs uhf cart energies, labels and densities" {
    assert_lt(O2_631GS_E_UHF_STABLE_CART, O2_631GS_E_UHF_DEFAULT_CART + 1.0e-12)
    assert_lt(2.0 - 1.0e-10, O2_631GS_UHF_S2_CART)
    assert_lt(2.0 - 1.0e-10, O2_631GS_UHF_S2_STABLE_CART)
}

test "o2_631gs rohf energies, labels and densities" {
    assert_lt(O2_631GS_E_ROHF_STABLE, O2_631GS_E_ROHF_DEFAULT + 1.0e-12)
}

test "o2_631gs rohf cart energies, labels and densities" {
    assert_lt(O2_631GS_E_ROHF_STABLE_CART, O2_631GS_E_ROHF_DEFAULT_CART + 1.0e-12)
}

test "o2_631gs E_uhf <= E_rohf" {
    assert_lt(O2_631GS_E_UHF_DEFAULT, O2_631GS_E_ROHF_DEFAULT + 1.0e-12)
    assert_lt(O2_631GS_E_UHF_STABLE, O2_631GS_E_ROHF_STABLE + 1.0e-12)
    assert_lt(O2_631GS_E_UHF_DEFAULT_CART, O2_631GS_E_ROHF_DEFAULT_CART + 1.0e-12)
    assert_lt(O2_631GS_E_UHF_STABLE_CART, O2_631GS_E_ROHF_STABLE_CART + 1.0e-12)
}
