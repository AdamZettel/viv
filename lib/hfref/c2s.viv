###
post: Cartesian to spherical, one shell at a time
agent: claude

Generated by `tools/hf_reference.py` from PySCF 2.5.0. Do not edit; rerun the
generator. Settings: conv_tol 1e-12, init_guess minao, symmetry off, and each
molecule built with cart=False and with cart=True. Every stored density is
then re-converged from itself at conv_tol_grad 1e-10 or tighter, and its
`_SELF_STEP` constant says how far one PySCF step moves it (below 1e-10).

M_l maps the unit-Cartesian components of one shell (PySCF order: lx from l
down, then ly) to PySCF's spherical ones (p as x, y, z; d as xy, yz, z^2,
xz, x^2 - y^2; f and g as m = -l..l): M_l = diag(F) cart2sph(l, 'sp'), with
F^2 = 4 pi (2i-1)!! (2j-1)!! (2k-1)!! / (2l+1)!! for l >= 2 and F = 1 below.

Also the two constants pyscf/gto/test/test_mole.py:520 and :529 assert: the
s and p factors of the unnormalized cart2sph, 1/(2 sqrt(pi)) and
sqrt(3/(4 pi)).
###

# ---- helpers for the tests below ----

#| Reshape a flat row-major vector into r x c.
def c2s_mat(v: Arr, r, c) -> Arr {
    a = zeros(r, c)
    for i to r {
        for j to c {
            a[i, j] = v[i * c + j]
        }
    }
    return a
}

def c2s_eye(n) -> Arr {
    a = zeros(n, n)
    for i to n {
        a[i, i] = 1.0
    }
    return a
}

#| Largest |A_ij - A_ji| / (1 + |A_ij|): a kinetic entry near 100 carries
#| rounding of about 1e-14, so the gap is measured relative to the entry.
def c2s_asym(a: Arr, n) {
    w = 0.0
    for i to n {
        for j to n {
            w = max(w, abs(a[i, j] - a[j, i]) / (1.0 + abs(a[i, j])))
        }
    }
    return w
}

#| Largest |A_ii - 1|.
def c2s_diag_dev(a: Arr, n) {
    w = 0.0
    for i to n {
        w = max(w, abs(a[i, i] - 1.0))
    }
    return w
}

#| sum_ij A_ij B_ij: Tr(D S) is the electron count.
def c2s_trace2(a: Arr, b: Arr, n) {
    t = 0.0
    for i to n {
        for j to n {
            t = t + a[i, j] * b[i, j]
        }
    }
    return t
}

#| pr[i, j] = the packed pair index of (i, j), in either order.
def c2s_pair_table(n) -> Arr {
    pr = zeros(n, n)
    for i to n {
        for j to i + 1 {
            pr[i, j] = i * (i + 1) / 2 + j
            pr[j, i] = pr[i, j]
        }
    }
    return pr
}

#| One- plus two-electron energy from spin densities and packed (ij|kl):
#| sum Dt h + 1/2 sum (ij|kl) [Dt_ij Dt_kl - Da_ik Da_jl - Db_ik Db_jl].
#| For RHF pass Da = Db = D/2. Written over all n^4 quartets because it is
#| a check, not a J/K build.
def c2s_e_elec(h: Arr, g: Arr, da: Arr, db: Arr, n) {
    pr = c2s_pair_table(n)
    e = 0.0
    for i to n {
        for j to n {
            e = e + (da[i, j] + db[i, j]) * h[i, j]
        }
    }
    e2 = 0.0
    for i to n {
        for j to n {
            pij = pr[i, j]
            dij = da[i, j] + db[i, j]
            for k to n {
                for l to n {
                    pkl = pr[k, l]
                    a = max(pij, pkl)
                    b = min(pij, pkl)
                    x = g[a * (a + 1) / 2 + b]
                    e2 = e2 + x * (dij * (da[k, l] + db[k, l]) - da[i, k] * da[j, l] - db[i, k] * db[j, l])
                }
            }
        }
    }
    return e + 0.5 * e2
}

def c2s_sumsq(g: Arr) {
    t = 0.0
    for k to len(g) {
        t = t + g[k] * g[k]
    }
    return t
}

#| sum_k w_k g_k with w_k = s_k / (2^31 - 1), s_k = 16807 s_(k-1) mod (2^31 - 1),
#| s_0 = seed. Every product stays below 2^53, so the weights are exact.
def c2s_wsum(g: Arr, seed) {
    s = seed
    t = 0.0
    for k to len(g) {
        s = mod(16807.0 * s, 2147483647.0)
        t = t + s / 2147483647.0 * g[k]
    }
    return t
}

#| Largest (ij|kl)^2 - (ij|ij)(kl|kl) over the packed set, relative to the
#| bound. Cauchy-Schwarz says it is at most 0.
def c2s_schwarz(g: Arr, n) {
    npair = n * (n + 1) / 2
    w = -1.0
    for a to npair {
        for b to a + 1 {
            x = g[a * (a + 1) / 2 + b]
            q = g[a * (a + 1) / 2 + a] * g[b * (b + 1) / 2 + b]
            w = max(w, (x * x - q) / (q + 1.0e-300))
        }
    }
    return w
}

#| The same bound on sampled entries, with the pair diagonal given.
def c2s_sample_schwarz(idx: Arr, val: Arr, gd: Arr) {
    w = -1.0
    for k to len(idx) {
        a = floor((sqrt(8.0 * idx[k] + 1.0) - 1.0) / 2.0)
        if a * (a + 1) / 2 > idx[k] {
            a = a - 1
        }
        if (a + 1) * (a + 2) / 2 <= idx[k] {
            a = a + 1
        }
        b = idx[k] - a * (a + 1) / 2
        q = gd[a] * gd[b]
        w = max(w, (val[k] * val[k] - q) / (q + 1.0e-300))
    }
    return w
}

#| Largest |M^T X M - Y|.
def c2s_mtxm_dev(m: Arr, x: Arr, y: Arr, nc, ns) {
    w = 0.0
    for a to ns {
        for b to ns {
            t = 0.0
            for i to nc {
                for j to nc {
                    t = t + m[i, a] * x[i, j] * m[j, b]
                }
            }
            w = max(w, abs(t - y[a, b]))
        }
    }
    return w
}

#| Count what is wrong with a shells pack: offsets that do not run on, a
#| component count that does not match l, a primitive range out of bounds.
def c2s_pack_bad(sh: Arr, nsh, nprim, natm) {
    bad = 0
    p0 = 0
    c0 = 0
    s0 = 0
    for k to nsh {
        l = sh[k, 1]
        if sh[k, 0] < 0 or sh[k, 0] >= natm {
            bad = bad + 1
        }
        if sh[k, 3] != p0 or sh[k, 4] != c0 or sh[k, 5] != s0 {
            bad = bad + 1
        }
        if sh[k, 6] != (l + 1) * (l + 2) / 2 or sh[k, 7] != 2 * l + 1 {
            bad = bad + 1
        }
        p0 = p0 + sh[k, 2]
        c0 = c0 + sh[k, 6]
        s0 = s0 + sh[k, 7]
    }
    if p0 != nprim {
        bad = bad + 1
    }
    return bad
}

# gto.cart2sph(0): test_mole.py:520 asserts 0.282094791773878143.
C2S_S_FACTOR = 0.28209479177387814
# gto.cart2sph(1) diagonal: test_mole.py:529 asserts 0.488602511902919921.
C2S_P_FACTOR = 0.4886025119029199
C2S_LMAX = 4
C2S_PI = 3.141592653589793

#| M_0, [1,1].
def c2s_m0_flat() -> Arr {
    return [1.0]
}

def c2s_m0() -> Arr {
    return c2s_mat(c2s_m0_flat(), 1, 1)
}

#| Powers (i, j, k) of each component.
def c2s_powers0_flat() -> Arr {
    return [0, 0, 0]
}

def c2s_powers0() -> Arr {
    return c2s_mat(c2s_powers0_flat(), 1, 3)
}

