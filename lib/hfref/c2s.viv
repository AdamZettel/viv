#| (n)!! with (-1)!! = 1.
def c2s_dfact(n) {
    r = 1.0
    k = n
    while k > 1 {
        r = r * k
        k = k - 2
    }
    return r
}

#| Overlap of two unit-normalized components on one center with one exponent:
#| per axis (a + b - 1)!! / sqrt((2a - 1)!! (2b - 1)!!) when a + b is even, else 0.
def c2s_shell_overlap(pw: Arr, nc) -> Arr {
    s = zeros(nc, nc)
    for i to nc {
        for j to nc {
            t = 1.0
            for d to shape(pw)[1] {
                a = pw[i, d]
                b = pw[j, d]
                if mod(a + b, 2.0) == 1.0 {
                    t = 0.0
                } else {
                    t = t * c2s_dfact(a + b - 1) / sqrt(c2s_dfact(2 * a - 1) * c2s_dfact(2 * b - 1))
                }
            }
            s[i, j] = t
        }
    }
    return s
}

#| Largest relative gap between the tabulated F^2 and the closed form.
def c2s_fc2_dev(pw: Arr, f2: Arr, nc) {
    w = 0.0
    for i to nc {
        a = pw[i, 0]
        b = pw[i, 1]
        c = pw[i, 2]
        l = a + b + c
        x = 1.0
        if l >= 2 {
            x = 4.0 * C2S_PI * c2s_dfact(2 * a - 1) * c2s_dfact(2 * b - 1) * c2s_dfact(2 * c - 1) / c2s_dfact(2 * l + 1)
        }
        w = max(w, abs(f2[i] - x) / x)
    }
    return w
}

test "c2s spherical functions are orthonormal and F matches its closed form" {
    assert_near(C2S_S_FACTOR, 1.0 / (2.0 * sqrt(C2S_PI)), 1.0e-16)
    assert_near(C2S_P_FACTOR, sqrt(3.0 / (4.0 * C2S_PI)), 1.0e-16)
    assert_lt(c2s_mtxm_dev(c2s_m0(), c2s_shell_overlap(c2s_powers0(), 1), c2s_eye(1), 1, 1), 1.0e-14)
    assert_lt(c2s_fc2_dev(c2s_powers0(), c2s_fc2_0(), 1), 1.0e-15)
    assert_lt(c2s_mtxm_dev(c2s_m1(), c2s_shell_overlap(c2s_powers1(), 3), c2s_eye(3), 3, 3), 1.0e-14)
    assert_lt(c2s_fc2_dev(c2s_powers1(), c2s_fc2_1(), 3), 1.0e-15)
    assert_lt(c2s_mtxm_dev(c2s_m2(), c2s_shell_overlap(c2s_powers2(), 6), c2s_eye(5), 6, 5), 1.0e-14)
    assert_lt(c2s_fc2_dev(c2s_powers2(), c2s_fc2_2(), 6), 1.0e-15)
    assert_lt(c2s_mtxm_dev(c2s_m3(), c2s_shell_overlap(c2s_powers3(), 10), c2s_eye(7), 10, 7), 1.0e-14)
    assert_lt(c2s_fc2_dev(c2s_powers3(), c2s_fc2_3(), 10), 1.0e-15)
    assert_lt(c2s_mtxm_dev(c2s_m4(), c2s_shell_overlap(c2s_powers4(), 15), c2s_eye(9), 15, 9), 1.0e-14)
    assert_lt(c2s_fc2_dev(c2s_powers4(), c2s_fc2_4(), 15), 1.0e-15)
}
