def n2_631gs_m() -> Arr {
    return breadth631gs_mat(n2_631gs_m_flat(), 30, 28)
}

# ---- N2_631GS RHF: nalpha 7, nbeta 7; default state is stable ----

N2_631GS_E_RHF = -108.94186885969204
N2_631GS_E_RHF_DEFAULT = -108.94186885969204
N2_631GS_E_RHF_STABLE = -108.94186885969204
# 1: no restart from the stability orbitals lowers the minao state; 0: one does; -1: not analyzed (stability restart).
N2_631GS_RHF_IS_STABLE = 1
N2_631GS_RHF_NALPHA = 7
N2_631GS_RHF_NBETA = 7
# Flagged: the huckel guess converges to this excited RHF solution.
N2_631GS_E_RHF_GUESS_HUCKEL = -108.20313259582834

# ---- N2_631GS RHF (cart): nalpha 7, nbeta 7; default state is stable ----

N2_631GS_E_RHF_CART = -108.94266234798268
N2_631GS_E_RHF_DEFAULT_CART = -108.94266234798268
N2_631GS_E_RHF_STABLE_CART = -108.94266234798268
# 1: no restart from the stability orbitals lowers the minao state; 0: one does; -1: not analyzed (stability restart).
N2_631GS_RHF_IS_STABLE_CART = 1
N2_631GS_RHF_NALPHA_CART = 7
N2_631GS_RHF_NBETA_CART = 7
# Flagged: the huckel guess converges to this excited RHF solution.
N2_631GS_E_RHF_GUESS_HUCKEL_CART = -108.2037380712142

test "nh3_631gs packs" {
    assert_near(breadth631gs_pack_bad(nh3_631gs_shells(), NH3_631GS_NSH, NH3_631GS_NPRIMTOT, NH3_631GS_NATOM), 0.0, 0.0)
    # nao_cart - nao_sph = sum over shells of ncart - nsph: 1 per d shell, 3 per f shell
    assert_near(NH3_631GS_NAO_CART - NH3_631GS_NAO_SPH, 1.0, 0.0)
    assert_near(len(nh3_631gs_fc()), NH3_631GS_NAO_CART, 0.0)
}

test "nh3_631gs sph one-electron integrals are symmetric with a unit overlap diagonal" {
    assert_near(breadth631gs_asym(nh3_631gs_s_sph(), 20), 0.0, 1.0e-14)
    assert_near(breadth631gs_asym(nh3_631gs_t_sph(), 20), 0.0, 1.0e-14)
    assert_near(breadth631gs_asym(nh3_631gs_v_sph(), 20), 0.0, 1.0e-14)
    assert_near(breadth631gs_diag_dev(nh3_631gs_s_sph(), 20), 0.0, 1.0e-14)
}

test "nh3_631gs sph sampled ERIs obey the Schwarz bound" {
    assert_near(len(nh3_631gs_eri8_sph_idx()), 256.0, 0.0)
    assert_near(len(nh3_631gs_eri8_sph_diag()), 210.0, 0.0)
    assert_lt(breadth631gs_sample_schwarz(nh3_631gs_eri8_sph_idx(), nh3_631gs_eri8_sph_val(), nh3_631gs_eri8_sph_diag()), 1.0e-12)
    assert_lt(0.0, NH3_631GS_ERI8_SPH_SUMSQ)
}

test "nh3_631gs unit one-electron integrals are symmetric with a unit overlap diagonal" {
    assert_near(breadth631gs_asym(nh3_631gs_s_unit(), 21), 0.0, 1.0e-14)
    assert_near(breadth631gs_asym(nh3_631gs_t_unit(), 21), 0.0, 1.0e-14)
    assert_near(breadth631gs_asym(nh3_631gs_v_unit(), 21), 0.0, 1.0e-14)
    assert_near(breadth631gs_diag_dev(nh3_631gs_s_unit(), 21), 0.0, 1.0e-14)
}

test "nh3_631gs unit sampled ERIs obey the Schwarz bound" {
    assert_near(len(nh3_631gs_eri8_cart_idx()), 256.0, 0.0)
    assert_near(len(nh3_631gs_eri8_cart_diag()), 231.0, 0.0)
    assert_lt(breadth631gs_sample_schwarz(nh3_631gs_eri8_cart_idx(), nh3_631gs_eri8_cart_val(), nh3_631gs_eri8_cart_diag()), 1.0e-12)
    assert_lt(0.0, NH3_631GS_ERI8_CART_SUMSQ)
}

test "nh3_631gs M^T X_unit M is the spherical X" {
    assert_lt(breadth631gs_mtxm_dev(nh3_631gs_m(), nh3_631gs_s_unit(), nh3_631gs_s_sph(), 21, 20), 1.0e-13)
    assert_lt(breadth631gs_mtxm_dev(nh3_631gs_m(), nh3_631gs_t_unit(), nh3_631gs_t_sph(), 21, 20), 1.0e-13)
    assert_lt(breadth631gs_mtxm_dev(nh3_631gs_m(), nh3_631gs_v_unit(), nh3_631gs_v_sph(), 21, 20), 1.0e-13)
}

test "nh3_631gs rhf energies, labels and densities" {
    assert_lt(NH3_631GS_E_RHF_STABLE, NH3_631GS_E_RHF_DEFAULT + 1.0e-12)
}

test "nh3_631gs rhf cart energies, labels and densities" {
    assert_lt(NH3_631GS_E_RHF_STABLE_CART, NH3_631GS_E_RHF_DEFAULT_CART + 1.0e-12)
}

