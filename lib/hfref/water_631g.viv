def water631g_spin2_uhf_db() -> Arr {
    return water631g_mat(water631g_spin2_uhf_db_flat(), 13, 13)
}

# ---- WATER631G SPIN2_ROHF: nalpha 6, nbeta 4; default state is stable ----

WATER631G_E_SPIN2_ROHF = -75.72365493633163
WATER631G_E_SPIN2_ROHF_DEFAULT = -75.72365493633163
WATER631G_E_SPIN2_ROHF_STABLE = -75.72365493633163
# 1: no restart from the stability orbitals lowers the minao state; 0: one does; -1: not analyzed (stability restart).
WATER631G_SPIN2_ROHF_IS_STABLE = 1
WATER631G_SPIN2_ROHF_NALPHA = 6
WATER631G_SPIN2_ROHF_NBETA = 4
# Third state: the huckel guess converges here, to neither the default nor the stable state.
WATER631G_E_SPIN2_ROHF_GUESS_HUCKEL = -75.63112377325734

# Max |D' - D| after one PySCF step (get_fock, eig, get_occ, make_rdm1) from the default density below.
WATER631G_SPIN2_ROHF_SELF_STEP = 2.4802382370125997e-13
