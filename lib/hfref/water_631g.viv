def water631g_spin2_rohf_db() -> Arr {
    return water631g_mat(water631g_spin2_rohf_db_flat(), 13, 13)
}

test "water631g packs" {
    assert_near(water631g_pack_bad(water631g_shells(), WATER631G_NSH, WATER631G_NPRIMTOT, WATER631G_NATOM), 0.0, 0.0)
    # nao_cart - nao_sph = sum over shells of ncart - nsph: 1 per d shell, 3 per f shell
    assert_near(WATER631G_NAO_CART - WATER631G_NAO_SPH, 0.0, 0.0)
    assert_near(len(water631g_fc()), WATER631G_NAO_CART, 0.0)
}

test "water631g unit one-electron integrals are symmetric with a unit overlap diagonal" {
    assert_near(water631g_asym(water631g_s_unit(), 13), 0.0, 1.0e-14)
    assert_near(water631g_asym(water631g_t_unit(), 13), 0.0, 1.0e-14)
    assert_near(water631g_asym(water631g_v_unit(), 13), 0.0, 1.0e-14)
    assert_near(water631g_diag_dev(water631g_s_unit(), 13), 0.0, 1.0e-14)
}

test "water631g unit packed ERIs match their checksums and the Schwarz bound" {
    assert_near(len(water631g_eri8_cart()), WATER631G_ERI8_CART_LEN, 0.0)
    assert_near(water631g_sumsq(water631g_eri8_cart()) / WATER631G_ERI8_CART_SUMSQ, 1.0, 1.0e-12)
    assert_near(water631g_wsum(water631g_eri8_cart(), WATER631G_SEED_WSUM), WATER631G_ERI8_CART_WSUM, 1.0e-12 * WATER631G_ERI8_CART_SUMSQ)
    assert_lt(water631g_schwarz(water631g_eri8_cart(), 13), 1.0e-12)
}

test "water631g rhf energies, labels and densities" {
    assert_lt(WATER631G_E_RHF_STABLE, WATER631G_E_RHF_DEFAULT + 1.0e-12)
    assert_lt(WATER631G_RHF_SELF_STEP, 1.0e-10)
    assert_near(water631g_asym(water631g_rhf_d(), 13), 0.0, 1.0e-12)
    assert_near(water631g_trace2(water631g_rhf_d(), water631g_s_unit(), 13), 10.0, 1.0e-10)
    assert_near(water631g_e_elec(water631g_t_unit() + water631g_v_unit(), water631g_eri8_cart(), water631g_rhf_d() * 0.5, water631g_rhf_d() * 0.5, 13) + WATER631G_E_NUC, WATER631G_E_RHF_DEFAULT, 1.0e-10)
}

test "water631g uhf energies, labels and densities" {
    assert_lt(WATER631G_E_UHF_STABLE, WATER631G_E_UHF_DEFAULT + 1.0e-12)
    assert_lt(0.0 - 1.0e-10, WATER631G_UHF_S2)
    assert_lt(0.0 - 1.0e-10, WATER631G_UHF_S2_STABLE)
    assert_lt(WATER631G_UHF_SELF_STEP, 1.0e-10)
    assert_near(water631g_asym(water631g_uhf_da(), 13) + water631g_asym(water631g_uhf_db(), 13), 0.0, 1.0e-12)
    assert_near(water631g_trace2(water631g_uhf_da(), water631g_s_unit(), 13) + water631g_trace2(water631g_uhf_db(), water631g_s_unit(), 13), 10.0, 1.0e-10)
    assert_near(water631g_e_elec(water631g_t_unit() + water631g_v_unit(), water631g_eri8_cart(), water631g_uhf_da(), water631g_uhf_db(), 13) + WATER631G_E_NUC, WATER631G_E_UHF_DEFAULT, 1.0e-10)
}

test "water631g cation_rohf energies, labels and densities" {
    assert_lt(WATER631G_E_CATION_ROHF_STABLE, WATER631G_E_CATION_ROHF_DEFAULT + 1.0e-12)
    assert_lt(WATER631G_CATION_ROHF_SELF_STEP, 1.0e-10)
    assert_near(water631g_asym(water631g_cation_rohf_da(), 13) + water631g_asym(water631g_cation_rohf_db(), 13), 0.0, 1.0e-12)
    assert_near(water631g_trace2(water631g_cation_rohf_da(), water631g_s_unit(), 13) + water631g_trace2(water631g_cation_rohf_db(), water631g_s_unit(), 13), 9.0, 1.0e-10)
    assert_near(water631g_e_elec(water631g_t_unit() + water631g_v_unit(), water631g_eri8_cart(), water631g_cation_rohf_da(), water631g_cation_rohf_db(), 13) + WATER631G_E_NUC, WATER631G_E_CATION_ROHF_DEFAULT, 1.0e-10)
}

test "water631g cation_uhf energies, labels and densities" {
    assert_lt(WATER631G_E_CATION_UHF_STABLE, WATER631G_E_CATION_UHF_DEFAULT + 1.0e-12)
    assert_lt(0.75 - 1.0e-10, WATER631G_CATION_UHF_S2)
    assert_lt(0.75 - 1.0e-10, WATER631G_CATION_UHF_S2_STABLE)
    assert_lt(WATER631G_CATION_UHF_SELF_STEP, 1.0e-10)
    assert_near(water631g_asym(water631g_cation_uhf_da(), 13) + water631g_asym(water631g_cation_uhf_db(), 13), 0.0, 1.0e-12)
    assert_near(water631g_trace2(water631g_cation_uhf_da(), water631g_s_unit(), 13) + water631g_trace2(water631g_cation_uhf_db(), water631g_s_unit(), 13), 9.0, 1.0e-10)
    assert_near(water631g_e_elec(water631g_t_unit() + water631g_v_unit(), water631g_eri8_cart(), water631g_cation_uhf_da(), water631g_cation_uhf_db(), 13) + WATER631G_E_NUC, WATER631G_E_CATION_UHF_DEFAULT, 1.0e-10)
}

test "water631g spinm2_uhf energies, labels and densities" {
    assert_lt(WATER631G_E_SPINM2_UHF_STABLE, WATER631G_E_SPINM2_UHF_DEFAULT + 1.0e-12)
    assert_lt(2.0 - 1.0e-10, WATER631G_SPINM2_UHF_S2)
    assert_lt(2.0 - 1.0e-10, WATER631G_SPINM2_UHF_S2_STABLE)
    assert_lt(WATER631G_SPINM2_UHF_SELF_STEP, 1.0e-10)
    assert_near(water631g_asym(water631g_spinm2_uhf_da(), 13) + water631g_asym(water631g_spinm2_uhf_db(), 13), 0.0, 1.0e-12)
    assert_near(water631g_trace2(water631g_spinm2_uhf_da(), water631g_s_unit(), 13) + water631g_trace2(water631g_spinm2_uhf_db(), water631g_s_unit(), 13), 10.0, 1.0e-10)
    assert_near(water631g_e_elec(water631g_t_unit() + water631g_v_unit(), water631g_eri8_cart(), water631g_spinm2_uhf_da(), water631g_spinm2_uhf_db(), 13) + WATER631G_E_NUC, WATER631G_E_SPINM2_UHF_DEFAULT, 1.0e-10)
}

