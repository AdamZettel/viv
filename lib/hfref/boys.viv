#| Values 1024 to 1036 of the table, flattened by row.
def boys_ref_chunk2() {
    return [2.570273133166553e-10, 5.783114549624745e-12, 1.590356501146805e-13, 5.1686586287271154e-15, 1.9382469857726683e-16, 8.23754968953384e-18, 3.9128361025285743e-19, 2.0542389538275014e-20, 1.1811873984508134e-21, 7.382421240317584e-23, 4.9831343372143685e-24, 3.6127723944804173e-25, 2.7998986057223236e-26]
}

#| The table as `F[ix, n]`, `ix` indexing `boys_ref_x()` and `n = 0..16`.
#| Built when called, so a program that only uses the module pays nothing.
def boys_ref_table() {
    ncol = BOYS_REF_NMAX + 1
    out = zeros(BOYS_REF_NX, ncol)
    # base: where the current chunk starts in the flattened table
    base = 0
    part0 = boys_ref_chunk0()
    for k to len(part0) {
        flat = base + k
        out[floor(flat / ncol), mod(flat, ncol)] = part0[k]
    }
    base = base + len(part0)
    part1 = boys_ref_chunk1()
    for k to len(part1) {
        flat = base + k
        out[floor(flat / ncol), mod(flat, ncol)] = part1[k]
    }
    base = base + len(part1)
    part2 = boys_ref_chunk2()
    for k to len(part2) {
        flat = base + k
        out[floor(flat / ncol), mod(flat, ncol)] = part2[k]
    }
    return out
}

test "the table falls with the order and with the argument" {
    boys_rt = boys_ref_table()
    boys_rx = boys_ref_x()
    for boys_ri to BOYS_REF_NX {
        for boys_rn to BOYS_REF_NMAX {
            if boys_rx[boys_ri] > 0.0 {
                assert_lt(boys_rt[boys_ri, boys_rn + 1], boys_rt[boys_ri, boys_rn])
            }
            if boys_ri > 0 {
                assert_lt(boys_rt[boys_ri, boys_rn], boys_rt[boys_ri - 1, boys_rn])
            }
        }
    }
}
