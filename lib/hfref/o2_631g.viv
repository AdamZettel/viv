def o2_631g_rohf_stable_db() -> Arr {
    return o2_631g_mat(o2_631g_rohf_stable_db_flat(), 18, 18)
}

test "o2_631g packs" {
    assert_near(o2_631g_pack_bad(o2_631g_shells(), O2_631G_NSH, O2_631G_NPRIMTOT, O2_631G_NATOM), 0.0, 0.0)
    # nao_cart - nao_sph = sum over shells of ncart - nsph: 1 per d shell, 3 per f shell
    assert_near(O2_631G_NAO_CART - O2_631G_NAO_SPH, 0.0, 0.0)
    assert_near(len(o2_631g_fc()), O2_631G_NAO_CART, 0.0)
}

test "o2_631g unit one-electron integrals are symmetric with a unit overlap diagonal" {
    assert_near(o2_631g_asym(o2_631g_s_unit(), 18), 0.0, 1.0e-14)
    assert_near(o2_631g_asym(o2_631g_t_unit(), 18), 0.0, 1.0e-14)
    assert_near(o2_631g_asym(o2_631g_v_unit(), 18), 0.0, 1.0e-14)
    assert_near(o2_631g_diag_dev(o2_631g_s_unit(), 18), 0.0, 1.0e-14)
}

test "o2_631g unit packed ERIs match their checksums and the Schwarz bound" {
    assert_near(len(o2_631g_eri8_cart()), O2_631G_ERI8_CART_LEN, 0.0)
    assert_near(o2_631g_sumsq(o2_631g_eri8_cart()) / O2_631G_ERI8_CART_SUMSQ, 1.0, 1.0e-12)
    assert_near(o2_631g_wsum(o2_631g_eri8_cart(), O2_631G_SEED_WSUM), O2_631G_ERI8_CART_WSUM, 1.0e-12 * O2_631G_ERI8_CART_SUMSQ)
    assert_lt(o2_631g_schwarz(o2_631g_eri8_cart(), 18), 1.0e-12)
}

test "o2_631g uhf energies, labels and densities" {
    assert_lt(O2_631G_E_UHF_STABLE, O2_631G_E_UHF_DEFAULT + 1.0e-12)
    assert_lt(2.0 - 1.0e-10, O2_631G_UHF_S2)
    assert_lt(2.0 - 1.0e-10, O2_631G_UHF_S2_STABLE)
    assert_lt(O2_631G_UHF_SELF_STEP, 1.0e-10)
    assert_near(o2_631g_asym(o2_631g_uhf_da(), 18) + o2_631g_asym(o2_631g_uhf_db(), 18), 0.0, 1.0e-12)
    assert_near(o2_631g_trace2(o2_631g_uhf_da(), o2_631g_s_unit(), 18) + o2_631g_trace2(o2_631g_uhf_db(), o2_631g_s_unit(), 18), 16.0, 1.0e-10)
    assert_near(o2_631g_e_elec(o2_631g_t_unit() + o2_631g_v_unit(), o2_631g_eri8_cart(), o2_631g_uhf_da(), o2_631g_uhf_db(), 18) + O2_631G_E_NUC, O2_631G_E_UHF_DEFAULT, 1.0e-10)
}

test "o2_631g rohf energies, labels and densities" {
    assert_lt(O2_631G_E_ROHF_STABLE, O2_631G_E_ROHF_DEFAULT + 1.0e-12)
    assert_lt(O2_631G_ROHF_SELF_STEP, 1.0e-10)
    assert_near(o2_631g_asym(o2_631g_rohf_da(), 18) + o2_631g_asym(o2_631g_rohf_db(), 18), 0.0, 1.0e-12)
    assert_near(o2_631g_trace2(o2_631g_rohf_da(), o2_631g_s_unit(), 18) + o2_631g_trace2(o2_631g_rohf_db(), o2_631g_s_unit(), 18), 16.0, 1.0e-10)
    assert_near(o2_631g_e_elec(o2_631g_t_unit() + o2_631g_v_unit(), o2_631g_eri8_cart(), o2_631g_rohf_da(), o2_631g_rohf_db(), 18) + O2_631G_E_NUC, O2_631G_E_ROHF_DEFAULT, 1.0e-10)
    assert_lt(O2_631G_ROHF_STABLE_SELF_STEP, 1.0e-10)
    assert_near(o2_631g_asym(o2_631g_rohf_stable_da(), 18) + o2_631g_asym(o2_631g_rohf_stable_db(), 18), 0.0, 1.0e-12)
    assert_near(o2_631g_trace2(o2_631g_rohf_stable_da(), o2_631g_s_unit(), 18) + o2_631g_trace2(o2_631g_rohf_stable_db(), o2_631g_s_unit(), 18), 16.0, 1.0e-10)
    assert_near(o2_631g_e_elec(o2_631g_t_unit() + o2_631g_v_unit(), o2_631g_eri8_cart(), o2_631g_rohf_stable_da(), o2_631g_rohf_stable_db(), 18) + O2_631G_E_NUC, O2_631G_E_ROHF_STABLE, 1.0e-10)
}

test "o2_631g E_uhf <= E_rohf" {
    assert_lt(O2_631G_E_UHF_DEFAULT, O2_631G_E_ROHF_DEFAULT + 1.0e-12)
    assert_lt(O2_631G_E_UHF_STABLE, O2_631G_E_ROHF_STABLE + 1.0e-12)
}
