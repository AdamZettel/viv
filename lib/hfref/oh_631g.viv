# ---- OH_631G ROHF: nalpha 5, nbeta 4; default state is stable ----

OH_631G_E_ROHF = -75.36184838040772
OH_631G_E_ROHF_DEFAULT = -75.36184838040772
OH_631G_E_ROHF_STABLE = -75.36184838040772
# 1: no restart from the stability orbitals lowers the minao state; 0: one does; -1: not analyzed (stability restart).
OH_631G_ROHF_IS_STABLE = 1
OH_631G_ROHF_NALPHA = 5
OH_631G_ROHF_NBETA = 4

