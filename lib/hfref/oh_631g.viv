def oh_631g_rohf_db() -> Arr {
    return oh_631g_mat(oh_631g_rohf_db_flat(), 11, 11)
}

test "oh_631g packs" {
    assert_near(oh_631g_pack_bad(oh_631g_shells(), OH_631G_NSH, OH_631G_NPRIMTOT, OH_631G_NATOM), 0.0, 0.0)
    # nao_cart - nao_sph = sum over shells of ncart - nsph: 1 per d shell, 3 per f shell
    assert_near(OH_631G_NAO_CART - OH_631G_NAO_SPH, 0.0, 0.0)
    assert_near(len(oh_631g_fc()), OH_631G_NAO_CART, 0.0)
}

test "oh_631g unit one-electron integrals are symmetric with a unit overlap diagonal" {
    assert_near(oh_631g_asym(oh_631g_s_unit(), 11), 0.0, 1.0e-14)
    assert_near(oh_631g_asym(oh_631g_t_unit(), 11), 0.0, 1.0e-14)
    assert_near(oh_631g_asym(oh_631g_v_unit(), 11), 0.0, 1.0e-14)
    assert_near(oh_631g_diag_dev(oh_631g_s_unit(), 11), 0.0, 1.0e-14)
}

test "oh_631g unit packed ERIs match their checksums and the Schwarz bound" {
    assert_near(len(oh_631g_eri8_cart()), OH_631G_ERI8_CART_LEN, 0.0)
    assert_near(oh_631g_sumsq(oh_631g_eri8_cart()) / OH_631G_ERI8_CART_SUMSQ, 1.0, 1.0e-12)
    assert_near(oh_631g_wsum(oh_631g_eri8_cart(), OH_631G_SEED_WSUM), OH_631G_ERI8_CART_WSUM, 1.0e-12 * OH_631G_ERI8_CART_SUMSQ)
    assert_lt(oh_631g_schwarz(oh_631g_eri8_cart(), 11), 1.0e-12)
}

test "oh_631g uhf energies, labels and densities" {
    assert_lt(OH_631G_E_UHF_STABLE, OH_631G_E_UHF_DEFAULT + 1.0e-12)
    assert_lt(0.75 - 1.0e-10, OH_631G_UHF_S2)
    assert_lt(0.75 - 1.0e-10, OH_631G_UHF_S2_STABLE)
    assert_lt(OH_631G_UHF_SELF_STEP, 1.0e-10)
    assert_near(oh_631g_asym(oh_631g_uhf_da(), 11) + oh_631g_asym(oh_631g_uhf_db(), 11), 0.0, 1.0e-12)
    assert_near(oh_631g_trace2(oh_631g_uhf_da(), oh_631g_s_unit(), 11) + oh_631g_trace2(oh_631g_uhf_db(), oh_631g_s_unit(), 11), 9.0, 1.0e-10)
    assert_near(oh_631g_e_elec(oh_631g_t_unit() + oh_631g_v_unit(), oh_631g_eri8_cart(), oh_631g_uhf_da(), oh_631g_uhf_db(), 11) + OH_631G_E_NUC, OH_631G_E_UHF_DEFAULT, 1.0e-10)
}

test "oh_631g rohf energies, labels and densities" {
    assert_lt(OH_631G_E_ROHF_STABLE, OH_631G_E_ROHF_DEFAULT + 1.0e-12)
    assert_lt(OH_631G_ROHF_SELF_STEP, 1.0e-10)
    assert_near(oh_631g_asym(oh_631g_rohf_da(), 11) + oh_631g_asym(oh_631g_rohf_db(), 11), 0.0, 1.0e-12)
    assert_near(oh_631g_trace2(oh_631g_rohf_da(), oh_631g_s_unit(), 11) + oh_631g_trace2(oh_631g_rohf_db(), oh_631g_s_unit(), 11), 9.0, 1.0e-10)
    assert_near(oh_631g_e_elec(oh_631g_t_unit() + oh_631g_v_unit(), oh_631g_eri8_cart(), oh_631g_rohf_da(), oh_631g_rohf_db(), 11) + OH_631G_E_NUC, OH_631G_E_ROHF_DEFAULT, 1.0e-10)
}

test "oh_631g E_uhf <= E_rohf" {
    assert_lt(OH_631G_E_UHF_DEFAULT, OH_631G_E_ROHF_DEFAULT + 1.0e-12)
    assert_lt(OH_631G_E_UHF_STABLE, OH_631G_E_ROHF_STABLE + 1.0e-12)
}
