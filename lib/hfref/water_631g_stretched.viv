def water631g_stretched_rhf_stable_d() -> Arr {
    return water631g_stretched_mat(water631g_stretched_rhf_stable_d_flat(), 13, 13)
}

# The RHF state PySCF lands on from minao; internally unstable.
WATER631G_STRETCHED_E_DEFAULT = -75.4460693906354
# The RHF state reached by restarting from the stability orbitals.
WATER631G_STRETCHED_E_STABLE = -75.4739098537268
test "water631g_stretched packs" {
    assert_near(water631g_stretched_pack_bad(water631g_stretched_shells(), WATER631G_STRETCHED_NSH, WATER631G_STRETCHED_NPRIMTOT, WATER631G_STRETCHED_NATOM), 0.0, 0.0)
    # nao_cart - nao_sph = sum over shells of ncart - nsph: 1 per d shell, 3 per f shell
    assert_near(WATER631G_STRETCHED_NAO_CART - WATER631G_STRETCHED_NAO_SPH, 0.0, 0.0)
    assert_near(len(water631g_stretched_fc()), WATER631G_STRETCHED_NAO_CART, 0.0)
}

test "water631g_stretched unit one-electron integrals are symmetric with a unit overlap diagonal" {
    assert_near(water631g_stretched_asym(water631g_stretched_s_unit(), 13), 0.0, 1.0e-14)
    assert_near(water631g_stretched_asym(water631g_stretched_t_unit(), 13), 0.0, 1.0e-14)
    assert_near(water631g_stretched_asym(water631g_stretched_v_unit(), 13), 0.0, 1.0e-14)
    assert_near(water631g_stretched_diag_dev(water631g_stretched_s_unit(), 13), 0.0, 1.0e-14)
}

test "water631g_stretched unit packed ERIs match their checksums and the Schwarz bound" {
    assert_near(len(water631g_stretched_eri8_cart()), WATER631G_STRETCHED_ERI8_CART_LEN, 0.0)
    assert_near(water631g_stretched_sumsq(water631g_stretched_eri8_cart()) / WATER631G_STRETCHED_ERI8_CART_SUMSQ, 1.0, 1.0e-12)
    assert_near(water631g_stretched_wsum(water631g_stretched_eri8_cart(), WATER631G_STRETCHED_SEED_WSUM), WATER631G_STRETCHED_ERI8_CART_WSUM, 1.0e-12 * WATER631G_STRETCHED_ERI8_CART_SUMSQ)
    assert_lt(water631g_stretched_schwarz(water631g_stretched_eri8_cart(), 13), 1.0e-12)
}

test "water631g_stretched rhf energies, labels and densities" {
    assert_lt(WATER631G_STRETCHED_E_RHF_STABLE, WATER631G_STRETCHED_E_RHF_DEFAULT + 1.0e-12)
    assert_lt(WATER631G_STRETCHED_RHF_SELF_STEP, 1.0e-10)
    assert_near(water631g_stretched_asym(water631g_stretched_rhf_d(), 13), 0.0, 1.0e-12)
    assert_near(water631g_stretched_trace2(water631g_stretched_rhf_d(), water631g_stretched_s_unit(), 13), 10.0, 1.0e-10)
    assert_near(water631g_stretched_e_elec(water631g_stretched_t_unit() + water631g_stretched_v_unit(), water631g_stretched_eri8_cart(), water631g_stretched_rhf_d() * 0.5, water631g_stretched_rhf_d() * 0.5, 13) + WATER631G_STRETCHED_E_NUC, WATER631G_STRETCHED_E_RHF_DEFAULT, 1.0e-10)
    assert_lt(WATER631G_STRETCHED_RHF_STABLE_SELF_STEP, 1.0e-10)
    assert_near(water631g_stretched_asym(water631g_stretched_rhf_stable_d(), 13), 0.0, 1.0e-12)
    assert_near(water631g_stretched_trace2(water631g_stretched_rhf_stable_d(), water631g_stretched_s_unit(), 13), 10.0, 1.0e-10)
    assert_near(water631g_stretched_e_elec(water631g_stretched_t_unit() + water631g_stretched_v_unit(), water631g_stretched_eri8_cart(), water631g_stretched_rhf_stable_d() * 0.5, water631g_stretched_rhf_stable_d() * 0.5, 13) + WATER631G_STRETCHED_E_NUC, WATER631G_STRETCHED_E_RHF_STABLE, 1.0e-10)
}
