def oh_sto3g_uhf_db() -> Arr {
    return oh_sto3g_mat(oh_sto3g_uhf_db_flat(), 6, 6)
}

# ---- OH_STO3G ROHF: nalpha 5, nbeta 4; default state is stable ----

OH_STO3G_E_ROHF = -74.36153072613816
OH_STO3G_E_ROHF_DEFAULT = -74.36153072613816
OH_STO3G_E_ROHF_STABLE = -74.36153072613816
# 1: no restart from the stability orbitals lowers the minao state; 0: one does; -1: not analyzed (stability restart).
OH_STO3G_ROHF_IS_STABLE = 1
OH_STO3G_ROHF_NALPHA = 5
OH_STO3G_ROHF_NBETA = 4

# Max |D' - D| after one PySCF step (get_fock, eig, get_occ, make_rdm1) from the default density below.
OH_STO3G_ROHF_SELF_STEP = 1.2753686995381486e-14
#| Converged alpha density, default state.
def oh_sto3g_rohf_da_flat() -> Arr {
    return [1.0569686713607962, -0.2417984195236519, -1.0726155470768565e-17, 2.624657416430829e-19,
        0.04214733450771532, -0.006051587389312103, -0.2417984195236519, 1.0540600991324967,
        -1.895385705390261e-17, -1.2592709540353528e-17, -0.23711487889936533, -0.07276221169742464,
        -1.0726155470768565e-17, -1.895385705390261e-17, 1.0000000000000002, -1.8381424694486874e-16,
        -1.5077376788154157e-16, 2.7377935679730006e-16, 2.624657416430829e-19, -1.2592709540353528e-17,
        -1.8381424694486874e-16, 1.0, 2.158406282699707e-16, 4.680122815975629e-17,
        0.04214733450771532, -0.23711487889936533, -1.5077376788154157e-16, 2.158406282699707e-16,
        0.4752325168369421, 0.3729430921632892, -0.006051587389312103, -0.07276221169742464,
        2.7377935679730006e-16, 4.680122815975629e-17, 0.3729430921632892, 0.3065460239591688]
}

def oh_sto3g_rohf_da() -> Arr {
    return oh_sto3g_mat(oh_sto3g_rohf_da_flat(), 6, 6)
}

#| Converged beta density, default state.
def oh_sto3g_rohf_db_flat() -> Arr {
    return [1.0569686713607962, -0.2417984195236519, -1.0944766864602213e-17, 6.759481997389739e-18,
        0.04214733450771532, -0.006051587389312103, -0.2417984195236519, 1.0540600991324967,
        -1.7377631999930662e-17, -5.943729352467973e-17, -0.23711487889936533, -0.07276221169742464,
        -1.0944766864602213e-17, -1.7377631999930662e-17, 0.9988690946571652, 0.033609915143310624,
        -1.4875159041833716e-16, 2.70715118382049e-16, 6.759481997389739e-18, -5.943729352467973e-17,
        0.033609915143310624, 0.0011309053428349934, 1.5574257198823354e-16, 1.378687907705098e-16,
        0.04214733450771532, -0.23711487889936533, -1.4875159041833716e-16, 1.5574257198823354e-16,
        0.4752325168369421, 0.3729430921632892, -0.006051587389312103, -0.07276221169742464,
        2.70715118382049e-16, 1.378687907705098e-16, 0.3729430921632892, 0.3065460239591688]
}

def oh_sto3g_rohf_db() -> Arr {
    return oh_sto3g_mat(oh_sto3g_rohf_db_flat(), 6, 6)
}

test "oh_sto3g packs" {
    assert_near(oh_sto3g_pack_bad(oh_sto3g_shells(), OH_STO3G_NSH, OH_STO3G_NPRIMTOT, OH_STO3G_NATOM), 0.0, 0.0)
    # nao_cart - nao_sph = sum over shells of ncart - nsph: 1 per d shell, 3 per f shell
    assert_near(OH_STO3G_NAO_CART - OH_STO3G_NAO_SPH, 0.0, 0.0)
    assert_near(len(oh_sto3g_fc()), OH_STO3G_NAO_CART, 0.0)
}

test "oh_sto3g unit one-electron integrals are symmetric with a unit overlap diagonal" {
    assert_near(oh_sto3g_asym(oh_sto3g_s_unit(), 6), 0.0, 1.0e-14)
    assert_near(oh_sto3g_asym(oh_sto3g_t_unit(), 6), 0.0, 1.0e-14)
    assert_near(oh_sto3g_asym(oh_sto3g_v_unit(), 6), 0.0, 1.0e-14)
    assert_near(oh_sto3g_diag_dev(oh_sto3g_s_unit(), 6), 0.0, 1.0e-14)
}

test "oh_sto3g unit packed ERIs match their checksums and the Schwarz bound" {
    assert_near(len(oh_sto3g_eri8_cart()), OH_STO3G_ERI8_CART_LEN, 0.0)
    assert_near(oh_sto3g_sumsq(oh_sto3g_eri8_cart()) / OH_STO3G_ERI8_CART_SUMSQ, 1.0, 1.0e-12)
    assert_near(oh_sto3g_wsum(oh_sto3g_eri8_cart(), OH_STO3G_SEED_WSUM), OH_STO3G_ERI8_CART_WSUM, 1.0e-12 * OH_STO3G_ERI8_CART_SUMSQ)
    assert_lt(oh_sto3g_schwarz(oh_sto3g_eri8_cart(), 6), 1.0e-12)
}

test "oh_sto3g uhf energies, labels and densities" {
    assert_lt(OH_STO3G_E_UHF_STABLE, OH_STO3G_E_UHF_DEFAULT + 1.0e-12)
    assert_lt(0.75 - 1.0e-10, OH_STO3G_UHF_S2)
    assert_lt(0.75 - 1.0e-10, OH_STO3G_UHF_S2_STABLE)
    assert_lt(OH_STO3G_UHF_SELF_STEP, 1.0e-10)
    assert_near(oh_sto3g_asym(oh_sto3g_uhf_da(), 6) + oh_sto3g_asym(oh_sto3g_uhf_db(), 6), 0.0, 1.0e-12)
    assert_near(oh_sto3g_trace2(oh_sto3g_uhf_da(), oh_sto3g_s_unit(), 6) + oh_sto3g_trace2(oh_sto3g_uhf_db(), oh_sto3g_s_unit(), 6), 9.0, 1.0e-10)
    assert_near(oh_sto3g_e_elec(oh_sto3g_t_unit() + oh_sto3g_v_unit(), oh_sto3g_eri8_cart(), oh_sto3g_uhf_da(), oh_sto3g_uhf_db(), 6) + OH_STO3G_E_NUC, OH_STO3G_E_UHF_DEFAULT, 1.0e-10)
}

test "oh_sto3g rohf energies, labels and densities" {
    assert_lt(OH_STO3G_E_ROHF_STABLE, OH_STO3G_E_ROHF_DEFAULT + 1.0e-12)
    assert_lt(OH_STO3G_ROHF_SELF_STEP, 1.0e-10)
    assert_near(oh_sto3g_asym(oh_sto3g_rohf_da(), 6) + oh_sto3g_asym(oh_sto3g_rohf_db(), 6), 0.0, 1.0e-12)
    assert_near(oh_sto3g_trace2(oh_sto3g_rohf_da(), oh_sto3g_s_unit(), 6) + oh_sto3g_trace2(oh_sto3g_rohf_db(), oh_sto3g_s_unit(), 6), 9.0, 1.0e-10)
    assert_near(oh_sto3g_e_elec(oh_sto3g_t_unit() + oh_sto3g_v_unit(), oh_sto3g_eri8_cart(), oh_sto3g_rohf_da(), oh_sto3g_rohf_db(), 6) + OH_STO3G_E_NUC, OH_STO3G_E_ROHF_DEFAULT, 1.0e-10)
}

test "oh_sto3g E_uhf <= E_rohf" {
    assert_lt(OH_STO3G_E_UHF_DEFAULT, OH_STO3G_E_ROHF_DEFAULT + 1.0e-12)
    assert_lt(OH_STO3G_E_UHF_STABLE, OH_STO3G_E_ROHF_STABLE + 1.0e-12)
}
