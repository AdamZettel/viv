def watertzvp_m() -> Arr {
    return watertzvp_mat(watertzvp_m_flat(), 48, 43)
}

# ---- WATERTZVP RHF: nalpha 5, nbeta 5; default state is stable ----

WATERTZVP_E_RHF = -76.05899070651952
WATERTZVP_E_RHF_DEFAULT = -76.05899070651952
WATERTZVP_E_RHF_STABLE = -76.05899070651952
# 1: no restart from the stability orbitals lowers the minao state; 0: one does; -1: not analyzed (stability restart).
WATERTZVP_RHF_IS_STABLE = 1
WATERTZVP_RHF_NALPHA = 5
WATERTZVP_RHF_NBETA = 5

# ---- WATERTZVP RHF (cart): nalpha 5, nbeta 5; default state is stable ----

WATERTZVP_E_RHF_CART = -76.0593966805151
WATERTZVP_E_RHF_DEFAULT_CART = -76.0593966805151
WATERTZVP_E_RHF_STABLE_CART = -76.0593966805151
# 1: no restart from the stability orbitals lowers the minao state; 0: one does; -1: not analyzed (stability restart).
WATERTZVP_RHF_IS_STABLE_CART = 1
WATERTZVP_RHF_NALPHA_CART = 5
WATERTZVP_RHF_NBETA_CART = 5

test "watertzvp packs" {
    assert_near(watertzvp_pack_bad(watertzvp_shells(), WATERTZVP_NSH, WATERTZVP_NPRIMTOT, WATERTZVP_NATOM), 0.0, 0.0)
    # nao_cart - nao_sph = sum over shells of ncart - nsph: 1 per d shell, 3 per f shell
    assert_near(WATERTZVP_NAO_CART - WATERTZVP_NAO_SPH, 5.0, 0.0)
    assert_near(len(watertzvp_fc()), WATERTZVP_NAO_CART, 0.0)
}

test "watertzvp sph one-electron integrals are symmetric with a unit overlap diagonal" {
    assert_near(watertzvp_asym(watertzvp_s_sph(), 43), 0.0, 1.0e-14)
    assert_near(watertzvp_asym(watertzvp_t_sph(), 43), 0.0, 1.0e-14)
    assert_near(watertzvp_asym(watertzvp_v_sph(), 43), 0.0, 1.0e-14)
    assert_near(watertzvp_diag_dev(watertzvp_s_sph(), 43), 0.0, 1.0e-14)
}

test "watertzvp sph sampled ERIs obey the Schwarz bound" {
    assert_near(len(watertzvp_eri8_sph_idx()), 256.0, 0.0)
    assert_near(len(watertzvp_eri8_sph_diag()), 946.0, 0.0)
    assert_lt(watertzvp_sample_schwarz(watertzvp_eri8_sph_idx(), watertzvp_eri8_sph_val(), watertzvp_eri8_sph_diag()), 1.0e-12)
    assert_lt(0.0, WATERTZVP_ERI8_SPH_SUMSQ)
}

test "watertzvp unit one-electron integrals are symmetric with a unit overlap diagonal" {
    assert_near(watertzvp_asym(watertzvp_s_unit(), 48), 0.0, 1.0e-14)
    assert_near(watertzvp_asym(watertzvp_t_unit(), 48), 0.0, 1.0e-14)
    assert_near(watertzvp_asym(watertzvp_v_unit(), 48), 0.0, 1.0e-14)
    assert_near(watertzvp_diag_dev(watertzvp_s_unit(), 48), 0.0, 1.0e-14)
}

test "watertzvp unit sampled ERIs obey the Schwarz bound" {
    assert_near(len(watertzvp_eri8_cart_idx()), 256.0, 0.0)
    assert_near(len(watertzvp_eri8_cart_diag()), 1176.0, 0.0)
    assert_lt(watertzvp_sample_schwarz(watertzvp_eri8_cart_idx(), watertzvp_eri8_cart_val(), watertzvp_eri8_cart_diag()), 1.0e-12)
    assert_lt(0.0, WATERTZVP_ERI8_CART_SUMSQ)
}

test "watertzvp M^T X_unit M is the spherical X" {
    assert_lt(watertzvp_mtxm_dev(watertzvp_m(), watertzvp_s_unit(), watertzvp_s_sph(), 48, 43), 1.0e-13)
    assert_lt(watertzvp_mtxm_dev(watertzvp_m(), watertzvp_t_unit(), watertzvp_t_sph(), 48, 43), 1.0e-13)
    assert_lt(watertzvp_mtxm_dev(watertzvp_m(), watertzvp_v_unit(), watertzvp_v_sph(), 48, 43), 1.0e-13)
}

test "watertzvp rhf energies, labels and densities" {
    assert_lt(WATERTZVP_E_RHF_STABLE, WATERTZVP_E_RHF_DEFAULT + 1.0e-12)
}

test "watertzvp rhf cart energies, labels and densities" {
    assert_lt(WATERTZVP_E_RHF_STABLE_CART, WATERTZVP_E_RHF_DEFAULT_CART + 1.0e-12)
}
