test "o2_sto3g packs" {
    assert_near(o2_sto3g_pack_bad(o2_sto3g_shells(), O2_STO3G_NSH, O2_STO3G_NPRIMTOT, O2_STO3G_NATOM), 0.0, 0.0)
    # nao_cart - nao_sph = sum over shells of ncart - nsph: 1 per d shell, 3 per f shell
    assert_near(O2_STO3G_NAO_CART - O2_STO3G_NAO_SPH, 0.0, 0.0)
    assert_near(len(o2_sto3g_fc()), O2_STO3G_NAO_CART, 0.0)
}

test "o2_sto3g unit one-electron integrals are symmetric with a unit overlap diagonal" {
    assert_near(o2_sto3g_asym(o2_sto3g_s_unit(), 10), 0.0, 1.0e-14)
    assert_near(o2_sto3g_asym(o2_sto3g_t_unit(), 10), 0.0, 1.0e-14)
    assert_near(o2_sto3g_asym(o2_sto3g_v_unit(), 10), 0.0, 1.0e-14)
    assert_near(o2_sto3g_diag_dev(o2_sto3g_s_unit(), 10), 0.0, 1.0e-14)
}

test "o2_sto3g unit packed ERIs match their checksums and the Schwarz bound" {
    assert_near(len(o2_sto3g_eri8_cart()), O2_STO3G_ERI8_CART_LEN, 0.0)
    assert_near(o2_sto3g_sumsq(o2_sto3g_eri8_cart()) / O2_STO3G_ERI8_CART_SUMSQ, 1.0, 1.0e-12)
    assert_near(o2_sto3g_wsum(o2_sto3g_eri8_cart(), O2_STO3G_SEED_WSUM), O2_STO3G_ERI8_CART_WSUM, 1.0e-12 * O2_STO3G_ERI8_CART_SUMSQ)
    assert_lt(o2_sto3g_schwarz(o2_sto3g_eri8_cart(), 10), 1.0e-12)
}

test "o2_sto3g uhf energies, labels and densities" {
    assert_lt(O2_STO3G_E_UHF_STABLE, O2_STO3G_E_UHF_DEFAULT + 1.0e-12)
    assert_lt(2.0 - 1.0e-10, O2_STO3G_UHF_S2)
    assert_lt(2.0 - 1.0e-10, O2_STO3G_UHF_S2_STABLE)
    assert_lt(O2_STO3G_UHF_SELF_STEP, 1.0e-10)
    assert_near(o2_sto3g_asym(o2_sto3g_uhf_da(), 10) + o2_sto3g_asym(o2_sto3g_uhf_db(), 10), 0.0, 1.0e-12)
    assert_near(o2_sto3g_trace2(o2_sto3g_uhf_da(), o2_sto3g_s_unit(), 10) + o2_sto3g_trace2(o2_sto3g_uhf_db(), o2_sto3g_s_unit(), 10), 16.0, 1.0e-10)
    assert_near(o2_sto3g_e_elec(o2_sto3g_t_unit() + o2_sto3g_v_unit(), o2_sto3g_eri8_cart(), o2_sto3g_uhf_da(), o2_sto3g_uhf_db(), 10) + O2_STO3G_E_NUC, O2_STO3G_E_UHF_DEFAULT, 1.0e-10)
    assert_lt(O2_STO3G_UHF_STABLE_SELF_STEP, 1.0e-10)
    assert_near(o2_sto3g_asym(o2_sto3g_uhf_stable_da(), 10) + o2_sto3g_asym(o2_sto3g_uhf_stable_db(), 10), 0.0, 1.0e-12)
    assert_near(o2_sto3g_trace2(o2_sto3g_uhf_stable_da(), o2_sto3g_s_unit(), 10) + o2_sto3g_trace2(o2_sto3g_uhf_stable_db(), o2_sto3g_s_unit(), 10), 16.0, 1.0e-10)
    assert_near(o2_sto3g_e_elec(o2_sto3g_t_unit() + o2_sto3g_v_unit(), o2_sto3g_eri8_cart(), o2_sto3g_uhf_stable_da(), o2_sto3g_uhf_stable_db(), 10) + O2_STO3G_E_NUC, O2_STO3G_E_UHF_STABLE, 1.0e-10)
}

test "o2_sto3g rohf energies, labels and densities" {
    assert_lt(O2_STO3G_E_ROHF_STABLE, O2_STO3G_E_ROHF_DEFAULT + 1.0e-12)
    assert_lt(O2_STO3G_ROHF_SELF_STEP, 1.0e-10)
    assert_near(o2_sto3g_asym(o2_sto3g_rohf_da(), 10) + o2_sto3g_asym(o2_sto3g_rohf_db(), 10), 0.0, 1.0e-12)
    assert_near(o2_sto3g_trace2(o2_sto3g_rohf_da(), o2_sto3g_s_unit(), 10) + o2_sto3g_trace2(o2_sto3g_rohf_db(), o2_sto3g_s_unit(), 10), 16.0, 1.0e-10)
    assert_near(o2_sto3g_e_elec(o2_sto3g_t_unit() + o2_sto3g_v_unit(), o2_sto3g_eri8_cart(), o2_sto3g_rohf_da(), o2_sto3g_rohf_db(), 10) + O2_STO3G_E_NUC, O2_STO3G_E_ROHF_DEFAULT, 1.0e-10)
    assert_lt(O2_STO3G_ROHF_STABLE_SELF_STEP, 1.0e-10)
    assert_near(o2_sto3g_asym(o2_sto3g_rohf_stable_da(), 10) + o2_sto3g_asym(o2_sto3g_rohf_stable_db(), 10), 0.0, 1.0e-12)
    assert_near(o2_sto3g_trace2(o2_sto3g_rohf_stable_da(), o2_sto3g_s_unit(), 10) + o2_sto3g_trace2(o2_sto3g_rohf_stable_db(), o2_sto3g_s_unit(), 10), 16.0, 1.0e-10)
    assert_near(o2_sto3g_e_elec(o2_sto3g_t_unit() + o2_sto3g_v_unit(), o2_sto3g_eri8_cart(), o2_sto3g_rohf_stable_da(), o2_sto3g_rohf_stable_db(), 10) + O2_STO3G_E_NUC, O2_STO3G_E_ROHF_STABLE, 1.0e-10)
}

test "o2_sto3g E_uhf <= E_rohf" {
    assert_lt(O2_STO3G_E_UHF_DEFAULT, O2_STO3G_E_ROHF_DEFAULT + 1.0e-12)
    assert_lt(O2_STO3G_E_UHF_STABLE, O2_STO3G_E_ROHF_STABLE + 1.0e-12)
}
