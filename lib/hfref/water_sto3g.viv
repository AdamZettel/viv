def watersto3g_s_sph() -> Arr {
    return watersto3g_s_unit()
}

def watersto3g_t_sph() -> Arr {
    return watersto3g_t_unit()
}

def watersto3g_v_sph() -> Arr {
    return watersto3g_v_unit()
}

#| Only s and p: the spherical and Cartesian sets are the same.
def watersto3g_eri8_sph() -> Arr {
    return watersto3g_eri8_cart()
}

def watersto3g_m() -> Arr {
    return watersto3g_eye(7)
}

# ---- WATERSTO3G RHF: nalpha 5, nbeta 5; default state is stable ----

WATERSTO3G_E_RHF = -74.9630631297292
WATERSTO3G_E_RHF_DEFAULT = -74.9630631297292
WATERSTO3G_E_RHF_STABLE = -74.9630631297292
# 1: no restart from the stability orbitals lowers the minao state; 0: one does; -1: not analyzed (stability restart).
WATERSTO3G_RHF_IS_STABLE = 1
WATERSTO3G_RHF_NALPHA = 5
WATERSTO3G_RHF_NBETA = 5

# Max |D' - D| after one PySCF step (get_fock, eig, get_occ, make_rdm1) from the default density below.
WATERSTO3G_RHF_SELF_STEP = 1.9912960169676808e-12
