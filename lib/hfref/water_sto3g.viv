test "watersto3g packs" {
    assert_near(watersto3g_pack_bad(watersto3g_shells(), WATERSTO3G_NSH, WATERSTO3G_NPRIMTOT, WATERSTO3G_NATOM), 0.0, 0.0)
    # nao_cart - nao_sph = sum over shells of ncart - nsph: 1 per d shell, 3 per f shell
    assert_near(WATERSTO3G_NAO_CART - WATERSTO3G_NAO_SPH, 0.0, 0.0)
    assert_near(len(watersto3g_fc()), WATERSTO3G_NAO_CART, 0.0)
}

test "watersto3g unit one-electron integrals are symmetric with a unit overlap diagonal" {
    assert_near(watersto3g_asym(watersto3g_s_unit(), 7), 0.0, 1.0e-14)
    assert_near(watersto3g_asym(watersto3g_t_unit(), 7), 0.0, 1.0e-14)
    assert_near(watersto3g_asym(watersto3g_v_unit(), 7), 0.0, 1.0e-14)
    assert_near(watersto3g_diag_dev(watersto3g_s_unit(), 7), 0.0, 1.0e-14)
}

test "watersto3g unit packed ERIs match their checksums and the Schwarz bound" {
    assert_near(len(watersto3g_eri8_cart()), WATERSTO3G_ERI8_CART_LEN, 0.0)
    assert_near(watersto3g_sumsq(watersto3g_eri8_cart()) / WATERSTO3G_ERI8_CART_SUMSQ, 1.0, 1.0e-12)
    assert_near(watersto3g_wsum(watersto3g_eri8_cart(), WATERSTO3G_SEED_WSUM), WATERSTO3G_ERI8_CART_WSUM, 1.0e-12 * WATERSTO3G_ERI8_CART_SUMSQ)
    assert_lt(watersto3g_schwarz(watersto3g_eri8_cart(), 7), 1.0e-12)
}

test "watersto3g rhf energies, labels and densities" {
    assert_lt(WATERSTO3G_E_RHF_STABLE, WATERSTO3G_E_RHF_DEFAULT + 1.0e-12)
    assert_lt(WATERSTO3G_RHF_SELF_STEP, 1.0e-10)
    assert_near(watersto3g_asym(watersto3g_rhf_d(), 7), 0.0, 1.0e-12)
    assert_near(watersto3g_trace2(watersto3g_rhf_d(), watersto3g_s_unit(), 7), 10.0, 1.0e-10)
    assert_near(watersto3g_e_elec(watersto3g_t_unit() + watersto3g_v_unit(), watersto3g_eri8_cart(), watersto3g_rhf_d() * 0.5, watersto3g_rhf_d() * 0.5, 7) + WATERSTO3G_E_NUC, WATERSTO3G_E_RHF_DEFAULT, 1.0e-10)
}

test "watersto3g uhf energies, labels and densities" {
    assert_lt(WATERSTO3G_E_UHF_STABLE, WATERSTO3G_E_UHF_DEFAULT + 1.0e-12)
    assert_lt(0.0 - 1.0e-10, WATERSTO3G_UHF_S2)
    assert_lt(0.0 - 1.0e-10, WATERSTO3G_UHF_S2_STABLE)
    assert_lt(WATERSTO3G_UHF_SELF_STEP, 1.0e-10)
    assert_near(watersto3g_asym(watersto3g_uhf_da(), 7) + watersto3g_asym(watersto3g_uhf_db(), 7), 0.0, 1.0e-12)
    assert_near(watersto3g_trace2(watersto3g_uhf_da(), watersto3g_s_unit(), 7) + watersto3g_trace2(watersto3g_uhf_db(), watersto3g_s_unit(), 7), 10.0, 1.0e-10)
    assert_near(watersto3g_e_elec(watersto3g_t_unit() + watersto3g_v_unit(), watersto3g_eri8_cart(), watersto3g_uhf_da(), watersto3g_uhf_db(), 7) + WATERSTO3G_E_NUC, WATERSTO3G_E_UHF_DEFAULT, 1.0e-10)
}
