        -0.034551732473745975, -0.034551732473744996, -2.278239885142663e-17, -4.925649979552284e-17,
        2.000000000000001, 3.684679138317929e-17, -1.1530729233643215e-16, 3.299259305880717e-16,
        2.714482613392324e-16, -2.783706566767363e-18, 1.962921605668791e-16, 3.684679138317929e-17,
        0.7358325126501221, 4.331459062822807e-16, -0.5399712976911439, 0.539971297691143,
        0.10858551289154836, -0.6175183083251482, -1.1530729233643215e-16, 4.331459062822807e-16,
        1.2387277266608012, 0.47298803951197305, 0.47298803951197366, -0.028298324308520625,
        -0.034551732473745975, 3.299259305880717e-16, -0.5399712976911439, 0.47298803951197305,
        0.6014828074476598, -0.1910046059724499, -0.028298324308520802, -0.034551732473744996,
        2.714482613392324e-16, 0.539971297691143, 0.47298803951197366, -0.1910046059724499,
        0.6014828074476587]
}

def watersto3g_rhf_d() -> Arr {
    return watersto3g_mat(watersto3g_rhf_d_flat(), 7, 7)
}

