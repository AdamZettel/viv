###
post: MINPACK's lmder, Levenberg-Marquardt least squares with a trust region
agent: claude

A port of `lmder.f` and `lmder1.f` from netlib MINPACK (lib/minpack/ref),
with the Fortran's arithmetic in the Fortran's order, so that the iterates
match a gfortran build of the original to the last bit where the problem's
own functions do. The explanation is in lib/minpack/lmder.intent; the checks
are in lib/minpack/mgh_check.viv and lib/minpack/check.sh.

**The function.** `fcn(data, x, fvec, fjac, iflag)` is a def: for `iflag` 1
it writes the m residuals at x into fvec, for 2 the m x n Jacobian into fjac,
for 0 it may print; it returns iflag, or a negative number to stop lmder.
`data` is any array the function needs (a problem number, measurements).

**Differences from the Fortran**, none of which changes an operation:

- indices count from 0, and `ipvt` holds 0-based column numbers;
- `fjac` is an `m x n` array instead of a leading-dimension array;
- the work arrays wa1 ... wa4 are allocated here instead of passed in;
- `info` is returned, and nfev and njev are written into `counts[0]` and
  `counts[1]`;
- every trial step writes one row into `hist` (the Fortran has no such
  record; it is what lets a test compare iterates, and a plot draw them).
  The columns are the H_ constants below. A `hist` with fewer rows than
  trial steps keeps the first rows; pass `zeros(1, H_X + n)` to keep none
  worth reading.

Used with `import minpack.lmder`.
###

from minpack.lmpar import lmpar
from minpack.qrfac import qrfac
from minpack.enorm import enorm, EPSMCH

# The columns of one row of hist: one row per trial step.
H_ITER = 0
H_NFEV = 1
H_DELTA_IN = 2
H_PAR_LM = 3
H_PNORM = 4
H_FNORM1 = 5
H_ACTRED = 6
H_PRERED = 7
H_RATIO = 8
H_DELTA = 9
H_PAR = 10
H_ACCEPT = 11
H_FNORM = 12
H_GNORM = 13
H_X = 14

# The thresholds of the trust region, from the data statement of lmder.f
# (the Fortran's names in parentheses). The halves (p5 there: `temp = 0.5`,
# `delta = pnorm / 0.5`, `par = 0.5 * par`, `/ 0.5` in prered and
# `0.5 * ratio`) stay written as 0.5, as the formulas they are part of.
#
# A trial step whose ratio of actual to predicted reduction is at most this
# shrinks the radius (p25).
LM_RATIO_SHRINK = 0.25
# A ratio at least this expands it to twice the step's length (p75).
LM_RATIO_EXPAND = 0.75
# A ratio at least this accepts the step: x moves to x + p (p0001).
LM_RATIO_ACCEPT = 0.0001
# The smallest factor t a shrink multiplies the radius by; the shrunk
# radius is t * min(delta, pnorm / LM_SHRINK_MIN), so it is also at most 10 t
# times the step's length (p1).
LM_SHRINK_MIN = 0.1
# A trial norm fnorm1 at least 1 / LM_RISE_LIMIT = 10 times fnorm counts as
# actred = -1 without squaring the quotient (which could overflow), and
# shrinks the radius by the full LM_SHRINK_MIN (p1).
LM_RISE_LIMIT = 0.1
# lmder1's settings (lmder1.f): the evaluations of f allowed per variable,
# plus one, and the initial radius as a multiple of |D x| (factor).
LMDER1_MAXFEV_PER = 100.0
LMDER1_FACTOR = 100.0

def lmder(fcn, data: Arr, x: Arr, fvec: Arr, fjac: Arr, ftol, xtol, gtol, maxfev, diag: Arr, mode, factor, nprint, ipvt: Arr, qtf: Arr, counts: Arr, hist: Arr) {
    m = len(fvec)
    n = len(x)
    step setup {
        wa1 = zeros(n)
        wa2 = zeros(n)
        wa3 = zeros(n)
        wa4 = zeros(m)
        epsmch = EPSMCH
        info = 0
        iflag = 0
        nfev = 0
        njev = 0
        nrow = 0
        par = 0.0
        iter = 1
        fnorm = 0.0
        fnorm1 = 0.0
        xnorm = 0.0
        delta = 0.0
        gnorm = 0.0
        pnorm = 0.0
        actred = 0.0
        prered = 0.0
        ratio = 0.0
        # what lmpar was given and returned, for hist
        delta_in = 0.0
        par_lm = 0.0
    }
    step check_input {
        ok = n > 0 and m >= n and ftol >= 0.0 and xtol >= 0.0 and gtol >= 0.0 and maxfev > 0 and factor > 0.0
        if ok and mode == 2 {
            for j to n {
                if diag[j] <= 0.0 {
                    ok = false
                }
            }
        }
    }
    if ok {
        step start {
            iflag = fcn(data, x, fvec, fjac, 1.0)
            nfev = 1
            fnorm = enorm(m, fvec)
        }
    }
    quit = not ok or iflag < 0
    while not quit {
        step jacobian {
            iflag = fcn(data, x, fvec, fjac, 2.0)
            njev = njev + 1
        }
        if iflag < 0 {
            break
        }
        if nprint > 0 {
            iflag = 0.0
            if mod(iter - 1.0, nprint) == 0.0 {
                iflag = fcn(data, x, fvec, fjac, 0.0)
            }
            if iflag < 0 {
                break
            }
        }
        step qr {
            qrfac(m, n, fjac, true, ipvt, wa1, wa2, wa3)
        }
        if iter == 1 {
            step scale {
                if mode != 2 {
                    for j to n {
                        diag[j] = wa2[j]
                        if wa2[j] == 0.0 {
                            diag[j] = 1.0
                        }
                    }
                }
            }
            step first_radius {
                for j to n {
                    wa3[j] = diag[j] * x[j]
                }
                xnorm = enorm(n, wa3)
                delta = factor * xnorm
                if delta == 0.0 {
                    delta = factor
                }
            }
        }
        step qtf {
            for i to m {
                wa4[i] = fvec[i]
            }
            for j to n {
                if fjac[j, j] != 0.0 {
                    sum = 0.0
                    for ii to m - j {
                        sum = sum + fjac[j + ii, j] * wa4[j + ii]
                    }
                    temp = -sum / fjac[j, j]
                    for ii to m - j {
                        wa4[j + ii] = wa4[j + ii] + fjac[j + ii, j] * temp
                    }
                }
                fjac[j, j] = wa1[j]
                qtf[j] = wa4[j]
            }
        }
        step gradient {
            gnorm = 0.0
            if fnorm != 0.0 {
                for j to n {
                    l = ipvt[j]
                    if wa2[l] != 0.0 {
                        sum = 0.0
                        for i to j + 1 {
                            sum = sum + fjac[i, j] * (qtf[i] / fnorm)
                        }
                        gnorm = max(gnorm, abs(sum / wa2[l]))
                    }
                }
            }
            if gnorm <= gtol {
                info = 4
            }
        }
        if info != 0 {
            break
        }
        if mode != 2 {
            step rescale {
                for j to n {
                    diag[j] = max(diag[j], wa2[j])
                }
            }
        }
        while true {
            step lm_parameter {
                delta_in = delta
                par = lmpar(n, fjac, ipvt, diag, qtf, delta, par, wa1, wa2, wa3, wa4)
                par_lm = par
            }
            step trial {
                for j to n {
                    wa1[j] = -wa1[j]
                    wa2[j] = x[j] + wa1[j]
                    wa3[j] = diag[j] * wa1[j]
                }
                pnorm = enorm(n, wa3)
                if iter == 1 {
                    delta = min(delta, pnorm)
                }
            }
            step evaluate {
                iflag = fcn(data, wa2, wa4, fjac, 1.0)
                nfev = nfev + 1
            }
            if iflag < 0 {
                quit = true
                break
            }
            step reductions {
                step actual {
                    fnorm1 = enorm(m, wa4)
                    actred = -1.0
                    if LM_RISE_LIMIT * fnorm1 < fnorm {
                        q = fnorm1 / fnorm
                        actred = 1.0 - q * q
                    }
                }
                step predicted {
                    for j to n {
                        wa3[j] = 0.0
                        l = ipvt[j]
                        temp = wa1[l]
                        for i to j + 1 {
                            wa3[i] = wa3[i] + fjac[i, j] * temp
                        }
                    }
                    temp1 = enorm(n, wa3) / fnorm
                    temp2 = (sqrt(par) * pnorm) / fnorm
                    prered = temp1 * temp1 + (temp2 * temp2) / 0.5
                    dirder = -(temp1 * temp1 + temp2 * temp2)
                }
                step quotient {
                    ratio = 0.0
                    if prered != 0.0 {
                        ratio = actred / prered
                    }
                }
            }
            step radius {
                if ratio <= LM_RATIO_SHRINK {
                    step shrink {
                        if actred >= 0.0 {
                            temp = 0.5
                        }
                        if actred < 0.0 {
                            temp = 0.5 * dirder / (dirder + 0.5 * actred)
                        }
                        if LM_RISE_LIMIT * fnorm1 >= fnorm or temp < LM_SHRINK_MIN {
                            temp = LM_SHRINK_MIN
                        }
                        delta = temp * min(delta, pnorm / LM_SHRINK_MIN)
                        par = par / temp
                    }
                } else if par == 0.0 or ratio >= LM_RATIO_EXPAND {
                    step expand {
                        delta = pnorm / 0.5
                        par = 0.5 * par
                    }
                }
            }
            if ratio >= LM_RATIO_ACCEPT {
                step accept {
                    for j to n {
                        x[j] = wa2[j]
                        wa2[j] = diag[j] * x[j]
                    }
                    for i to m {
                        fvec[i] = wa4[i]
                    }
                    xnorm = enorm(n, wa2)
                    fnorm = fnorm1
                    iter = iter + 1
                }
            }
            step history {
                if nrow < len(hist) {
                    hist[nrow, H_ITER] = iter
                    hist[nrow, H_NFEV] = nfev
                    hist[nrow, H_DELTA_IN] = delta_in
                    hist[nrow, H_PAR_LM] = par_lm
                    hist[nrow, H_PNORM] = pnorm
                    hist[nrow, H_FNORM1] = fnorm1
                    hist[nrow, H_ACTRED] = actred
                    hist[nrow, H_PRERED] = prered
                    hist[nrow, H_RATIO] = ratio
                    hist[nrow, H_DELTA] = delta
                    hist[nrow, H_PAR] = par
                    hist[nrow, H_ACCEPT] = 0.0
                    if ratio >= LM_RATIO_ACCEPT {
                        hist[nrow, H_ACCEPT] = 1.0
                    }
                    hist[nrow, H_FNORM] = fnorm
                    hist[nrow, H_GNORM] = gnorm
                    for j to n {
                        hist[nrow, H_X + j] = x[j]
                    }
                }
                nrow = nrow + 1
            }
            step converged {
                if abs(actred) <= ftol and prered <= ftol and 0.5 * ratio <= 1.0 {
                    info = 1
                }
                if delta <= xtol * xnorm {
                    info = 2
                }
                if abs(actred) <= ftol and prered <= ftol and 0.5 * ratio <= 1.0 and info == 2 {
                    info = 3
                }
            }
            if info != 0 {
                quit = true
                break
            }
            step stringent {
                if nfev >= maxfev {
                    info = 5
                }
                if abs(actred) <= epsmch and prered <= epsmch and 0.5 * ratio <= 1.0 {
                    info = 6
                }
                if delta <= epsmch * xnorm {
                    info = 7
                }
                if gnorm <= epsmch {
                    info = 8
                }
            }
            if info != 0 {
                quit = true
                break
            }
            if ratio >= LM_RATIO_ACCEPT {
                break
            }
        }
    }
    step finish {
        if iflag < 0 {
            info = iflag
        }
        iflag = 0.0
        if nprint > 0 {
            fcn(data, x, fvec, fjac, 0.0)
        }
        counts[0] = nfev
        counts[1] = njev
    }
    return info
}

# The evaluations of f lmder1 allows for n variables (maxfev in lmder1.f).
def lmder1_maxfev(n) {
    return LMDER1_MAXFEV_PER * (n + 1.0)
}

def lmder1(fcn, data: Arr, x: Arr, fvec: Arr, fjac: Arr, tol, ipvt: Arr, counts: Arr, hist: Arr) {
    n = len(x)
    m = len(fvec)
    info = 0
    if n > 0 and m >= n and tol >= 0.0 {
        diag = zeros(n)
        qtf = zeros(n)
        maxfev = lmder1_maxfev(n)
        info = lmder(fcn, data, x, fvec, fjac, tol, tol, 0.0, maxfev, diag, 1.0, LMDER1_FACTOR, 0.0, ipvt, qtf, counts, hist)
        if info == 8 {
            info = 4
        }
    }
    return info
}

# ---- tests --------------------------------------------------------------

# Rosenbrock's function as residuals, f1 = 10 (x2 - x1^2) and f2 = 1 - x1,
# written as MINPACK's test driver writes it.
#~ test
def lm_rosenbrock(data: Arr, x: Arr, fvec: Arr, fjac: Arr, iflag) {
    if iflag == 1 {
        fvec[0] = 10.0 * (x[1] - x[0] * x[0])
        fvec[1] = 1.0 - x[0]
    }
    if iflag == 2 {
        fjac[0, 0] = -(20.0 * x[0])
        fjac[0, 1] = 10.0
        fjac[1, 0] = -1.0
        fjac[1, 1] = 0.0
    }
    # data[0] > 0: stop (return -1) at that many residual evaluations
    if iflag == 1 and data[0] > 0.0 {
        data[1] = data[1] + 1.0
        if data[1] >= data[0] {
            return -1.0
        }
    }
    return iflag
}

