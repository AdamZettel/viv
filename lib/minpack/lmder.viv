test "Rosenbrock from (-1.2, 1): info 4 at x = (1, 1) after 21 evaluations of f and 16 of J, as in the Fortran" {
    x = [-1.2, 1.0]
    counts = zeros(2)
    hist = zeros(lmder1_maxfev(len(x)), H_X + len(x))
    info = lmder1(lm_rosenbrock, [0.0, 0.0], x, zeros(2), zeros(2, 2), sqrt(EPSMCH), zeros(2), counts, hist)
    assert_near(info, 4.0, 0.0)
    assert_near(counts[0], 21.0, 0.0)
    assert_near(counts[1], 16.0, 0.0)
    assert_near(x[0], 1.0, 0.0)
    assert_near(x[1], 1.0, 0.0)
}

test "all 20 trial steps on Rosenbrock equal the Fortran's, every recorded number to the last bit" {
    x = [-1.2, 1.0]
    hist = zeros(lmder1_maxfev(len(x)), H_X + len(x))
    lmder1(lm_rosenbrock, [0.0, 0.0], x, zeros(2), zeros(2, 2), sqrt(EPSMCH), zeros(2), zeros(2), hist)
    ref = lm_rosenbrock_oracle()
    for r to len(ref) {
        for c to H_X + len(x) {
            assert_near(hist[r, c], ref[r, c], 0.0)
        }
    }
    # and no trial step after the Fortran's last
    assert_near(hist[len(ref), H_NFEV], 0.0, 0.0)
}

test "5 of the 20 trial steps on Rosenbrock are rejected, and fnorm never rises" {
    x = [-1.2, 1.0]
    hist = zeros(lmder1_maxfev(len(x)), H_X + len(x))
    counts = zeros(2)
    lmder1(lm_rosenbrock, [0.0, 0.0], x, zeros(2), zeros(2, 2), sqrt(EPSMCH), zeros(2), counts, hist)
    rejected = 0.0
    prev = 4.919349550499537
    # every evaluation of f after the first is one trial step
    for r to counts[0] - 1.0 {
        if hist[r, H_ACCEPT] == 0.0 {
            rejected = rejected + 1.0
        }
        assert_true(hist[r, H_FNORM] <= prev)
        prev = hist[r, H_FNORM]
    }
    assert_near(rejected, 5.0, 0.0)
}

test "a function that returns -1 stops lmder, and info is -1" {
    x = [-1.2, 1.0]
    counts = zeros(2)
    info = lmder1(lm_rosenbrock, [5.0, 0.0], x, zeros(2), zeros(2, 2), sqrt(EPSMCH), zeros(2), counts, zeros(1, H_X + 2))
    assert_near(info, -1.0, 0.0)
    assert_near(counts[0], 5.0, 0.0)
}

test "improper input gives info 0 without evaluating anything" {
    counts = zeros(2)
    info = lmder1(lm_rosenbrock, [0.0, 0.0], [-1.2, 1.0], zeros(2), zeros(2, 2), -1.0, zeros(2), counts, zeros(1, H_X + 2))
    assert_near(info, 0.0, 0.0)
    assert_near(counts[0], 0.0, 0.0)
}

test "Rosenbrock's first trial is the Gauss-Newton step, 71.7 long in a radius of 3051; f grows from 4.92 to 48.4, ratio -95.8, and the radius drops to 7.17" {
    x = [-1.2, 1.0]
    hist = zeros(lmder1_maxfev(len(x)), H_X + len(x))
    lmder1(lm_rosenbrock, [0.0, 0.0], x, zeros(2), zeros(2, 2), sqrt(EPSMCH), zeros(2), zeros(2), hist)
    assert_near(hist[0, H_DELTA_IN], 3051.03, 0.01)
    assert_near(hist[0, H_PAR_LM], 0.0, 0.0)
    assert_near(hist[0, H_PNORM], 71.66, 0.01)
    assert_near(hist[0, H_FNORM], 4.919, 0.001)
    assert_near(hist[0, H_FNORM1], 48.4, 1.0e-9)
    assert_near(hist[0, H_RATIO], -95.8, 1.0e-9)
    assert_near(hist[0, H_DELTA], 7.166, 0.001)
    assert_near(hist[0, H_ACCEPT], 0.0, 0.0)
    # the second trial, with par = 0.0078, is accepted
    assert_near(hist[1, H_PAR_LM], 0.0078, 0.0001)
    assert_near(hist[1, H_ACCEPT], 1.0, 0.0)
}

