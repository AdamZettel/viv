lmder  @b769c32b
  watch per iteration  fnorm, par, delta, ratio, pnorm, x
  watch at radius      nfev, fnorm1, ratio, delta
  hold per iteration   delta > 0.0                                 "the trust radius stays positive"
  hold per iteration   par >= 0.0                                  "the Levenberg-Marquardt parameter is never negative"
  hold at reductions   prered >= 0.0                               "the predicted reduction is a sum of squares"
  hold at reductions   ratio < LM_RATIO_ACCEPT or fnorm1 < fnorm   "a step the test will accept lowers the residual norm"
  hold at radius       ratio > LM_RATIO_SHRINK or (delta <= 0.5 * delta_in and delta <= 0.5 * (pnorm / LM_SHRINK_MIN))   "a poor step at least halves the radius, and leaves it at most 5 times the step's length"
  hold at radius       ratio <= LM_RATIO_SHRINK or not (par_lm == 0.0 or ratio >= LM_RATIO_EXPAND) or (delta == pnorm / 0.5 and par == 0.5 * par_lm)   "a good step, or a Gauss-Newton step, sets the radius to twice the step's length and halves par"
  watch at start         x, fnorm
  watch at jacobian      x, fjac
  watch at scale         diag
  watch at first_radius  xnorm, delta
  watch at gradient      gnorm
  watch at lm_parameter  delta_in, par_lm
  watch at trial         pnorm, delta
  watch at actual        fnorm, fnorm1, actred
  watch at predicted     prered
  watch at quotient      ratio
  watch at shrink        pnorm, delta, par
  watch at expand        ratio, pnorm, delta, par
  watch at accept        x, fnorm, xnorm
  watch at finish        nfev, njev, x
