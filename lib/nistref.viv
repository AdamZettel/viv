test "the NIST energies add up the way NIST says they do" {
    # Etot = Ekin + Ecoul + Eenuc + Exc, exactly, for every atom taken
    assert_near(H_LDA_ETOT, H_LDA_EKIN + H_LDA_ECOUL + H_LDA_EENUC + H_LDA_EXC, 2.0e-6)
    assert_near(HE_LDA_ETOT, HE_LDA_EKIN + HE_LDA_ECOUL + HE_LDA_EENUC + HE_LDA_EXC, 2.0e-6)
    assert_near(LI_LDA_ETOT, LI_LDA_EKIN + LI_LDA_ECOUL + LI_LDA_EENUC + LI_LDA_EXC, 2.0e-6)
    assert_near(BE_LDA_ETOT, BE_LDA_EKIN + BE_LDA_ECOUL + BE_LDA_EENUC + BE_LDA_EXC, 2.0e-6)
    assert_near(B_LDA_ETOT, B_LDA_EKIN + B_LDA_ECOUL + B_LDA_EENUC + B_LDA_EXC, 2.0e-6)
    assert_near(C_LDA_ETOT, C_LDA_EKIN + C_LDA_ECOUL + C_LDA_EENUC + C_LDA_EXC, 2.0e-6)
    assert_near(N_LDA_ETOT, N_LDA_EKIN + N_LDA_ECOUL + N_LDA_EENUC + N_LDA_EXC, 2.0e-6)
    assert_near(O_LDA_ETOT, O_LDA_EKIN + O_LDA_ECOUL + O_LDA_EENUC + O_LDA_EXC, 2.0e-6)
    assert_near(F_LDA_ETOT, F_LDA_EKIN + F_LDA_ECOUL + F_LDA_EENUC + F_LDA_EXC, 2.0e-6)
    assert_near(NE_LDA_ETOT, NE_LDA_EKIN + NE_LDA_ECOUL + NE_LDA_EENUC + NE_LDA_EXC, 2.0e-6)
    assert_near(NA_LDA_ETOT, NA_LDA_EKIN + NA_LDA_ECOUL + NA_LDA_EENUC + NA_LDA_EXC, 2.0e-6)
    assert_near(MG_LDA_ETOT, MG_LDA_EKIN + MG_LDA_ECOUL + MG_LDA_EENUC + MG_LDA_EXC, 2.0e-6)
    assert_near(AL_LDA_ETOT, AL_LDA_EKIN + AL_LDA_ECOUL + AL_LDA_EENUC + AL_LDA_EXC, 2.0e-6)
    assert_near(SI_LDA_ETOT, SI_LDA_EKIN + SI_LDA_ECOUL + SI_LDA_EENUC + SI_LDA_EXC, 2.0e-6)
    assert_near(P_LDA_ETOT, P_LDA_EKIN + P_LDA_ECOUL + P_LDA_EENUC + P_LDA_EXC, 2.0e-6)
    assert_near(S_LDA_ETOT, S_LDA_EKIN + S_LDA_ECOUL + S_LDA_EENUC + S_LDA_EXC, 2.0e-6)
    assert_near(CL_LDA_ETOT, CL_LDA_EKIN + CL_LDA_ECOUL + CL_LDA_EENUC + CL_LDA_EXC, 2.0e-6)
    assert_near(AR_LDA_ETOT, AR_LDA_EKIN + AR_LDA_ECOUL + AR_LDA_EENUC + AR_LDA_EXC, 2.0e-6)
}

test "the atoms are bound, their shells are ordered, and heavier is deeper" {
    # Every occupied level is below zero and they rise with n and l, which
    # is the shell structure the table is a table of.
    e_h = h_lda_eigs()
    for i to len(e_h) {
        assert_lt(e_h[i], 0.0)
    }
    for i to len(e_h) - 1 {
        assert_lt(e_h[i], e_h[i + 1])
    }
    e_he = he_lda_eigs()
    for i to len(e_he) {
        assert_lt(e_he[i], 0.0)
    }
    for i to len(e_he) - 1 {
        assert_lt(e_he[i], e_he[i + 1])
    }
    e_li = li_lda_eigs()
    for i to len(e_li) {
        assert_lt(e_li[i], 0.0)
    }
    for i to len(e_li) - 1 {
        assert_lt(e_li[i], e_li[i + 1])
    }
    e_be = be_lda_eigs()
    for i to len(e_be) {
        assert_lt(e_be[i], 0.0)
    }
    for i to len(e_be) - 1 {
        assert_lt(e_be[i], e_be[i + 1])
    }
    e_b = b_lda_eigs()
    for i to len(e_b) {
        assert_lt(e_b[i], 0.0)
    }
    for i to len(e_b) - 1 {
        assert_lt(e_b[i], e_b[i + 1])
    }
    e_c = c_lda_eigs()
    for i to len(e_c) {
        assert_lt(e_c[i], 0.0)
    }
    for i to len(e_c) - 1 {
        assert_lt(e_c[i], e_c[i + 1])
    }
    e_n = n_lda_eigs()
    for i to len(e_n) {
        assert_lt(e_n[i], 0.0)
    }
    for i to len(e_n) - 1 {
        assert_lt(e_n[i], e_n[i + 1])
    }
    e_o = o_lda_eigs()
    for i to len(e_o) {
        assert_lt(e_o[i], 0.0)
    }
    for i to len(e_o) - 1 {
        assert_lt(e_o[i], e_o[i + 1])
    }
    e_f = f_lda_eigs()
    for i to len(e_f) {
        assert_lt(e_f[i], 0.0)
    }
    for i to len(e_f) - 1 {
        assert_lt(e_f[i], e_f[i + 1])
    }
    e_ne = ne_lda_eigs()
    for i to len(e_ne) {
        assert_lt(e_ne[i], 0.0)
    }
    for i to len(e_ne) - 1 {
        assert_lt(e_ne[i], e_ne[i + 1])
    }
    e_na = na_lda_eigs()
    for i to len(e_na) {
        assert_lt(e_na[i], 0.0)
    }
    for i to len(e_na) - 1 {
        assert_lt(e_na[i], e_na[i + 1])
    }
    e_mg = mg_lda_eigs()
    for i to len(e_mg) {
        assert_lt(e_mg[i], 0.0)
    }
    for i to len(e_mg) - 1 {
        assert_lt(e_mg[i], e_mg[i + 1])
    }
    e_al = al_lda_eigs()
    for i to len(e_al) {
        assert_lt(e_al[i], 0.0)
    }
    for i to len(e_al) - 1 {
        assert_lt(e_al[i], e_al[i + 1])
    }
    e_si = si_lda_eigs()
    for i to len(e_si) {
        assert_lt(e_si[i], 0.0)
    }
    for i to len(e_si) - 1 {
        assert_lt(e_si[i], e_si[i + 1])
    }
    e_p = p_lda_eigs()
    for i to len(e_p) {
        assert_lt(e_p[i], 0.0)
    }
    for i to len(e_p) - 1 {
        assert_lt(e_p[i], e_p[i + 1])
    }
    e_s = s_lda_eigs()
    for i to len(e_s) {
        assert_lt(e_s[i], 0.0)
    }
    for i to len(e_s) - 1 {
        assert_lt(e_s[i], e_s[i + 1])
    }
    e_cl = cl_lda_eigs()
    for i to len(e_cl) {
        assert_lt(e_cl[i], 0.0)
    }
    for i to len(e_cl) - 1 {
        assert_lt(e_cl[i], e_cl[i + 1])
    }
    e_ar = ar_lda_eigs()
    for i to len(e_ar) {
        assert_lt(e_ar[i], 0.0)
    }
    for i to len(e_ar) - 1 {
        assert_lt(e_ar[i], e_ar[i + 1])
    }
    # and the total energy falls as the nucleus grows
    assert_lt(HE_LDA_ETOT, H_LDA_ETOT)
    assert_lt(LI_LDA_ETOT, HE_LDA_ETOT)
    assert_lt(BE_LDA_ETOT, LI_LDA_ETOT)
    assert_lt(B_LDA_ETOT, BE_LDA_ETOT)
    assert_lt(C_LDA_ETOT, B_LDA_ETOT)
    assert_lt(N_LDA_ETOT, C_LDA_ETOT)
    assert_lt(O_LDA_ETOT, N_LDA_ETOT)
    assert_lt(F_LDA_ETOT, O_LDA_ETOT)
    assert_lt(NE_LDA_ETOT, F_LDA_ETOT)
    assert_lt(NA_LDA_ETOT, NE_LDA_ETOT)
    assert_lt(MG_LDA_ETOT, NA_LDA_ETOT)
    assert_lt(AL_LDA_ETOT, MG_LDA_ETOT)
    assert_lt(SI_LDA_ETOT, AL_LDA_ETOT)
    assert_lt(P_LDA_ETOT, SI_LDA_ETOT)
    assert_lt(S_LDA_ETOT, P_LDA_ETOT)
    assert_lt(CL_LDA_ETOT, S_LDA_ETOT)
    assert_lt(AR_LDA_ETOT, CL_LDA_ETOT)
}

test "the virial theorem does NOT hold for these, and that is the point" {
    # For the exact solution of a Coulomb Hamiltonian, 2T + V = 0, so the
    # kinetic energy would be minus the total. It is not, and asserting that
    # it was is how this test started. Ekin here is the NON-interacting
    # Kohn-Sham kinetic energy, which is not the interacting one, and the
    # Levy-Perdew relation that does hold in density functional theory
    # carries a scaling term in the exchange-correlation energy.
    #
    # NIST's own numbers say so: for oxygen T is 74.116881 against -Etot of
    # 74.473077, half a percent apart. Left here as an assertion of the gap
    # rather than deleted, so nobody puts it back.
    assert_lt(1.0e-4, abs(H_LDA_EKIN + H_LDA_ETOT) / abs(H_LDA_ETOT))
    assert_lt(1.0e-4, abs(HE_LDA_EKIN + HE_LDA_ETOT) / abs(HE_LDA_ETOT))
    assert_lt(1.0e-4, abs(LI_LDA_EKIN + LI_LDA_ETOT) / abs(LI_LDA_ETOT))
    assert_lt(1.0e-4, abs(BE_LDA_EKIN + BE_LDA_ETOT) / abs(BE_LDA_ETOT))
    assert_lt(1.0e-4, abs(B_LDA_EKIN + B_LDA_ETOT) / abs(B_LDA_ETOT))
    assert_lt(1.0e-4, abs(C_LDA_EKIN + C_LDA_ETOT) / abs(C_LDA_ETOT))
    assert_lt(1.0e-4, abs(N_LDA_EKIN + N_LDA_ETOT) / abs(N_LDA_ETOT))
    assert_lt(1.0e-4, abs(O_LDA_EKIN + O_LDA_ETOT) / abs(O_LDA_ETOT))
    assert_lt(1.0e-4, abs(F_LDA_EKIN + F_LDA_ETOT) / abs(F_LDA_ETOT))
    assert_lt(1.0e-4, abs(NE_LDA_EKIN + NE_LDA_ETOT) / abs(NE_LDA_ETOT))
    assert_lt(1.0e-4, abs(NA_LDA_EKIN + NA_LDA_ETOT) / abs(NA_LDA_ETOT))
    assert_lt(1.0e-4, abs(MG_LDA_EKIN + MG_LDA_ETOT) / abs(MG_LDA_ETOT))
    assert_lt(1.0e-4, abs(AL_LDA_EKIN + AL_LDA_ETOT) / abs(AL_LDA_ETOT))
    assert_lt(1.0e-4, abs(SI_LDA_EKIN + SI_LDA_ETOT) / abs(SI_LDA_ETOT))
    assert_lt(1.0e-4, abs(P_LDA_EKIN + P_LDA_ETOT) / abs(P_LDA_ETOT))
    assert_lt(1.0e-4, abs(S_LDA_EKIN + S_LDA_ETOT) / abs(S_LDA_ETOT))
    assert_lt(1.0e-4, abs(CL_LDA_EKIN + CL_LDA_ETOT) / abs(CL_LDA_ETOT))
    assert_lt(1.0e-4, abs(AR_LDA_EKIN + AR_LDA_ETOT) / abs(AR_LDA_ETOT))
}

