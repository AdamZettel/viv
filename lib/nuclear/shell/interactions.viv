# The interactions shipped with lib/nuclear/shell, as the text of their files
# (data/*.sps, data/*.int), so an exported program carries them.
#
# sd.sps, usdb.int: the sd shell and the USDB interaction of B. A. Brown and
#   W. A. Richter, Phys. Rev. C 74, 034315 (2006), as BIGSTICK ships them in
#   examples/sd (github.com/cwjsdsu/BigstickPublick, MIT license,
#   Copyright (c) 2017 Lawrence Livermore National Security and San Diego
#   State University Research Foundation).
# p.sps, ckpot.int: the p shell and the Cohen-Kurath (8-16)POT interaction,
#   S. Cohen and D. Kurath, Nucl. Phys. 73, 1 (1965), converted to isospin
#   form by data/snt_to_iso.py.

#: SD_SPS  the sd shell: 0d3/2, 0d5/2, 1s1/2 on an oxygen-16 core
SD_SPS = """iso
3
       0.0  2.0  1.5  2
       0.0  2.0  2.5  2
       1.0  0.0  0.5  2
"""

