#| The def2-SVP basis set as a `Basis` record.
def basis_def2svp() -> Basis {
    return basis_of(basis_def2svp_shells_flat(), basis_def2svp_prims_flat())
}

#| The Cartesian and spherical AO counts of one atom of each element, `1` to `18`,
#| as the generator counted them.
def basis_def2svp_nao() -> Arr {
    return [5, 5, 5, 5, 9, 9, 9, 9, 15, 14, 15, 14,
        15, 14, 15, 14, 15, 14, 15, 14, 16, 15, 19, 18,
        19, 18, 19, 18, 19, 18, 19, 18, 19, 18, 19, 18]
}

test "the def2-SVP table covers H through Ar, each element's shells in one run" {
    btdef2svp_b = basis_def2svp()
    assert_near(len(btdef2svp_b.shells), BASIS_DEF2SVP_NSHELL, 0.0)
    assert_near(len(btdef2svp_b.prims), BASIS_DEF2SVP_NPRIM, 0.0)
    assert_near(basis_check(btdef2svp_b), 0.0, 0.0)
    btdef2svp_n = basis_rows(basis_def2svp_nao(), BS_NAO_LEN)
    for btdef2svp_z to len(btdef2svp_n) {
        btdef2svp_k = basis_nao(btdef2svp_b, btdef2svp_z + 1)
        assert_near(btdef2svp_k[0], btdef2svp_n[btdef2svp_z, 0], 0.0)
        assert_near(btdef2svp_k[1], btdef2svp_n[btdef2svp_z, 1], 0.0)
    }
}
