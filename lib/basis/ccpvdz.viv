        453.7, 0.00570555, 106.8, 0.043046,
        33.73, 0.176591, 12.13, 0.406863,
        4.594, 0.452549, 1.678, 0.122801,
        0.5909, -0.00445996, 453.7, -0.00160655,
        106.8, -0.0121714, 33.73, -0.0520789,
        12.13, -0.123737, 4.594, -0.151619,
        1.678, 0.142425, 0.5909, 0.584501,
        0.1852, 1.0, 0.738, 1.0]
}

#| The cc-pVDZ basis set as a `Basis` record.
def basis_ccpvdz() -> Basis {
    return basis_of(basis_ccpvdz_shells_flat(), basis_ccpvdz_prims_flat())
}

#| The Cartesian and spherical AO counts of one atom of each element, `1` to `18`,
#| as the generator counted them.
def basis_ccpvdz_nao() -> Arr {
    return [5, 5, 5, 5, 15, 14, 15, 14, 15, 14, 15, 14,
        15, 14, 15, 14, 15, 14, 15, 14, 19, 18, 19, 18,
        19, 18, 19, 18, 19, 18, 19, 18, 19, 18, 19, 18]
}

test "the cc-pVDZ table covers H through Ar, each element's shells in one run" {
    btccpvdz_b = basis_ccpvdz()
    assert_near(len(btccpvdz_b.shells), BASIS_CCPVDZ_NSHELL, 0.0)
    assert_near(len(btccpvdz_b.prims), BASIS_CCPVDZ_NPRIM, 0.0)
    assert_near(basis_check(btccpvdz_b), 0.0, 0.0)
    btccpvdz_n = basis_rows(basis_ccpvdz_nao(), BS_NAO_LEN)
    for btccpvdz_z to len(btccpvdz_n) {
        btccpvdz_k = basis_nao(btccpvdz_b, btccpvdz_z + 1)
        assert_near(btccpvdz_k[0], btccpvdz_n[btccpvdz_z, 0], 0.0)
        assert_near(btccpvdz_k[1], btccpvdz_n[btccpvdz_z, 1], 0.0)
    }
}
