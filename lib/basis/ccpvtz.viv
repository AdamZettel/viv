#| The cc-pVTZ basis set as a `Basis` record.
def basis_ccpvtz() -> Basis {
    return basis_of(basis_ccpvtz_shells_flat(), basis_ccpvtz_prims_flat())
}

#| The Cartesian and spherical AO counts of one atom of each element, `1` to `18`,
#| as the generator counted them.
def basis_ccpvtz_nao() -> Arr {
    return [15, 14, 15, 14, 35, 30, 35, 30, 35, 30, 35, 30,
        35, 30, 35, 30, 35, 30, 35, 30, 39, 34, 39, 34,
        39, 34, 39, 34, 39, 34, 39, 34, 39, 34, 39, 34]
}

test "the cc-pVTZ table covers H through Ar, each element's shells in one run" {
    btccpvtz_b = basis_ccpvtz()
    assert_near(len(btccpvtz_b.shells), BASIS_CCPVTZ_NSHELL, 0.0)
    assert_near(len(btccpvtz_b.prims), BASIS_CCPVTZ_NPRIM, 0.0)
    assert_near(basis_check(btccpvtz_b), 0.0, 0.0)
    btccpvtz_n = basis_rows(basis_ccpvtz_nao(), BS_NAO_LEN)
    for btccpvtz_z to len(btccpvtz_n) {
        btccpvtz_k = basis_nao(btccpvtz_b, btccpvtz_z + 1)
        assert_near(btccpvtz_k[0], btccpvtz_n[btccpvtz_z, 0], 0.0)
        assert_near(btccpvtz_k[1], btccpvtz_n[btccpvtz_z, 1], 0.0)
    }
}
