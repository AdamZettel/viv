#| The 6-31G* basis set as a `Basis` record.
def basis_631gs() -> Basis {
    return basis_of(basis_631gs_shells_flat(), basis_631gs_prims_flat())
}

#| The Cartesian and spherical AO counts of one atom of each element, `1` to `18`,
#| as the generator counted them.
def basis_631gs_nao() -> Arr {
    return [2, 2, 2, 2, 15, 14, 15, 14, 15, 14, 15, 14,
        15, 14, 15, 14, 15, 14, 15, 14, 19, 18, 19, 18,
        19, 18, 19, 18, 19, 18, 19, 18, 19, 18, 19, 18]
}

test "the 6-31G* table covers H through Ar, each element's shells in one run" {
    bt631gs_b = basis_631gs()
    assert_near(len(bt631gs_b.shells), BASIS_631GS_NSHELL, 0.0)
    assert_near(len(bt631gs_b.prims), BASIS_631GS_NPRIM, 0.0)
    assert_near(basis_check(bt631gs_b), 0.0, 0.0)
    bt631gs_n = basis_rows(basis_631gs_nao(), BS_NAO_LEN)
    for bt631gs_z to len(bt631gs_n) {
        bt631gs_k = basis_nao(bt631gs_b, bt631gs_z + 1)
        assert_near(bt631gs_k[0], bt631gs_n[bt631gs_z, 0], 0.0)
        assert_near(bt631gs_k[1], bt631gs_n[bt631gs_z, 1], 0.0)
    }
}
