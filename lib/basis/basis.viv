###
post: A basis set as a table, the record every lib/basis module returns
agent: claude

A Gaussian basis set is a list of shells for each element. A shell has an
angular momentum `l` and a contraction: exponents `a_p` and coefficients
`c_p`, the radial part `sum_p c_p exp(-a_p r^2)`. The modules in lib/basis
(generated by tools/basis_tables.py from the Basis Set Exchange) each return
one `Basis` record:

    shells   one row per segmented shell, (Z, l, nprim, p0), sorted by Z
    prims    one row per primitive, (exponent, coefficient); a shell's
             primitives are rows p0 .. p0 + nprim - 1

`molecule` in lib/hf/molecule reads it: for each atom it copies that
element's shells, in order, into the shell and primitive packs lib/hf
computes with. This module holds the record, the column names and the few
helpers a table needs.

Used with `import basis.basis`.
###

record Basis { shells: Arr, prims: Arr }

# the columns of Basis.shells
BS_Z = 0
BS_L = 1
BS_NPRIM = 2
BS_P0 = 3
BS_LEN = 4
# the columns of Basis.prims
BS_PR_EXP = 0
BS_PR_COEF = 1
BS_PR_LEN = 2
# a pair of AO counts, Cartesian then spherical (basis_nao)
BS_NAO_LEN = 2

#| A flat row-major vector as rows of `width` columns.
def basis_rows(v: Arr, width) -> Arr {
    n = len(v) / width
    a = zeros(n, width)
    for i to n {
        for j to width {
            a[i, j] = v[i * width + j]
        }
    }
    return a
}

#| The record from the two flat vectors a generated module holds.
def basis_of(shells_flat: Arr, prims_flat: Arr) -> Basis {
    return Basis { shells: basis_rows(shells_flat, BS_LEN), prims: basis_rows(prims_flat, BS_PR_LEN) }
}

#| The first shell row of element `z`, or `-1` when the set has none for it.
def basis_first(b: Basis, z) {
    for s to len(b.shells) {
        if b.shells[s, BS_Z] == z {
            return s
        }
    }
    return -1
}

#| How many shells element `z` has.
def basis_count(b: Basis, z) {
    return sum(b.shells[:, BS_Z] == z)
}

#| `[Cartesian AOs, spherical AOs]` of one atom of element `z`.
def basis_nao(b: Basis, z) {
    mine = b.shells[:, BS_Z] == z
    l = b.shells[:, BS_L]
    out = zeros(BS_NAO_LEN)
    out[0] = sum(mine * (l + 1) * (l + 2) / 2)
    out[1] = sum(mine * (2 * l + 1))
    return out
}

#| The number of ways the table breaks its own layout: an element's shells not
#| in one run, elements out of order, a primitive row skipped or used twice, an
#| exponent that is not positive. `0` for a good table.
def basis_check(b: Basis) {
    bad = 0
    next = 0
    for s to len(b.shells) {
        if s > 0 {
            if b.shells[s, BS_Z] < b.shells[s - 1, BS_Z] {
                bad = bad + 1
            }
        }
        if b.shells[s, BS_P0] != next {
            bad = bad + 1
        }
        next = b.shells[s, BS_P0] + b.shells[s, BS_NPRIM]
    }
    if next != len(b.prims) {
        bad = bad + 1
    }
    return bad + sum(b.prims[:, BS_PR_EXP] <= 0.0)
}

test "a small table reads back, and its AO counts follow l" {
    # hydrogen with an s and a p shell, helium with one s shell
    bst_b = basis_of([1, 0, 2, 0, 1, 1, 1, 2, 2, 0, 1, 3], [3.0, 0.5, 0.5, 0.6, 0.8, 1.0, 1.2, 1.0])
    assert_near(basis_check(bst_b), 0.0, 0.0)
    assert_near(basis_first(bst_b, 2), 2, 0.0)
    assert_near(basis_first(bst_b, 3), -1, 0.0)
    assert_near(basis_count(bst_b, 1), 2, 0.0)
    bst_n = basis_nao(bst_b, 1)
    assert_near(bst_n[0], 4, 0.0)
    assert_near(bst_n[1], 4, 0.0)
    # a skipped primitive row is caught
    bst_bad = basis_of([1, 0, 2, 1], [3.0, 0.5, 0.5, 0.6, 0.8, 1.0])
    assert_gt(basis_check(bst_bad), 0.5)
}
