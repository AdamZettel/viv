#| The def2-TZVP basis set as a `Basis` record.
def basis_def2tzvp() -> Basis {
    return basis_of(basis_def2tzvp_shells_flat(), basis_def2tzvp_prims_flat())
}

#| The Cartesian and spherical AO counts of one atom of each element, `1` to `18`,
#| as the generator counted them.
def basis_def2tzvp_nao() -> Arr {
    return [6, 6, 6, 6, 14, 14, 20, 19, 36, 31, 36, 31,
        36, 31, 36, 31, 36, 31, 36, 31, 35, 32, 35, 32,
        42, 37, 42, 37, 42, 37, 42, 37, 42, 37, 42, 37]
}

test "the def2-TZVP table covers H through Ar, each element's shells in one run" {
    btdef2tzvp_b = basis_def2tzvp()
    assert_near(len(btdef2tzvp_b.shells), BASIS_DEF2TZVP_NSHELL, 0.0)
    assert_near(len(btdef2tzvp_b.prims), BASIS_DEF2TZVP_NPRIM, 0.0)
    assert_near(basis_check(btdef2tzvp_b), 0.0, 0.0)
    btdef2tzvp_n = basis_rows(basis_def2tzvp_nao(), BS_NAO_LEN)
    for btdef2tzvp_z to len(btdef2tzvp_n) {
        btdef2tzvp_k = basis_nao(btdef2tzvp_b, btdef2tzvp_z + 1)
        assert_near(btdef2tzvp_k[0], btdef2tzvp_n[btdef2tzvp_z, 0], 0.0)
        assert_near(btdef2tzvp_k[1], btdef2tzvp_n[btdef2tzvp_z, 1], 0.0)
    }
}
