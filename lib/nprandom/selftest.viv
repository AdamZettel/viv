from nprandom.legacy import (
    npr_lg_bounded, npr_lg_cdf, npr_lg_search, npr_lg_shuffle, npr_lg_shuffle_rows,
    npr_lg_uniform,
)
from nprandom.mt19937 import npr_mt_double, npr_mt_new, npr_mt_seed, npr_mt_seed_array
from nprandom.generator import (
    npr_gn_bounded, npr_gn_choice_noreplace, npr_gn_normal, npr_gn_shuffle, npr_gn_shuffle_rows,
    npr_gn_uniform,
)
from nprandom.pcg64 import npr_pcg_double, npr_pcg_from_entropy
from nprandom.seedseq import npr_ss_pool, npr_ss_words

#| 0, 1, ..., n - 1.
def st_iota(n) {
    a = zeros(n)
    for i to n {
        a[i] = i
    }
    return a
}

#| A rows by cols matrix holding 0, 1, 2, ... row by row.
def st_grid(rows, cols) {
    A = zeros(rows, cols)
    for i to rows {
        for j to cols {
            A[i, j] = cols * i + j
        }
    }
    return A
}

#| A matrix's entries, row by row.
def st_flat(A: Arr) {
    out = []
    for i to shape(A)[0] {
        for j to shape(A)[1] {
            out = append(out, A[i, j])
        }
    }
    return out
}

test "legacy random_sample after seed 0" {
    REF = [
        0.5488135039273248, 0.7151893663724195, 0.6027633760716439, 0.5448831829968969,
        0.4236547993389047, 0.6458941130666561
    ]
    st = npr_mt_new()
    npr_mt_seed(st, 0)
    got = []
    for i to len(REF) {
        got = append(got, npr_mt_double(st))
    }
    assert_allclose(got, REF, 0.0)
}

test "legacy seed 2**32 - 1, 1500 draws (three twists)" {
    REF = [
        0.8107026579786386, 0.5544952460056457, 0.2832342052349047, 0.8441294851925575,
        0.802496735111522
    ]
    n_draws = 1500
    st = npr_mt_new()
    npr_mt_seed(st, 4294967295)
    got = []
    for i to n_draws {
        v = npr_mt_double(st)
        if i >= n_draws - len(REF) {
            got = append(got, v)
        }
    }
    assert_allclose(got, REF, 0.0)
}

test "legacy seed [1, 2, 3] (init_by_array)" {
    REF = [
        0.6098612722867289, 0.8866970434146851, 0.47633673750662764, 0.8976583215326422
    ]
    st = npr_mt_new()
    npr_mt_seed_array(st, [1, 2, 3])
    got = []
    for i to len(REF) {
        got = append(got, npr_mt_double(st))
    }
    assert_allclose(got, REF, 0.0)
}

test "legacy seed of 700 words (a key longer than the state)" {
    REF = [
        0.03882396749776795, 0.5684460219118541, 0.9899101369047573
    ]
    key_len = 700
    key_step = 7919
    key = []
    for i to key_len {
        key = append(key, mod(i * key_step, 4294967296.0))
    }
    st = npr_mt_new()
    npr_mt_seed_array(st, key)
    got = []
    for i to len(REF) {
        got = append(got, npr_mt_double(st))
    }
    assert_allclose(got, REF, 0.0)
}

test "legacy uniform(-2, 3) and rand interleaved" {
    REF = [
        -0.12729940576318755, 0.9507143064099162, 2.0720242327543796
    ]
    st = npr_mt_new()
    npr_mt_seed(st, 42)
    got = [npr_lg_uniform(st, -2.0, 3.0 - -2.0), npr_mt_double(st), npr_lg_uniform(st, 5.0, 1.0 - 5.0)]
    assert_allclose(got, REF, 0.0)
}

test "legacy randint over ranges 10, 0, 2**32 - 1, 2**32 + 5, 2**40, 7" {
    REF = [
        5, 8, 9, 5,
        0, 0, 1, 7,
        5, 1484172013, 1704103299, 109688382642,
        1
    ]
    n_small = 8
    st = npr_mt_new()
    npr_mt_seed(st, 1)
    got = []
    for i to n_small {
        got = append(got, npr_lg_bounded(st, 10 - 1))
    }
    got = append(got, 5 + npr_lg_bounded(st, 0))
    got = append(got, npr_lg_bounded(st, 4294967295))
    got = append(got, -3 + npr_lg_bounded(st, 4294967296.0 + 3 - 1 + 3))
    got = append(got, npr_lg_bounded(st, 1099511627776.0 - 1))
    got = append(got, -3 + npr_lg_bounded(st, 4 - 1 + 3))
    assert_allclose(got, REF, 0.0)
}

test "legacy shuffle, permutation, rows" {
    REF = [
        5.0, 4.0, 1.0, 2.0,
        9.0, 6.0, 7.0, 0.0,
        3.0, 8.0, 6, 1,
        3, 4, 0, 5,
        2, 9.0, 10.0, 11.0,
        12.0, 13.0, 14.0, 3.0,
        4.0, 5.0, 6.0, 7.0,
        8.0, 0.0, 1.0, 2.0
    ]
    n_a = 10
    n_p = 7
    rows = 5
    cols = 3
    st = npr_mt_new()
    npr_mt_seed(st, 3)
    a = st_iota(n_a)
    npr_lg_shuffle(st, a)
    p = st_iota(n_p)
    npr_lg_shuffle(st, p)
    A = st_grid(rows, cols)
    npr_lg_shuffle_rows(st, A)
    got = concat(concat(a, p), st_flat(A))
    assert_allclose(got, REF, 0.0)
}

test "legacy choice with replacement, with p, without replacement" {
    REF = [
        4, 9, 6, 3,
        3, 3, 3, 2,
        2, 0, 1, 1,
        5, 2, 3
    ]
    pop = 10
    n_pick = 5
    n_p = 6
    n_unique = 4
    st = npr_mt_new()
    npr_mt_seed(st, 7)
    got = []
    for i to n_pick {
        got = append(got, npr_lg_bounded(st, pop - 1))
    }
    cdf = npr_lg_cdf([0.1, 0.2, 0.3, 0.4])
    u = []
    for i to n_p {
        u = append(u, npr_mt_double(st))
    }
    for i to n_p {
        got = append(got, npr_lg_search(cdf, u[i]))
    }
    perm = st_iota(pop)
    npr_lg_shuffle(st, perm)
    for i to n_unique {
        got = append(got, perm[i])
    }
    assert_allclose(got, REF, 0.0)
}

test "the SeedSequence pools of 0, 42, 2**32 - 1, 2**40 + 3 and [1, 2, 3, 4, 5]" {
    REF = [
        4265667335, 1328953910, 1320288413, 3365567143,
        1662858758, 128880814, 1875164712, 753753205,
        2625504364, 3738155522, 1800708531, 3301221904,
        2907267167, 3980074586, 1877032172, 1126316378,
        426959988, 2549860685, 1625409769, 3009254745
    ]
    seeds = [0, 42, 4294967295, 1099511627779.0]
    got = []
    for s to len(seeds) {
        got = concat(got, npr_ss_pool(npr_ss_words(seeds[s])))
    }
    got = concat(got, npr_ss_pool([1, 2, 3, 4, 5]))
    assert_allclose(got, REF, 0.0)
}

test "default_rng random for seeds 0, 1, 2**32 - 1, 2**53 - 1" {
    REF = [
        0.6369616873214543, 0.2697867137638703, 0.04097352393619469, 0.5118216247002567,
        0.9504636963259353, 0.14415961271963373, 0.2519435680449965, 0.21906579628685663,
        0.28728472043517017, 0.7862681066761149, 0.6063032385025929, 0.5376094823800641
    ]
    seeds = [0, 1, 4294967295, 9007199254740991.0]
    n_each = 3
    got = []
    for s to len(seeds) {
        rng = npr_pcg_from_entropy(npr_ss_words(seeds[s]))
        for i to n_each {
            got = append(got, npr_pcg_double(rng))
        }
    }
    assert_allclose(got, REF, 0.0)
}

test "the last three of 1000 draws from default_rng(0)" {
    REF = [
        0.383319396547832, 0.16486371752648665, 0.3800078966332565
    ]
    n_draws = 1000
    rng = npr_pcg_from_entropy([0])
    got = []
    for i to n_draws {
        v = npr_pcg_double(rng)
        if i >= n_draws - len(REF) {
            got = append(got, v)
        }
    }
    assert_allclose(got, REF, 0.0)
}

test "Generator.integers over ranges 10, 0, 2**32 - 1, 2**32 + 5, 2**40, 2**53 - 2, with random between" {
    REF = [
        6.0, 8.0, 0.0, 8.0,
        4.0, 5.0, 0.2858013800881416, 2213306431.0,
        231630600.0, 421518542151.0, 3679199551440676.0, 1.0,
        0.04875771072716806
    ]
    n_small = 5
    rng = npr_pcg_from_entropy([5])
    got = []
    for i to n_small {
        got = append(got, npr_gn_bounded(rng, 10 - 1))
    }
    got = append(got, 5 + npr_gn_bounded(rng, 0))
    got = append(got, npr_pcg_double(rng))
    got = append(got, npr_gn_bounded(rng, 4294967295))
    got = append(got, -3 + npr_gn_bounded(rng, 4294967296.0 + 3 - 1 + 3))
    got = append(got, npr_gn_bounded(rng, 1099511627776.0 - 1))
    got = append(got, npr_gn_bounded(rng, 9007199254740991.0 - 1))
    got = append(got, 1 + npr_gn_bounded(rng, 7 - 1))
    got = append(got, npr_pcg_double(rng))
    assert_allclose(got, REF, 0.0)
}

test "Generator.uniform, shuffle, permutation, rows" {
    REF = [
        -0.3571489861540019, 6.0, 9.0, 2.0,
        1.0, 8.0, 4.0, 5.0,
        0.0, 3.0, 7.0, 3.0,
        2.0, 0.0, 5.0, 4.0,
        1.0, 0.0, 1.0, 2.0,
        9.0, 10.0, 11.0, 3.0,
        4.0, 5.0, 6.0, 7.0,
        8.0
    ]
    n_a = 10
    n_p = 6
    rows = 4
    cols = 3
    rng = npr_pcg_from_entropy([11])
    got = [npr_gn_uniform(rng, -1.0, 4.0 - -1.0)]
    a = st_iota(n_a)
    npr_gn_shuffle(rng, a)
    p = st_iota(n_p)
    npr_gn_shuffle(rng, p)
    A = st_grid(rows, cols)
    npr_gn_shuffle_rows(rng, A)
    got = concat(concat(concat(got, a), p), st_flat(A))
    assert_allclose(got, REF, 0.0)
}

test "Generator.choice with replacement, with p, without (Floyd, shuffled and not), and from 20000" {
    REF = [
        8.0, 8.0, 8.0, 8.0,
        0.0, 1.0, 0.0, 3.0,
        3.0, 0.0, 3.0, 5.0,
        8.0, 9.0, 1.0, 85.0,
        7.0, 63.0, 42.0, 34.0,
        81.0, 10353.0, 17631.0, 8174.0,
        13753.0, 0.3046824021351616
    ]
    pop = 10
    n_pick = 5
    n_p = 6
    n_unique = 4
    big_pop = 100
    n_big = 6
    huge_pop = 20000
    n_huge = 500
    n_tail = 4
    rng = npr_pcg_from_entropy([13])
    got = []
    for i to n_pick {
        got = append(got, npr_gn_bounded(rng, pop - 1))
    }
    cdf = npr_lg_cdf([0.1, 0.2, 0.3, 0.4])
    u = []
    for i to n_p {
        u = append(u, npr_pcg_double(rng))
    }
    for i to n_p {
        got = append(got, npr_lg_search(cdf, u[i]))
    }
    got = concat(got, npr_gn_choice_noreplace(rng, pop, n_unique, 1))
    got = concat(got, npr_gn_choice_noreplace(rng, big_pop, n_big, 0))
    c = npr_gn_choice_noreplace(rng, huge_pop, n_huge, 1)
    for i to n_tail {
        got = append(got, c[n_huge - n_tail + i])
    }
    got = append(got, npr_pcg_double(rng))
    assert_allclose(got, REF, 0.0)
}

