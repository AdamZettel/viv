    rng = npr_pcg_from_entropy([2])
    got = zeros(len(REF))
    for i to len(REF) {
        got[i] = npr_gn_normal(rng)
    }
    assert_allclose(got, REF, 0.0)
    tail = npr_gn_normal(rng)
    assert_true(tail != tail)
}

test "Generator.normal(loc, scale) is loc + scale * z" {
    REF = [
        -0.10567387196575329, -2.878575046460499, -1.656345427042233
    ]
    rng = npr_pcg_from_entropy([9])
    got = [1.5 + 2.0 * npr_gn_normal(rng), -3.0 + 0.5 * npr_gn_normal(rng), npr_gn_normal(rng)]
    assert_allclose(got, REF, 0.0)
}
