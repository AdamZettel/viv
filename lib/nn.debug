# What to check while an attention head runs. Nothing here prints: the watches and holds go into the story of
# the program that uses lib/nn, and a failed hold fails the run.
attention  @3db0c754
  watch at weights        A
  hold at weights         max(abs(A @ (zeros(T) + 1.0) - 1.0)) <= 1.0e-12   "each row of attention weights sums to 1"
  hold at weights         sum(A * future) == 0.0                            "no weight falls on a later position"
