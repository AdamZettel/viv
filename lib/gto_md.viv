test "water in 6-31G, which is the molecule PySCF's own test suite checks" {
    # pyscf/scf/test/test_h2o.py: self.assertAlmostEqual(rhf.scf(), -75.98394849812, 9)
    nbf = WATER631G_NBF
    R = water631g_coords()
    Z = water631g_charges()
    bs = water631g_bf_shell()
    bp = water631g_bf_pow()
    sa = water631g_shell_atom()
    se = water631g_shell_expo()
    sc = water631g_shell_coef()
    npm = WATER631G_NPRIM
    S = md_one_electron(R, Z, bs, bp, sa, se, sc, nbf, npm, WATER631G_NATM, 0)
    T = md_one_electron(R, Z, bs, bp, sa, se, sc, nbf, npm, WATER631G_NATM, 1)
    V = md_one_electron(R, Z, bs, bp, sa, se, sc, nbf, npm, WATER631G_NATM, 2)
    assert_lt(gto_worst(S, water631g_S(), nbf), 1.0e-12)
    assert_lt(gto_worst(T, water631g_T(), nbf), 1.0e-12)
    assert_lt(gto_worst(V, water631g_V(), nbf), 1.0e-12)
    CEN = md_prep_center(bs, sa, R, nbf)
    EXP = md_prep_expo(bs, se, nbf, npm)
    CN = md_prep_cn(bs, bp, se, sc, nbf, npm)
    NP = md_prep_nprim(bs, water631g_shell_nprim(), nbf)
    G = md_eri_fast(CEN, EXP, CN, NP, bp, nbf)
    iters = 80
    e = gto_rhf(T + V, S, G, nbf, WATER631G_NOCC, WATER631G_ENUC, iters)
    assert_lt(abs(e - WATER631G_ERHF), 1.0e-9)
    # and against the number PySCF's test file asserts, to the places it asserts
    assert_near(e, -75.98394849812, 1.0e-9)
}

#| Rotate a table of coordinates about the axis `(ux, uy, uz)` by `th`, by
#| Rodrigues' formula. Used to ask the energy a question it must answer the same
#| way every time.
def rotate_coords(R: Arr, natm, ux, uy, uz, th) {
    n = sqrt(ux * ux + uy * uy + uz * uz)
    kx = ux / n
    ky = uy / n
    kz = uz / n
    c = cos(th)
    s = sin(th)
    out = zeros(natm, GTO_DIM)
    for i to natm {
        x = R[i, 0]
        y = R[i, 1]
        z = R[i, 2]
        dot = kx * x + ky * y + kz * z
        out[i, 0] = x * c + (ky * z - kz * y) * s + kx * dot * (1.0 - c)
        out[i, 1] = y * c + (kz * x - kx * z) * s + ky * dot * (1.0 - c)
        out[i, 2] = z * c + (kx * y - ky * x) * s + kz * dot * (1.0 - c)
    }
    return out
}

#| The Hartree-Fock energy of water at whatever coordinates it is handed, and
#| the density on the way out.
def water_energy_at(R: Arr, Pout: Arr) {
    nbf = WATER_NBF
    Z = water_charges()
    bs = water_bf_shell()
    bp = water_bf_pow()
    sa = water_shell_atom()
    se = water_shell_expo()
    sc = water_shell_coef()
    npm = WATER_NPRIM
    S = md_one_electron(R, Z, bs, bp, sa, se, sc, nbf, npm, WATER_NATM, 0)
    T = md_one_electron(R, Z, bs, bp, sa, se, sc, nbf, npm, WATER_NATM, 1)
    V = md_one_electron(R, Z, bs, bp, sa, se, sc, nbf, npm, WATER_NATM, 2)
    CEN = md_prep_center(bs, sa, R, nbf)
    EXP = md_prep_expo(bs, se, nbf, npm)
    CN = md_prep_cn(bs, bp, se, sc, nbf, npm)
    NP = md_prep_nprim(bs, water_shell_nprim(), nbf)
    G = md_eri_fast(CEN, EXP, CN, NP, bp, nbf)
    # nuclear repulsion at these coordinates, not the reference one
    enuc = 0.0
    for i to WATER_NATM {
        for j to i {
            d = 0.0
            for k to GTO_DIM {
                dd = R[i, k] - R[j, k]
                d = d + dd * dd
            }
            enuc = enuc + Z[i] * Z[j] / sqrt(d)
        }
    }
    return gto_rhf_full(T + V, S, G, nbf, WATER_NOCC, enuc, MD_WATER_SCF_ITERS, Pout)
}

test "the energy does not care which way the molecule is pointing" {
    # p functions are defined along the fixed axes, so this only comes out right
    # if the three of them are handled as one shell that spans a rotation
    # invariant space. It is the check that will catch d functions the day they
    # are written, and it needs no reference at all.
    R = water_coords()
    P = zeros(WATER_NBF, WATER_NBF)
    e0 = water_energy_at(R, P)
    assert_lt(abs(e0 - WATER_ERHF), 1.0e-10)
    worst = 0.0
    nangles = 5
    for k to nangles {
        th = 0.3 + 0.55 * k
        Rr = rotate_coords(R, WATER_NATM, 0.31, -0.74, 0.59, th)
        worst = max(worst, abs(water_energy_at(Rr, P) - e0))
    }
    assert_lt(worst, 1.0e-10)
}

test "and it does not care where the molecule is" {
    R = water_coords()
    P = zeros(WATER_NBF, WATER_NBF)
    e0 = water_energy_at(R, P)
    Rt = zeros(WATER_NATM, GTO_DIM)
    for i to WATER_NATM {
        Rt[i, 0] = R[i, 0] + 3.7
        Rt[i, 1] = R[i, 1] - 1.9
        Rt[i, 2] = R[i, 2] + 8.25
    }
    assert_lt(abs(water_energy_at(Rt, P) - e0), 1.0e-10)
}

test "the density holds the electrons it is supposed to" {
    nbf = WATER_NBF
    R = water_coords()
    P = zeros(nbf, nbf)
    junk = water_energy_at(R, P)
    S = md_one_electron(R, water_charges(), water_bf_shell(), water_bf_pow(), water_shell_atom(), water_shell_expo(), water_shell_coef(), nbf, WATER_NPRIM, WATER_NATM, 0)
    PS = P @ S
    tr = 0.0
    for i to nbf {
        tr = tr + PS[i, i]
    }
    # ten electrons in water, and the trace of PS counts them
    assert_near(tr, 2.0 * WATER_NOCC, 1.0e-10)
    # and the density is idempotent through the overlap: P S P = 2 P
    PSP = PS @ P
    for i to nbf {
        for j to nbf {
            assert_near(PSP[i, j], 2.0 * P[i, j], 1.0e-9)
        }
    }
}

