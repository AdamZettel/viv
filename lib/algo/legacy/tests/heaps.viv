# Generated by tools/algo/check.py from lib/algo/algo.spec: do not edit.
# Each case prints its input (= X), its results, and the verdict of each postcondition
# (? ...) as lib/algo/props.viv computes it; check.py checks them again in Python.
from algo.cases import algo_case, CASE_NAMES
from algo.props import (
    algo_is_max_heap, algo_is_permutation, algo_is_sorted, algo_is_sorted_desc,
    algo_is_stable_values,
)
from algo.legacy.heaps import (
    build_max_heap, extract_max, heap_insert, heap_items, heap_new, heap_sort_in_place, heappop,
    heappush,
)

#| ta_build_max_heap: TheAlgorithms heap.py: build_max_heap
def algo_t_ta_build_max_heap(kind, n, inside, skip: Arr) -> Bool {
    X = algo_case(kind, n, 1 + 97 * kind + n)
    print("@ ta_build_max_heap", CASE_NAMES[kind], n)
    H = heap_new(len(X))
    build_max_heap(H, X)
    R = heap_items(H)
    print("= X", fmt(X))
    print("= R", fmt(R))
    p0 = algo_is_max_heap(R)
    p1 = algo_is_permutation(R, X)
    print("?", p0, p1)
    return inside == 0 or ((p0 or skip[0] == 1) and (p1 or skip[1] == 1))
}

#| ta_heap_insert: TheAlgorithms heap.py: insert one by one
def algo_t_ta_heap_insert(kind, n, inside, skip: Arr) -> Bool {
    X = algo_case(kind, n, 1 + 97 * kind + n)
    print("@ ta_heap_insert", CASE_NAMES[kind], n)
    H = heap_new(len(X))
    for i to len(X) {
        heap_insert(H, X[i])
    }
    R = heap_items(H)
    print("= X", fmt(X))
    print("= R", fmt(R))
    p0 = algo_is_max_heap(R)
    p1 = algo_is_permutation(R, X)
    print("?", p0, p1)
    return inside == 0 or ((p0 or skip[0] == 1) and (p1 or skip[1] == 1))
}

#| ta_extract_max: TheAlgorithms heap.py: build, then extract_max until empty
def algo_t_ta_extract_max(kind, n, inside, skip: Arr) -> Bool {
    X = algo_case(kind, n, 1 + 97 * kind + n)
    print("@ ta_extract_max", CASE_NAMES[kind], n)
    H = heap_new(len(X))
    build_max_heap(H, X)
    R = zeros(len(X))
    for i to len(X) {
        R[i] = extract_max(H)
    }
    print("= X", fmt(X))
    print("= R", fmt(R))
    p0 = algo_is_sorted_desc(R)
    p1 = algo_is_permutation(R, X)
    print("?", p0, p1)
    return inside == 0 or ((p0 or skip[0] == 1) and (p1 or skip[1] == 1))
}

#| ta_heap_sort_in_place: TheAlgorithms heap.py: heap_sort_in_place
def algo_t_ta_heap_sort_in_place(kind, n, inside, skip: Arr) -> Bool {
    X = algo_case(kind, n, 1 + 97 * kind + n)
    print("@ ta_heap_sort_in_place", CASE_NAMES[kind], n)
    H = heap_new(len(X))
    build_max_heap(H, X)
    heap_sort_in_place(H)
    R = heap_items(H)
    print("= X", fmt(X))
    print("= R", fmt(R))
    p0 = algo_is_permutation(R, X)
    p1 = algo_is_sorted(R)
    p2 = algo_is_stable_values(R, X)
    print("?", p0, p1, p2)
    return inside == 0 or ((p0 or skip[0] == 1) and (p1 or skip[1] == 1))
}

#| dijkstra_heap: the (cost, vertex) min-heap of TheAlgorithms' Dijkstra port
def algo_t_dijkstra_heap(kind, n, inside, skip: Arr) -> Bool {
    X = algo_case(kind, n, 1 + 97 * kind + n)
    print("@ dijkstra_heap", CASE_NAMES[kind], n)
    H = zeros(len(X) + 1, 2)
    size = 0
    for i to len(X) {
        size = heappush(H, size, X[i], i)
    }
    R = zeros(len(X))
    for i to len(X) {
        size = heappop(H, size)
        R[i] = H[size, 0]
    }
    print("= X", fmt(X))
    print("= R", fmt(R))
    p0 = algo_is_sorted(R)
    print("?", p0)
    return inside == 0 or ((p0 or skip[0] == 1))
}

