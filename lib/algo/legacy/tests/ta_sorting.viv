#| ta_merge_sort: TheAlgorithms merge_sort (study/idioms/thealgorithms-python/sorting.viv)
def algo_t_ta_merge_sort(kind, n, inside, skip: Arr) -> Bool {
    X = algo_case(kind, n, 1 + 97 * kind + n)
    print("@ ta_merge_sort", CASE_NAMES[kind], n)
    R = merge_sort(X)
    print("= X", fmt(X))
    print("= R", fmt(R))
    p0 = algo_is_permutation(R, X)
    p1 = algo_is_sorted(R)
    p2 = algo_is_stable_values(R, X)
    print("?", p0, p1, p2)
    return inside == 0 or ((p0 or skip[0] == 1) and (p1 or skip[1] == 1) and (p2 or skip[2] == 1))
}

