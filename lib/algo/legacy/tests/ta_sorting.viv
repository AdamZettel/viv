#| ta_binary_search: TheAlgorithms binary_search: the leftmost index of x, or -1
def algo_t_ta_binary_search(kind, n, inside, skip: Arr) -> Bool {
    X = algo_case(kind, n, 1 + 97 * kind + n)
    print("@ ta_binary_search", CASE_NAMES[kind], n)
    V = copy(X)
    sort(V)
    Q = algo_needles(V)
    RS = zeros(len(Q))
    for k to len(Q) {
        RS[k] = binary_search(V, Q[k])
    }
    print("= X", fmt(X))
    print("= RS", fmt(RS))
    print("= V", fmt(V))
    print("= Q", fmt(Q))
    p0 = algo_all_first_or_none(RS, V, Q)
    print("?", p0)
    return inside == 0 or ((p0 or skip[0] == 1))
}

