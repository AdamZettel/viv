from algo.legacy.order import lg_le

# from study/idioms/thealgorithms-python/seq.viv: argsort

#| The indices that sort `keys` ascending, ties kept in input order
#| (Python `sorted(range(n), key=keys.__getitem__)`): a bottom-up merge sort.
def seq_argsort(keys: Arr) -> Arr {
    n = len(keys)
    idx = zeros(n)
    tmp = zeros(n)
    for i to n {
        idx[i] = i
    }
    width = 1.0
    while width < n {
        lo = 0.0
        while lo < n {
            mid = min(lo + width, n)
            hi = min(lo + 2.0 * width, n)
            i = lo
            j = mid
            for k to hi - lo {
                if i < mid and (j >= hi or lg_le(keys[idx[i]], keys[idx[j]])) {
                    tmp[lo + k] = idx[i]
                    i = i + 1.0
                }
                else {
                    tmp[lo + k] = idx[j]
                    j = j + 1.0
                }
            }
            lo = hi
        }
        idx[:] = tmp
        width = 2.0 * width
    }
    return idx
}
