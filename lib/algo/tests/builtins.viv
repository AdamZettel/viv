# Generated by tools/algo/check.py from lib/algo/algo.spec: do not edit.
# Each case prints its input (= X), its results, and the verdict of each postcondition
# (? ...) as lib/algo/props.viv computes it; check.py checks them again in Python.
from algo.cases import algo_case, CASE_NAMES
from algo.props import (
    algo_is_index_perm, algo_is_max_pos, algo_is_min_pos, algo_is_permutation, algo_is_sorted,
    algo_is_sorted_by, algo_is_sorted_total, algo_is_stable_by, algo_is_stable_values,
)

#| builtin_sort: the `sort` builtin
def algo_t_builtin_sort(kind, n, inside, skip: Arr) -> Bool {
    X = algo_case(kind, n, 1 + 97 * kind + n)
    print("@ builtin_sort", CASE_NAMES[kind], n)
    R = copy(X)
    sort(R)
    print("= X", fmt(X))
    print("= R", fmt(R))
    p0 = algo_is_permutation(R, X)
    p1 = algo_is_sorted_total(R)
    p2 = algo_is_stable_values(R, X)
    print("?", p0, p1, p2)
    return inside == 0 or ((p0 or skip[0] == 1) and (p1 or skip[1] == 1))
}

#| phrase_sorted: the phrase `take V sorted` (phrases.rs: take(V, argsort(V), 0))
def algo_t_phrase_sorted(kind, n, inside, skip: Arr) -> Bool {
    X = algo_case(kind, n, 1 + 97 * kind + n)
    print("@ phrase_sorted", CASE_NAMES[kind], n)
    R = take X sorted
    print("= X", fmt(X))
    print("= R", fmt(R))
    p0 = algo_is_permutation(R, X)
    p1 = algo_is_sorted(R)
    p2 = algo_is_stable_values(R, X)
    p3 = algo_is_sorted_total(R)
    print("?", p0, p1, p2, p3)
    return inside == 0 or ((p0 or skip[0] == 1) and (p1 or skip[1] == 1) and (p2 or skip[2] == 1))
}

#| builtin_argsort: the `argsort` builtin
def algo_t_builtin_argsort(kind, n, inside, skip: Arr) -> Bool {
    X = algo_case(kind, n, 1 + 97 * kind + n)
    print("@ builtin_argsort", CASE_NAMES[kind], n)
    P = argsort(X)
    print("= X", fmt(X))
    print("= P", fmt(P))
    p0 = algo_is_index_perm(P, len(X))
    p1 = algo_is_sorted_by(P, X)
    p2 = algo_is_stable_by(P, X)
    print("?", p0, p1, p2)
    return inside == 0 or ((p0 or skip[0] == 1) and (p1 or skip[1] == 1) and (p2 or skip[2] == 1))
}

#| builtin_argsort_key: `argsort(a, key=...)`, which parser.rs lowers to a merge sort in Viv
def algo_t_builtin_argsort_key(kind, n, inside, skip: Arr) -> Bool {
    X = algo_case(kind, n, 1 + 97 * kind + n)
    print("@ builtin_argsort_key", CASE_NAMES[kind], n)
    P = argsort(X, key=fn(x) -> x)
    print("= X", fmt(X))
    print("= P", fmt(P))
    p0 = algo_is_index_perm(P, len(X))
    p1 = algo_is_sorted_by(P, X)
    p2 = algo_is_stable_by(P, X)
    print("?", p0, p1, p2)
    return inside == 0 or ((p0 or skip[0] == 1) and (p1 or skip[1] == 1) and (p2 or skip[2] == 1))
}

#| builtin_argmin: the `argmin` builtin
def algo_t_builtin_argmin(kind, n, inside, skip: Arr) -> Bool {
    X = algo_case(kind, n, 1 + 97 * kind + n)
    print("@ builtin_argmin", CASE_NAMES[kind], n)
    R = argmin(X)
    print("= X", fmt(X))
    print("= R", fmt(R))
    p0 = algo_is_min_pos(R, X)
    print("?", p0)
    return inside == 0 or ((p0 or skip[0] == 1))
}

#| builtin_argmax: the `argmax` builtin
def algo_t_builtin_argmax(kind, n, inside, skip: Arr) -> Bool {
    X = algo_case(kind, n, 1 + 97 * kind + n)
    print("@ builtin_argmax", CASE_NAMES[kind], n)
    R = argmax(X)
    print("= X", fmt(X))
    print("= R", fmt(R))
    p0 = algo_is_max_pos(R, X)
    print("?", p0)
    return inside == 0 or ((p0 or skip[0] == 1))
}

