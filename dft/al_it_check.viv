# Al: what the calculation must reproduce, and the picture of it.
#
#     dft/run.sh al it
#
# GENERATED by dft/ref/make_deck.py, which RAN dft/ref/pwdft_ref.py -- an independent numpy implementation that diagonalizes H densely --
# at exactly this deck's settings and pinned what it printed.
# A disagreement here is a bug in one of the two implementations.

GAMMA_P = NSEG
LAST = NPTS - 1.0

test "SCF converged: density, energy, and every occupied band's residual" {
    assert_lt(DRHO, 1.0e-8)
    assert_lt(EIGRES, EIG_TOL)
    assert_lt(ITER, MAXIT)
}
test "every band-path point converged" {
    assert_lt(BANDRES, EIG_TOL)
}
test "free energy agrees with the numpy reference" {
    assert_near(ETOT, 0.598595595079, 1.0e-7)
}
test "the Fermi level agrees with the numpy reference" {
    assert_near(EFERMI, 0.284482863616, 1.0e-7)
}
test "band energies at L, Gamma and X agree with the numpy reference (eV)" {
    assert_near(EVB[0.0, 0.0], -4.617181044, 1.0e-5)   # L, band 1
    assert_near(EVB[0.0, 1.0], -4.436650937, 1.0e-5)   # L, band 2
    assert_near(EVB[0.0, 2.0], 11.037701390, 1.0e-5)   # L, band 3
    assert_near(EVB[GAMMA_P, 0.0], -11.149189968, 1.0e-5)   # Gamma, band 1
    assert_near(EVB[GAMMA_P, 1.0], 12.755642052, 1.0e-5)   # Gamma, band 2
    assert_near(EVB[GAMMA_P, 2.0], 12.755642052, 1.0e-5)   # Gamma, band 3
    assert_near(EVB[LAST, 0.0], -2.970240813, 1.0e-5)   # X, band 1
    assert_near(EVB[LAST, 1.0], -1.642758542, 1.0e-5)   # X, band 2
    assert_near(EVB[LAST, 2.0], 5.413952043, 1.0e-5)   # X, band 3
}

