# Cu: what the calculation must reproduce, and the picture of it.
#
#     dft/run.sh cu it
#
# GENERATED by dft/ref/make_deck.py, which RAN dft/ref/pwdft_iter.py -- an independent numpy implementation of the same iterative method --
# at exactly this deck's settings and pinned what it printed.
# A disagreement here is a bug in one of the two implementations.

GAMMA_P = NSEG
LAST = NPTS - 1.0

test "SCF converged: density, energy, and every occupied band's residual" {
    assert_lt(DRHO, 1.0e-8)
    assert_lt(EIGRES, EIG_TOL)
    assert_lt(ITER, MAXIT - 0.5)
}
test "every band-path point converged" {
    assert_lt(BANDRES, EIG_TOL)
}
test "free energy agrees with the numpy reference" {
    assert_near(ETOT, -6.840756354444, 1.0e-7)
}
test "the Fermi level agrees with the numpy reference" {
    assert_near(EFERMI, 0.471147207119, 1.0e-7)
}
test "band energies at L, Gamma and X agree with the numpy reference (eV)" {
    assert_near(EVB[0.0, 0.0], -5.296650288, 1.0e-5)   # L, band 1
    assert_near(EVB[0.0, 1.0], -3.222805723, 1.0e-5)   # L, band 2
    assert_near(EVB[0.0, 2.0], -3.222805722, 1.0e-5)   # L, band 3
    assert_near(EVB[0.0, 3.0], -1.589489056, 1.0e-5)   # L, band 4
    assert_near(EVB[0.0, 4.0], -1.589489051, 1.0e-5)   # L, band 5
    assert_near(EVB[0.0, 5.0], -1.159059264, 1.0e-5)   # L, band 6
    assert_near(EVB[0.0, 6.0], 3.711105058, 1.0e-5)   # L, band 7
    assert_near(EVB[GAMMA_P, 0.0], -9.627422876, 1.0e-5)   # Gamma, band 1
    assert_near(EVB[GAMMA_P, 1.0], -3.280592543, 1.0e-5)   # Gamma, band 2
    assert_near(EVB[GAMMA_P, 2.0], -3.280592541, 1.0e-5)   # Gamma, band 3
    assert_near(EVB[GAMMA_P, 3.0], -3.280592538, 1.0e-5)   # Gamma, band 4
    assert_near(EVB[GAMMA_P, 4.0], -2.253370433, 1.0e-5)   # Gamma, band 5
    assert_near(EVB[GAMMA_P, 5.0], -2.253370431, 1.0e-5)   # Gamma, band 6
    assert_near(EVB[GAMMA_P, 6.0], 23.106843100, 1.0e-5)   # Gamma, band 7
    assert_near(EVB[LAST, 0.0], -4.992229494, 1.0e-5)   # X, band 1
    assert_near(EVB[LAST, 1.0], -4.615690603, 1.0e-5)   # X, band 2
    assert_near(EVB[LAST, 2.0], -1.630434012, 1.0e-5)   # X, band 3
    assert_near(EVB[LAST, 3.0], -1.398723220, 1.0e-5)   # X, band 4
    assert_near(EVB[LAST, 4.0], -1.398723218, 1.0e-5)   # X, band 5
    assert_near(EVB[LAST, 5.0], 1.311674647, 1.0e-5)   # X, band 6
    assert_near(EVB[LAST, 6.0], 7.215638275, 1.0e-5)   # X, band 7
}

