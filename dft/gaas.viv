# Gallium arsenide, zincblende: two species, and NO inversion symmetry, so the
# density's Fourier coefficients are genuinely complex.
#
#     dft/run.sh gaas it      iterative engine: dft/pwdft_it.viv + dft/gaas_it_check.viv
