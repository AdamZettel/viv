# C: what the calculation must reproduce, and the picture of it.
#
#     dft/run.sh c it
#
# GENERATED by dft/ref/make_deck.py, which RAN dft/ref/pwdft_ref.py -- an independent numpy implementation that diagonalizes H densely --
# at exactly this deck's settings and pinned what it printed.
# A disagreement here is a bug in one of the two implementations.

GAMMA_P = NSEG
LAST = NPTS - 1.0

test "SCF converged: density, energy, and every occupied band's residual" {
    assert_lt(DRHO, 1.0e-8)
    assert_lt(EIGRES, EIG_TOL)
    assert_lt(ITER, MAXIT)
}
test "every band-path point converged" {
    assert_lt(BANDRES, EIG_TOL)
}
test "total energy agrees with the numpy reference" {
    assert_near(ETOT, 1.398490176994, 1.0e-7)
}
test "band energies at L, Gamma and X agree with the numpy reference (eV)" {
    assert_near(EVB[0.0, 0.0], -15.528027225, 1.0e-5)   # L, band 1
    assert_near(EVB[0.0, 1.0], -13.403838859, 1.0e-5)   # L, band 2
    assert_near(EVB[0.0, 2.0], -2.776759434, 1.0e-5)   # L, band 3
    assert_near(EVB[0.0, 3.0], -2.776759434, 1.0e-5)   # L, band 4
    assert_near(EVB[0.0, 4.0], 8.405368457, 1.0e-5)   # L, band 5
    assert_near(EVB[0.0, 5.0], 8.405368457, 1.0e-5)   # L, band 6
    assert_near(EVB[GAMMA_P, 0.0], -21.373975422, 1.0e-5)   # Gamma, band 1
    assert_near(EVB[GAMMA_P, 1.0], -0.000052280, 1.0e-5)   # Gamma, band 2
    assert_near(EVB[GAMMA_P, 2.0], -0.000000000, 1.0e-5)   # Gamma, band 3
    assert_near(EVB[GAMMA_P, 3.0], 0.000000000, 1.0e-5)   # Gamma, band 4
    assert_near(EVB[GAMMA_P, 4.0], 5.579105299, 1.0e-5)   # Gamma, band 5
    assert_near(EVB[GAMMA_P, 5.0], 5.579146141, 1.0e-5)   # Gamma, band 6
    assert_near(EVB[LAST, 0.0], -12.645389675, 1.0e-5)   # X, band 1
    assert_near(EVB[LAST, 1.0], -12.645389070, 1.0e-5)   # X, band 2
    assert_near(EVB[LAST, 2.0], -6.304301582, 1.0e-5)   # X, band 3
    assert_near(EVB[LAST, 3.0], -6.304277827, 1.0e-5)   # X, band 4
    assert_near(EVB[LAST, 4.0], 4.675080966, 1.0e-5)   # X, band 5
    assert_near(EVB[LAST, 5.0], 4.675082056, 1.0e-5)   # X, band 6
}

