# What to check while the dense engine runs.
# Nothing here prints: the watches and holds go into the story
# (`dft/lens.sh story pwdft --engine c`), and a failed hold fails the run.
# dft/run.sh passes the modules as --use preludes, which leaves this file out,
# so the checked runs in dft/check.sh are unchanged by it.
#
# The SCF loop itself is top-level code, not a def, and a watch or a hold
# belongs to a def; so the checks sit in the defs the loop calls.
setup_slot  @f220a1d7
  hold at keep         n < NPWMAX                               "every plane wave that passes the cutoff fits the arrays pw_extent sized"
build_vtot  @0fd3e8ea
  hold per iteration   eh >= 0.0                                "the Hartree energy is a sum of squares"
add_density  @06c816a7
  hold per iteration   sum(out) * DV <= NELEC + 1.0e-8          "the partial density never holds more electrons than the cell"
