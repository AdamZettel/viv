# Aluminum, fcc: a METAL, so occupations are Fermi-Dirac and the Fermi level is solved for.
#
#     dft/run.sh al         dense engine:     dft/pwdft.viv    + dft/al_check.viv
#     dft/run.sh al it      iterative engine: dft/pwdft_it.viv + dft/al_it_check.viv
#
# GENERATED by dft/ref/make_deck.py from dft/ref/materials.py -- do not edit by hand.

# GTH/HGH pseudopotentials, LDA (Pade). GENERATED by dft/pseudo/make_pseudo.py
# from CP2K's GTH_POTENTIALS table -- do not edit by hand.
#   S. Goedecker, M. Teter, J. Hutter, PRB 54, 1703 (1996)
#   C. Hartwigsen, S. Goedecker, J. Hutter, PRB 58, 3641 (1998)
#   species 0: Al GTH-PADE-q3
NSPEC = 1.0
GTH_NLOC = 4.0         #: GTH_NLOC  coefficients C1..C4 of the local part
GTH_NL = 4.0           #: GTH_NL  angular momentum channels, l = 0 .. 3
GTH_NPMAX = 3.0        #: GTH_NPMAX  at most this many projectors in one channel
ZION = zeros(NSPEC)
RLOC = zeros(NSPEC)
CLOC = zeros(NSPEC, GTH_NLOC)
NPRJ = zeros(NSPEC, GTH_NL)       #: NPRJ  projectors per (species, l)
RPRJ = zeros(NSPEC, GTH_NL)       #: RPRJ  projector radius r_l per (species, l)
HPRJ = zeros(NSPEC, GTH_NL, GTH_NPMAX, GTH_NPMAX) #: HPRJ  the coupling matrix h^l_ij per (species, l)
ZION[0] = 3.0
RLOC[0] = 0.45
CLOC[0, 0] = -8.49135116
NPRJ[0, 0] = 2.0
RPRJ[0, 0] = 0.46010427
HPRJ[0, 0, 0, 0] = 5.08833953
HPRJ[0, 0, 0, 1] = -1.03784325
HPRJ[0, 0, 1, 0] = -1.03784325
HPRJ[0, 0, 1, 1] = 2.67969975
NPRJ[0, 1] = 1.0
RPRJ[0, 1] = 0.53674439
HPRJ[0, 1, 0, 0] = 2.19343827

# --- the crystal: an fcc lattice ---------------------------------------------
ALAT = 7.65                          #: ALAT  lattice constant, bohr
A = [[0.0, ALAT / 2.0, ALAT / 2.0],
     [ALAT / 2.0, 0.0, ALAT / 2.0],
     [ALAT / 2.0, ALAT / 2.0, 0.0]]   #: A  primitive vectors, one per ROW
NAT = 1.0
ATSPEC = [0.0]        #: ATSPEC  species index of each atom
ATFRAC = [[0.0, 0.0, 0.0]]   #: ATFRAC  positions, fractions of A

# --- the calculation --------------------------------------------------------
ECUT = 10.0                           #: ECUT  plane-wave cutoff, hartree
NBANDS = 6.0                         #: NBANDS  bands computed at every k-point
SMEAR = 0.01                          #: SMEAR  Fermi-Dirac width, hartree; 0 for an insulator
NKMESH = 4.0                         #: NKMESH  the k-mesh is NKMESH^3, shifted (dft/kmesh.viv)
MIX = 0.6                             #: MIX  the damping in the Anderson mixer (dft/pw_common.viv)
SCF_TOL = 1.0e-9
MAXIT = 80.0
NITER = 3.0                           #: NITER  LOBPCG steps per k-point per SCF iteration (iterative engine)
NITER_BANDS = 60.0                    #: NITER_BANDS  at most this many LOBPCG steps per band-path point, from a cold start
EIG_TOL = 1.0e-5                      #: EIG_TOL  residual norm |H psi - eps psi| every band that matters must reach

# --- the band path: L -> Gamma -> X ------------------------------------------
NCORNER = 3.0
CORNER = [[0.5, 0.5, 0.5],
          [0.0, 0.0, 0.0],
          [0.5, 0.0, 0.5]]
NSEG = 30.0                           #: NSEG  points per path segment; the figure has 2 NSEG + 1
