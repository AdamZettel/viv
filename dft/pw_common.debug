# What to check in the shared parts. Nothing
# here prints: the watches and holds go into the story of the program that
# uses this module (`dft/lens.sh story pwdft_it --engine c`), and a failed
# hold fails the run.
fermi_level  @9b8fbfbd
  hold per iteration   lo <= hi                                 "the bracket around the Fermi level never turns inside out"
fill_occupations  @689ca974
  hold per iteration   ent >= 0.0                               "the electronic entropy is not negative"
anderson_step  @f0bdb55d
  hold per iteration   tr >= 0.0                                "the trace of the least-squares matrix is a sum of squares"
