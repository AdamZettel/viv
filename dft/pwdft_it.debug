# What to check while the iterative engine runs. Nothing here prints: the watches and holds go into the story
# (`dft/lens.sh story pwdft_it --engine c`), and a failed hold fails the run.
# dft/run.sh passes the modules as --use preludes, which leaves this file out,
# so the checked runs and the C behind the served wasm are unchanged by it.
new_density  @b22a2794
  hold per iteration   sum(acc) * DV <= NELEC + 1.0e-8          "the partial density never holds more electrons than the cell"
