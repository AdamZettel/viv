###
Metropolis Monte Carlo of Lennard-Jones atoms at constant N, V and T, the
potential cut (not shifted) at r_cut. Each step is a sweep: every atom in
turn is moved by a random displacement in a cube and the move is accepted
with probability min(1, exp(-dU / T)). A run returns the block and run
averages of the energy and pressure (for the cut potential, and corrected
for the full potential), the configurational temperature, the heat
capacity from the energy's fluctuations, the acceptance ratio, the final
configuration and, when it samples, g(r).

This is mc_nvt_lj of Allen and Tildesley's examples for Computer
Simulation of Liquids (2nd ed., Oxford University Press, 2017;
https://github.com/Allen-Tildesley/examples), ported to Viv. If you use
it, cite the book.
###
# The program behind `vp.liquids.mc_nvt` (mc_nvt.export.toml).
#
#     viv run ports/liquids/mc_nvt.viv     (in the interpreter: slow at the default size; vipyr compiles it)
#
# Derived from mc_nvt_lj.f90 of https://github.com/Allen-Tildesley/examples
# (commit 4818bc82), by Michael P. Allen and Dominic J. Tildesley, CC0-1.0;
# see ports/liquids/LICENSE. Upstream's run seeds its generator afresh after
# reading the starting configuration; so does this one.
from ports.liquids.lj import Pot, potential, force_sq, mc_sweep, potential_lrc, pressure_lrc, pressure_delta, check_box
from ports.liquids.setup import starting_configuration, DIM
from ports.liquids.averages import AVG, MSD, averages, blk_begin, blk_add, blk_end, run_end
from ports.liquids.analysis import pair_histogram, pair_add, pair_g

#: n  the number of atoms, 4 nc^3 for the fcc start (32, 108, 256, 500, 864, ...); ignored when r_start is given
n: Int = 256
#: density  the number density N / V; sets the box side when r_start is not given
density = 0.75
#: temperature  the temperature
temperature = 1.0
#: r_cut  the potential's cutoff, in sigma; at most half the box
r_cut = 2.5
#: dr_max  the largest trial displacement along each axis, in sigma
dr_max = 0.15
#: nblock  the number of blocks the run is averaged in
nblock: Int = 10
#: nstep  the sweeps per block (upstream's default is 10000)
nstep: Int = 1000
#: seed  the seed of the random numbers
seed: Int = 1
#: r_start  a starting configuration (N, 3), in sigma, instead of the fcc lattice; box_start must come with it
r_start = zeros(0, DIM)
#: box_start  the box side of r_start, in sigma
box_start = 0.0
#: sample  every this many sweeps, the configuration goes into g(r); 0: none
sample: Int = 0
#: gr_dr  the bin width of g(r), in sigma
gr_dr = 0.02

# the averaged variables, in upstream's order
MOVE_RATIO: Int = 0
E_CUT: Int = 1
P_CUT: Int = 2
E_FULL: Int = 3
P_FULL: Int = 4
T_CONFIG: Int = 5
CV_FULL: Int = 6
NVAR: Int = 7
#| the ideal gas's heat capacity per atom, which the energy's fluctuations leave out
CV_IDEAL = 1.5

if nblock < 1 or nstep < 0 {
    stop(f"nblock must be at least 1 and nstep at least 0; they are {nblock} and {nstep}")
}
if temperature <= 0.0 or dr_max <= 0.0 {
    stop(f"temperature and dr_max must be positive; they are {temperature} and {dr_max}")
}

#: box  the box side, in sigma
r, v_unused, box = starting_configuration(n, density, temperature, seed, r_start, zeros(0, DIM), box_start)
nat: Int = int(shape(r)[0])
check_box(box, r_cut)
#: rho  the number density N / V
rho = nat / (box * box * box)
srand(1.0 * seed)

f = zeros(nat, DIM)
total = potential(r, box, r_cut)
if total.ovr {
    stop("two atoms overlap in the starting configuration")
}

#| The seven variables of one sweep: upstream's calc_variables.
def variables(t: Pot, m_ratio: Num, r: Arr, f: Arr, box: Num, r_cut: Num, temperature: Num) -> Arr {
    nat: Int = int(shape(r)[0])
    vol = box * box * box
    rho = nat / vol
    fsq = force_sq(r, f, box, r_cut)
    out = zeros(NVAR)
    out[MOVE_RATIO] = m_ratio
    out[E_CUT] = 1.5 * temperature + t.pot / nat
    out[E_FULL] = potential_lrc(rho, r_cut) + 1.5 * temperature + t.pot / nat
    out[P_CUT] = pressure_delta(rho, r_cut) + rho * temperature + t.vir / vol
    out[P_FULL] = pressure_lrc(rho, r_cut) + rho * temperature + t.vir / vol
    out[T_CONFIG] = fsq / t.lap
    out[CV_FULL] = t.pot / (temperature * sqrt(1.0 * nat))
    return out
}

first = variables(total, 0.0, r, f, box, r_cut, temperature)
meth: [Int] = [AVG, AVG, AVG, AVG, AVG, AVG, MSD]
add = zeros(NVAR)
add[CV_FULL] = CV_IDEAL
acc = averages(meth, add, nblock, -1)
#: energy_series  e_cut after every sweep
energy_series = zeros(nblock * nstep)
gr_h = pair_histogram(gr_dr, box)
step: Int = 0
for blk to nblock {
    blk_begin(acc)
    for stp to nstep {
        total, moves = mc_sweep(r, total, box, r_cut, temperature, dr_max)
        m_ratio = 1.0 * moves / nat
        vals = variables(total, m_ratio, r, f, box, r_cut, temperature)
        blk_add(acc, vals)
        energy_series[step] = vals[E_CUT]
        step = step + 1
        if sample > 0 and step % sample == 0 {
            pair_add(gr_h, r * box, box)
        }
    }
    blk_end(acc)
}
avg, err = run_end(acc)

# ---- the run averages and their errors
#: move_ratio  the fraction of trial moves accepted
move_ratio = avg[MOVE_RATIO]
#: e_cut  the energy per atom of the cut (not shifted) potential, with the ideal gas's 3T/2
e_cut = avg[E_CUT]
#: e_cut_err  its standard error from the block averages
e_cut_err = err[E_CUT]
#: p_cut  the pressure of the cut potential, with the delta correction for the step at r_cut
p_cut = avg[P_CUT]
#: p_cut_err  its standard error
p_cut_err = err[P_CUT]
#: e_full  the energy per atom with the long-range correction: an estimate for the full potential
e_full = avg[E_FULL]
#: e_full_err  its standard error
e_full_err = err[E_FULL]
#: p_full  the pressure with the long-range correction
p_full = avg[P_FULL]
#: p_full_err  its standard error
p_full_err = err[P_FULL]
#: t_config  the configurational temperature, |F|^2 / lap U, which should come out at T
t_config = avg[T_CONFIG]
#: t_config_err  its standard error
t_config_err = err[T_CONFIG]
#: cv_full  the heat capacity per atom from the energy's fluctuations, plus 3/2 (the same for the cut and the full potential)
cv_full = avg[CV_FULL]
#: cv_full_err  its standard error
cv_full_err = err[CV_FULL]
#: blocks  the block averages, one row per block, columns move_ratio, e_cut, p_cut, e_full, p_full, t_config, cv_full
blocks = acc.blocks
#: initial  the same seven variables at the start (the first is 0)
initial = first
#: r_final  the final positions (N, 3), in sigma, in the box centered on the origin
r_final = r * box

#: gr_r  the midpoints of the g(r) bins, in sigma (empty without sample)
gr_r = zeros(0)
#: gr  g(r) at those midpoints
gr = zeros(0)
if sample > 0 {
    gr_r, gr = pair_g(gr_h, nat, box)
}

print(f"N = {nat}  rho = {fmt(rho, '.6f')}  T = {temperature}  dr_max = {dr_max}  {nblock} blocks of {nstep} sweeps  acceptance {fmt(move_ratio, '.4f')}")
print(f"E/N cut = {fmt(e_cut, '.6f')} +- {fmt(e_cut_err, '.6f')}  P cut = {fmt(p_cut, '.6f')} +- {fmt(p_cut_err, '.6f')}")
print(f"E/N full = {fmt(e_full, '.6f')}  P full = {fmt(p_full, '.6f')}  T config = {fmt(t_config, '.4f')}  Cv/N = {fmt(cv_full, '.4f')} +- {fmt(cv_full_err, '.4f')}")

test "the running energy is the energy of the final configuration" {
    check = potential(r, box, r_cut)
    assert_near(check.pot, total.pot, 1.0e-9 * abs(check.pot))
    assert_near(check.vir, total.vir, 1.0e-9 * abs(check.vir))
}

