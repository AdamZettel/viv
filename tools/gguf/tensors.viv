# print_tensors of one GGUF file: `viv run --set 'MODEL="path"' tools/gguf/tensors.viv`
# (tools/gguf/check.sh compares it with tools/gguf/ref.py's print of gguf-py's)
from gguf.tensors import read_gguf, print_tensors

MODEL = "lib/gguf/tests/tiny.gguf"

print_tensors(read_gguf(MODEL))

