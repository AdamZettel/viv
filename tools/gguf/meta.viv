# print_meta of one GGUF file: `viv run --set 'MODEL="path"' tools/gguf/meta.viv`
# (tools/gguf/check.sh compares it with tools/gguf/ref.py's print of gguf-py's)
from gguf.header import read_meta, print_meta

MODEL = "lib/gguf/tests/tiny.gguf"

print_meta(read_meta(MODEL))

