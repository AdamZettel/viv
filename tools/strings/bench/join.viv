# Join 10^6 one-character strings into one string.
# One pass: the result is sized from the parts, so the cost is linear.
N = 1000000
parts = []
for i to N {
    parts = append(parts, chr(97 + i % 26))
}
s = join("", parts)
print(fmt(len(s), "d"), s[:5], s[-3:])

