# ---- f-strings
print(repr(f"x = {1.5:.3f}!"))
print(repr(f"x = {1.5:.2e}!"))
print(repr(f"x = {1.5:10.4f}!"))
print(repr(f"x = {1.5:g}!"))
print(repr(f"{1:d}"))
print(repr(f"{1.5}"))
print(repr(f"{1.5!r}"))
print(repr(f"x = {0.30000000000000004:.3f}!"))
print(repr(f"x = {0.30000000000000004:.2e}!"))
print(repr(f"x = {0.30000000000000004:10.4f}!"))
print(repr(f"x = {0.30000000000000004:g}!"))
print(repr(f"{0:d}"))
print(repr(f"{0.30000000000000004}"))
print(repr(f"{0.30000000000000004!r}"))
print(repr(f"x = {-3.0:.3f}!"))
print(repr(f"x = {-3.0:.2e}!"))
print(repr(f"x = {-3.0:10.4f}!"))
print(repr(f"x = {-3.0:g}!"))
print(repr(f"{-3:d}"))
print(repr(f"{-3.0}"))
print(repr(f"{-3.0!r}"))
print(repr(f"[{"ab"}] [{"ab"!r}] [{"ab":>5}] [{"ab"!r:^9}]"))
print(repr(f"[{"it's"}] [{"it's"!r}] [{"it's":>5}] [{"it's"!r:^9}]"))
print(repr(f"[{"é"}] [{"é"!r}] [{"é":>5}] [{"é"!r:^9}]"))
print(repr(f"{{literal}} {1.0 + 2.0} {"a" + "b"}"))
print(repr(f"{join(", ", ["x", "y"])}"))
print(fmt(len("héllo"), "d"))
print(fmt(len(""), "d"))
print(fmt(len("\u{1F600}\u{301}"), "d"))
