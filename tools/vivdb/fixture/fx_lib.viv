# A two-file fixture for tools/vivdb/test_vivdb.py: a library def that calls
# the builtin exp, one that nothing calls, and a program that imports it.

#| what: the fraction left after time t at rate k
def fx_decay(t: Num, k: Num) -> Num {
    return exp(-k * t)
}

#| what: what fx_decay leaves of a total
def fx_left(total: Num, t: Num, k: Num) -> Num {
    return total * fx_decay(t, k)
}

def fx_unused(x: Num) -> Num {
    return x + 1.0
}

