# The program half of the vivdb fixture.
from fx_lib import fx_left

def fx_half_life(k: Num) -> Num {
    #: the time at which half is left
    return log(2.0) / k
}

k = 0.5
print(fx_left(100.0, fx_half_life(k), k))

test "half is left at the half-life" {
    assert_near(fx_left(1.0, fx_half_life(0.25), 0.25), 0.5, 1e-12)
}

