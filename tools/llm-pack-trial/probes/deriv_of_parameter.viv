# Written from the prompt pack before it had a section on lambdas: the
# interpreter runs it (r = 1.41421); `viv f.viv -o f.c` refuses deriv of a
# function parameter. deriv takes a lambda written at the call.
def newton(f, x0) {
    x = x0
    for k to 20 {
        x = x - f(x) / deriv(f, x)
    }
    return x
}
r = newton(fn(x) -> x * x - 2.0, 1.0)
show r
test "t" {
    assert_near(r, sqrt(2.0), 1.0e-14)
}

