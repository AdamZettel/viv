# Written from the prompt pack before it had a section on lambdas: the
# interpreter runs it and prints 6; `viv f.viv -o f.c` refuses it, because a
# lambda that is a value may not capture a local of its def.
def g(a) {
    h = fn(x) -> a * x
    return h(2.0)
}
show g(3.0)
test "t" {
    assert_near(g(3.0), 6.0, 1.0e-12)
}

