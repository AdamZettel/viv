# Written from the prompt pack: both engines refuse a def name as the
# first argument of simpson; the interpreter says to wrap it, fn(x) -> sq(x).
def sq(x) {
    return x * x
}
def integ(f, a, b) {
    return 0.5 * (b - a) * (f(a) + f(b))
}
show integ(sq, 0.0, 1.0)
show simpson(sq, 0.0, 1.0, 10)
test "t" {
    assert_near(simpson(sq, 0.0, 1.0, 10), 1.0 / 3.0, 1.0e-12)
}

