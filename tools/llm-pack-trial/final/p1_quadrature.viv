# Gauss-Legendre (3 points per panel) against composite Simpson on the integral
# of exp(x) over [0, 1], exactly e - 1.

def gauss3(f, a, b, panels) {
    h = (b - a) / panels
    r = sqrt(3.0 / 5.0)
    s = 0.0
    for k to panels {
        mid = a + (k + 0.5) * h
        half = 0.5 * h
        s += half * (5.0 / 9.0 * f(mid - r * half) + 8.0 / 9.0 * f(mid) + 5.0 / 9.0 * f(mid + r * half))
    }
    return s
}

exact = exp(1.0) - 1.0
g1 = gauss3(fn(x) -> exp(x), 0.0, 1.0, 1)
g2 = gauss3(fn(x) -> exp(x), 0.0, 1.0, 2)
s8 = simpson(fn(x) -> exp(x), 0.0, 1.0, 8)
err_g1 = abs(g1 - exact)
err_g2 = abs(g2 - exact)
err_s8 = abs(s8 - exact)
show err_g1
show err_g2
show err_s8
ratio = err_g1 / err_g2
show ratio

test "three-point Gauss is exact to 1e-5 with one panel" {
    assert_lt(err_g1, 1.0e-5)
}
test "halving the panel cuts the Gauss error by about 2^6" {
    assert_near(ratio, 64.0, 4.0)
}
# Simpson's error bound is (b - a) h^4 max|f''''(x)| / 180 = (1/8)^4 e / 180,
# about 3.7e-6. The first version of this test asked for 1e-6 and failed at 2.3e-6.
test "Simpson with 8 panels is within its error bound" {
    assert_lt(err_s8, pow(0.125, 4.0) * exp(1.0) / 180.0)
}

