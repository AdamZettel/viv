#| 0, 1, ..., n - 1.
def py_iota(n) {
    a = zeros(n)
    for i to n {
        a[i] = i
    }
    return a
}

#| Every entry of a real array, row-major, as a vector (a copy).
def py_flat(a: Arr) {
    return take(a, py_iota(numel(a)))
}

#| np.eye(n, k=d): ones on the d-th diagonal.
def py_eye(n, d) {
    E = zeros(n, n)
    for i to n {
        j = i + d
        if j >= 0 and j < n {
            E[i, j] = 1
        }
    }
    return E
}

#| np.sort(a) / sorted(a): a sorted COPY. Viv's sort(a) sorts in place and returns 0.
def py_sort(a: Arr) {
    if any(a != a) {
        stop("py2viv: sorting a NaN (Python's sorted and NumPy's sort each put it somewhere of their own)")
    }
    if any(a == 0) and any(1.0 / a == -1.0 / 0.0) and any(1.0 / a == 1.0 / 0.0) {
        stop("py2viv: sorting 0.0 and -0.0 together (their order is the sort algorithm's)")
    }
    b = a * 1.0
    sort(b)
    return b
}

#| np.linalg.solve(A, b) for a vector b. Viv's lin_solve(A, b, x) writes x and returns 0.
def py_solve(A: Arr, b: Arr) {
    if not (all(abs(A) < 1.0 / 0.0) and all(abs(b) < 1.0 / 0.0)) {
        stop("py2viv: np.linalg.solve with a NaN or an infinity (LAPACK's answer is its own)")
    }
    x = zeros(len(b))
    lin_solve(A, b, x)
    if all(abs(A) < 1.0 / 0.0) and all(abs(b) < 1.0 / 0.0) and not all(abs(x) < 1.0 / 0.0) {
        stop("numpy.linalg.LinAlgError: Singular matrix")
    }
    return x
}

#| np.linalg.inv(A): A X = I, solved by lin_solve_multi.
def py_inv(A: Arr) {
    if not all(abs(A) < 1.0 / 0.0) {
        stop("py2viv: np.linalg.inv of a matrix with a NaN or an infinity (LAPACK's answer is its own)")
    }
    X = zeros(len(A), len(A))
    lin_solve_multi(A, py_eye(len(A), 0), X)
    if all(abs(A) < 1.0 / 0.0) and not all(abs(X) < 1.0 / 0.0) {
        stop("numpy.linalg.LinAlgError: Singular matrix")
    }
    return X
}

#| The symmetric matrix whose lower triangle is A's (what LAPACK's UPLO='L' routines read).
def py_lower_sym(A: Arr) {
    n = len(A)
    S = zeros(n, n)
    for i to n {
        for j to n {
            if j <= i {
                S[i, j] = A[i, j]
            }
            else {
                S[i, j] = A[j, i]
            }
        }
    }
    return S
}

#| np.linalg.cholesky(A): the lower factor. Viv's cholesky(A, L) writes L. LAPACK reads only
#| the lower triangle of A, and raises where a pivot is not positive.
def py_cholesky(A: Arr) {
    S = py_lower_sym(A)
    if not all(abs(S) < 1.0 / 0.0) {
        stop("py2viv: np.linalg.cholesky of a matrix with a NaN or an infinity (LAPACK's answer is its own)")
    }
    L = zeros(len(A), len(A))
    cholesky(S, L)
    if all(abs(S) < 1.0 / 0.0) and not all(abs(L) < 1.0 / 0.0) {
        stop("numpy.linalg.LinAlgError: Matrix is not positive definite")
    }
    return L
}

#| np.linalg.eigvalsh(H): ascending eigenvalues. Viv's spectrum_sym(H, w) writes w. LAPACK
#| reads only the lower triangle of H (UPLO='L').
def py_eigvalsh(H: Arr) {
    if not all(abs(H) < 1.0 / 0.0) {
        stop("py2viv: np.linalg.eigvalsh of a matrix with a NaN or an infinity (LAPACK's answer is its own)")
    }
    w = zeros(len(H))
    spectrum_sym(py_lower_sym(H), w)
    return w
}

#| np.fft.fft(x) of a real vector: copied into a complex array, then transformed in place.
def py_fft_r(x: Arr) {
    if not all(abs(x) < 1.0 / 0.0) {
        stop("py2viv: an FFT of an array with a NaN or an infinity (pocketfft's answer is its own)")
    }
    X = czeros(len(x))
    for i to len(x) {
        X[i] = x[i]
    }
    fft(X)
    return X
}

#| np.fft.ifft(x) of a complex vector (carries 1/n, as NumPy's does).
def py_ifft_c(x: CArr) {
    if not all(abs(x) < 1.0 / 0.0) {
        stop("py2viv: an FFT of an array with a NaN or an infinity (pocketfft's answer is its own)")
    }
    X = czeros(len(x))
    for i to len(x) {
        X[i] = x[i]
    }
    ifft(X)
    return X
}

#| An int result, as Python's int: a -0.0 becomes 0 (an int has no sign on zero), and the run
#| stops at 2^53, past which a double no longer holds every integer (Python's int does).
def py_int(x) {
    if abs(x) >= 9007199254740992 {
        stop("py2viv: an integer reached 2^53; Python's int is exact there and a double is not")
    }
    return x + 0.0
}

#| a / b with a float: ZeroDivisionError on a zero divisor.
def py_div_f(a, b) {
    if b == 0 {
        stop("ZeroDivisionError: float division by zero")
    }
    return a / b
}

#| np.max(a): NaN if any entry is NaN, else the largest (+0 over -0).
def py_npmax(a: Arr) {
    if any(a != a) {
        return 0.0 / 0.0
    }
    f = py_flat(a)
    m = f[0]
    for i from 1 to len(f) {
        m = py_zmax2(m, f[i])
    }
    return m
}

#| np.isclose(a, b, rtol, atol) of two numbers: |a - b| <= atol + rtol |b| when both are
#| finite, a == b otherwise (a NaN is never close).
def py_npisclose(a, b, rtol, atol) {
    if abs(a) < 1.0 / 0.0 and abs(b) < 1.0 / 0.0 {
        return abs(a - b) <= atol + rtol * abs(b)
    }
    return a == b
}

#| np.allclose(a, b, rtol, atol) of two arrays of one shape: np.isclose entry by entry.
def py_allclose(a: Arr, b: Arr, rtol, atol) {
    fa = py_flat(a)
    fb = py_flat(b)
    if len(fa) != len(fb) {
        stop("py2viv: np.allclose of two arrays of different sizes (NumPy broadcasts them)")
    }
    for i to len(fa) {
        if not py_npisclose(fa[i], fb[i], rtol, atol) {
            return false
        }
    }
    return true
}

#| An array size, as NumPy takes it: ValueError for a negative one (Viv would make an empty
#| array).
def py_size(n) {
    if n < 0 {
        stop("ValueError: negative dimensions are not allowed")
    }
    return n
}

#| The larger of two numbers that are not NaN, +0 over -0 (NumPy's rule; Viv's max of two
#| zeros differs between engines).
def py_zmax2(a, b) {
    if a > b {
        return a
    }
    if b > a {
        return b
    }
    if a == 0 {
        return a + b
    }
    return a
}

#| sum(u * v) of two real vectors, the lengths checked (Viv's compiled engines do not check
#| them).
def py_vdot(u: Arr, v: Arr) {
    if len(u) != len(v) {
        stop("py2viv: a dot product of vectors of different lengths (NumPy raises ValueError)")
    }
    return sum(u * v)
}

#| The shape NumPy broadcasts two shapes da and db to (aligned at the last axis, a length 1
#| stretched); the run stops where NumPy raises ValueError.
def py_bdims(da: Arr, db: Arr) {
    n = len(da)
    if len(db) > n {
        n = len(db)
    }
    e = zeros(n)
    for i to n {
        x = 1
        y = 1
        if i >= n - len(da) {
            x = da[i - n + len(da)]
        }
        if i >= n - len(db) {
            y = db[i - n + len(db)]
        }
        if x == y or y == 1 {
            e[i] = x
        }
        else {
            if x == 1 {
                e[i] = y
            }
            else {
                stop("ValueError: operands could not be broadcast together with shapes")
            }
        }
    }
    return e
}

#| The flat indices, in row-major order of the shape e, of the entries of an array of shape d
#| that broadcasting to e reads (a length 1 of d is read again along that axis of e).
def py_bidx(d: Arr, e: Arr) {
    n = len(e)
    m = len(d)
    st = zeros(n)
    s = 1
    for k to m {
        j = m - 1 - k
        if d[j] != 1 {
            st[j + n - m] = s
        }
        s = s * d[j]
    }
    idx = zeros(1)
    for i to n {
        w = e[i]
        nxt = zeros(len(idx) * w)
        for p to len(idx) {
            for c to w {
                nxt[p * w + c] = idx[p] + c * st[i]
            }
        }
        idx = nxt
    }
    return idx
}

#| a broadcast to the shape e (a shape py_bdims gave for a and another array): a itself when
#| it has that shape, else a new array whose entries are copies of a's.
def py_bto(a: Arr, e: Arr) {
    d = shape(a)
    if len(d) == len(e) {
        if all(d == e) {
            return a
        }
    }
    return py_shaped(take(a, py_bidx(d, e)), e)
}

#| a - b of two real arrays, broadcast.
def py_bsub(a: Arr, b: Arr) {
    e = py_bdims(shape(a), shape(b))
    return py_bto(a, e) - py_bto(b, e)
}

#| np.allclose(a, b, rtol, atol) of two arrays, broadcast.
def py_ballclose(a: Arr, b: Arr, rtol, atol) {
    e = py_bdims(shape(a), shape(b))
    return py_allclose(py_bto(a, e), py_bto(b, e), rtol, atol)
}

#| The entries of f, row-major, as an array of shape e (a vector of 1 to 4 lengths).
def py_shaped(f: Arr, e: Arr) {
    if len(e) == 1 {
        return f
    }
    if len(e) == 2 {
        z = zeros(e[0], e[1])
    }
    else {
        if len(e) == 3 {
            z = zeros(e[0], e[1], e[2])
        }
        else {
            z = zeros(e[0], e[1], e[2], e[3])
        }
    }
    put(z, py_iota(numel(z)), f)
    return z
}

# The NumPy calls whose Viv builtins have another calling convention, each checked against
# NumPy. frontends.md found the 2026-09-24 prototype silently wrong on the first three: np.sort
# returned 0 and sorted its argument, np.fft.fft returned 0, np.linalg.solve failed with an
# arity error.
# 
# Viv's FFT, LU, Cholesky and Jacobi eigensolver are not pocketfft's or LAPACK's, so these agree
# to rounding, not to the bit.
# # py2viv: rtol=1e-12 atol=1e-13
# np.sort returns a sorted copy and leaves its argument alone
a = [0.5, -1.0, 2.0, 0.25]
b = py_sort(a)
print("sorted", fmt(b))
print("original untouched", fmt(a))
print("dot(a, sort(a))", fmt(py_vdot(a, b)))
s = py_sort(a)
print("sorted() of an array", fmt(s[0]), fmt(s[3]))
# FFT of a real signal, and back
n = 8
x = zeros(py_size(n))
for k to n {
    x[k] = sin(py_div_f(2.0 * 3.141592653589793 * k, n)) + 0.5 * cos(py_div_f(4.0 * 3.141592653589793 * k, n)) + 0.25
}
X = py_fft_r(x)
print("fft real parts", fmt(re(X)))
print("fft imaginary parts", fmt(im(X)))
print("|X|", fmt(abs(X)))
y = py_ifft_c(X)
print("ifft(fft(x)) real", fmt(re(y)))
# solve, cholesky, inv
A = [[4.0, 1.0, 0.5], [1.0, 3.0, 0.25], [0.5, 0.25, 2.0]]
rhs = [1.0, 2.0, 3.0]
sol = py_solve(A, rhs)
print("solve", fmt(sol))
print("residual", fmt(py_npmax(abs(py_bsub(A @ sol, rhs)))))
L = py_cholesky(A)
print("cholesky", fmt(L))
Ainv = py_inv(A)
print("inv", fmt(Ainv))
# np.linalg.eigh is refused: each eigenvector's sign (and a degenerate pair's basis) is the
# solver's choice, so Viv's Jacobi and LAPACK can disagree on inputs a program cannot see.
print("eigvalsh", fmt(py_eigvalsh(A)))

def py_test_test_sort_copies() {
    c = [3.0, 1.0, 2.0]
    d = py_sort(c)
    if not (d[0] == 1.0 and d[2] == 3.0) {
        assert_true(false)
        return 0
    }
    if not (c[0] == 3.0) {
        assert_true(false)
        return 0
    }
    assert_true(true)
    return 0
}
test "test_sort_copies" {
    py_test_test_sort_copies()
}

def py_test_test_solve_residual() {
    M = [[2.0, 1.0], [1.0, 3.0]]
    v = [1.0, 1.0]
    u = py_solve(M, v)
    if not (abs(2.0 * u[0] + u[1] - 1.0) < 1e-14) {
        assert_true(false)
        return 0
    }
    if not (abs(u[0] + 3.0 * u[1] - 1.0) < 1e-14) {
        assert_true(false)
        return 0
    }
    assert_true(true)
    return 0
}
test "test_solve_residual" {
    py_test_test_solve_residual()
}

def py_test_test_ifft_inverts_fft() {
    z = zeros(5)
    for k to 5 {
        z[k] = 1.0 + py_int(k * k)
    }
    back = py_ifft_c(py_fft_r(z))
    if not (py_ballclose(re(back), z, 0.0, 1e-13)) {
        assert_true(false)
        return 0
    }
    assert_true(true)
    return 0
}
test "test_ifft_inverts_fft" {
    py_test_test_ifft_inverts_fft()
}

