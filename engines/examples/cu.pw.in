! Copper: fcc, one atom, at the lattice constant dft/ref/materials.py uses (6.82 bohr).
! Smearing 0.02 Ry is dft/'s 0.01 Ha; no cutoff or k-mesh, so the engine uses the ones measured for copper.
&CONTROL
  calculation = 'scf'
  prefix = 'copper'
/
&SYSTEM
  ibrav = 2, celldm(1) = 6.82, nat = 1, ntyp = 1,
  occupations = 'smearing', degauss = 0.02
/
ATOMIC_SPECIES
  Cu  63.546  Cu.pz-d-rrkjus.UPF
ATOMIC_POSITIONS {alat}
  Cu 0.00 0.00 0.00
