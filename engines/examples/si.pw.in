! Silicon: an SCF input for Quantum ESPRESSO's pw.x, the way the tutorials write it.
&CONTROL
  calculation = 'scf'
  prefix = 'silicon'
  pseudo_dir = './pseudo'
/
&SYSTEM
  ibrav = 2, celldm(1) = 10.26, nat = 2, ntyp = 1,
  ecutwfc = 20.0
  nbnd = 8
/
&ELECTRONS
  conv_thr = 1.0d-10
/
ATOMIC_SPECIES
  Si  28.086  Si.pz-vbc.UPF
ATOMIC_POSITIONS {alat}
  Si 0.00 0.00 0.00
  Si 0.25 0.25 0.25
K_POINTS {automatic}
  2 2 2 1 1 1
