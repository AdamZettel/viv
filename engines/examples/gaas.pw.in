! Gallium arsenide, zincblende: ibrav = 0 with the cell written out in angstrom,
! and the atoms in crystal coordinates.
&CONTROL
  calculation = 'scf'
  prefix = 'gaas'
/
&SYSTEM
  ibrav = 0
  nat = 2
  ntyp = 2
  ecutwfc = 28.0
  occupations = 'fixed'
/
&ELECTRONS
/
ATOMIC_SPECIES
  Ga  69.723  Ga.pz-bhs.UPF
  As  74.922  As.pz-bhs.UPF
CELL_PARAMETERS angstrom
  -2.8258063062   0.000000000   2.8258063062
   0.000000000   2.8258063062   2.8258063062
  -2.8258063062   2.8258063062   0.000000000
ATOMIC_POSITIONS crystal
  Ga 0.00 0.00 0.00
  As 0.25 0.25 0.25
K_POINTS automatic
  2 2 2 0 0 0
