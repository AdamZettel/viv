# The Faddeeva function and the plasma dispersion function on a grid, for
# gallery/math/plot_plasma_dispersion_function.py: one call evaluates the
# whole grid, where vp.special.faddeeva_w takes one point per call.

import zfunc

#| w(x + i y) at every point of the grid x by y, row by row (row k is y[k]):
#| the real parts and the imaginary parts, each of len(y) * len(x) values.
def w_grid(x: Arr, y: Arr) {
    re_w = zeros(len(y) * len(x))
    im_w = zeros(len(y) * len(x))
    for k to len(y) {
        for j to len(x) {
            w = zfunc.zf_w(complex(x[j], y[k]))
            re_w[k * len(x) + j] = re(w)
            im_w[k * len(x) + j] = im(w)
        }
    }
    return re_w, im_w
}

#| Z(zeta) at every point of the grid, laid out as w_grid's.
def z_grid(x: Arr, y: Arr) {
    re_z = zeros(len(y) * len(x))
    im_z = zeros(len(y) * len(x))
    for k to len(y) {
        for j to len(x) {
            z = zfunc.zf_z(complex(x[j], y[k]))
            re_z[k * len(x) + j] = re(z)
            im_z[k * len(x) + j] = im(z)
        }
    }
    return re_z, im_z
}

test "w(0) = 1" {
    a, b = w_grid([0.0], [0.0])
    assert_near(a[0], 1.0, 1.0e-14)
    assert_near(b[0], 0.0, 1.0e-14)
}

