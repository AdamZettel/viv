const START = `import vipyr as vp

# water, unless atoms= and coords= say otherwise
r = vp.scf.run(basis="cc-pvdz")
r.e_tot, r.converged, r.mo_energy   # hartree
r.check()    # the program's own tests on this run`;

const VIV = `#| The sum of squares of an array.
def sumsq(x: Arr) -> Num {
    s = 0.0
    for v in x {
        s = s + v * v
    }
    return s
}`;

const OWN = `import numpy as np
import vipyr as vp

k = vp.load("kernels.viv")               # compiled to C once, cached under __pycache__/vipyr/
k.sumsq(np.arange(4.0))                  # 14.0: each annotated top-level def is a Python function

import vipyr.auto                        # or vp.install(): the import hook
import kernels                           # finds kernels.viv beside your .py files`;

const PIT = `import vipyr as vp

# does any feature of fn read a row later than the row it is computed for?
vp.check_point_in_time(fn, df, by="user_id", ts="ts")

# replay serving request by request: equal to the training batch, bit for bit?
vp.check_parity(fn, df, by="user_id", ts="ts")`;
