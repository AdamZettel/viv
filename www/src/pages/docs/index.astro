---
// SPDX-License-Identifier: MIT OR Apache-2.0
// SPDX-FileCopyrightText: 2026 The Viv authors
import DocPage from '../../layouts/DocPage.astro';
import { vivTree } from '../../lib/site';
import corpus from '../../data/vivDocExamples.json';

const counts = Object.fromEntries(
  corpus.topics.map((t) => [t.slug, corpus.examples.filter((e) => e.topic === t.slug).length])
);
const total = corpus.examples.length;
---

<DocPage
  title="Docs by example · Viv"
  description={`Viv construct by construct: ${corpus.topics.length} topics and ${total} runnable examples, each with its expected output checked by a test.`}
  tree={vivTree(corpus.topics)}>
  <h1>Examples of every construct</h1>
  <p class="lede">
    The language construct by construct. You can run and edit every snippet on these pages, and a
    test checks that each one still prints the output shown: the docs and the tests are the same
    {total} examples.
  </p>

  <div class="grid">
    {
      corpus.topics.map((t) => (
        <a class="card" href={`/docs/${t.slug}`}>
          <h3>{t.title}</h3>
          <p>{t.intro}</p>
          <span class="card-tag">
            {counts[t.slug]} example{counts[t.slug] === 1 ? '' : 's'}
          </span>
        </a>
      ))
    }
  </div>

  <h2>Two topics to read first</h2>
  <p>
    <a href="/docs/errors"><strong>Errors</strong></a> — every error message on that page is the
    compiler's actual message, checked by the doctest suite, so a change to any of them fails a test.
  </p>
  <p>
    <a href="/docs/scope"><strong>Scope &amp; mutation</strong></a> — where names live and which
    values are shared. Assignment and parameter passing <em>alias</em> arrays, so
    <code>b = a</code> shares storage and a function that writes into an array parameter writes
    into the caller's array. It is the rule most likely to surprise you if you guess.
  </p>

  <p>
    <a href="/compare"><strong>Python and Viv, side by side</strong></a> — small programs written
    in both languages, with the same output, lined up region by region, for a reader who knows
    Python.
  </p>

  <div class="nextprev">
    <span><a href="/tour">← The guided tour</a></span>
    <span><a href="/reference">The reference tables →</a></span>
  </div>
</DocPage>
