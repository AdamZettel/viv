---
// SPDX-License-Identifier: MIT OR Apache-2.0
// SPDX-FileCopyrightText: 2026 The Viv authors
// /gallery: the Viv programs by topic, in the shape of /vipyr/gallery. Each
// card is an entry of src/data/vivgallery.json (scripts/gallery-build.mjs):
// the plane-wave DFT code, the PDE solvers, the example programs with a
// reference value, and the Viv program behind each /vipyr/gallery example. A
// figure on a card is the first one that program's own run drew.
import DocPage from '../layouts/DocPage.astro';
import GalleryCard from '../components/GalleryCard.astro';
import gallery from '../data/vivgallery.json';
import pde from '../data/pde.json';
import programs from '../data/programs.json';
import { vivTree, TOPICS } from '../lib/site';
import SceneCards from '../components/SceneCards.jsx';
import { SCENES } from '../data/scenes.mjs';
import dft from '../data/dft.json';
import '../styles/scenes.css';

const entries = (gallery as any).entries as any[];
// the sections a whole page lists more of
const MORE: Record<string, [string, string]> = {
  'math-pde': ['/pde', `All ${pde.solvers.length} PDE solvers`],
};
const groups = TOPICS.map((t) => {
  const mine = entries.filter((e) => e.topic === t.id);
  const sections = t.sections
    .map((s) => ({ ...s, entries: mine.filter((e) => e.section === s.id), more: MORE[`${t.id}-${s.id}`] }))
    .filter((s) => s.entries.length);
  return { ...t, count: mine.length, sections };
}).filter((g) => g.count);
// the scenes at the top: every program with a picture of its own (the walk is on the home page)
const featured = SCENES.filter((s: any) => s.kind !== 'walk');
const si = (dft as any).materials.find((m: any) => m.id === 'si');
---

<DocPage
  title="Gallery · Viv"
  description="Programs written in Viv, by topic: each card shows the first figure the program drew or the result it is checked on, and opens the program in the workbench."
  tree={vivTree()}
  toc={[['scenes', 'Scenes'] as [string, string], ...groups.map((g) => [g.id, g.title] as [string, string])]}>
  <h1>Gallery</h1>
  <section class="g-scenes" aria-labelledby="scenes">
    <h2 id="scenes" class="sr-only">Scenes</h2>
    <SceneCards client:visible scenes={featured} extra={{ silicon: si.result }} />
  </section>
  <p class="lede">
    Programs written in Viv, by topic. Cards marked <em>In vipyr</em> are the ones <a href="/vipyr/gallery">vipyr's gallery</a> calls from Python.
  </p>
  {
    groups.map((g) => (
      <section class="g-topic">
        <h2 id={g.id}>{g.title}</h2>
        {g.sections.map((s) => (
          <>
            <h3 class="g-sec" id={`${g.id}-${s.id}`}>{s.title}</h3>
            <div class="g-grid">
              {s.entries.map((e) => (
                <GalleryCard entry={e} summary viv />
              ))}
            </div>
            {s.more && (
              <p class="g-more">
                <a href={s.more[0]}>{s.more[1]} →</a>
              </p>
            )}
          </>
        ))}
      </section>
    ))
  }
  <p class="g-more">
    <a href="/examples">All {programs.programs.length} example programs →</a>
  </p>
</DocPage>

<style>
  .g-scenes {
    margin: 0.4rem 0 2.2rem;
  }
  .g-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 16px;
    margin: 1rem 0 0.6rem;
  }
  .g-sec {
    margin: 1.4rem 0 0.2rem;
    font-size: 1.05rem;
  }
  .g-more {
    margin: 0.4rem 0 0;
    font-size: 0.95rem;
  }
</style>
