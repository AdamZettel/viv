---
// SPDX-License-Identifier: MIT OR Apache-2.0
// SPDX-FileCopyrightText: 2026 The Viv authors
// The walk through one program's run (components/ZoomWalk.jsx), full window
// like the vipyr atlas (/vipyr/map): the run's call graph drawn by the
// atlas's layout and styles, a camera that follows the run from call to call,
// and a panel with the def that runs and its code. The bundle and the
// recording are the explorer's (scripts/explore-build.mjs,
// public/explore-worker.js).
import Base from '../../../layouts/Base.astro';
import ZoomWalk from '../../../components/ZoomWalk.jsx';
import data from '../../../data/explore.json';
import 'katex/dist/katex.min.css';
import '../../../styles/explore.css';
import '../../../styles/codemap.css';
import '../../../styles/zoomwalk.css';

export function getStaticPaths() {
  return data.programs.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
---

<Base title={`Walk through ${p.title} · Viv`} description={`${p.blurb} Watch it run: the call graph follows each call to the def that runs, and the panel beside it marks the line that is running.`} app>
  <ZoomWalk client:only="react" slug={p.slug} title={p.title} />
  <noscript><p class="cm-empty">The walk needs JavaScript. The program is {p.file}.</p></noscript>
</Base>
