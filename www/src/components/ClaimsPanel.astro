---
// SPDX-License-Identifier: MIT OR Apache-2.0
// SPDX-FileCopyrightText: 2026 The Viv authors
// A post's claims, under its four views: how many of the numbers its prose
// states are tied to a test, the run, a reference or a citation, which are not,
// and how many of its sentences have been fact-checked. Built from
// src/data/claims.json (scripts/claims-build.mjs) and posts/claim_verdicts.json.
import katex from 'katex';
import { postClaims, STATUS_ORDER, STATUS_NOTES } from '../lib/claimsView.js';
import { renderProse } from '../lib/richText.js';
import ClaimsItem from './ClaimsItem.astro';
import '../styles/claims.css';

interface Props { slug: string }
const { slug } = Astro.props;
const c = postClaims(slug);
const prose = (s: string) => renderProse(s, katex);
const pct = (k: number) => (c && c.total ? (100 * k) / c.total : 0);
// what a reader has to look at: nothing ties it to the program, or it disagrees
const needs = c ? c.attention.filter((n) => n.status === 'orphan' || n.status === 'mismatch' || n.status === 'cited') : [];
const numHtml = (raw: string) => (/[\\^{]/.test(raw) ? prose(`$${raw.replace(/%$/, '\\%')}$`) : raw);
---

{c && c.total > 0 && (
  <section id="claims" class="cl-panel" aria-labelledby="cl-panel-h">
    <details>
      <summary>
        <h2 id="cl-panel-h">Claims</h2>
        <span class="cl-sum">
          {c.counts.checked} of {c.total} numbers in the prose checked by a test
          {c.failing > 0 && <b class="cl-bad"> · {c.failing} mismatch{c.failing > 1 ? 'es' : ''}</b>}
          {c.counts.orphan > 0 && <span> · {c.counts.orphan} orphan{c.counts.orphan > 1 ? 's' : ''}</span>}
          <span> · {c.checkedSentences} of {c.checkable} factual sentences fact-checked</span>
        </span>
        <span class="cl-bar" aria-hidden="true">
          {STATUS_ORDER.filter((s) => c.counts[s]).map((s) => <i class={`cl-s-${s}`} style={`width:${pct(c.counts[s])}%`} />)}
        </span>
      </summary>
      <div class="cl-body">
        <ul class="cl-legend">
          {STATUS_ORDER.filter((s) => c.counts[s]).map((s) => (
            <li><span class={`cl-chip cl-s-${s}`}>{s}</span> {c.counts[s]} <small>{STATUS_NOTES[s]}</small></li>
          ))}
        </ul>
        {needs.length > 0 && (
          <>
            <h3>Needs a reader</h3>
            <ul class="cl-list">{needs.map((n) => <ClaimsItem n={n} />)}</ul>
          </>
        )}
        <h3>Each number and what checks it</h3>
        <div class="tablewrap">
          <table class="cl-all">
            <thead><tr><th>Number</th><th class="r">Line</th><th>Checked by</th></tr></thead>
            <tbody>
              {c.all.map((n) => (
                <tr class={n.failing ? 'cl-failing' : undefined}>
                  <td class="cl-num" set:html={numHtml(n.raw)} />
                  <td class="r">{n.line}</td>
                  <td>
                    {n.test ? (
                      <>the test “{n.test}”</>
                    ) : n.checkedBy ? (
                      <span set:html={prose(n.checkedBy)} />
                    ) : (
                      <>
                        <span class={`cl-chip cl-s-${n.status}`}>not checked</span> <span set:html={prose(n.what || STATUS_NOTES[n.status])} />
                      </>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {c.disputed.length > 0 && (
          <>
            <h3>Disputed sentences</h3>
            <ul class="cl-list">{c.disputed.map((d) => <li class="cl-item cl-failing"><p class="cl-sent" set:html={prose(d.text)} /><p class="cl-what">{d.note}</p></li>)}</ul>
          </>
        )}
        <p class="cl-more">
          Every post's claims, with filters: <a href={`/claims?post=${slug}`}>Claims</a>. How a number is linked:
          <code>www/scripts/claims/link.mjs</code>.
        </p>
      </div>
    </details>
  </section>
)}
