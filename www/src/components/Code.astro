---
// SPDX-License-Identifier: MIT OR Apache-2.0
// SPDX-FileCopyrightText: 2026 The Viv authors
// Every static code block on the site. One component so that "this is code"
// has one look and one highlighter (src/lib/highlight.js).
//
//   <Code lang="viv" code={source} />
//   <Code lang="console" code={`$ viv run a.viv\n42`} />     a session: $ lines are commands
//   <Code lang="sh" code={...} />                            every line a command
//
// `tall` caps the height and scrolls; `wide` lifts the prose measure.
import { highlight } from '../lib/highlight.js';

export interface Props {
  code: string;
  lang?: string;
  tall?: boolean;
  wide?: boolean;
}
const { code, lang = '', tall = false, wide = false } = Astro.props;
---

<pre class:list={['dump', 'code', { 'dump-tall': tall, 'dump-wide': wide }]} data-lang={lang || undefined}><code set:html={highlight(code.replace(/\n$/, ''), lang)} /></pre>
