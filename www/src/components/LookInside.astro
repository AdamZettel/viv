---
// SPDX-License-Identifier: MIT OR Apache-2.0
// SPDX-FileCopyrightText: 2026 The Viv authors
// "Look inside this program" for the Astro pages (the galleries, /explore):
// the same block as LookInside.jsx, rendered at build time.
import { LOOK_INSIDE } from '../lib/atlasLink.js';
import '../styles/lookinside.css';

interface Props {
  links: { atlas: string; explore: string | null } | null;
  compact?: boolean;
  here?: 'atlas' | 'explore' | null;
  heading?: string;
}
const { links, compact = false, here = null, heading = LOOK_INSIDE.heading } = Astro.props;
const cur = (k: string) => (here === k ? { 'aria-current': 'page' } : {});
---

{
  links && links.atlas && (
    <section class={`li-block${compact ? ' li-compact' : ''}`} aria-label={heading}>
      <p class="li-head">{heading}</p>
      <ul class="li-ways">
        <li class="li-way">
          <a class="li-btn" href={links.atlas} {...cur('atlas')}>
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="7" height="5" rx="1" /><rect x="14" y="4" width="7" height="5" rx="1" /><rect x="8.5" y="15" width="7" height="5" rx="1" /><path d="M6.5 9v3h11V9M12 12v3" /></svg>
            Atlas
          </a>
          <p class="li-line">{LOOK_INSIDE.atlas}</p>
        </li>
        <li class="li-way">
          {links.explore ? (
            <>
              <a class="li-btn" href={links.explore} {...cur('explore')}>
                <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M5 4.5v15l10-7.5z" /><rect x="16.5" y="4.5" width="2.5" height="15" rx="0.6" /></svg>
                Explore
              </a>
              <p class="li-line">{LOOK_INSIDE.explore}</p>
            </>
          ) : (
            <p class="li-line li-norun">{LOOK_INSIDE.noRun}</p>
          )}
        </li>
      </ul>
    </section>
  )
}
