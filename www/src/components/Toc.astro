---
// SPDX-License-Identifier: MIT OR Apache-2.0
// SPDX-FileCopyrightText: 2026 The Viv authors
// A sticky contents rail for the long pages. Items are declared by the page
// rather than scraped, so the labels can be shorter than the headings.
export interface Props {
  items: [string, string][]; // [anchor, label]
  title?: string;
}
const { items, title = 'On this page' } = Astro.props;
---

<nav class="toc" aria-label={title}>
  <h4>{title}</h4>
  <ul>
    {items.map(([id, label]) => (
      <li><a href={`#${id}`}>{label}</a></li>
    ))}
  </ul>
</nav>
