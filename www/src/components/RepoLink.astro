// A link to a file in the repository while it is public (REPO_PUBLIC in
// src/lib/repo.js); until then the same words, unlinked.
import { repoLink } from '../lib/repo.js';

interface Props {
  path: string;
  kind?: 'blob' | 'tree';
  class?: string;
}
const { path, kind = 'blob', class: cls } = Astro.props;
const href = repoLink(path, kind);
---

{href ? <a href={href} class={cls}><slot /></a> : <span class={cls}><slot /></span>}
