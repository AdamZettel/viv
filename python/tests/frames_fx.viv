record Cols {
    x: Arr
    n: [Int]
}

record Out {
    y: Arr
    k: [Int]
}

record Echo {
    tag: [Int]
    when: [Int]
}

def scale(x: Arr, n: [Int], a: Num) -> Out {
    y = zeros(len(x))
    k = int_zeros(len(n))
    for i to len(x) {
        y[i] = a * x[i] + n[i]
        k[i] = 2 * n[i]
    }
    return Out { y: y, k: k }
}

def scale_rec(p: Cols) -> Out {
    return scale(p.x, p.n, 1.0)
}

def masked(v: Arr, v_valid: [Int]) -> Arr {
    out = zeros(len(v))
    for i to len(v) {
        out[i] = v[i]
        if v_valid[i] == 0 {
            out[i] = -1.0
        }
    }
    return out
}

def echo(tag: [Int], when: [Int]) -> Echo {
    return Echo { tag: tag, when: when }
}

def head2(n: [Int]) -> Out {
    return Out { y: [1.0, 2.0], k: [n[0], n[1]] }
}

def total(x: Arr) -> Num {
    return sum(x)
}

def poke(x: Arr) -> Num {
    j: Int = len(x) + 5
    return x[j]
}

