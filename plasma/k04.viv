# k lambda_D = 0.4, damped less than half as fast as 0.5. Exact root:
# omega = 1.28506 - 0.06613 i (posts/refs/landau_root.py; the program computes
# it itself with lib/zfunc).
#
#     viv run --use plasma/k04.viv --use plasma/landau.viv plasma/landau_check.viv
#
# Choices, measured as for plasma/k05.viv:
#
#   DT       gamma error   omega error   energy drift / W0   native
#   0.2      5.7e-3        1.0e-3        7.3e-3              0.20 s
#   0.1      1.4e-3        2.5e-4        1.8e-3              0.39 s
#   0.05     3.6e-4        6.2e-5        4.2e-4              1.03 s   <- this deck
#   0.025    9.1e-5        1.5e-5        5.7e-5              1.68 s
#   0.0125   2.5e-5        3.4e-6        -7.5e-5             3.19 s
#
# As at 0.5, second order in DT, and NX (8, 16, 32) and NV (128, 512) do not
# show at DT = 0.05. The run is longer because the wave damps slower: by
# t = 60 its field energy has fallen by e^-8.

#: NX  grid points in x over one wavelength
NX = 16.0
#: NV  grid points in v on [-VMAX, VMAX), periodic
NV = 256.0
#: VMAX  the velocity grid's edge, in units of the plasma frequency times the Debye length; 6 VT or more
VMAX = 6.0
#: VT  the electrons' thermal speed; the Debye length is VT in these units
VT = 1.0
#: K0  the perturbation's wavenumber; the box is one wavelength, 2 pi / K0
K0 = 0.4
#: ALPHA  the relative amplitude of the density perturbation, 1 + ALPHA cos(K0 x); small, so the wave stays linear
ALPHA = 1.0e-4
#: DT  the time step, in units of the inverse plasma frequency
DT = 0.05
#: T_END  the run's length, in units of the inverse plasma frequency
T_END = 60.0
#: T_FIT0  the fit window's start: the next root down, 1.461 - 0.879 i, damps faster by 0.81, so by t = 12 its share of the field has fallen by e^-9.8 = 6e-5 relative to the Landau mode's
T_FIT0 = 12.0
#: T_FIT1  the fit window's end
T_FIT1 = 60.0

