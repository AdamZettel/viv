# B052 (bugs/ledger.jsonl): a variable named after a function of unistd.h,
# strings.h, signal.h or select.h (acct, index, read, write, ...) was a C
# compile error. Each name here must compile to C and print the same in the
# interpreter, native and wasm.
acct = 1.0
index = 2.0
read = 3.0
write = 4.0
pause = 5.0
select = 6.0
total = acct + index + read + write + pause + select
print(total)

test "variables named like libc functions keep their values" {
    assert_near(total, 21.0, 0.0)
}

