# B205 (bugs/ledger.jsonl): `s = int(2.0)` left `s` a number, so `f(s)` with
# `f(n: Int)` was refused although the note said int(x) makes an Int. A
# variable whose every assignment is an Int (int(...), a literal, Int
# arithmetic) is now an Int; one that is also given a fraction stays a number.
def f(n: Int) -> Int {
    return n * 2
}

s = int(2.0)
k = int(7.9)
k = k // 2
j = int(7.9)
j = j / 2
print(f(s), f(k), j)

test "a variable that holds int(...) is an Int" {
    assert_true(f(s) == 4)
    assert_true(f(k) == 6)
    assert_near(j, 3.5, 0.0)
}

