# B110 (bugs/ledger.jsonl): `assert_true(ok)` in a test made `ok` a number
# before the comparison assigned to it was typed, when that comparison read a
# result unpacked from a def whose return type arrives later; the program was
# refused ("`ok` is a number but is assigned a boolean").
def pair() {
    return 1, 2.0
}

def run() {
    n, s = pair()
    k: Int = int(n)
    return k, s
}

k, s = run()
ok = s <= 3.0
print(ok)

test "a comparison asserted in a test stays a boolean" {
    assert_true(ok)
}

