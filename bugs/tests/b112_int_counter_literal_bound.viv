# B112 (bugs/ledger.jsonl): a loop variable that is an Int (an earlier loop
# counted it to an Int bound) and is counted again to a literal bound compiled
# to invalid wasm (the counter converted to f64 for an i64 local); the
# interpreter and C ran it.
def f(n: Int) {
    s = 0.0
    for i to n {
        s += float(i)
    }
    for i to 3 {
        s += float(i)
    }
    return s
}
print(f(4))

test "an Int loop variable counted to a literal bound" {
    assert_near(f(4), 9.0, 0.0)
}

