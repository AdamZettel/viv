# B346 (bugs/ledger.jsonl): a module of defs and records alone, with no test
# block and no top-level statement, did not link as a C program ("Undefined
# symbols: _main"), so tools/three-engines.sh reported DOES NOT BUILD. The C
# backend now writes an empty main for it; every engine prints nothing.
record Pair {
    a: Num
    b: Num
}

def f(x: Int) -> Int {
    return x
}

def swap(p: Pair) -> Pair {
    return Pair { a: p.b, b: p.a }
}

