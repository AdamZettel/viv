# B208 (bugs/ledger.jsonl): a record field could not name a record declared
# later in the file ("unknown type `Thing`"), though a def can call a later
# def. Records are now resolved, and their C structs written, in the order
# their fields need.
record Box {
    item: Thing
    label: Str
}

record Thing {
    n: Num
}

b = Box { item: Thing { n: 1.5 }, label: "box" }
print(b.item.n, b.label)

test "a field names a record declared after it" {
    assert_near(b.item.n, 1.5, 0.0)
}

