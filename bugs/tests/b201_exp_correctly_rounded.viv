# B292 (bugs/ledger.jsonl): exp(1.0) printed 2.7182818284590455, one ulp above
# the double nearest e, because exp was musl's (within an ulp, not correctly
# rounded). exp is now correctly rounded in every engine
# (lang/viv/src/vmath/exp_cr.rs; tools/vmath/check_exp.py holds it to mpmath).
print(fmt(exp(1.0)), fmt(exp(1.4901161193847656e-08)), fmt(exp(-710.5674486794707)))

test "exp gives the double nearest e^x" {
    assert_true(exp(1.0) == e)
    assert_true(fmt(exp(1.0)) == "2.718281828459045")
    # x = 2^-26: e^x lies just above a midpoint between two doubles
    assert_true(fmt(exp(1.4901161193847656e-08)) == "1.0000000149011614")
    # a subnormal result
    assert_true(fmt(exp(-710.5674486794707)) == "2.53792052732055e-309")
}

