# B204 (bugs/ledger.jsonl): an if-expression with an integer literal on one
# side and an Int on the other (`return 0 if n == 0 else n` in a `-> Int`
# def) was refused, naming the compiler's hidden variable `viv__if1`. The
# literal now takes the other side's type, as it does in `x: Int = 0`.
def f(n: Int) -> Int {
    return 0 if n == 0 else n
}

c = true
s: Int = -1 if c else 1
print(f(3), f(0), s)

test "a literal beside an Int in an if-expression is an Int" {
    assert_true(f(3) == 3)
    assert_true(f(0) == 0)
    assert_true(s == -1)
}

