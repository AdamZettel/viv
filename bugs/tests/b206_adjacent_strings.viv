# B206 (bugs/ledger.jsonl): two string literals side by side were accepted
# and the second dropped (`"a" "b"` gave "a"), and `"""abc"""` gave "". They
# are now Python's: adjacent literals join, and a triple-quoted string holds
# newlines and quotes.
t = "a" "b"
s = """abc
d"e"
"""
long = ("one "
        "two")
print(t, len(s), long)

test "adjacent and triple-quoted literals keep their text" {
    assert_true(t == "ab")
    assert_true(s == "abc\nd\"e\"\n")
    assert_true(long == "one two")
}

