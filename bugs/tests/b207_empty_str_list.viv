# B207 (bugs/ledger.jsonl): `used: [Str] = []` then `"a" in used` stopped
# the interpreter ("`in` looks for a number in an array") while C and wasm
# printed false: the interpreter's `[]` is an empty real array until a string
# is appended, and `in` did not read it as an empty list of strings.
used: [Str] = []
print("a" in used, len(used))
used = append(used, "a")
print("a" in used, used)

test "an empty [Str] holds no string" {
    assert_true("a" in used)
    assert_true(not ("b" in used))
}

