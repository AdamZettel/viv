# B203 (bugs/ledger.jsonl): the zero-pad flag was read as part of the width
# and dropped: fmt(-1.5, "06.2f") gave " -1.50" (Python: "-01.50") and
# fmt(2.0, "05d") gave "    2" (Python: "00002").
x = -1.5
n: Int = 42
s = "ab"
print(fmt(x, "06.2f"), f"{x:06.2f}", fmt(2.0, "05d"), f"{n:05d}", fmt(s, "05"))

test "the zero flag pads with zeros after the sign" {
    assert_true(fmt(x, "06.2f") == "-01.50")
    assert_true(f"{x:06.2f}" == "-01.50")
    assert_true(fmt(2.0, "05d") == "00002")
    assert_true(f"{n:05d}" == "00042")
    assert_true(f"{-n:05d}" == "-0042")
    assert_true(fmt(s, "05") == "ab000")
}

