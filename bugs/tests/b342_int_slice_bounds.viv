# B342 (bugs/ledger.jsonl): `s[a:b]` with Int bounds was refused ("expected
# a number for a slice bound") though an Int indexes directly. An Int bound
# now converts as an Int index does, for strings, lists of strings and
# arrays alike.
s = "hello"
a: Int = 1
b: Int = 3
words = ["a", "b", "c", "d"]
v = [1.0, 2.0, 3.0, 4.0]
print(s[a:b], words[a:b], v[a:b], s[a:], v[:b])

test "Int slice bounds" {
    assert_true(s[a:b] == "el")
    assert_true(len(words[a:b]) == 2)
    assert_true(v[a:b][0] == 2.0)
}

