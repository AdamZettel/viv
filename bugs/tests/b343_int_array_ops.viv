# B343 (bugs/ledger.jsonl): [Int] lacked extend, sum, slices, min, max and
# sort, which Arr has. Each is now exact on Ints in every engine: sum stops
# on overflow, min and max of an empty Int array stop, sort orders Ints.
a: [Int] = [3, 1, 2]
b: [Int] = [4, -7]
a = extend(a, b)
lo: Int = 1
hi: Int = 3
middle = a[lo:hi]
print(a, sum(a), min(a), max(a))
print(middle, a[1:], a[:-1], a[::2])
a[0:2] = b
sort(a)
print(a)
none: [Int] = []
print(sum(none), len(a[0:0]))
big: [Int] = [9223372036854775807, -9223372036854775807, 5]
print(sum(big))

test "Int array operations" {
    assert_true(sum(a) == -4)
    assert_true(min(a) == -7)
    assert_true(max(a) == 4)
    assert_true(middle[1] == 2)
    assert_true(sum(big) == 5)
}

