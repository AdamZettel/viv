# B209 (bugs/ledger.jsonl): a record field typed `Map` refused a map with
# string keys ("field `m` of `R` is a map but this value is a map with
# string keys"), where a parameter `m: Map` takes one. The field now takes
# its kinds from the maps it is built from, as the parameter does.
record R {
    m: Map
}

m = map()
m["a"] = 1.0
r = R { m: m }
print(r.m, r.m["a"])

test "a Map field holds a map of strings" {
    assert_near(r.m["a"], 1.0, 0.0)
}

