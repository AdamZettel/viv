import xc.gga.gga_k_vw as c0
import xc.lda.lda_k_gds08_worker as c1

#| GGA_K_GDS08 (libxc id 591): Combined analytical theory with Monte Carlo sampling
#|| 1.0 * GGA_K_VW + 1.0 * LDA_K_GDS08_WORKER
#~ reference: L. M. Ghiringhelli and L. Delle Site.,  Phys. Rev. B 77, 073104 (2008)

#| libxc's exc and vxc of the mixture, unpolarized: per point [zk, vrho, vsigma]
def eval_unpol(rho: Arr, sigma: Arr) -> Arr {
    nspin = 1
    width = 3
    n = len(rho) // nspin
    out = zeros(width * n)
    out = out + 1.0 * c0.eval_unpol(rho, sigma)
    part1 = c1.eval_unpol(rho)
    for i to n {
        for j to 2 {
            out[width * i + j] += 1.0 * part1[2 * i + j]
        }
    }
    return out
}

#| libxc's exc and vxc of the mixture, spin-polarized: per point [zk, vrho, vsigma]
def eval_pol(rho: Arr, sigma: Arr) -> Arr {
    nspin = 2
    width = 6
    n = len(rho) // nspin
    out = zeros(width * n)
    out = out + 1.0 * c0.eval_pol(rho, sigma)
    part1 = c1.eval_pol(rho)
    for i to n {
        for j to 3 {
            out[width * i + j] += 1.0 * part1[3 * i + j]
        }
    }
    return out
}
