import xc.gga.gga_x_pbe as c0
import xc.gga.gga_c_pbe as c1

#| HYB_GGA_XC_PBEH (libxc id 406): PBEH (PBE0)
#|| 0.75 * GGA_X_PBE + 1.0 * GGA_C_PBE
#~ reference: C. Adamo and V. Barone.,  J. Chem. Phys. 110, 6158 (1999)
#~ reference: M. Ernzerhof and G. E. Scuseria.,  J. Chem. Phys. 110, 5029 (1999)
#~ hybrid: exact-exchange fraction cam_alpha = 0.25, cam_beta = 0.0, omega = 0.0; this module is the semilocal part only

#| libxc's exc and vxc of the mixture, unpolarized: per point [zk, vrho, vsigma]
def eval_unpol(rho: Arr, sigma: Arr) -> Arr {
    nspin = 1
    width = 3
    n = len(rho) // nspin
    out = zeros(width * n)
    out = out + 0.75 * c0.eval_unpol(rho, sigma)
    out = out + 1.0 * c1.eval_unpol(rho, sigma)
    return out
}

#| libxc's exc and vxc of the mixture, spin-polarized: per point [zk, vrho, vsigma]
def eval_pol(rho: Arr, sigma: Arr) -> Arr {
    nspin = 2
    width = 6
    n = len(rho) // nspin
    out = zeros(width * n)
    out = out + 0.75 * c0.eval_pol(rho, sigma)
    out = out + 1.0 * c1.eval_pol(rho, sigma)
    return out
}
