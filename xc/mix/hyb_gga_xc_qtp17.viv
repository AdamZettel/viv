import xc.lda.lda_x as c0
import xc.lda.lda_c_vwn_rpa as c1
import xc.gga.gga_c_lyp as c2

#| HYB_GGA_XC_QTP17 (libxc id 460): Global hybrid for vertical ionization potentials
#|| 0.38 * LDA_X + 0.19999999999999996 * LDA_C_VWN_RPA + 0.8 * GGA_C_LYP
#~ reference: Y. Jin and R. J. Bartlett.,  J. Chem. Phys. 149, 064111 (2018)
#~ hybrid: exact-exchange fraction cam_alpha = 0.62, cam_beta = 0.0, omega = 0.0; this module is the semilocal part only

#| libxc's exc and vxc of the mixture, unpolarized: per point [zk, vrho, vsigma]
def eval_unpol(rho: Arr, sigma: Arr) -> Arr {
    nspin = 1
    width = 3
    n = len(rho) // nspin
    out = zeros(width * n)
    part0 = c0.eval_unpol(rho)
    for i to n {
        for j to 2 {
            out[width * i + j] += 0.38 * part0[2 * i + j]
        }
    }
    part1 = c1.eval_unpol(rho)
    for i to n {
        for j to 2 {
            out[width * i + j] += 0.19999999999999996 * part1[2 * i + j]
        }
    }
    out = out + 0.8 * c2.eval_unpol(rho, sigma)
    return out
}

#| libxc's exc and vxc of the mixture, spin-polarized: per point [zk, vrho, vsigma]
def eval_pol(rho: Arr, sigma: Arr) -> Arr {
    nspin = 2
    width = 6
    n = len(rho) // nspin
    out = zeros(width * n)
    part0 = c0.eval_pol(rho)
    for i to n {
        for j to 3 {
            out[width * i + j] += 0.38 * part0[3 * i + j]
        }
    }
    part1 = c1.eval_pol(rho)
    for i to n {
        for j to 3 {
            out[width * i + j] += 0.19999999999999996 * part1[3 * i + j]
        }
    }
    out = out + 0.8 * c2.eval_pol(rho, sigma)
    return out
}
