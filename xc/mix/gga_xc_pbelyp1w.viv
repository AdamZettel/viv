import xc.lda.lda_c_vwn as c0
import xc.gga.gga_x_pbe as c1
import xc.gga.gga_c_lyp as c2

#| GGA_XC_PBELYP1W (libxc id 175): PBELYP1W
#|| 0.26 * LDA_C_VWN + 1.0 * GGA_X_PBE + 0.74 * GGA_C_LYP
#~ reference: E. E. Dahlke and D. G. Truhlar.,  J. Phys. Chem. B 109, 15677 (2005)

#| libxc's exc and vxc of the mixture, unpolarized: per point [zk, vrho, vsigma]
def eval_unpol(rho: Arr, sigma: Arr) -> Arr {
    nspin = 1
    width = 3
    n = len(rho) // nspin
    out = zeros(width * n)
    part0 = c0.eval_unpol(rho)
    for i to n {
        for j to 2 {
            out[width * i + j] += 0.26 * part0[2 * i + j]
        }
    }
    out = out + 1.0 * c1.eval_unpol(rho, sigma)
    out = out + 0.74 * c2.eval_unpol(rho, sigma)
    return out
}

#| libxc's exc and vxc of the mixture, spin-polarized: per point [zk, vrho, vsigma]
def eval_pol(rho: Arr, sigma: Arr) -> Arr {
    nspin = 2
    width = 6
    n = len(rho) // nspin
    out = zeros(width * n)
    part0 = c0.eval_pol(rho)
    for i to n {
        for j to 3 {
            out[width * i + j] += 0.26 * part0[3 * i + j]
        }
    }
    out = out + 1.0 * c1.eval_pol(rho, sigma)
    out = out + 0.74 * c2.eval_pol(rho, sigma)
    return out
}
