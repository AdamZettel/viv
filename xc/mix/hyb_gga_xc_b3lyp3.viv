import xc.lda.lda_x as c0
import xc.gga.gga_x_b88 as c1
import xc.lda.lda_c_vwn_3 as c2
import xc.gga.gga_c_lyp as c3

#| HYB_GGA_XC_B3LYP3 (libxc id 394): B3LYP with VWN functional 3 instead of RPA
#|| 0.08000000000000007 * LDA_X + 0.72 * GGA_X_B88 + 0.18999999999999995 * LDA_C_VWN_3 + 0.81 * GGA_C_LYP
#~ reference: P. J. Stephens, F. J. Devlin, C. F. Chabalowski, and M. J. Frisch.,  J. Phys. Chem. 98, 11623 (1994)
#~ hybrid: exact-exchange fraction cam_alpha = 0.2, cam_beta = 0.0, omega = 0.0; this module is the semilocal part only

#| libxc's exc and vxc of the mixture, unpolarized: per point [zk, vrho, vsigma]
def eval_unpol(rho: Arr, sigma: Arr) -> Arr {
    nspin = 1
    width = 3
    n = len(rho) // nspin
    out = zeros(width * n)
    part0 = c0.eval_unpol(rho)
    for i to n {
        for j to 2 {
            out[width * i + j] += 0.08000000000000007 * part0[2 * i + j]
        }
    }
    out = out + 0.72 * c1.eval_unpol(rho, sigma)
    part2 = c2.eval_unpol(rho)
    for i to n {
        for j to 2 {
            out[width * i + j] += 0.18999999999999995 * part2[2 * i + j]
        }
    }
    out = out + 0.81 * c3.eval_unpol(rho, sigma)
    return out
}

#| libxc's exc and vxc of the mixture, spin-polarized: per point [zk, vrho, vsigma]
def eval_pol(rho: Arr, sigma: Arr) -> Arr {
    nspin = 2
    width = 6
    n = len(rho) // nspin
    out = zeros(width * n)
    part0 = c0.eval_pol(rho)
    for i to n {
        for j to 3 {
            out[width * i + j] += 0.08000000000000007 * part0[3 * i + j]
        }
    }
    out = out + 0.72 * c1.eval_pol(rho, sigma)
    part2 = c2.eval_pol(rho)
    for i to n {
        for j to 3 {
            out[width * i + j] += 0.18999999999999995 * part2[3 * i + j]
        }
    }
    out = out + 0.81 * c3.eval_pol(rho, sigma)
    return out
}
