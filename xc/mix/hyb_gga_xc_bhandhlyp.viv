import xc.gga.gga_x_b88 as c0
import xc.gga.gga_c_lyp as c1

#| HYB_GGA_XC_BHANDHLYP (libxc id 436): BHandHLYP
#|| 0.5 * GGA_X_B88 + 1.0 * GGA_C_LYP
#~ reference: A. D. Becke.,  J. Chem. Phys. 98, 1372 (1993)
#~ reference: Defined through Gaussian implementation.
#~ hybrid: exact-exchange fraction cam_alpha = 0.5, cam_beta = 0.0, omega = 0.0; this module is the semilocal part only

#| libxc's exc and vxc of the mixture, unpolarized: per point [zk, vrho, vsigma]
def eval_unpol(rho: Arr, sigma: Arr) -> Arr {
    nspin = 1
    width = 3
    n = len(rho) // nspin
    out = zeros(width * n)
    out = out + 0.5 * c0.eval_unpol(rho, sigma)
    out = out + 1.0 * c1.eval_unpol(rho, sigma)
    return out
}

#| libxc's exc and vxc of the mixture, spin-polarized: per point [zk, vrho, vsigma]
def eval_pol(rho: Arr, sigma: Arr) -> Arr {
    nspin = 2
    width = 6
    n = len(rho) // nspin
    out = zeros(width * n)
    out = out + 0.5 * c0.eval_pol(rho, sigma)
    out = out + 1.0 * c1.eval_pol(rho, sigma)
    return out
}
