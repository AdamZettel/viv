import xc.gga.gga_x_rpw86 as c0
import xc.gga.gga_c_pbe as c1

#| GGA_XC_VV10 (libxc id 255): Vydrov and Van Voorhis
#|| 1.0 * GGA_X_RPW86 + 1.0 * GGA_C_PBE
#~ reference: O. A. Vydrov and T. Van Voorhis.,  J. Chem. Phys. 133, 244103 (2010)

#| libxc's exc and vxc of the mixture, unpolarized: per point [zk, vrho, vsigma]
def eval_unpol(rho: Arr, sigma: Arr) -> Arr {
    nspin = 1
    width = 3
    n = len(rho) // nspin
    out = zeros(width * n)
    out = out + 1.0 * c0.eval_unpol(rho, sigma)
    out = out + 1.0 * c1.eval_unpol(rho, sigma)
    return out
}

#| libxc's exc and vxc of the mixture, spin-polarized: per point [zk, vrho, vsigma]
def eval_pol(rho: Arr, sigma: Arr) -> Arr {
    nspin = 2
    width = 6
    n = len(rho) // nspin
    out = zeros(width * n)
    out = out + 1.0 * c0.eval_pol(rho, sigma)
    out = out + 1.0 * c1.eval_pol(rho, sigma)
    return out
}
