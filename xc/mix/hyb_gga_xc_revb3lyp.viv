import xc.lda.lda_x as c0
import xc.gga.gga_x_b88 as c1
import xc.lda.lda_c_vwn_rpa as c2
import xc.gga.gga_c_lyp as c3

#| HYB_GGA_XC_REVB3LYP (libxc id 454): Revised B3LYP
#|| 0.13 * LDA_X + 0.67 * GGA_X_B88 + 0.16000000000000003 * LDA_C_VWN_RPA + 0.84 * GGA_C_LYP
#~ reference: L. Lu, H. Hu, H. Hou, and B. Wang.,  Comput. Theor. Chem. 1015, 64 (2013)
#~ hybrid: exact-exchange fraction cam_alpha = 0.2, cam_beta = 0.0, omega = 0.0; this module is the semilocal part only

#| libxc's exc and vxc of the mixture, unpolarized: per point [zk, vrho, vsigma]
def eval_unpol(rho: Arr, sigma: Arr) -> Arr {
    nspin = 1
    width = 3
    n = len(rho) // nspin
    out = zeros(width * n)
    part0 = c0.eval_unpol(rho)
    for i to n {
        for j to 2 {
            out[width * i + j] += 0.13 * part0[2 * i + j]
        }
    }
    out = out + 0.67 * c1.eval_unpol(rho, sigma)
    part2 = c2.eval_unpol(rho)
    for i to n {
        for j to 2 {
            out[width * i + j] += 0.16000000000000003 * part2[2 * i + j]
        }
    }
    out = out + 0.84 * c3.eval_unpol(rho, sigma)
    return out
}

#| libxc's exc and vxc of the mixture, spin-polarized: per point [zk, vrho, vsigma]
def eval_pol(rho: Arr, sigma: Arr) -> Arr {
    nspin = 2
    width = 6
    n = len(rho) // nspin
    out = zeros(width * n)
    part0 = c0.eval_pol(rho)
    for i to n {
        for j to 3 {
            out[width * i + j] += 0.13 * part0[3 * i + j]
        }
    }
    out = out + 0.67 * c1.eval_pol(rho, sigma)
    part2 = c2.eval_pol(rho)
    for i to n {
        for j to 3 {
            out[width * i + j] += 0.16000000000000003 * part2[3 * i + j]
        }
    }
    out = out + 0.84 * c3.eval_pol(rho, sigma)
    return out
}
