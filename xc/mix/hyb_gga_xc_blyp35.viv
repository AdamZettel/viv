import xc.gga.gga_x_b88 as c0
import xc.gga.gga_c_lyp as c1

#| HYB_GGA_XC_BLYP35 (libxc id 499): BLYP35
#|| 0.65 * GGA_X_B88 + 1.0 * GGA_C_LYP
#~ reference: M. Renz, K. Theilacker, C. Lambert, and M. Kaupp.,  J. Am. Chem. Soc. 131, 16292-16302 (2009)
#~ reference: M. Kaupp, M. Renz, M. Parthey, M. Stolte, F. Würthner, and C. Lambert.,  Phys. Chem. Chem. Phys. 13, 16973-16986 (2011)
#~ hybrid: exact-exchange fraction cam_alpha = 0.35, cam_beta = 0.0, omega = 0.0; this module is the semilocal part only

#| libxc's exc and vxc of the mixture, unpolarized: per point [zk, vrho, vsigma]
def eval_unpol(rho: Arr, sigma: Arr) -> Arr {
    nspin = 1
    width = 3
    n = len(rho) // nspin
    out = zeros(width * n)
    out = out + 0.65 * c0.eval_unpol(rho, sigma)
    out = out + 1.0 * c1.eval_unpol(rho, sigma)
    return out
}

#| libxc's exc and vxc of the mixture, spin-polarized: per point [zk, vrho, vsigma]
def eval_pol(rho: Arr, sigma: Arr) -> Arr {
    nspin = 2
    width = 6
    n = len(rho) // nspin
    out = zeros(width * n)
    out = out + 0.65 * c0.eval_pol(rho, sigma)
    out = out + 1.0 * c1.eval_pol(rho, sigma)
    return out
}
