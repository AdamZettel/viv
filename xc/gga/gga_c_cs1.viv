from xc.core import gga_pol_point, gga_unpol_point

#| GGA_C_CS1 (libxc id 565): A dynamical correlation functional
#|| kind c, family gga, Maple script gga_exc/gga_c_cs1.mpl
#~ reference: N. C. Handy and A. J. Cohen.,  J. Chem. Phys. 116, 5411-5418 (2002)
#~ reference: E. I. Proynov and A. J. Thakkar.,  Int. J. Quantum Chem. 106, 436–446 (2006)

#: DENS_THRESHOLD  libxc's dens_threshold for this functional: smaller total densities give zero
DENS_THRESHOLD = 1.0e-20
#: SIGMA_THRESHOLD  libxc's sigma_threshold, dens_threshold^(4/3)
SIGMA_THRESHOLD = 2.154434690031891e-27

#| the energy per particle, unpolarized: x = [rho, sigma]
def zk_unpol(x: Arr) -> Num {
    rho = x[0]
    sigma = x[1]
    xt = sqrt(sigma) / rho ^ (4.0 / 3.0)
    cs1_eab = 1.0 / 4.0 / (1.0 + 0.349 * rho ^ (-1.0 / 3.0)) * (-0.159068 + 2.86308e-07 * xt ^ 4.0 / (1.0 + 0.006 * xt ^ 2.0) ^ 2.0)
    t = rho / 2.0
    t_1 = t ^ (1.0 / 3.0)
    xs0 = sqrt(sigma / 4.0) / t ^ (4.0 / 3.0)
    cs1_ess = 1.0 / 2.0 * t_1 / (t_1 + 0.349) * (-0.018897 + 5.58864e-06 * xs0 ^ 4.0 / (1.0 + 0.006 * xs0 ^ 2.0) ^ 2.0)
    f_cs1 = cs1_eab + cs1_ess + cs1_ess
    return f_cs1
}

#| the energy per particle, spin-polarized: x = [rho_a, rho_b, sigma_aa, sigma_ab, sigma_bb]
def zk_pol(x: Arr) -> Num {
    rho_a = x[0]
    rho_b = x[1]
    sigma_aa = x[2]
    sigma_ab = x[3]
    sigma_bb = x[4]
    dens = rho_a + rho_b
    zeta = (rho_a - rho_b) / dens
    xt = sqrt(sigma_aa + 2.0 * sigma_ab + sigma_bb) / dens ^ (4.0 / 3.0)
    cs1_eab = (1.0 - zeta ^ 2.0) / 4.0 / (1.0 + 0.349 * dens ^ (-1.0 / 3.0)) * (-0.159068 + 2.86308e-07 * xt ^ 4.0 / (1.0 + 0.006 * xt ^ 2.0) ^ 2.0)
    t = 1.0 + zeta
    if t <= 2.220446049250313e-16 {
        opz_pow_n = 2.220446049250313e-16
    }
    else {
        opz_pow_n = t
    }
    t_1 = rho_a ^ (1.0 / 3.0)
    xs0 = sqrt(sigma_aa) / rho_a ^ (4.0 / 3.0)
    cs1_ess = opz_pow_n / 2.0 * t_1 / (t_1 + 0.349) * (-0.018897 + 5.58864e-06 * xs0 ^ 4.0 / (1.0 + 0.006 * xs0 ^ 2.0) ^ 2.0)
    t_2 = 1.0 - zeta
    if t_2 <= 2.220446049250313e-16 {
        opz_pow_n_1 = 2.220446049250313e-16
    }
    else {
        opz_pow_n_1 = t_2
    }
    t_3 = rho_b ^ (1.0 / 3.0)
    xs1 = sqrt(sigma_bb) / rho_b ^ (4.0 / 3.0)
    cs1_ess_1 = opz_pow_n_1 / 2.0 * t_3 / (t_3 + 0.349) * (-0.018897 + 5.58864e-06 * xs1 ^ 4.0 / (1.0 + 0.006 * xs1 ^ 2.0) ^ 2.0)
    f_cs1 = cs1_eab + cs1_ess + cs1_ess_1
    return f_cs1
}

#| the energy per volume, unpolarized: libxc's mf, whose gradient is [vrho, vsigma]
def _mf_unpol(x: Arr) -> Num {
    return x[0] * zk_unpol(x)
}

#| the energy per volume, spin-polarized
def _mf_pol(x: Arr) -> Num {
    return (x[0] + x[1]) * zk_pol(x)
}

#| libxc's xc_gga_exc_vxc, unpolarized: per point [zk, vrho, vsigma]
def eval_unpol(rho: Arr, sigma: Arr) -> Arr {
    n = len(rho)
    width = 3
    out = zeros(width * n)
    for i to n {
        if rho[i] >= DENS_THRESHOLD {
            x = gga_unpol_point(rho[i], sigma[i], DENS_THRESHOLD, SIGMA_THRESHOLD)
            g = grad(_mf_unpol, x)
            out[width * i] = zk_unpol(x)
            out[width * i + 1] = g[0]
            out[width * i + 2] = g[1]
        }
    }
    return out
}

#| libxc's xc_gga_exc_vxc, spin-polarized: rho = [a, b], sigma = [aa, ab, bb] per point;
#| out [zk, vrho_a, vrho_b, vsigma_aa, vsigma_ab, vsigma_bb]
def eval_pol(rho: Arr, sigma: Arr) -> Arr {
    nspin = 2
    nsigma = 3
    width = 6
    n = len(rho) // nspin
    out = zeros(width * n)
    for i to n {
        if rho[nspin * i] + rho[nspin * i + 1] >= DENS_THRESHOLD {
            x = gga_pol_point(rho[nspin * i], rho[nspin * i + 1], sigma[nsigma * i], sigma[nsigma * i + 1],
                              sigma[nsigma * i + 2], DENS_THRESHOLD, SIGMA_THRESHOLD)
            g = grad(_mf_pol, x)
            out[width * i] = zk_pol(x)
            for k to len(x) {
                out[width * i + 1 + k] = g[k]
            }
        }
    }
    return out
}
