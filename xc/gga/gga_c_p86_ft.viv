from xc.core import gga_pol_point, gga_unpol_point

#| GGA_C_P86_FT (libxc id 217): Perdew 86 with more accurate value for ftilde
#|| kind c, family gga, Maple script gga_exc/gga_c_p86.mpl
#~ reference: J. P. Perdew.,  Phys. Rev. B 33, 8822 (1986)

#: DENS_THRESHOLD  libxc's dens_threshold for this functional: smaller total densities give zero
DENS_THRESHOLD = 1.0e-15
#: SIGMA_THRESHOLD  libxc's sigma_threshold, dens_threshold^(4/3)
SIGMA_THRESHOLD = 1.0000000000000027e-20

#| the energy per particle, unpolarized: x = [rho, sigma]
def zk_unpol(x: Arr) -> Num {
    rho = x[0]
    sigma = x[1]
    r_ws = 0.6203504908994 / rho ^ (1.0 / 3.0)
    if r_ws >= 1.0 {
        ec_low = -0.1423 / (1.0 + 1.0529 * sqrt(r_ws) + 0.3334 * r_ws)
        ec = ec_low
    }
    else {
        t = log(r_ws)
        ec_high = 0.0311 * t + -0.048 + 0.002 * r_ws * t + -0.0116 * r_ws
        ec = ec_high
    }
    xt = sqrt(sigma) / rho ^ (4.0 / 3.0)
    p86_x1 = xt / sqrt(r_ws / 0.6203504908994)
    t_1 = r_ws ^ 2.0
    p86_cc = 0.001667 + (0.002568 + 0.023266 * r_ws + 7.389e-06 * t_1) / (1.0 + 8.723 * r_ws + 0.472 * t_1 + 0.07389 * r_ws ^ 3.0)
    p86_mphi = 0.19199566167376364 * 0.004235 / p86_cc * p86_x1
    p86_h = p86_x1 ^ 2.0 * exp(-p86_mphi) * p86_cc
    f_p86 = ec + p86_h
    return f_p86
}

#| the energy per particle, spin-polarized: x = [rho_a, rho_b, sigma_aa, sigma_ab, sigma_bb]
def zk_pol(x: Arr) -> Num {
    rho_a = x[0]
    rho_b = x[1]
    sigma_aa = x[2]
    sigma_ab = x[3]
    sigma_bb = x[4]
    dens = rho_a + rho_b
    r_ws = 0.6203504908994 / dens ^ (1.0 / 3.0)
    if r_ws >= 1.0 {
        t = sqrt(r_ws)
        ec_low = -0.1423 / (1.0 + 1.0529 * t + 0.3334 * r_ws)
        ec = ec_low
    }
    else {
        t_1 = log(r_ws)
        ec_high = 0.0311 * t_1 + -0.048 + 0.002 * r_ws * t_1 + -0.0116 * r_ws
        ec = ec_high
    }
    if r_ws >= 1.0 {
        t_2 = sqrt(r_ws)
        ec_low_1 = -0.0843 / (1.0 + 1.3981 * t_2 + 0.2611 * r_ws)
        ec_1 = ec_low_1
    }
    else {
        t_3 = log(r_ws)
        ec_high_1 = 0.01555 * t_3 + -0.0269 + 0.0007 * r_ws * t_3 + -0.0048 * r_ws
        ec_1 = ec_high_1
    }
    zeta = (rho_a - rho_b) / dens
    t_4 = 1.0 + zeta
    if t_4 <= 2.220446049250313e-16 {
        opz_pow_n = 1.3445809915232009e-21
    }
    else {
        opz_pow_n = t_4 ^ (4.0 / 3.0)
    }
    t_5 = 1.0 - zeta
    if t_5 <= 2.220446049250313e-16 {
        opz_pow_n_1 = 1.3445809915232009e-21
    }
    else {
        opz_pow_n_1 = t_5 ^ (4.0 / 3.0)
    }
    f_zeta = (opz_pow_n + opz_pow_n_1 - 2.0) / 0.5198420997897464
    f_pz = ec + (ec_1 - ec) * f_zeta
    xt = sqrt(sigma_aa + 2.0 * sigma_ab + sigma_bb) / dens ^ (4.0 / 3.0)
    p86_x1 = xt / sqrt(r_ws / 0.6203504908994)
    t_6 = r_ws ^ 2.0
    p86_cc = 0.001667 + (0.002568 + 0.023266 * r_ws + 7.389e-06 * t_6) / (1.0 + 8.723 * r_ws + 0.472 * t_6 + 0.07389 * r_ws ^ 3.0)
    p86_mphi = 0.19199566167376364 * 0.004235 / p86_cc * p86_x1
    if t_4 <= 2.220446049250313e-16 {
        opz_pow_n_2 = 8.142048951722617e-27
    }
    else {
        opz_pow_n_2 = t_4 ^ (5.0 / 3.0)
    }
    if t_5 <= 2.220446049250313e-16 {
        opz_pow_n_3 = 8.142048951722617e-27
    }
    else {
        opz_pow_n_3 = t_5 ^ (5.0 / 3.0)
    }
    p86_dd = sqrt(opz_pow_n_2 + opz_pow_n_3) / 1.4142135623730951
    p86_h = p86_x1 ^ 2.0 * exp(-p86_mphi) * p86_cc / p86_dd
    f_p86 = f_pz + p86_h
    return f_p86
}

#| the energy per volume, unpolarized: libxc's mf, whose gradient is [vrho, vsigma]
def _mf_unpol(x: Arr) -> Num {
    return x[0] * zk_unpol(x)
}

#| the energy per volume, spin-polarized
def _mf_pol(x: Arr) -> Num {
    return (x[0] + x[1]) * zk_pol(x)
}

#| libxc's xc_gga_exc_vxc, unpolarized: per point [zk, vrho, vsigma]
def eval_unpol(rho: Arr, sigma: Arr) -> Arr {
    n = len(rho)
    width = 3
    out = zeros(width * n)
    for i to n {
        if rho[i] >= DENS_THRESHOLD {
            x = gga_unpol_point(rho[i], sigma[i], DENS_THRESHOLD, SIGMA_THRESHOLD)
            g = grad(_mf_unpol, x)
            out[width * i] = zk_unpol(x)
            out[width * i + 1] = g[0]
            out[width * i + 2] = g[1]
        }
    }
    return out
}

#| libxc's xc_gga_exc_vxc, spin-polarized: rho = [a, b], sigma = [aa, ab, bb] per point;
#| out [zk, vrho_a, vrho_b, vsigma_aa, vsigma_ab, vsigma_bb]
def eval_pol(rho: Arr, sigma: Arr) -> Arr {
    nspin = 2
    nsigma = 3
    width = 6
    n = len(rho) // nspin
    out = zeros(width * n)
    for i to n {
        if rho[nspin * i] + rho[nspin * i + 1] >= DENS_THRESHOLD {
            x = gga_pol_point(rho[nspin * i], rho[nspin * i + 1], sigma[nsigma * i], sigma[nsigma * i + 1],
                              sigma[nsigma * i + 2], DENS_THRESHOLD, SIGMA_THRESHOLD)
            g = grad(_mf_pol, x)
            out[width * i] = zk_pol(x)
            for k to len(x) {
                out[width * i + 1 + k] = g[k]
            }
        }
    }
    return out
}
