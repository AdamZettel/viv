from xc.core import gga_pol_point, gga_unpol_point, xc_asinh

#| GGA_X_2D_B88 (libxc id 127): Becke 88 in 2D
#|| kind x, family gga, Maple script gga_exc/gga_x_2d_b88.mpl
#~ reference: J. G. Vilhena, E. Räsänen, M. A. L. Marques, and S. Pittalis.,  J. Chem. Theory Comput. 10, 1837-1842 (2014)

#: DENS_THRESHOLD  libxc's dens_threshold for this functional: smaller total densities give zero
DENS_THRESHOLD = 1.0e-15
#: SIGMA_THRESHOLD  libxc's sigma_threshold, dens_threshold^(4/3)
SIGMA_THRESHOLD = 1.0000000000000027e-20

#| the energy per particle, unpolarized: x = [rho, sigma]
def zk_unpol(x: Arr) -> Num {
    rho = x[0]
    sigma = x[1]
    t = rho / 2.0
    if t <= 1.0e-15 {
        branch = 0.0
    }
    else {
        r_ws = 0.5641895835477563 / rho ^ (1.0 / 2.0)
        lda_x_spin = -0.5319230405352435 * 0.5641895835477563 / r_ws
        xs0 = sqrt(sigma / 4.0) / t ^ (3.0 / 2.0)
        v_2d_b88_f = 1.0 + 0.004652691358626979 * xs0 ^ 2.0 / (1.0 + 0.056 * xs0 * xc_asinh(xs0))
        branch = lda_x_spin * v_2d_b88_f
    }
    gga_exchange = branch + branch
    return gga_exchange
}

#| the energy per particle, spin-polarized: x = [rho_a, rho_b, sigma_aa, sigma_ab, sigma_bb]
def zk_pol(x: Arr) -> Num {
    rho_a = x[0]
    rho_b = x[1]
    sigma_aa = x[2]
    sigma_ab = x[3]
    sigma_bb = x[4]
    if rho_a <= 1.0e-15 {
        branch = 0.0
    }
    else {
        dens = rho_a + rho_b
        t = 1.0 / dens
        if 2.0 * rho_a * t <= 2.220446049250313e-16 {
            z_thr = -0.9999999999999998
        }
        else {
            if 2.0 * rho_b * t <= 2.220446049250313e-16 {
                branch_1 = 0.9999999999999998
            }
            else {
                zeta = (rho_a - rho_b) / dens
                branch_1 = zeta
            }
            z_thr = branch_1
        }
        t_1 = 1.0 + z_thr
        if t_1 <= 2.220446049250313e-16 {
            opz_pow_n = 3.308722450212111e-24
        }
        else {
            opz_pow_n = t_1 ^ (3.0 / 2.0)
        }
        r_ws = 0.5641895835477563 / dens ^ (1.0 / 2.0)
        t_2 = 0.5641895835477563 / r_ws
        lda_x_spin = -1.5045055561273502 * opz_pow_n * 0.3535533905932738 * t_2
        xs0 = sqrt(sigma_aa) / rho_a ^ (3.0 / 2.0)
        v_2d_b88_f = 1.0 + 0.004652691358626979 * xs0 ^ 2.0 / (1.0 + 0.056 * xs0 * xc_asinh(xs0))
        branch = lda_x_spin * v_2d_b88_f
    }
    if rho_b <= 1.0e-15 {
        branch_2 = 0.0
    }
    else {
        dens_1 = rho_a + rho_b
        t_3 = 1.0 / dens_1
        if 2.0 * rho_b * t_3 <= 2.220446049250313e-16 {
            z_thr_1 = -0.9999999999999998
        }
        else {
            if 2.0 * rho_a * t_3 <= 2.220446049250313e-16 {
                branch_3 = 0.9999999999999998
            }
            else {
                zeta_1 = (rho_a - rho_b) / dens_1
                branch_3 = -zeta_1
            }
            z_thr_1 = branch_3
        }
        t_4 = 1.0 + z_thr_1
        if t_4 <= 2.220446049250313e-16 {
            opz_pow_n_1 = 3.308722450212111e-24
        }
        else {
            opz_pow_n_1 = t_4 ^ (3.0 / 2.0)
        }
        r_ws_1 = 0.5641895835477563 / dens_1 ^ (1.0 / 2.0)
        t_5 = 0.5641895835477563 / r_ws_1
        lda_x_spin_1 = -1.5045055561273502 * opz_pow_n_1 * 0.3535533905932738 * t_5
        xs1 = sqrt(sigma_bb) / rho_b ^ (3.0 / 2.0)
        v_2d_b88_f_1 = 1.0 + 0.004652691358626979 * xs1 ^ 2.0 / (1.0 + 0.056 * xs1 * xc_asinh(xs1))
        branch_2 = lda_x_spin_1 * v_2d_b88_f_1
    }
    gga_exchange = branch + branch_2
    return gga_exchange
}

#| the energy per volume, unpolarized: libxc's mf, whose gradient is [vrho, vsigma]
def _mf_unpol(x: Arr) -> Num {
    return x[0] * zk_unpol(x)
}

#| the energy per volume, spin-polarized
def _mf_pol(x: Arr) -> Num {
    return (x[0] + x[1]) * zk_pol(x)
}

#| libxc's xc_gga_exc_vxc, unpolarized: per point [zk, vrho, vsigma]
def eval_unpol(rho: Arr, sigma: Arr) -> Arr {
    n = len(rho)
    width = 3
    out = zeros(width * n)
    for i to n {
        if rho[i] >= DENS_THRESHOLD {
            x = gga_unpol_point(rho[i], sigma[i], DENS_THRESHOLD, SIGMA_THRESHOLD)
            g = grad(_mf_unpol, x)
            out[width * i] = zk_unpol(x)
            out[width * i + 1] = g[0]
            out[width * i + 2] = g[1]
        }
    }
    return out
}

#| libxc's xc_gga_exc_vxc, spin-polarized: rho = [a, b], sigma = [aa, ab, bb] per point;
#| out [zk, vrho_a, vrho_b, vsigma_aa, vsigma_ab, vsigma_bb]
def eval_pol(rho: Arr, sigma: Arr) -> Arr {
    nspin = 2
    nsigma = 3
    width = 6
    n = len(rho) // nspin
    out = zeros(width * n)
    for i to n {
        if rho[nspin * i] + rho[nspin * i + 1] >= DENS_THRESHOLD {
            x = gga_pol_point(rho[nspin * i], rho[nspin * i + 1], sigma[nsigma * i], sigma[nsigma * i + 1],
                              sigma[nsigma * i + 2], DENS_THRESHOLD, SIGMA_THRESHOLD)
            g = grad(_mf_pol, x)
            out[width * i] = zk_pol(x)
            for k to len(x) {
                out[width * i + 1 + k] = g[k]
            }
        }
    }
    return out
}
