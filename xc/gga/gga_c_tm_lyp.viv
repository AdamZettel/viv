from xc.core import gga_pol_point, gga_unpol_point

#| GGA_C_TM_LYP (libxc id 559): Takkar and McCarthy reparametrization
#|| kind c, family gga, Maple script gga_exc/gga_c_lyp.mpl
#~ reference: A. J. Thakkar and S. P. McCarthy.,  J. Chem. Phys. 131, 134109 (2009)

#: DENS_THRESHOLD  libxc's dens_threshold for this functional: smaller total densities give zero
DENS_THRESHOLD = 1.0e-14
#: SIGMA_THRESHOLD  libxc's sigma_threshold, dens_threshold^(4/3)
SIGMA_THRESHOLD = 2.1544346900318888e-19

#| the energy per particle, unpolarized: x = [rho, sigma]
def zk_unpol(x: Arr) -> Num {
    rho = x[0]
    sigma = x[1]
    r_ws = 0.6203504908994 / rho ^ (1.0 / 3.0)
    t = r_ws / 0.6203504908994
    t_1 = 1.0 + 0.15 * t
    lyp_t1 = -(1.0 / t_1)
    lyp_omega = 0.21 * exp(-(0.41 * t)) / t_1
    xt = sqrt(sigma) / rho ^ (4.0 / 3.0)
    lyp_delta = (0.41 + 0.15 / t_1) * t
    lyp_t2 = -(xt ^ 2.0 * ((47.0 - 7.0 * lyp_delta) / 72.0 - 2.0 / 3.0))
    xs0 = sqrt(sigma / 4.0) / (rho / 2.0) ^ (4.0 / 3.0)
    t_2 = xs0 ^ 2.0
    t_3 = t_2 + t_2
    lyp_t4 = 0.03937253280921479 * (5.0 / 2.0 - lyp_delta / 18.0) * t_3
    lyp_t5 = 0.002187362933845266 * (lyp_delta - 11.0) * t_3
    t_4 = t_2 / 4.0
    f_lyp_rr = 0.0393 * (lyp_t1 + lyp_omega * (lyp_t2 + -2.871234000188192 + lyp_t4 + lyp_t5 - 0.15749013123685915 * (2.0 / 3.0 * t_3 - t_4 - t_4)))
    return f_lyp_rr
}

#| the energy per particle, spin-polarized: x = [rho_a, rho_b, sigma_aa, sigma_ab, sigma_bb]
def zk_pol(x: Arr) -> Num {
    rho_a = x[0]
    rho_b = x[1]
    sigma_aa = x[2]
    sigma_ab = x[3]
    sigma_bb = x[4]
    dens = rho_a + rho_b
    zeta = (rho_a - rho_b) / dens
    t = 1.0 - zeta ^ 2.0
    r_ws = 0.6203504908994 / dens ^ (1.0 / 3.0)
    t_1 = r_ws / 0.6203504908994
    t_2 = 1.0 + 0.15 * t_1
    lyp_t1 = -(t / t_2)
    lyp_omega = 0.21 * exp(-(0.41 * t_1)) / t_2
    xt = sqrt(sigma_aa + 2.0 * sigma_ab + sigma_bb) / dens ^ (4.0 / 3.0)
    lyp_delta = (0.41 + 0.15 / t_2) * t_1
    lyp_t2 = -(xt ^ 2.0 * (t * (47.0 - 7.0 * lyp_delta) / 72.0 - 2.0 / 3.0))
    t_3 = 1.0 + zeta
    if t_3 <= 2.220446049250313e-16 {
        opz_pow_n = 1.8078980427655138e-42
    }
    else {
        opz_pow_n = t_3 ^ (8.0 / 3.0)
    }
    t_4 = 1.0 - zeta
    if t_4 <= 2.220446049250313e-16 {
        opz_pow_n_1 = 1.8078980427655138e-42
    }
    else {
        opz_pow_n_1 = t_4 ^ (8.0 / 3.0)
    }
    xs0 = sqrt(sigma_aa) / rho_a ^ (4.0 / 3.0)
    t_5 = xs0 ^ 2.0
    xs1 = sqrt(sigma_bb) / rho_b ^ (4.0 / 3.0)
    t_6 = xs1 ^ 2.0
    t_7 = t_5 * opz_pow_n + t_6 * opz_pow_n_1
    lyp_t4 = 0.03937253280921479 * t * (5.0 / 2.0 - lyp_delta / 18.0) * t_7
    if t_3 <= 2.220446049250313e-16 {
        opz_pow_n_2 = 4.0143400665060586e-58
    }
    else {
        opz_pow_n_2 = t_3 ^ (11.0 / 3.0)
    }
    if t_4 <= 2.220446049250313e-16 {
        opz_pow_n_3 = 4.0143400665060586e-58
    }
    else {
        opz_pow_n_3 = t_4 ^ (11.0 / 3.0)
    }
    lyp_t5 = 0.002187362933845266 * t * (lyp_delta - 11.0) * (t_5 * opz_pow_n_2 + t_6 * opz_pow_n_3)
    if t_3 <= 2.220446049250313e-16 {
        opz_pow_n_4 = 4.930380657631324e-32
    }
    else {
        opz_pow_n_4 = t_3 ^ 2.0
    }
    if t_4 <= 2.220446049250313e-16 {
        opz_pow_n_5 = 4.930380657631324e-32
    }
    else {
        opz_pow_n_5 = t_4 ^ 2.0
    }
    f_lyp_rr = 0.0393 * (lyp_t1 + lyp_omega * (lyp_t2 - 1.435617000094096 * t * (opz_pow_n + opz_pow_n_1) + lyp_t4 + lyp_t5 - 0.15749013123685915 * (2.0 / 3.0 * t_7 - opz_pow_n_4 * t_6 * opz_pow_n_1 / 4.0 - opz_pow_n_5 * t_5 * opz_pow_n / 4.0)))
    return f_lyp_rr
}

#| the energy per volume, unpolarized: libxc's mf, whose gradient is [vrho, vsigma]
def _mf_unpol(x: Arr) -> Num {
    return x[0] * zk_unpol(x)
}

#| the energy per volume, spin-polarized
def _mf_pol(x: Arr) -> Num {
    return (x[0] + x[1]) * zk_pol(x)
}

#| libxc's xc_gga_exc_vxc, unpolarized: per point [zk, vrho, vsigma]
def eval_unpol(rho: Arr, sigma: Arr) -> Arr {
    n = len(rho)
    width = 3
    out = zeros(width * n)
    for i to n {
        if rho[i] >= DENS_THRESHOLD {
            x = gga_unpol_point(rho[i], sigma[i], DENS_THRESHOLD, SIGMA_THRESHOLD)
            g = grad(_mf_unpol, x)
            out[width * i] = zk_unpol(x)
            out[width * i + 1] = g[0]
            out[width * i + 2] = g[1]
        }
    }
    return out
}

#| libxc's xc_gga_exc_vxc, spin-polarized: rho = [a, b], sigma = [aa, ab, bb] per point;
#| out [zk, vrho_a, vrho_b, vsigma_aa, vsigma_ab, vsigma_bb]
def eval_pol(rho: Arr, sigma: Arr) -> Arr {
    nspin = 2
    nsigma = 3
    width = 6
    n = len(rho) // nspin
    out = zeros(width * n)
    for i to n {
        if rho[nspin * i] + rho[nspin * i + 1] >= DENS_THRESHOLD {
            x = gga_pol_point(rho[nspin * i], rho[nspin * i + 1], sigma[nsigma * i], sigma[nsigma * i + 1],
                              sigma[nsigma * i + 2], DENS_THRESHOLD, SIGMA_THRESHOLD)
            g = grad(_mf_pol, x)
            out[width * i] = zk_pol(x)
            for k to len(x) {
                out[width * i + 1 + k] = g[k]
            }
        }
    }
    return out
}
