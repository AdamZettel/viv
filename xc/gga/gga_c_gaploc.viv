from xc.core import gga_pol_point, gga_unpol_point

#| GGA_C_GAPLOC (libxc id 556): Gaploc
#|| kind c, family gga, Maple script gga_exc/gga_c_gaploc.mpl
#~ reference: E. Fabiano, P. E. Trevisanutto, A. Terentjevs, and L. A. Constantin.,  J. Chem. Theory Comput. 10, 2016-2026 (2014)

#: DENS_THRESHOLD  libxc's dens_threshold for this functional: smaller total densities give zero
DENS_THRESHOLD = 1.0e-15
#: SIGMA_THRESHOLD  libxc's sigma_threshold, dens_threshold^(4/3)
SIGMA_THRESHOLD = 1.0000000000000027e-20

#| the energy per particle, unpolarized: x = [rho, sigma]
def zk_unpol(x: Arr) -> Num {
    rho = x[0]
    sigma = x[1]
    r_ws = 0.6203504908994 / rho ^ (1.0 / 3.0)
    t = sqrt(r_ws)
    t_1 = r_ws ^ 2.0
    g_aux = 7.5957 * t + 3.5876 * r_ws + 1.6382 * r_ws ^ 1.5 + 0.49294 * t_1
    g = -(0.062182 * (1.0 + 0.2137 * r_ws) * log(1.0 + 1.0 / (0.062182 * g_aux)))
    gap_c = 0.23878 / t_1
    gap_eps_1 = 0.04953 * r_ws ^ (3.0 / 2.0) / (1.0 + t * (1.07924 + 0.07928 * t + 0.04953 * r_ws))
    gap_eps_2 = -0.02504 * r_ws ^ 3.0 + 0.007026 * r_ws ^ 4.0 + -0.001268 * r_ws ^ 5.0 + 0.0001136 * r_ws ^ 6.0 + -3.841e-06 * r_ws ^ 7.0
    t_2 = 2.0 * (gap_c * gap_eps_1 - g ^ 2.0)
    gap_c3 = -((2.0 * gap_eps_1 ^ 2.0 - g * gap_eps_2) / t_2)
    gap_c1 = -(gap_c * gap_c3)
    xt = sqrt(sigma) / rho ^ (4.0 / 3.0)
    gaploc_s = 0.1282782438530422 * xt * 1.2599210498948732
    gap_t = xt * rho ^ (1.0 / 6.0) / 3.969372790439712
    t_3 = gap_t ^ 3.0
    gaploc_alpha = (8.54613 + 3.0 * t_3) / (1.0 + t_3)
    t_4 = gaploc_s ^ gaploc_alpha
    gap_g = 1.8415842761764334 * t_4 / t_1 * (14.709046 + gaploc_s ^ 2.0) / (1.0 + t_4)
    gap_c2 = (2.0 * g * gap_eps_1 - gap_c * gap_eps_2) / t_2
    gap_eps = (g + gap_c1 * gap_g) / (1.0 + gap_c2 * gap_g + gap_c3 * gap_g ^ 2.0)
    return gap_eps
}

#| the energy per particle, spin-polarized: x = [rho_a, rho_b, sigma_aa, sigma_ab, sigma_bb]
def zk_pol(x: Arr) -> Num {
    rho_a = x[0]
    rho_b = x[1]
    sigma_aa = x[2]
    sigma_ab = x[3]
    sigma_bb = x[4]
    dens = rho_a + rho_b
    r_ws = 0.6203504908994 / dens ^ (1.0 / 3.0)
    t = sqrt(r_ws)
    t_1 = r_ws ^ 1.5
    t_2 = r_ws ^ 2.0
    g_aux = 7.5957 * t + 3.5876 * r_ws + 1.6382 * t_1 + 0.49294 * t_2
    t_3 = 0.062182 * (1.0 + 0.2137 * r_ws) * log(1.0 + 1.0 / (0.062182 * g_aux))
    g = -t_3
    gap_c = 0.23878 / t_2
    t_4 = r_ws ^ (3.0 / 2.0)
    gap_eps_1 = 0.04953 * t_4 / (1.0 + t * (1.07924 + 0.07928 * t + 0.04953 * r_ws))
    t_5 = r_ws ^ 3.0
    t_6 = r_ws ^ 4.0
    t_7 = r_ws ^ 5.0
    t_8 = r_ws ^ 6.0
    t_9 = r_ws ^ 7.0
    gap_eps_2 = -0.02504 * t_5 + 0.007026 * t_6 + -0.001268 * t_7 + 0.0001136 * t_8 + -3.841e-06 * t_9
    t_10 = 2.0 * (gap_c * gap_eps_1 - g ^ 2.0)
    gap_c3 = -((2.0 * gap_eps_1 ^ 2.0 - g * gap_eps_2) / t_10)
    gap_c1 = -(gap_c * gap_c3)
    xt = sqrt(sigma_aa + 2.0 * sigma_ab + sigma_bb) / dens ^ (4.0 / 3.0)
    gaploc_s = 0.1282782438530422 * xt * 1.2599210498948732
    t_11 = xt * dens ^ (1.0 / 6.0)
    gap_t = t_11 / 3.969372790439712
    t_12 = gap_t ^ 3.0
    gaploc_alpha = (8.54613 + 3.0 * t_12) / (1.0 + t_12)
    t_13 = gaploc_s ^ gaploc_alpha
    t_14 = 14.709046 + gaploc_s ^ 2.0
    gap_g = 1.8415842761764334 * t_13 / t_2 * t_14 / (1.0 + t_13)
    gap_c2 = (2.0 * g * gap_eps_1 - gap_c * gap_eps_2) / t_10
    gap_eps = (g + gap_c1 * gap_g) / (1.0 + gap_c2 * gap_g + gap_c3 * gap_g ^ 2.0)
    zeta = (rho_a - rho_b) / dens
    t_15 = 1.0 + zeta
    if t_15 <= 2.220446049250313e-16 {
        opz_pow_n = 1.3445809915232009e-21
    }
    else {
        opz_pow_n = t_15 ^ (4.0 / 3.0)
    }
    t_16 = 1.0 - zeta
    if t_16 <= 2.220446049250313e-16 {
        opz_pow_n_1 = 1.3445809915232009e-21
    }
    else {
        opz_pow_n_1 = t_16 ^ (4.0 / 3.0)
    }
    f_zeta = (opz_pow_n + opz_pow_n_1 - 2.0) / 0.5198420997897464
    g_aux_1 = 14.1189 * t + 6.1977 * r_ws + 3.3662 * t_1 + 0.62517 * t_2
    g_1 = -(0.03109 * (1.0 + 0.20548 * r_ws) * log(1.0 + 1.0 / (0.03109 * g_aux_1)))
    g_aux_2 = 10.357 * t + 3.6231 * r_ws + 0.88026 * t_1 + 0.49671 * t_2
    g_2 = -(0.033774 * (1.0 + 0.11125 * r_ws) * log(1.0 + 1.0 / (0.033774 * g_aux_2)))
    f_pw = g + 1.0 * (g_1 + t_3 + g_2 / 1.709921) - 1.0 * g_2 / 1.709921
    gap_c_1 = 0.064535 / t_2
    gap_eps_1_1 = 0.0471985 * t_4 / (1.0 + t * (1.49676 + 0.00179054 * t + 0.0471985 * r_ws))
    gap_eps_2_1 = -0.0324091 * t_5 + 0.00999978 * t_6 + -0.00193483 * t_7 + 0.000179118 * t_8 + -6.15798e-06 * t_9
    t_17 = 2.0 * (gap_c_1 * gap_eps_1_1 - f_pw ^ 2.0)
    gap_c3_1 = -((2.0 * gap_eps_1_1 ^ 2.0 - f_pw * gap_eps_2_1) / t_17)
    gap_c1_1 = -(gap_c_1 * gap_c3_1)
    gap_t_1 = t_11 / 3.1504932716717486
    t_18 = gap_t_1 ^ 3.0
    gaploc_alpha_1 = (8.54613 + 3.0 * t_18) / (1.0 + t_18)
    t_19 = gaploc_s ^ gaploc_alpha_1
    gap_g_1 = 1.8415842761764334 * t_19 / t_2 * t_14 / (1.0 + t_19)
    gap_c2_1 = (2.0 * f_pw * gap_eps_1_1 - gap_c_1 * gap_eps_2_1) / t_17
    gap_eps_3 = (f_pw + gap_c1_1 * gap_g_1) / (1.0 + gap_c2_1 * gap_g_1 + gap_c3_1 * gap_g_1 ^ 2.0)
    f_gap = gap_eps + f_zeta * (gap_eps_3 - gap_eps)
    return f_gap
}

#| the energy per volume, unpolarized: libxc's mf, whose gradient is [vrho, vsigma]
def _mf_unpol(x: Arr) -> Num {
    return x[0] * zk_unpol(x)
}

#| the energy per volume, spin-polarized
def _mf_pol(x: Arr) -> Num {
    return (x[0] + x[1]) * zk_pol(x)
}

#| libxc's xc_gga_exc_vxc, unpolarized: per point [zk, vrho, vsigma]
def eval_unpol(rho: Arr, sigma: Arr) -> Arr {
    n = len(rho)
    width = 3
    out = zeros(width * n)
    for i to n {
        if rho[i] >= DENS_THRESHOLD {
            x = gga_unpol_point(rho[i], sigma[i], DENS_THRESHOLD, SIGMA_THRESHOLD)
            g = grad(_mf_unpol, x)
            out[width * i] = zk_unpol(x)
            out[width * i + 1] = g[0]
            out[width * i + 2] = g[1]
        }
    }
    return out
}

#| libxc's xc_gga_exc_vxc, spin-polarized: rho = [a, b], sigma = [aa, ab, bb] per point;
#| out [zk, vrho_a, vrho_b, vsigma_aa, vsigma_ab, vsigma_bb]
def eval_pol(rho: Arr, sigma: Arr) -> Arr {
    nspin = 2
    nsigma = 3
    width = 6
    n = len(rho) // nspin
    out = zeros(width * n)
    for i to n {
        if rho[nspin * i] + rho[nspin * i + 1] >= DENS_THRESHOLD {
            x = gga_pol_point(rho[nspin * i], rho[nspin * i + 1], sigma[nsigma * i], sigma[nsigma * i + 1],
                              sigma[nsigma * i + 2], DENS_THRESHOLD, SIGMA_THRESHOLD)
            g = grad(_mf_pol, x)
            out[width * i] = zk_pol(x)
            for k to len(x) {
                out[width * i + 1 + k] = g[k]
            }
        }
    }
    return out
}
