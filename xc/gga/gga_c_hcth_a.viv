from xc.core import gga_pol_point, gga_unpol_point

#| GGA_C_HCTH_A (libxc id 97): HCTH-A
#|| kind c, family gga, Maple script gga_exc/gga_c_hcth_a.mpl
#~ reference: F. A. Hamprecht, A. J. Cohen, D. J. Tozer, and N. C. Handy.,  J. Chem. Phys. 109, 6264 (1998)

#: DENS_THRESHOLD  libxc's dens_threshold for this functional: smaller total densities give zero
DENS_THRESHOLD = 1.0e-15
#: SIGMA_THRESHOLD  libxc's sigma_threshold, dens_threshold^(4/3)
SIGMA_THRESHOLD = 1.0000000000000027e-20

#| the energy per particle, unpolarized: x = [rho, sigma]
def zk_unpol(x: Arr) -> Num {
    rho = x[0]
    sigma = x[1]
    t = rho / 2.0
    if t <= 1.0e-15 {
        lda_stoll_par = 0.0
    }
    else {
        r_ws = 0.6203504908994 / rho ^ (1.0 / 3.0)
        t_1 = r_ws * 1.2599210498948732
        t_2 = sqrt(t_1)
        fx_vwn = t_1 + 3.72744 * t_2 + 12.9352
        t_3 = 2.0 * t_2
        f_aux = 0.0310907 * (log(t_1 / fx_vwn) + 1.2474243062431214 * atan(6.15199081975908 / (t_3 + 3.72744)) - -0.031167608678943783 * log((t_2 - -0.10498) ^ 2.0 / fx_vwn))
        fx_vwn_1 = t_1 + 7.06042 * t_2 + 18.0578
        f_aux_1 = 0.01554535 * (log(t_1 / fx_vwn_1) + 3.3766620352569054 * atan(4.730926909560113 / (t_3 + 7.06042)) - -0.14460061018520726 * log((t_2 - -0.325) ^ 2.0 / fx_vwn_1))
        dmc = f_aux_1 - f_aux
        f_vwn = f_aux + dmc * 1.0
        lda_stoll_par = 1.0 / 2.0 * f_vwn
    }
    xs0 = sqrt(sigma / 4.0) / t ^ (4.0 / 3.0)
    t_4 = xs0 ^ 2.0
    t_5 = 0.2 * t_4
    t_6 = t_5 / (1.0 + t_5)
    b97_g = 0.0136823 + 0.26892 * t_6 + -0.550769 * t_6 ^ 2.0 + 1.03947 * t_6 ^ 3.0
    t_7 = lda_stoll_par * b97_g
    b97_fpar = t_7 + t_7
    r_ws_1 = 0.6203504908994 / rho ^ (1.0 / 3.0)
    t_8 = sqrt(r_ws_1)
    fx_vwn_2 = r_ws_1 + 3.72744 * t_8 + 12.9352
    f_aux_2 = 0.0310907 * (log(r_ws_1 / fx_vwn_2) + 1.2474243062431214 * atan(6.15199081975908 / (2.0 * t_8 + 3.72744)) - -0.031167608678943783 * log((t_8 - -0.10498) ^ 2.0 / fx_vwn_2))
    lda_stoll_perp = f_aux_2 - lda_stoll_par - lda_stoll_par
    t_9 = 0.006 * (sqrt(t_4 + t_4) / 1.4142135623730951) ^ 2.0
    t_10 = t_9 / (1.0 + t_9)
    b97_g_1 = 0.836897 + 1.72051 * t_10 + -2.78498 * t_10 ^ 2.0 + -4.57504 * t_10 ^ 3.0
    b97_fperp = lda_stoll_perp * b97_g_1
    b97_f = b97_fpar + b97_fperp
    return b97_f
}

#| the energy per particle, spin-polarized: x = [rho_a, rho_b, sigma_aa, sigma_ab, sigma_bb]
def zk_pol(x: Arr) -> Num {
    rho_a = x[0]
    rho_b = x[1]
    sigma_aa = x[2]
    sigma_ab = x[3]
    sigma_bb = x[4]
    dens = rho_a + rho_b
    zeta = (rho_a - rho_b) / dens
    t = 1.0 + zeta
    if rho_a <= 1.0e-15 or t <= 2.220446049250313e-16 {
        lda_stoll_par = 0.0
    }
    else {
        if t <= 2.220446049250313e-16 {
            opz_pow_n = 2.220446049250313e-16
        }
        else {
            opz_pow_n = t
        }
        r_ws = 0.6203504908994 / dens ^ (1.0 / 3.0)
        t_1 = r_ws * 1.2599210498948732
        if t <= 2.220446049250313e-16 {
            opz_pow_n_1 = 165140.37185182082
        }
        else {
            opz_pow_n_1 = t ^ (-1.0 / 3.0)
        }
        t_2 = t_1 * opz_pow_n_1
        t_3 = sqrt(t_2)
        fx_vwn = t_2 + 3.72744 * t_3 + 12.9352
        t_4 = 2.0 * t_3
        f_aux = 0.0310907 * (log(t_2 / fx_vwn) + 1.2474243062431214 * atan(6.15199081975908 / (t_4 + 3.72744)) - -0.031167608678943783 * log((t_3 - -0.10498) ^ 2.0 / fx_vwn))
        fx_vwn_1 = t_2 + 7.06042 * t_3 + 18.0578
        f_aux_1 = 0.01554535 * (log(t_2 / fx_vwn_1) + 3.3766620352569054 * atan(4.730926909560113 / (t_4 + 7.06042)) - -0.14460061018520726 * log((t_3 - -0.325) ^ 2.0 / fx_vwn_1))
        dmc = f_aux_1 - f_aux
        f_vwn = f_aux + dmc * 1.0
        lda_stoll_par = opz_pow_n / 2.0 * f_vwn
    }
    xs0 = sqrt(sigma_aa) / rho_a ^ (4.0 / 3.0)
    t_5 = xs0 ^ 2.0
    t_6 = 0.2 * t_5
    t_7 = t_6 / (1.0 + t_6)
    b97_g = 0.0136823 + 0.26892 * t_7 + -0.550769 * t_7 ^ 2.0 + 1.03947 * t_7 ^ 3.0
    t_8 = 1.0 - zeta
    if rho_b <= 1.0e-15 or t_8 <= 2.220446049250313e-16 {
        lda_stoll_par_1 = 0.0
    }
    else {
        if t_8 <= 2.220446049250313e-16 {
            opz_pow_n_2 = 2.220446049250313e-16
        }
        else {
            opz_pow_n_2 = t_8
        }
        r_ws_1 = 0.6203504908994 / dens ^ (1.0 / 3.0)
        t_9 = r_ws_1 * 1.2599210498948732
        if t_8 <= 2.220446049250313e-16 {
            opz_pow_n_3 = 165140.37185182082
        }
        else {
            opz_pow_n_3 = t_8 ^ (-1.0 / 3.0)
        }
        t_10 = t_9 * opz_pow_n_3
        t_11 = sqrt(t_10)
        fx_vwn_2 = t_10 + 3.72744 * t_11 + 12.9352
        t_12 = 2.0 * t_11
        f_aux_2 = 0.0310907 * (log(t_10 / fx_vwn_2) + 1.2474243062431214 * atan(6.15199081975908 / (t_12 + 3.72744)) - -0.031167608678943783 * log((t_11 - -0.10498) ^ 2.0 / fx_vwn_2))
        fx_vwn_3 = t_10 + 7.06042 * t_11 + 18.0578
        f_aux_3 = 0.01554535 * (log(t_10 / fx_vwn_3) + 3.3766620352569054 * atan(4.730926909560113 / (t_12 + 7.06042)) - -0.14460061018520726 * log((t_11 - -0.325) ^ 2.0 / fx_vwn_3))
        dmc_1 = f_aux_3 - f_aux_2
        f_vwn_1 = f_aux_2 + dmc_1 * 1.0
        lda_stoll_par_1 = opz_pow_n_2 / 2.0 * f_vwn_1
    }
    xs1 = sqrt(sigma_bb) / rho_b ^ (4.0 / 3.0)
    t_13 = xs1 ^ 2.0
    t_14 = 0.2 * t_13
    t_15 = t_14 / (1.0 + t_14)
    b97_g_1 = 0.0136823 + 0.26892 * t_15 + -0.550769 * t_15 ^ 2.0 + 1.03947 * t_15 ^ 3.0
    b97_fpar = lda_stoll_par * b97_g + lda_stoll_par_1 * b97_g_1
    r_ws_2 = 0.6203504908994 / dens ^ (1.0 / 3.0)
    t_16 = sqrt(r_ws_2)
    fx_vwn_4 = r_ws_2 + 3.72744 * t_16 + 12.9352
    t_17 = 2.0 * t_16
    f_aux_4 = 0.0310907 * (log(r_ws_2 / fx_vwn_4) + 1.2474243062431214 * atan(6.15199081975908 / (t_17 + 3.72744)) - -0.031167608678943783 * log((t_16 - -0.10498) ^ 2.0 / fx_vwn_4))
    fx_vwn_5 = r_ws_2 + 1.13107 * t_16 + 13.0045
    f_aux_5 = -0.01688686394038963 * (log(r_ws_2 / fx_vwn_5) + 0.31770800474394145 * atan(7.123108917818118 / (t_17 + 1.13107)) - -0.00041403379428206277 * log((t_16 - -0.0047584) ^ 2.0 / fx_vwn_5))
    if t <= 2.220446049250313e-16 {
        opz_pow_n_4 = 1.3445809915232009e-21
    }
    else {
        opz_pow_n_4 = t ^ (4.0 / 3.0)
    }
    if t_8 <= 2.220446049250313e-16 {
        opz_pow_n_5 = 1.3445809915232009e-21
    }
    else {
        opz_pow_n_5 = t_8 ^ (4.0 / 3.0)
    }
    f_zeta = (opz_pow_n_4 + opz_pow_n_5 - 2.0) / 0.5198420997897464
    t_18 = zeta ^ 4.0
    fx_vwn_6 = r_ws_2 + 7.06042 * t_16 + 18.0578
    f_aux_6 = 0.01554535 * (log(r_ws_2 / fx_vwn_6) + 3.3766620352569054 * atan(4.730926909560113 / (t_17 + 7.06042)) - -0.14460061018520726 * log((t_16 - -0.325) ^ 2.0 / fx_vwn_6))
    dmc_2 = f_aux_6 - f_aux_4
    f_vwn_2 = f_aux_4 + f_aux_5 * f_zeta * (1.0 - t_18) / 1.7099209341613657 + dmc_2 * f_zeta * t_18
    lda_stoll_perp = f_vwn_2 - lda_stoll_par - lda_stoll_par_1
    t_19 = 0.006 * (sqrt(t_5 + t_13) / 1.4142135623730951) ^ 2.0
    t_20 = t_19 / (1.0 + t_19)
    b97_g_2 = 0.836897 + 1.72051 * t_20 + -2.78498 * t_20 ^ 2.0 + -4.57504 * t_20 ^ 3.0
    b97_fperp = lda_stoll_perp * b97_g_2
    b97_f = b97_fpar + b97_fperp
    return b97_f
}

#| the energy per volume, unpolarized: libxc's mf, whose gradient is [vrho, vsigma]
def _mf_unpol(x: Arr) -> Num {
    return x[0] * zk_unpol(x)
}

#| the energy per volume, spin-polarized
def _mf_pol(x: Arr) -> Num {
    return (x[0] + x[1]) * zk_pol(x)
}

#| libxc's xc_gga_exc_vxc, unpolarized: per point [zk, vrho, vsigma]
def eval_unpol(rho: Arr, sigma: Arr) -> Arr {
    n = len(rho)
    width = 3
    out = zeros(width * n)
    for i to n {
        if rho[i] >= DENS_THRESHOLD {
            x = gga_unpol_point(rho[i], sigma[i], DENS_THRESHOLD, SIGMA_THRESHOLD)
            g = grad(_mf_unpol, x)
            out[width * i] = zk_unpol(x)
            out[width * i + 1] = g[0]
            out[width * i + 2] = g[1]
        }
    }
    return out
}

#| libxc's xc_gga_exc_vxc, spin-polarized: rho = [a, b], sigma = [aa, ab, bb] per point;
#| out [zk, vrho_a, vrho_b, vsigma_aa, vsigma_ab, vsigma_bb]
def eval_pol(rho: Arr, sigma: Arr) -> Arr {
    nspin = 2
    nsigma = 3
    width = 6
    n = len(rho) // nspin
    out = zeros(width * n)
    for i to n {
        if rho[nspin * i] + rho[nspin * i + 1] >= DENS_THRESHOLD {
            x = gga_pol_point(rho[nspin * i], rho[nspin * i + 1], sigma[nsigma * i], sigma[nsigma * i + 1],
                              sigma[nsigma * i + 2], DENS_THRESHOLD, SIGMA_THRESHOLD)
            g = grad(_mf_pol, x)
            out[width * i] = zk_pol(x)
            for k to len(x) {
                out[width * i + 1 + k] = g[k]
            }
        }
    }
    return out
}
