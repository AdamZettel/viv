from xc.core import gga_pol_point, gga_unpol_point

#| GGA_X_HJS_B88 (libxc id 527): HJS screened exchange B88 version
#|| kind x, family gga, Maple script gga_exc/gga_x_hjs.mpl
#~ reference: T. M. Henderson, B. G. Janesko, and G. E. Scuseria.,  J. Chem. Phys. 128, 194105 (2008)

#: DENS_THRESHOLD  libxc's dens_threshold for this functional: smaller total densities give zero
DENS_THRESHOLD = 1.0e-07
#: SIGMA_THRESHOLD  libxc's sigma_threshold, dens_threshold^(4/3)
SIGMA_THRESHOLD = 4.641588833612784e-10

#| the energy per particle, unpolarized: x = [rho, sigma]
def zk_unpol(x: Arr) -> Num {
    rho = x[0]
    sigma = x[1]
    t = rho / 2.0
    if t <= 1.0e-07 {
        branch = 0.0
    }
    else {
        r_ws = 0.6203504908994 / rho ^ (1.0 / 3.0)
        lda_x_spin = -0.3692793831910112 * 0.6203504908994 / r_ws
        kf = 1.919158292677513 / r_ws
        nu = 0.11 / kf
        xs0 = sqrt(sigma / 4.0) / t ^ (4.0 / 3.0)
        t_1 = 0.1282782438530422 * xs0
        t_2 = t_1 ^ 2.0
        t_3 = t_1 ^ 3.0
        t_4 = t_1 ^ 4.0
        t_5 = t_1 ^ 5.0
        t_6 = t_1 ^ 6.0
        t_7 = t_1 ^ 7.0
        hjs_fh = (0.00968615 * t_2 + -0.0242498 * t_3 + 0.0259009 * t_4 + -0.0136606 * t_5 + 0.00309606 * t_6 + -7.32583e-05 * t_7) / (1.0 + -2.50356 * t_1 + 2.79656 * t_2 + -1.79401 * t_3 + 0.714888 * t_4 + -0.165924 * t_5 + 0.0118379 * t_6 + 0.0037806 * t_7 + -0.000157905 * t_1 ^ 8.0 + 1.45323e-06 * t_1 ^ 9.0)
        t_8 = t_2 * hjs_fh
        if t_8 > 1.0e-10 {
            m_max = t_8
        }
        else {
            m_max = 1.0e-10
        }
        hjs_lambda = 0.60965 + m_max
        t_9 = nu ^ 2.0
        t_10 = sqrt(hjs_lambda + t_9)
        hjs_chi = nu / t_10
        hjs_ff = 1.0 - t_2 / (-3.203523 * (1.0 + t_2 / 4.0)) - m_max / -0.237298
        t_11 = hjs_chi ^ 3.0
        t_12 = hjs_lambda ^ 2.0
        t_13 = hjs_lambda ^ 3.0
        t_14 = 0.757211 + m_max
        if t_14 > 1.0e-10 {
            m_max_1 = t_14
        }
        else {
            m_max_1 = 1.0e-10
        }
        hjs_fg = -(-0.0474596 * hjs_ff * hjs_lambda) - -0.028363733333333332 * t_12 - 0.9086532 * t_13 - hjs_lambda ^ (7.0 / 2.0) * (1.4179630807244128 + 12.0 / 5.0 * (sqrt(m_max) - sqrt(m_max_1)))
        t_15 = sqrt(m_max + t_9)
        t_16 = sqrt(m_max_1 + t_9)
        t_17 = nu + t_10
        hjs_f1 = 0.757211 - -0.04727288888888889 * (1.0 - hjs_chi) / hjs_lambda - -0.026366444444444446 * hjs_ff * (2.0 - 3.0 * hjs_chi + t_11) / t_12 - 1.0 / 9.0 * hjs_fg * (8.0 - 15.0 * hjs_chi + 10.0 * t_11 - 3.0 * hjs_chi ^ 5.0) / t_13 + 2.0 * nu * (t_15 - t_16) + 2.0 * m_max * log((nu + t_15) / t_17) - 2.0 * m_max_1 * log((nu + t_16) / t_17)
        branch = lda_x_spin * hjs_f1
    }
    gga_exchange_nsp = branch + branch
    return gga_exchange_nsp
}

#| the energy per particle, spin-polarized: x = [rho_a, rho_b, sigma_aa, sigma_ab, sigma_bb]
def zk_pol(x: Arr) -> Num {
    rho_a = x[0]
    rho_b = x[1]
    sigma_aa = x[2]
    sigma_ab = x[3]
    sigma_bb = x[4]
    if rho_a <= 1.0e-07 {
        branch = 0.0
    }
    else {
        dens = rho_a + rho_b
        t = 1.0 / dens
        if 2.0 * rho_a * t <= 2.220446049250313e-16 {
            z_thr = -0.9999999999999998
        }
        else {
            if 2.0 * rho_b * t <= 2.220446049250313e-16 {
                branch_1 = 0.9999999999999998
            }
            else {
                zeta = (rho_a - rho_b) / dens
                branch_1 = zeta
            }
            z_thr = branch_1
        }
        t_1 = 1.0 + z_thr
        if t_1 <= 2.220446049250313e-16 {
            opz_pow_n = 1.3445809915232009e-21
        }
        else {
            opz_pow_n = t_1 ^ (4.0 / 3.0)
        }
        r_ws = 0.6203504908994 / dens ^ (1.0 / 3.0)
        t_2 = 0.6203504908994 / r_ws
        lda_x_spin = -0.9305257363491001 * opz_pow_n * 0.3968502629920499 * t_2
        zeta_1 = (rho_a - rho_b) / dens
        if 1.0 + zeta_1 <= 2.220446049250313e-16 {
            z_thr_1 = -0.9999999999999998
        }
        else {
            if 1.0 - zeta_1 <= 2.220446049250313e-16 {
                branch_2 = 0.9999999999999998
            }
            else {
                branch_2 = zeta_1
            }
            z_thr_1 = branch_2
        }
        t_3 = 1.0 + z_thr_1
        if t_3 <= 2.220446049250313e-16 {
            opz_pow_n_1 = 6.0554544523933395e-06
        }
        else {
            opz_pow_n_1 = t_3 ^ (1.0 / 3.0)
        }
        kf = 3.093667726280136 * opz_pow_n_1 * 0.6203504908994 / r_ws
        nu = 0.11 / kf
        xs0 = sqrt(sigma_aa) / rho_a ^ (4.0 / 3.0)
        t_4 = 0.1282782438530422 * xs0
        t_5 = t_4 ^ 2.0
        t_6 = t_4 ^ 3.0
        t_7 = t_4 ^ 4.0
        t_8 = t_4 ^ 5.0
        t_9 = t_4 ^ 6.0
        t_10 = t_4 ^ 7.0
        hjs_fh = (0.00968615 * t_5 + -0.0242498 * t_6 + 0.0259009 * t_7 + -0.0136606 * t_8 + 0.00309606 * t_9 + -7.32583e-05 * t_10) / (1.0 + -2.50356 * t_4 + 2.79656 * t_5 + -1.79401 * t_6 + 0.714888 * t_7 + -0.165924 * t_8 + 0.0118379 * t_9 + 0.0037806 * t_10 + -0.000157905 * t_4 ^ 8.0 + 1.45323e-06 * t_4 ^ 9.0)
        t_11 = t_5 * hjs_fh
        if t_11 > 1.0e-10 {
            m_max = t_11
        }
        else {
            m_max = 1.0e-10
        }
        hjs_lambda = 0.60965 + m_max
        t_12 = nu ^ 2.0
        t_13 = sqrt(hjs_lambda + t_12)
        hjs_chi = nu / t_13
        hjs_ff = 1.0 - t_5 / (-3.203523 * (1.0 + t_5 / 4.0)) - m_max / -0.237298
        t_14 = hjs_chi ^ 3.0
        t_15 = hjs_lambda ^ 2.0
        t_16 = hjs_lambda ^ 3.0
        t_17 = 0.757211 + m_max
        if t_17 > 1.0e-10 {
            m_max_1 = t_17
        }
        else {
            m_max_1 = 1.0e-10
        }
        hjs_fg = -(-0.0474596 * hjs_ff * hjs_lambda) - -0.028363733333333332 * t_15 - 0.9086532 * t_16 - hjs_lambda ^ (7.0 / 2.0) * (1.4179630807244128 + 12.0 / 5.0 * (sqrt(m_max) - sqrt(m_max_1)))
        t_18 = sqrt(m_max + t_12)
        t_19 = sqrt(m_max_1 + t_12)
        t_20 = nu + t_13
        hjs_f1 = 0.757211 - -0.04727288888888889 * (1.0 - hjs_chi) / hjs_lambda - -0.026366444444444446 * hjs_ff * (2.0 - 3.0 * hjs_chi + t_14) / t_15 - 1.0 / 9.0 * hjs_fg * (8.0 - 15.0 * hjs_chi + 10.0 * t_14 - 3.0 * hjs_chi ^ 5.0) / t_16 + 2.0 * nu * (t_18 - t_19) + 2.0 * m_max * log((nu + t_18) / t_20) - 2.0 * m_max_1 * log((nu + t_19) / t_20)
        branch = lda_x_spin * hjs_f1
    }
    if rho_b <= 1.0e-07 {
        branch_3 = 0.0
    }
    else {
        dens_1 = rho_a + rho_b
        t_21 = 1.0 / dens_1
        if 2.0 * rho_b * t_21 <= 2.220446049250313e-16 {
            z_thr_2 = -0.9999999999999998
        }
        else {
            if 2.0 * rho_a * t_21 <= 2.220446049250313e-16 {
                branch_4 = 0.9999999999999998
            }
            else {
                zeta_2 = (rho_a - rho_b) / dens_1
                branch_4 = -zeta_2
            }
            z_thr_2 = branch_4
        }
        t_22 = 1.0 + z_thr_2
        if t_22 <= 2.220446049250313e-16 {
            opz_pow_n_2 = 1.3445809915232009e-21
        }
        else {
            opz_pow_n_2 = t_22 ^ (4.0 / 3.0)
        }
        r_ws_1 = 0.6203504908994 / dens_1 ^ (1.0 / 3.0)
        t_23 = 0.6203504908994 / r_ws_1
        lda_x_spin_1 = -0.9305257363491001 * opz_pow_n_2 * 0.3968502629920499 * t_23
        zeta_3 = (rho_a - rho_b) / dens_1
        if 1.0 - zeta_3 <= 2.220446049250313e-16 {
            z_thr_3 = -0.9999999999999998
        }
        else {
            if 1.0 + zeta_3 <= 2.220446049250313e-16 {
                branch_5 = 0.9999999999999998
            }
            else {
                branch_5 = -zeta_3
            }
            z_thr_3 = branch_5
        }
        t_24 = 1.0 + z_thr_3
        if t_24 <= 2.220446049250313e-16 {
            opz_pow_n_3 = 6.0554544523933395e-06
        }
        else {
            opz_pow_n_3 = t_24 ^ (1.0 / 3.0)
        }
        kf_1 = 3.093667726280136 * opz_pow_n_3 * 0.6203504908994 / r_ws_1
        nu_1 = 0.11 / kf_1
        xs1 = sqrt(sigma_bb) / rho_b ^ (4.0 / 3.0)
        t_25 = 0.1282782438530422 * xs1
        t_26 = t_25 ^ 2.0
        t_27 = t_25 ^ 3.0
        t_28 = t_25 ^ 4.0
        t_29 = t_25 ^ 5.0
        t_30 = t_25 ^ 6.0
        t_31 = t_25 ^ 7.0
        hjs_fh_1 = (0.00968615 * t_26 + -0.0242498 * t_27 + 0.0259009 * t_28 + -0.0136606 * t_29 + 0.00309606 * t_30 + -7.32583e-05 * t_31) / (1.0 + -2.50356 * t_25 + 2.79656 * t_26 + -1.79401 * t_27 + 0.714888 * t_28 + -0.165924 * t_29 + 0.0118379 * t_30 + 0.0037806 * t_31 + -0.000157905 * t_25 ^ 8.0 + 1.45323e-06 * t_25 ^ 9.0)
        t_32 = t_26 * hjs_fh_1
        if t_32 > 1.0e-10 {
            m_max_2 = t_32
        }
        else {
            m_max_2 = 1.0e-10
        }
        hjs_lambda_1 = 0.60965 + m_max_2
        t_33 = nu_1 ^ 2.0
        t_34 = sqrt(hjs_lambda_1 + t_33)
        hjs_chi_1 = nu_1 / t_34
        hjs_ff_1 = 1.0 - t_26 / (-3.203523 * (1.0 + t_26 / 4.0)) - m_max_2 / -0.237298
        t_35 = hjs_chi_1 ^ 3.0
        t_36 = hjs_lambda_1 ^ 2.0
        t_37 = hjs_lambda_1 ^ 3.0
        t_38 = 0.757211 + m_max_2
        if t_38 > 1.0e-10 {
            m_max_3 = t_38
        }
        else {
            m_max_3 = 1.0e-10
        }
        hjs_fg_1 = -(-0.0474596 * hjs_ff_1 * hjs_lambda_1) - -0.028363733333333332 * t_36 - 0.9086532 * t_37 - hjs_lambda_1 ^ (7.0 / 2.0) * (1.4179630807244128 + 12.0 / 5.0 * (sqrt(m_max_2) - sqrt(m_max_3)))
        t_39 = sqrt(m_max_2 + t_33)
        t_40 = sqrt(m_max_3 + t_33)
        t_41 = nu_1 + t_34
        hjs_f1_1 = 0.757211 - -0.04727288888888889 * (1.0 - hjs_chi_1) / hjs_lambda_1 - -0.026366444444444446 * hjs_ff_1 * (2.0 - 3.0 * hjs_chi_1 + t_35) / t_36 - 1.0 / 9.0 * hjs_fg_1 * (8.0 - 15.0 * hjs_chi_1 + 10.0 * t_35 - 3.0 * hjs_chi_1 ^ 5.0) / t_37 + 2.0 * nu_1 * (t_39 - t_40) + 2.0 * m_max_2 * log((nu_1 + t_39) / t_41) - 2.0 * m_max_3 * log((nu_1 + t_40) / t_41)
        branch_3 = lda_x_spin_1 * hjs_f1_1
    }
    gga_exchange_nsp = branch + branch_3
    return gga_exchange_nsp
}

#| the energy per volume, unpolarized: libxc's mf, whose gradient is [vrho, vsigma]
def _mf_unpol(x: Arr) -> Num {
    return x[0] * zk_unpol(x)
}

#| the energy per volume, spin-polarized
def _mf_pol(x: Arr) -> Num {
    return (x[0] + x[1]) * zk_pol(x)
}

#| libxc's xc_gga_exc_vxc, unpolarized: per point [zk, vrho, vsigma]
def eval_unpol(rho: Arr, sigma: Arr) -> Arr {
    n = len(rho)
    width = 3
    out = zeros(width * n)
    for i to n {
        if rho[i] >= DENS_THRESHOLD {
            x = gga_unpol_point(rho[i], sigma[i], DENS_THRESHOLD, SIGMA_THRESHOLD)
            g = grad(_mf_unpol, x)
            out[width * i] = zk_unpol(x)
            out[width * i + 1] = g[0]
            out[width * i + 2] = g[1]
        }
    }
    return out
}

#| libxc's xc_gga_exc_vxc, spin-polarized: rho = [a, b], sigma = [aa, ab, bb] per point;
#| out [zk, vrho_a, vrho_b, vsigma_aa, vsigma_ab, vsigma_bb]
def eval_pol(rho: Arr, sigma: Arr) -> Arr {
    nspin = 2
    nsigma = 3
    width = 6
    n = len(rho) // nspin
    out = zeros(width * n)
    for i to n {
        if rho[nspin * i] + rho[nspin * i + 1] >= DENS_THRESHOLD {
            x = gga_pol_point(rho[nspin * i], rho[nspin * i + 1], sigma[nsigma * i], sigma[nsigma * i + 1],
                              sigma[nsigma * i + 2], DENS_THRESHOLD, SIGMA_THRESHOLD)
            g = grad(_mf_pol, x)
            out[width * i] = zk_pol(x)
            for k to len(x) {
                out[width * i + 1 + k] = g[k]
            }
        }
    }
    return out
}
