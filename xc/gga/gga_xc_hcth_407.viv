#: DENS_THRESHOLD  libxc's dens_threshold for this functional: smaller total densities give zero
DENS_THRESHOLD = 1.0e-14
#: SIGMA_THRESHOLD  libxc's sigma_threshold, dens_threshold^(4/3)
SIGMA_THRESHOLD = 2.1544346900318888e-19

#| the energy per particle, unpolarized: x = [rho, sigma]
def zk_unpol(x: Arr) -> Num {
    rho = x[0]
    sigma = x[1]
    t = rho / 2.0
    if t <= 1.0e-14 {
        lda_stoll_par = 0.0
    }
    else {
        r_ws = 0.6203504908994 / rho ^ (1.0 / 3.0)
        t_1 = r_ws * 1.2599210498948732
        t_2 = 0.6203504908994 / t_1
        n_total = t_2 ^ 3.0
        n_spin = 2.0 * n_total / 2.0
        if n_spin <= 1.0e-14 {
            f_lda_x = 0.0
        }
        else {
            lda_x_spin = -0.9305257363491001 * t_2
            f_lda_x = lda_x_spin
        }
        lda_stoll_par = 1.0 / 2.0 * f_lda_x
    }
    xs0 = sqrt(sigma / 4.0) / t ^ (4.0 / 3.0)
    t_3 = xs0 ^ 2.0
    t_4 = 0.004 * t_3
    t_5 = t_4 / (1.0 + t_4)
    b97_g = 1.08184 + -0.518339 * t_5 + 3.42562 * t_5 ^ 2.0 + -2.62901 * t_5 ^ 3.0 + 2.28855 * t_5 ^ 4.0
    t_6 = lda_stoll_par * b97_g
    b97_fpar = t_6 + t_6
    if t <= 1.0e-14 {
        lda_stoll_par_1 = 0.0
    }
    else {
        r_ws_1 = 0.6203504908994 / rho ^ (1.0 / 3.0)
        t_7 = r_ws_1 * 1.2599210498948732
        t_8 = sqrt(t_7)
        t_9 = t_7 ^ 1.5
        t_10 = t_7 ^ 2.0
        g_aux = 7.5957 * t_8 + 3.5876 * t_7 + 1.6382 * t_9 + 0.49294 * t_10
        t_11 = 0.062182 * (1.0 + 0.2137 * t_7) * log(1.0 + 1.0 / (0.062182 * g_aux))
        g = -t_11
        g_aux_1 = 14.1189 * t_8 + 6.1977 * t_7 + 3.3662 * t_9 + 0.62517 * t_10
        g_1 = -(0.03109 * (1.0 + 0.20548 * t_7) * log(1.0 + 1.0 / (0.03109 * g_aux_1)))
        g_aux_2 = 10.357 * t_8 + 3.6231 * t_7 + 0.88026 * t_9 + 0.49671 * t_10
        g_2 = -(0.033774 * (1.0 + 0.11125 * t_7) * log(1.0 + 1.0 / (0.033774 * g_aux_2)))
        f_pw = g + 1.0 * (g_1 + t_11 + g_2 / 1.709921) - 1.0 * g_2 / 1.709921
        lda_stoll_par_1 = 1.0 / 2.0 * f_pw
    }
    t_12 = 0.2 * t_3
    t_13 = t_12 / (1.0 + t_12)
    b97_g_1 = 1.18777 + -2.40292 * t_13 + 5.61741 * t_13 ^ 2.0 + -9.17923 * t_13 ^ 3.0 + 6.24798 * t_13 ^ 4.0
    t_14 = lda_stoll_par_1 * b97_g_1
    b97_fpar_1 = t_14 + t_14
    r_ws_2 = 0.6203504908994 / rho ^ (1.0 / 3.0)
    g_aux_3 = 7.5957 * sqrt(r_ws_2) + 3.5876 * r_ws_2 + 1.6382 * r_ws_2 ^ 1.5 + 0.49294 * r_ws_2 ^ 2.0
    g_3 = -(0.062182 * (1.0 + 0.2137 * r_ws_2) * log(1.0 + 1.0 / (0.062182 * g_aux_3)))
    lda_stoll_perp = g_3 - lda_stoll_par_1 - lda_stoll_par_1
    t_15 = 0.006 * (sqrt(t_3 + t_3) / 1.4142135623730951) ^ 2.0
    t_16 = t_15 / (1.0 + t_15)
    b97_g_2 = 0.589076 + 4.42374 * t_16 + -19.2218 * t_16 ^ 2.0 + 42.5721 * t_16 ^ 3.0 + -42.0052 * t_16 ^ 4.0
    b97_fperp = lda_stoll_perp * b97_g_2
    b97_f = b97_fpar_1 + b97_fperp
    f = b97_fpar + b97_f
    return f
}

#| the energy per particle, spin-polarized: x = [rho_a, rho_b, sigma_aa, sigma_ab, sigma_bb]
def zk_pol(x: Arr) -> Num {
    rho_a = x[0]
    rho_b = x[1]
    sigma_aa = x[2]
    sigma_ab = x[3]
    sigma_bb = x[4]
    dens = rho_a + rho_b
    zeta = (rho_a - rho_b) / dens
    t = 1.0 + zeta
    if rho_a <= 1.0e-14 or t <= 2.220446049250313e-16 {
        lda_stoll_par = 0.0
    }
    else {
        if t <= 2.220446049250313e-16 {
            opz_pow_n = 2.220446049250313e-16
        }
        else {
            opz_pow_n = t
        }
        t_1 = opz_pow_n / 2.0
        r_ws = 0.6203504908994 / dens ^ (1.0 / 3.0)
        t_2 = r_ws * 1.2599210498948732
        t_3 = 1.0 / dens
        t_4 = 2.0 * rho_a * t_3
        if t_4 <= 2.220446049250313e-16 {
            opz_pow_n_1 = 165140.37185182082
        }
        else {
            opz_pow_n_1 = t_4 ^ (-1.0 / 3.0)
        }
        t_5 = 0.6203504908994 / (t_2 * opz_pow_n_1)
        n_total = t_5 ^ 3.0
        n_spin = 2.0 * n_total / 2.0
        if n_spin <= 1.0e-14 {
            f_lda_x = 0.0
        }
        else {
            lda_x_spin = -0.9305257363491001 * t_5
            f_lda_x = lda_x_spin
        }
        lda_stoll_par = t_1 * f_lda_x
    }
    xs0 = sqrt(sigma_aa) / rho_a ^ (4.0 / 3.0)
    t_6 = xs0 ^ 2.0
    t_7 = 0.004 * t_6
    t_8 = t_7 / (1.0 + t_7)
    b97_g = 1.08184 + -0.518339 * t_8 + 3.42562 * t_8 ^ 2.0 + -2.62901 * t_8 ^ 3.0 + 2.28855 * t_8 ^ 4.0
    t_9 = 1.0 - zeta
    if rho_b <= 1.0e-14 or t_9 <= 2.220446049250313e-16 {
        lda_stoll_par_1 = 0.0
    }
    else {
        if t_9 <= 2.220446049250313e-16 {
            opz_pow_n_2 = 2.220446049250313e-16
        }
        else {
            opz_pow_n_2 = t_9
        }
        t_10 = opz_pow_n_2 / 2.0
        r_ws_1 = 0.6203504908994 / dens ^ (1.0 / 3.0)
        t_11 = r_ws_1 * 1.2599210498948732
        t_12 = 1.0 / dens
        t_13 = 2.0 * rho_b * t_12
        if t_13 <= 2.220446049250313e-16 {
            opz_pow_n_3 = 165140.37185182082
        }
        else {
            opz_pow_n_3 = t_13 ^ (-1.0 / 3.0)
        }
        t_14 = 0.6203504908994 / (t_11 * opz_pow_n_3)
        n_total_1 = t_14 ^ 3.0
        n_spin_1 = 2.0 * n_total_1 / 2.0
        if n_spin_1 <= 1.0e-14 {
            f_lda_x_1 = 0.0
        }
        else {
            lda_x_spin_1 = -0.9305257363491001 * t_14
            f_lda_x_1 = lda_x_spin_1
        }
        lda_stoll_par_1 = t_10 * f_lda_x_1
    }
    xs1 = sqrt(sigma_bb) / rho_b ^ (4.0 / 3.0)
    t_15 = xs1 ^ 2.0
    t_16 = 0.004 * t_15
    t_17 = t_16 / (1.0 + t_16)
    b97_g_1 = 1.08184 + -0.518339 * t_17 + 3.42562 * t_17 ^ 2.0 + -2.62901 * t_17 ^ 3.0 + 2.28855 * t_17 ^ 4.0
    b97_fpar = lda_stoll_par * b97_g + lda_stoll_par_1 * b97_g_1
    if rho_a <= 1.0e-14 or t <= 2.220446049250313e-16 {
        lda_stoll_par_2 = 0.0
    }
    else {
        if t <= 2.220446049250313e-16 {
            opz_pow_n_4 = 2.220446049250313e-16
        }
        else {
            opz_pow_n_4 = t
        }
        t_18 = opz_pow_n_4 / 2.0
        r_ws_2 = 0.6203504908994 / dens ^ (1.0 / 3.0)
        t_19 = r_ws_2 * 1.2599210498948732
        if t <= 2.220446049250313e-16 {
            opz_pow_n_5 = 165140.37185182082
        }
        else {
            opz_pow_n_5 = t ^ (-1.0 / 3.0)
        }
        t_20 = t_19 * opz_pow_n_5
        t_21 = sqrt(t_20)
        t_22 = t_20 ^ 1.5
        t_23 = t_20 ^ 2.0
        g_aux = 7.5957 * t_21 + 3.5876 * t_20 + 1.6382 * t_22 + 0.49294 * t_23
        t_24 = 0.062182 * (1.0 + 0.2137 * t_20) * log(1.0 + 1.0 / (0.062182 * g_aux))
        g = -t_24
        g_aux_1 = 14.1189 * t_21 + 6.1977 * t_20 + 3.3662 * t_22 + 0.62517 * t_23
        g_1 = -(0.03109 * (1.0 + 0.20548 * t_20) * log(1.0 + 1.0 / (0.03109 * g_aux_1)))
        g_aux_2 = 10.357 * t_21 + 3.6231 * t_20 + 0.88026 * t_22 + 0.49671 * t_23
        g_2 = -(0.033774 * (1.0 + 0.11125 * t_20) * log(1.0 + 1.0 / (0.033774 * g_aux_2)))
        f_pw = g + 1.0 * (g_1 + t_24 + g_2 / 1.709921) - 1.0 * g_2 / 1.709921
        lda_stoll_par_2 = t_18 * f_pw
    }
    t_25 = 0.2 * t_6
    t_26 = t_25 / (1.0 + t_25)
    b97_g_2 = 1.18777 + -2.40292 * t_26 + 5.61741 * t_26 ^ 2.0 + -9.17923 * t_26 ^ 3.0 + 6.24798 * t_26 ^ 4.0
    if rho_b <= 1.0e-14 or t_9 <= 2.220446049250313e-16 {
        lda_stoll_par_3 = 0.0
    }
    else {
        if t_9 <= 2.220446049250313e-16 {
            opz_pow_n_6 = 2.220446049250313e-16
        }
        else {
            opz_pow_n_6 = t_9
        }
        t_27 = opz_pow_n_6 / 2.0
        r_ws_3 = 0.6203504908994 / dens ^ (1.0 / 3.0)
        t_28 = r_ws_3 * 1.2599210498948732
        if t_9 <= 2.220446049250313e-16 {
            opz_pow_n_7 = 165140.37185182082
        }
        else {
            opz_pow_n_7 = t_9 ^ (-1.0 / 3.0)
        }
        t_29 = t_28 * opz_pow_n_7
        t_30 = sqrt(t_29)
        t_31 = t_29 ^ 1.5
        t_32 = t_29 ^ 2.0
        g_aux_3 = 7.5957 * t_30 + 3.5876 * t_29 + 1.6382 * t_31 + 0.49294 * t_32
        t_33 = 0.062182 * (1.0 + 0.2137 * t_29) * log(1.0 + 1.0 / (0.062182 * g_aux_3))
        g_3 = -t_33
        g_aux_4 = 14.1189 * t_30 + 6.1977 * t_29 + 3.3662 * t_31 + 0.62517 * t_32
        g_4 = -(0.03109 * (1.0 + 0.20548 * t_29) * log(1.0 + 1.0 / (0.03109 * g_aux_4)))
        g_aux_5 = 10.357 * t_30 + 3.6231 * t_29 + 0.88026 * t_31 + 0.49671 * t_32
        g_5 = -(0.033774 * (1.0 + 0.11125 * t_29) * log(1.0 + 1.0 / (0.033774 * g_aux_5)))
        f_pw_1 = g_3 + 1.0 * (g_4 + t_33 + g_5 / 1.709921) - 1.0 * g_5 / 1.709921
        lda_stoll_par_3 = t_27 * f_pw_1
    }
    t_34 = 0.2 * t_15
    t_35 = t_34 / (1.0 + t_34)
    b97_g_3 = 1.18777 + -2.40292 * t_35 + 5.61741 * t_35 ^ 2.0 + -9.17923 * t_35 ^ 3.0 + 6.24798 * t_35 ^ 4.0
    b97_fpar_1 = lda_stoll_par_2 * b97_g_2 + lda_stoll_par_3 * b97_g_3
    r_ws_4 = 0.6203504908994 / dens ^ (1.0 / 3.0)
    t_36 = sqrt(r_ws_4)
    t_37 = r_ws_4 ^ 1.5
    t_38 = r_ws_4 ^ 2.0
    g_aux_6 = 7.5957 * t_36 + 3.5876 * r_ws_4 + 1.6382 * t_37 + 0.49294 * t_38
    t_39 = 0.062182 * (1.0 + 0.2137 * r_ws_4) * log(1.0 + 1.0 / (0.062182 * g_aux_6))
    g_6 = -t_39
    if t <= 2.220446049250313e-16 {
        opz_pow_n_8 = 1.3445809915232009e-21
    }
    else {
        opz_pow_n_8 = t ^ (4.0 / 3.0)
    }
    if t_9 <= 2.220446049250313e-16 {
        opz_pow_n_9 = 1.3445809915232009e-21
    }
    else {
        opz_pow_n_9 = t_9 ^ (4.0 / 3.0)
    }
    f_zeta = (opz_pow_n_8 + opz_pow_n_9 - 2.0) / 0.5198420997897464
    g_aux_7 = 14.1189 * t_36 + 6.1977 * r_ws_4 + 3.3662 * t_37 + 0.62517 * t_38
    g_7 = -(0.03109 * (1.0 + 0.20548 * r_ws_4) * log(1.0 + 1.0 / (0.03109 * g_aux_7)))
    g_aux_8 = 10.357 * t_36 + 3.6231 * r_ws_4 + 0.88026 * t_37 + 0.49671 * t_38
    g_8 = -(0.033774 * (1.0 + 0.11125 * r_ws_4) * log(1.0 + 1.0 / (0.033774 * g_aux_8)))
    f_pw_2 = g_6 + zeta ^ 4.0 * f_zeta * (g_7 + t_39 + g_8 / 1.709921) - f_zeta * g_8 / 1.709921
    lda_stoll_perp = f_pw_2 - lda_stoll_par_2 - lda_stoll_par_3
    t_40 = 0.006 * (sqrt(t_6 + t_15) / 1.4142135623730951) ^ 2.0
    t_41 = t_40 / (1.0 + t_40)
    b97_g_4 = 0.589076 + 4.42374 * t_41 + -19.2218 * t_41 ^ 2.0 + 42.5721 * t_41 ^ 3.0 + -42.0052 * t_41 ^ 4.0
    b97_fperp = lda_stoll_perp * b97_g_4
    b97_f = b97_fpar_1 + b97_fperp
    f = b97_fpar + b97_f
    return f
}

#| the energy per volume, unpolarized: libxc's mf, whose gradient is [vrho, vsigma]
def _mf_unpol(x: Arr) -> Num {
    return x[0] * zk_unpol(x)
}

#| the energy per volume, spin-polarized
def _mf_pol(x: Arr) -> Num {
    return (x[0] + x[1]) * zk_pol(x)
}

#| libxc's xc_gga_exc_vxc, unpolarized: per point [zk, vrho, vsigma]
def eval_unpol(rho: Arr, sigma: Arr) -> Arr {
    n = len(rho)
    width = 3
    out = zeros(width * n)
    for i to n {
        if rho[i] >= DENS_THRESHOLD {
            x = gga_unpol_point(rho[i], sigma[i], DENS_THRESHOLD, SIGMA_THRESHOLD)
            g = grad(_mf_unpol, x)
            out[width * i] = zk_unpol(x)
            out[width * i + 1] = g[0]
            out[width * i + 2] = g[1]
        }
    }
    return out
}

#| libxc's xc_gga_exc_vxc, spin-polarized: rho = [a, b], sigma = [aa, ab, bb] per point;
#| out [zk, vrho_a, vrho_b, vsigma_aa, vsigma_ab, vsigma_bb]
def eval_pol(rho: Arr, sigma: Arr) -> Arr {
    nspin = 2
    nsigma = 3
    width = 6
    n = len(rho) // nspin
    out = zeros(width * n)
    for i to n {
        if rho[nspin * i] + rho[nspin * i + 1] >= DENS_THRESHOLD {
            x = gga_pol_point(rho[nspin * i], rho[nspin * i + 1], sigma[nsigma * i], sigma[nsigma * i + 1],
                              sigma[nsigma * i + 2], DENS_THRESHOLD, SIGMA_THRESHOLD)
            g = grad(_mf_pol, x)
            out[width * i] = zk_pol(x)
            for k to len(x) {
                out[width * i + 1 + k] = g[k]
            }
        }
    }
    return out
}
