from xc.core import gga_pol_point, gga_unpol_point

#| GGA_C_HYB_TAU_HCTH (libxc id 283): correlation part of hyb-tau-hcth
#|| kind c, family gga, Maple script gga_exc/gga_c_bmk.mpl
#~ reference: A. D. Boese and N. C. Handy.,  J. Chem. Phys. 116, 9559 (2002)

#: DENS_THRESHOLD  libxc's dens_threshold for this functional: smaller total densities give zero
DENS_THRESHOLD = 1.0e-14
#: SIGMA_THRESHOLD  libxc's sigma_threshold, dens_threshold^(4/3)
SIGMA_THRESHOLD = 2.1544346900318888e-19

#| the energy per particle, unpolarized: x = [rho, sigma]
def zk_unpol(x: Arr) -> Num {
    rho = x[0]
    sigma = x[1]
    t = rho / 2.0
    if t <= 1.0e-14 {
        lda_stoll_par = 0.0
    }
    else {
        r_ws = 0.6203504908994 / rho ^ (1.0 / 3.0)
        t_1 = r_ws * 1.2599210498948732
        t_2 = sqrt(t_1)
        t_3 = t_1 ^ 1.5
        t_4 = t_1 ^ 2.0
        g_aux = 7.5957 * t_2 + 3.5876 * t_1 + 1.6382 * t_3 + 0.49294 * t_4
        t_5 = 0.062182 * (1.0 + 0.2137 * t_1) * log(1.0 + 1.0 / (0.062182 * g_aux))
        g = -t_5
        g_aux_1 = 14.1189 * t_2 + 6.1977 * t_1 + 3.3662 * t_3 + 0.62517 * t_4
        g_1 = -(0.03109 * (1.0 + 0.20548 * t_1) * log(1.0 + 1.0 / (0.03109 * g_aux_1)))
        g_aux_2 = 10.357 * t_2 + 3.6231 * t_1 + 0.88026 * t_3 + 0.49671 * t_4
        g_2 = -(0.033774 * (1.0 + 0.11125 * t_1) * log(1.0 + 1.0 / (0.033774 * g_aux_2)))
        f_pw = g + 1.0 * (g_1 + t_5 + g_2 / 1.709921) - 1.0 * g_2 / 1.709921
        lda_stoll_par = 1.0 / 2.0 * f_pw
    }
    xs0 = sqrt(sigma / 4.0) / t ^ (4.0 / 3.0)
    t_6 = xs0 ^ 2.0
    t_7 = 0.2 * t_6
    t_8 = t_7 / (1.0 + t_7)
    b97_g = 0.186 + 3.9782 * t_8 + -7.0694 * t_8 ^ 2.0 + 3.4747 * t_8 ^ 3.0
    t_9 = lda_stoll_par * b97_g
    b97_fpar = t_9 + t_9
    r_ws_1 = 0.6203504908994 / rho ^ (1.0 / 3.0)
    g_aux_3 = 7.5957 * sqrt(r_ws_1) + 3.5876 * r_ws_1 + 1.6382 * r_ws_1 ^ 1.5 + 0.49294 * r_ws_1 ^ 2.0
    g_3 = -(0.062182 * (1.0 + 0.2137 * r_ws_1) * log(1.0 + 1.0 / (0.062182 * g_aux_3)))
    lda_stoll_perp = g_3 - lda_stoll_par - lda_stoll_par
    t_10 = 0.006 * (sqrt(t_6 + t_6) / 1.4142135623730951) ^ 2.0
    t_11 = t_10 / (1.0 + t_10)
    b97_g_1 = 0.8049 + 3.8388 * t_11 + -13.547 * t_11 ^ 2.0 + 3.9133 * t_11 ^ 3.0
    b97_fperp = lda_stoll_perp * b97_g_1
    b97_f = b97_fpar + b97_fperp
    return b97_f
}

#| the energy per particle, spin-polarized: x = [rho_a, rho_b, sigma_aa, sigma_ab, sigma_bb]
def zk_pol(x: Arr) -> Num {
    rho_a = x[0]
    rho_b = x[1]
    sigma_aa = x[2]
    sigma_ab = x[3]
    sigma_bb = x[4]
    dens = rho_a + rho_b
    zeta = (rho_a - rho_b) / dens
    t = 1.0 + zeta
    if rho_a <= 1.0e-14 or t <= 2.220446049250313e-16 {
        lda_stoll_par = 0.0
    }
    else {
        if t <= 2.220446049250313e-16 {
            opz_pow_n = 2.220446049250313e-16
        }
        else {
            opz_pow_n = t
        }
        r_ws = 0.6203504908994 / dens ^ (1.0 / 3.0)
        t_1 = r_ws * 1.2599210498948732
        if t <= 2.220446049250313e-16 {
            opz_pow_n_1 = 165140.37185182082
        }
        else {
            opz_pow_n_1 = t ^ (-1.0 / 3.0)
        }
        t_2 = t_1 * opz_pow_n_1
        t_3 = sqrt(t_2)
        t_4 = t_2 ^ 1.5
        t_5 = t_2 ^ 2.0
        g_aux = 7.5957 * t_3 + 3.5876 * t_2 + 1.6382 * t_4 + 0.49294 * t_5
        t_6 = 0.062182 * (1.0 + 0.2137 * t_2) * log(1.0 + 1.0 / (0.062182 * g_aux))
        g = -t_6
        g_aux_1 = 14.1189 * t_3 + 6.1977 * t_2 + 3.3662 * t_4 + 0.62517 * t_5
        g_1 = -(0.03109 * (1.0 + 0.20548 * t_2) * log(1.0 + 1.0 / (0.03109 * g_aux_1)))
        g_aux_2 = 10.357 * t_3 + 3.6231 * t_2 + 0.88026 * t_4 + 0.49671 * t_5
        g_2 = -(0.033774 * (1.0 + 0.11125 * t_2) * log(1.0 + 1.0 / (0.033774 * g_aux_2)))
        f_pw = g + 1.0 * (g_1 + t_6 + g_2 / 1.709921) - 1.0 * g_2 / 1.709921
        lda_stoll_par = opz_pow_n / 2.0 * f_pw
    }
    xs0 = sqrt(sigma_aa) / rho_a ^ (4.0 / 3.0)
    t_7 = xs0 ^ 2.0
    t_8 = 0.2 * t_7
    t_9 = t_8 / (1.0 + t_8)
    b97_g = 0.186 + 3.9782 * t_9 + -7.0694 * t_9 ^ 2.0 + 3.4747 * t_9 ^ 3.0
    t_10 = 1.0 - zeta
    if rho_b <= 1.0e-14 or t_10 <= 2.220446049250313e-16 {
        lda_stoll_par_1 = 0.0
    }
    else {
        if t_10 <= 2.220446049250313e-16 {
            opz_pow_n_2 = 2.220446049250313e-16
        }
        else {
            opz_pow_n_2 = t_10
        }
        r_ws_1 = 0.6203504908994 / dens ^ (1.0 / 3.0)
        t_11 = r_ws_1 * 1.2599210498948732
        if t_10 <= 2.220446049250313e-16 {
            opz_pow_n_3 = 165140.37185182082
        }
        else {
            opz_pow_n_3 = t_10 ^ (-1.0 / 3.0)
        }
        t_12 = t_11 * opz_pow_n_3
        t_13 = sqrt(t_12)
        t_14 = t_12 ^ 1.5
        t_15 = t_12 ^ 2.0
        g_aux_3 = 7.5957 * t_13 + 3.5876 * t_12 + 1.6382 * t_14 + 0.49294 * t_15
        t_16 = 0.062182 * (1.0 + 0.2137 * t_12) * log(1.0 + 1.0 / (0.062182 * g_aux_3))
        g_3 = -t_16
        g_aux_4 = 14.1189 * t_13 + 6.1977 * t_12 + 3.3662 * t_14 + 0.62517 * t_15
        g_4 = -(0.03109 * (1.0 + 0.20548 * t_12) * log(1.0 + 1.0 / (0.03109 * g_aux_4)))
        g_aux_5 = 10.357 * t_13 + 3.6231 * t_12 + 0.88026 * t_14 + 0.49671 * t_15
        g_5 = -(0.033774 * (1.0 + 0.11125 * t_12) * log(1.0 + 1.0 / (0.033774 * g_aux_5)))
        f_pw_1 = g_3 + 1.0 * (g_4 + t_16 + g_5 / 1.709921) - 1.0 * g_5 / 1.709921
        lda_stoll_par_1 = opz_pow_n_2 / 2.0 * f_pw_1
    }
    xs1 = sqrt(sigma_bb) / rho_b ^ (4.0 / 3.0)
    t_17 = xs1 ^ 2.0
    t_18 = 0.2 * t_17
    t_19 = t_18 / (1.0 + t_18)
    b97_g_1 = 0.186 + 3.9782 * t_19 + -7.0694 * t_19 ^ 2.0 + 3.4747 * t_19 ^ 3.0
    b97_fpar = lda_stoll_par * b97_g + lda_stoll_par_1 * b97_g_1
    r_ws_2 = 0.6203504908994 / dens ^ (1.0 / 3.0)
    t_20 = sqrt(r_ws_2)
    t_21 = r_ws_2 ^ 1.5
    t_22 = r_ws_2 ^ 2.0
    g_aux_6 = 7.5957 * t_20 + 3.5876 * r_ws_2 + 1.6382 * t_21 + 0.49294 * t_22
    t_23 = 0.062182 * (1.0 + 0.2137 * r_ws_2) * log(1.0 + 1.0 / (0.062182 * g_aux_6))
    g_6 = -t_23
    if t <= 2.220446049250313e-16 {
        opz_pow_n_4 = 1.3445809915232009e-21
    }
    else {
        opz_pow_n_4 = t ^ (4.0 / 3.0)
    }
    if t_10 <= 2.220446049250313e-16 {
        opz_pow_n_5 = 1.3445809915232009e-21
    }
    else {
        opz_pow_n_5 = t_10 ^ (4.0 / 3.0)
    }
    f_zeta = (opz_pow_n_4 + opz_pow_n_5 - 2.0) / 0.5198420997897464
    g_aux_7 = 14.1189 * t_20 + 6.1977 * r_ws_2 + 3.3662 * t_21 + 0.62517 * t_22
    g_7 = -(0.03109 * (1.0 + 0.20548 * r_ws_2) * log(1.0 + 1.0 / (0.03109 * g_aux_7)))
    g_aux_8 = 10.357 * t_20 + 3.6231 * r_ws_2 + 0.88026 * t_21 + 0.49671 * t_22
    g_8 = -(0.033774 * (1.0 + 0.11125 * r_ws_2) * log(1.0 + 1.0 / (0.033774 * g_aux_8)))
    f_pw_2 = g_6 + zeta ^ 4.0 * f_zeta * (g_7 + t_23 + g_8 / 1.709921) - f_zeta * g_8 / 1.709921
    lda_stoll_perp = f_pw_2 - lda_stoll_par - lda_stoll_par_1
    t_24 = 0.006 * (sqrt(t_7 + t_17) / 1.4142135623730951) ^ 2.0
    t_25 = t_24 / (1.0 + t_24)
    b97_g_2 = 0.8049 + 3.8388 * t_25 + -13.547 * t_25 ^ 2.0 + 3.9133 * t_25 ^ 3.0
    b97_fperp = lda_stoll_perp * b97_g_2
    b97_f = b97_fpar + b97_fperp
    return b97_f
}

#| the energy per volume, unpolarized: libxc's mf, whose gradient is [vrho, vsigma]
def _mf_unpol(x: Arr) -> Num {
    return x[0] * zk_unpol(x)
}

#| the energy per volume, spin-polarized
def _mf_pol(x: Arr) -> Num {
    return (x[0] + x[1]) * zk_pol(x)
}

#| libxc's xc_gga_exc_vxc, unpolarized: per point [zk, vrho, vsigma]
def eval_unpol(rho: Arr, sigma: Arr) -> Arr {
    n = len(rho)
    width = 3
    out = zeros(width * n)
    for i to n {
        if rho[i] >= DENS_THRESHOLD {
            x = gga_unpol_point(rho[i], sigma[i], DENS_THRESHOLD, SIGMA_THRESHOLD)
            g = grad(_mf_unpol, x)
            out[width * i] = zk_unpol(x)
            out[width * i + 1] = g[0]
            out[width * i + 2] = g[1]
        }
    }
    return out
}

#| libxc's xc_gga_exc_vxc, spin-polarized: rho = [a, b], sigma = [aa, ab, bb] per point;
#| out [zk, vrho_a, vrho_b, vsigma_aa, vsigma_ab, vsigma_bb]
def eval_pol(rho: Arr, sigma: Arr) -> Arr {
    nspin = 2
    nsigma = 3
    width = 6
    n = len(rho) // nspin
    out = zeros(width * n)
    for i to n {
        if rho[nspin * i] + rho[nspin * i + 1] >= DENS_THRESHOLD {
            x = gga_pol_point(rho[nspin * i], rho[nspin * i + 1], sigma[nsigma * i], sigma[nsigma * i + 1],
                              sigma[nsigma * i + 2], DENS_THRESHOLD, SIGMA_THRESHOLD)
            g = grad(_mf_pol, x)
            out[width * i] = zk_pol(x)
            for k to len(x) {
                out[width * i + 1 + k] = g[k]
            }
        }
    }
    return out
}
