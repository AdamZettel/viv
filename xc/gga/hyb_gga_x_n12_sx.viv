from xc.core import gga_pol_point, gga_unpol_point

#| HYB_GGA_X_N12_SX (libxc id 81): Minnesota N12-SX exchange functional
#|| kind x, family hyb_gga, Maple script gga_exc/gga_x_n12.mpl
#~ reference: R. Peverati and D. G. Truhlar.,  Phys. Chem. Chem. Phys. 14, 16187 (2012)
#~ hybrid: exact-exchange fraction cam_alpha = 0.0, cam_beta = 0.25, omega = 0.11; this module is the semilocal part only

#: DENS_THRESHOLD  libxc's dens_threshold for this functional: smaller total densities give zero
DENS_THRESHOLD = 1.0e-14
#: SIGMA_THRESHOLD  libxc's sigma_threshold, dens_threshold^(4/3)
SIGMA_THRESHOLD = 2.1544346900318888e-19

#| the energy per particle, unpolarized: x = [rho, sigma]
def zk_unpol(x: Arr) -> Num {
    rho = x[0]
    sigma = x[1]
    t = rho / 2.0
    if t <= 1.0e-14 {
        branch = 0.0
    }
    else {
        r_ws = 0.6203504908994 / rho ^ (1.0 / 3.0)
        lda_x_spin = -0.3692793831910112 * 0.6203504908994 / r_ws
        xs0 = sqrt(sigma / 4.0) / t ^ (4.0 / 3.0)
        t_1 = 0.004 * xs0 ^ 2.0
        n12_ux = t_1 / (1.0 + t_1)
        t_2 = n12_ux ^ 2.0
        t_3 = n12_ux ^ 3.0
        n12_rss = r_ws * 1.2599210498948732
        n12_vx = 1.0 / (1.0 + 0.6447967816065878 * n12_rss)
        n12_fn12 = 0.681116 + 1.88858 * n12_ux + 1.7859 * t_2 + 0.879456 * t_3 + (-0.081227 + -1.08723 * n12_ux + -4.18682 * t_2 + -30.0 * t_3) * n12_vx + (0.536236 + -5.45678 * n12_ux + 30.0 * t_2 + 55.1105 * t_3) * n12_vx ^ 2.0 + (-0.709913 + 13.0001 * n12_ux + -72.4877 * t_2 + 29.8363 * t_3) * n12_vx ^ 3.0
        branch = lda_x_spin * n12_fn12
    }
    gga_exchange_nsp = branch + branch
    return gga_exchange_nsp
}

#| the energy per particle, spin-polarized: x = [rho_a, rho_b, sigma_aa, sigma_ab, sigma_bb]
def zk_pol(x: Arr) -> Num {
    rho_a = x[0]
    rho_b = x[1]
    sigma_aa = x[2]
    sigma_ab = x[3]
    sigma_bb = x[4]
    if rho_a <= 1.0e-14 {
        branch = 0.0
    }
    else {
        dens = rho_a + rho_b
        t = 1.0 / dens
        if 2.0 * rho_a * t <= 2.220446049250313e-16 {
            z_thr = -0.9999999999999998
        }
        else {
            if 2.0 * rho_b * t <= 2.220446049250313e-16 {
                branch_1 = 0.9999999999999998
            }
            else {
                zeta = (rho_a - rho_b) / dens
                branch_1 = zeta
            }
            z_thr = branch_1
        }
        t_1 = 1.0 + z_thr
        if t_1 <= 2.220446049250313e-16 {
            opz_pow_n = 1.3445809915232009e-21
        }
        else {
            opz_pow_n = t_1 ^ (4.0 / 3.0)
        }
        r_ws = 0.6203504908994 / dens ^ (1.0 / 3.0)
        t_2 = 0.6203504908994 / r_ws
        lda_x_spin = -0.9305257363491001 * opz_pow_n * 0.3968502629920499 * t_2
        xs0 = sqrt(sigma_aa) / rho_a ^ (4.0 / 3.0)
        t_3 = 0.004 * xs0 ^ 2.0
        n12_ux = t_3 / (1.0 + t_3)
        t_4 = n12_ux ^ 2.0
        t_5 = n12_ux ^ 3.0
        t_6 = r_ws * 1.2599210498948732
        zeta_1 = (rho_a - rho_b) / dens
        if 1.0 + zeta_1 <= 2.220446049250313e-16 {
            z_thr_1 = -0.9999999999999998
        }
        else {
            if 1.0 - zeta_1 <= 2.220446049250313e-16 {
                branch_2 = 0.9999999999999998
            }
            else {
                branch_2 = zeta_1
            }
            z_thr_1 = branch_2
        }
        t_7 = 1.0 + z_thr_1
        if t_7 <= 2.220446049250313e-16 {
            opz_pow_n_1 = 165140.37185182082
        }
        else {
            opz_pow_n_1 = t_7 ^ (-1.0 / 3.0)
        }
        n12_rss = t_6 * opz_pow_n_1
        n12_vx = 1.0 / (1.0 + 0.6447967816065878 * n12_rss)
        n12_fn12 = 0.681116 + 1.88858 * n12_ux + 1.7859 * t_4 + 0.879456 * t_5 + (-0.081227 + -1.08723 * n12_ux + -4.18682 * t_4 + -30.0 * t_5) * n12_vx + (0.536236 + -5.45678 * n12_ux + 30.0 * t_4 + 55.1105 * t_5) * n12_vx ^ 2.0 + (-0.709913 + 13.0001 * n12_ux + -72.4877 * t_4 + 29.8363 * t_5) * n12_vx ^ 3.0
        branch = lda_x_spin * n12_fn12
    }
    if rho_b <= 1.0e-14 {
        branch_3 = 0.0
    }
    else {
        dens_1 = rho_a + rho_b
        t_8 = 1.0 / dens_1
        if 2.0 * rho_b * t_8 <= 2.220446049250313e-16 {
            z_thr_2 = -0.9999999999999998
        }
        else {
            if 2.0 * rho_a * t_8 <= 2.220446049250313e-16 {
                branch_4 = 0.9999999999999998
            }
            else {
                zeta_2 = (rho_a - rho_b) / dens_1
                branch_4 = -zeta_2
            }
            z_thr_2 = branch_4
        }
        t_9 = 1.0 + z_thr_2
        if t_9 <= 2.220446049250313e-16 {
            opz_pow_n_2 = 1.3445809915232009e-21
        }
        else {
            opz_pow_n_2 = t_9 ^ (4.0 / 3.0)
        }
        r_ws_1 = 0.6203504908994 / dens_1 ^ (1.0 / 3.0)
        t_10 = 0.6203504908994 / r_ws_1
        lda_x_spin_1 = -0.9305257363491001 * opz_pow_n_2 * 0.3968502629920499 * t_10
        xs1 = sqrt(sigma_bb) / rho_b ^ (4.0 / 3.0)
        t_11 = 0.004 * xs1 ^ 2.0
        n12_ux_1 = t_11 / (1.0 + t_11)
        t_12 = n12_ux_1 ^ 2.0
        t_13 = n12_ux_1 ^ 3.0
        t_14 = r_ws_1 * 1.2599210498948732
        zeta_3 = (rho_a - rho_b) / dens_1
        if 1.0 - zeta_3 <= 2.220446049250313e-16 {
            z_thr_3 = -0.9999999999999998
        }
        else {
            if 1.0 + zeta_3 <= 2.220446049250313e-16 {
                branch_5 = 0.9999999999999998
            }
            else {
                branch_5 = -zeta_3
            }
            z_thr_3 = branch_5
        }
        t_15 = 1.0 + z_thr_3
        if t_15 <= 2.220446049250313e-16 {
            opz_pow_n_3 = 165140.37185182082
        }
        else {
            opz_pow_n_3 = t_15 ^ (-1.0 / 3.0)
        }
        n12_rss_1 = t_14 * opz_pow_n_3
        n12_vx_1 = 1.0 / (1.0 + 0.6447967816065878 * n12_rss_1)
        n12_fn12_1 = 0.681116 + 1.88858 * n12_ux_1 + 1.7859 * t_12 + 0.879456 * t_13 + (-0.081227 + -1.08723 * n12_ux_1 + -4.18682 * t_12 + -30.0 * t_13) * n12_vx_1 + (0.536236 + -5.45678 * n12_ux_1 + 30.0 * t_12 + 55.1105 * t_13) * n12_vx_1 ^ 2.0 + (-0.709913 + 13.0001 * n12_ux_1 + -72.4877 * t_12 + 29.8363 * t_13) * n12_vx_1 ^ 3.0
        branch_3 = lda_x_spin_1 * n12_fn12_1
    }
    gga_exchange_nsp = branch + branch_3
    return gga_exchange_nsp
}

#| the energy per volume, unpolarized: libxc's mf, whose gradient is [vrho, vsigma]
def _mf_unpol(x: Arr) -> Num {
    return x[0] * zk_unpol(x)
}

#| the energy per volume, spin-polarized
def _mf_pol(x: Arr) -> Num {
    return (x[0] + x[1]) * zk_pol(x)
}

#| libxc's xc_gga_exc_vxc, unpolarized: per point [zk, vrho, vsigma]
def eval_unpol(rho: Arr, sigma: Arr) -> Arr {
    n = len(rho)
    width = 3
    out = zeros(width * n)
    for i to n {
        if rho[i] >= DENS_THRESHOLD {
            x = gga_unpol_point(rho[i], sigma[i], DENS_THRESHOLD, SIGMA_THRESHOLD)
            g = grad(_mf_unpol, x)
            out[width * i] = zk_unpol(x)
            out[width * i + 1] = g[0]
            out[width * i + 2] = g[1]
        }
    }
    return out
}

#| libxc's xc_gga_exc_vxc, spin-polarized: rho = [a, b], sigma = [aa, ab, bb] per point;
#| out [zk, vrho_a, vrho_b, vsigma_aa, vsigma_ab, vsigma_bb]
def eval_pol(rho: Arr, sigma: Arr) -> Arr {
    nspin = 2
    nsigma = 3
    width = 6
    n = len(rho) // nspin
    out = zeros(width * n)
    for i to n {
        if rho[nspin * i] + rho[nspin * i + 1] >= DENS_THRESHOLD {
            x = gga_pol_point(rho[nspin * i], rho[nspin * i + 1], sigma[nsigma * i], sigma[nsigma * i + 1],
                              sigma[nsigma * i + 2], DENS_THRESHOLD, SIGMA_THRESHOLD)
            g = grad(_mf_pol, x)
            out[width * i] = zk_pol(x)
            for k to len(x) {
                out[width * i + 1 + k] = g[k]
            }
        }
    }
    return out
}
