from xc.core import gga_pol_point, gga_unpol_point

#| GGA_C_OPTC (libxc id 200): Optimized correlation functional of Cohen and Handy
#|| kind c, family gga, Maple script gga_exc/gga_c_optc.mpl
#~ reference: A. J. Cohen and N. C. Handy.,  Mol. Phys. 99, 607 (2001)

#: DENS_THRESHOLD  libxc's dens_threshold for this functional: smaller total densities give zero
DENS_THRESHOLD = 1.0e-12
#: SIGMA_THRESHOLD  libxc's sigma_threshold, dens_threshold^(4/3)
SIGMA_THRESHOLD = 1.0000000000000021e-16

#| the energy per particle, unpolarized: x = [rho, sigma]
def zk_unpol(x: Arr) -> Num {
    rho = x[0]
    sigma = x[1]
    r_ws = 0.6203504908994 / rho ^ (1.0 / 3.0)
    t = sqrt(r_ws)
    t_1 = r_ws ^ 2.0
    g_aux = 7.5957 * t + 3.5876 * r_ws + 1.6382 * r_ws ^ 1.5 + 0.49294 * t_1
    g = -(0.062182 * (1.0 + 0.2137 * r_ws) * log(1.0 + 1.0 / (0.062182 * g_aux)))
    xt = sqrt(sigma) / rho ^ (4.0 / 3.0)
    tt = xt / (5.039684199579493 * t)
    t_2 = tt ^ 2.0
    a = 2.697586091519874 / (exp(-(0.18 * g / 0.004452402138403639)) - 1.0)
    t_3 = tt ^ 4.0
    h0 = 0.02473556743557577 * log(1.0 + 2.697586091519874 * (t_2 + a * t_3) / (1.0 + a * t_2 + a ^ 2.0 * t_3))
    rg_c_xc = (2.568 + 23.266 * r_ws + 0.007389 * t_1) / (1000.0 * (1.0 + 8.723 * r_ws + 0.472 * t_1))
    h1 = 15.755920349483144 * (rg_c_xc - 0.002568 - -0.0007144285714285715) * t_2 * exp(-66.34364396064501 * r_ws * t_2)
    f_pw91 = g + h0 + h1
    t_4 = r_ws * 1.2599210498948732
    t_5 = sqrt(t_4)
    t_6 = t_4 ^ 1.5
    t_7 = t_4 ^ 2.0
    g_aux_1 = 7.5957 * t_5 + 3.5876 * t_4 + 1.6382 * t_6 + 0.49294 * t_7
    t_8 = 0.062182 * (1.0 + 0.2137 * t_4) * log(1.0 + 1.0 / (0.062182 * g_aux_1))
    g_1 = -t_8
    g_aux_2 = 14.1189 * t_5 + 6.1977 * t_4 + 3.3662 * t_6 + 0.62517 * t_7
    g_2 = -(0.03109 * (1.0 + 0.20548 * t_4) * log(1.0 + 1.0 / (0.03109 * g_aux_2)))
    g_aux_3 = 10.357 * t_5 + 3.6231 * t_4 + 0.88026 * t_6 + 0.49671 * t_7
    g_3 = -(0.033774 * (1.0 + 0.11125 * t_4) * log(1.0 + 1.0 / (0.033774 * g_aux_3)))
    f_pw = g_1 + 1.0 * (g_2 + t_8 + g_3 / 1.709921) - 1.0 * g_3 / 1.709921
    xs0 = sqrt(sigma / 4.0) / (rho / 2.0) ^ (4.0 / 3.0)
    tt_1 = xs0 / (4.000000000092399 * t_5)
    t_9 = tt_1 ^ 2.0
    a_1 = 2.697586091519874 / (exp(-(0.18 * f_pw / 0.002226201069356093)) - 1.0)
    t_10 = tt_1 ^ 4.0
    h0_1 = 0.012367783718644963 * log(1.0 + 2.697586091519874 * (t_9 + a_1 * t_10) / (1.0 + a_1 * t_9 + a_1 ^ 2.0 * t_10))
    rg_c_xc_1 = (2.568 + 23.266 * t_4 + 0.007389 * t_7) / (1000.0 * (1.0 + 8.723 * t_4 + 0.472 * t_7))
    h1_1 = 15.755920349483144 * (rg_c_xc_1 - 0.002568 - -0.0007144285714285715) * 0.5000000000346496 * t_9 * exp(-66.34364396064501 * t_4 * 0.3968502630287184 * t_9)
    f_pw91_1 = f_pw + h0_1 + h1_1
    t_11 = f_pw91_1 / 2.0
    optc_f2 = t_11 + t_11
    f = 1.1015 * f_pw91 + -0.43899999999999995 * optc_f2
    return f
}

#| the energy per particle, spin-polarized: x = [rho_a, rho_b, sigma_aa, sigma_ab, sigma_bb]
def zk_pol(x: Arr) -> Num {
    rho_a = x[0]
    rho_b = x[1]
    sigma_aa = x[2]
    sigma_ab = x[3]
    sigma_bb = x[4]
    dens = rho_a + rho_b
    r_ws = 0.6203504908994 / dens ^ (1.0 / 3.0)
    t = sqrt(r_ws)
    t_1 = r_ws ^ 1.5
    t_2 = r_ws ^ 2.0
    g_aux = 7.5957 * t + 3.5876 * r_ws + 1.6382 * t_1 + 0.49294 * t_2
    t_3 = 0.062182 * (1.0 + 0.2137 * r_ws) * log(1.0 + 1.0 / (0.062182 * g_aux))
    g = -t_3
    zeta = (rho_a - rho_b) / dens
    t_4 = 1.0 + zeta
    if t_4 <= 2.220446049250313e-16 {
        opz_pow_n = 1.3445809915232009e-21
    }
    else {
        opz_pow_n = t_4 ^ (4.0 / 3.0)
    }
    t_5 = 1.0 - zeta
    if t_5 <= 2.220446049250313e-16 {
        opz_pow_n_1 = 1.3445809915232009e-21
    }
    else {
        opz_pow_n_1 = t_5 ^ (4.0 / 3.0)
    }
    f_zeta = (opz_pow_n + opz_pow_n_1 - 2.0) / 0.5198420997897464
    g_aux_1 = 14.1189 * t + 6.1977 * r_ws + 3.3662 * t_1 + 0.62517 * t_2
    g_1 = -(0.03109 * (1.0 + 0.20548 * r_ws) * log(1.0 + 1.0 / (0.03109 * g_aux_1)))
    g_aux_2 = 10.357 * t + 3.6231 * r_ws + 0.88026 * t_1 + 0.49671 * t_2
    g_2 = -(0.033774 * (1.0 + 0.11125 * r_ws) * log(1.0 + 1.0 / (0.033774 * g_aux_2)))
    f_pw = g + zeta ^ 4.0 * f_zeta * (g_1 + t_3 + g_2 / 1.709921) - f_zeta * g_2 / 1.709921
    if t_4 <= 2.220446049250313e-16 {
        opz_pow_n_2 = 3.6668528625010315e-11
    }
    else {
        opz_pow_n_2 = t_4 ^ (2.0 / 3.0)
    }
    if t_5 <= 2.220446049250313e-16 {
        opz_pow_n_3 = 3.6668528625010315e-11
    }
    else {
        opz_pow_n_3 = t_5 ^ (2.0 / 3.0)
    }
    mphi = (opz_pow_n_2 + opz_pow_n_3) / 2.0
    t_6 = mphi ^ 3.0
    xt = sqrt(sigma_aa + 2.0 * sigma_ab + sigma_bb) / dens ^ (4.0 / 3.0)
    tt = xt / (5.039684199579493 * mphi * t)
    t_7 = tt ^ 2.0
    a = 2.697586091519874 / (exp(-(0.18 * f_pw / (t_6 * 0.004452402138403639))) - 1.0)
    t_8 = tt ^ 4.0
    h0 = 0.02473556743557577 * t_6 * log(1.0 + 2.697586091519874 * (t_7 + a * t_8) / (1.0 + a * t_7 + a ^ 2.0 * t_8))
    rg_c_xc = (2.568 + 23.266 * r_ws + 0.007389 * t_2) / (1000.0 * (1.0 + 8.723 * r_ws + 0.472 * t_2))
    h1 = 15.755920349483144 * (rg_c_xc - 0.002568 - -0.0007144285714285715) * t_6 * t_7 * exp(-66.34364396064501 * r_ws * mphi ^ 4.0 * t_7)
    f_pw91 = f_pw + h0 + h1
    t_9 = r_ws * (2.0 / t_4) ^ (1.0 / 3.0)
    t_10 = sqrt(t_9)
    t_11 = t_9 ^ 1.5
    t_12 = t_9 ^ 2.0
    g_aux_3 = 7.5957 * t_10 + 3.5876 * t_9 + 1.6382 * t_11 + 0.49294 * t_12
    t_13 = 0.062182 * (1.0 + 0.2137 * t_9) * log(1.0 + 1.0 / (0.062182 * g_aux_3))
    g_3 = -t_13
    g_aux_4 = 14.1189 * t_10 + 6.1977 * t_9 + 3.3662 * t_11 + 0.62517 * t_12
    g_4 = -(0.03109 * (1.0 + 0.20548 * t_9) * log(1.0 + 1.0 / (0.03109 * g_aux_4)))
    g_aux_5 = 10.357 * t_10 + 3.6231 * t_9 + 0.88026 * t_11 + 0.49671 * t_12
    g_5 = -(0.033774 * (1.0 + 0.11125 * t_9) * log(1.0 + 1.0 / (0.033774 * g_aux_5)))
    f_pw_1 = g_3 + 1.0 * (g_4 + t_13 + g_5 / 1.709921) - 1.0 * g_5 / 1.709921
    xs0 = sqrt(sigma_aa) / rho_a ^ (4.0 / 3.0)
    tt_1 = xs0 / (4.000000000092399 * t_10)
    t_14 = tt_1 ^ 2.0
    a_1 = 2.697586091519874 / (exp(-(0.18 * f_pw_1 / 0.002226201069356093)) - 1.0)
    t_15 = tt_1 ^ 4.0
    h0_1 = 0.012367783718644963 * log(1.0 + 2.697586091519874 * (t_14 + a_1 * t_15) / (1.0 + a_1 * t_14 + a_1 ^ 2.0 * t_15))
    rg_c_xc_1 = (2.568 + 23.266 * t_9 + 0.007389 * t_12) / (1000.0 * (1.0 + 8.723 * t_9 + 0.472 * t_12))
    h1_1 = 15.755920349483144 * (rg_c_xc_1 - 0.002568 - -0.0007144285714285715) * 0.5000000000346496 * t_14 * exp(-66.34364396064501 * t_9 * 0.3968502630287184 * t_14)
    f_pw91_1 = f_pw_1 + h0_1 + h1_1
    if t_4 <= 2.220446049250313e-16 {
        opz_pow_n_4 = 2.220446049250313e-16
    }
    else {
        opz_pow_n_4 = t_4
    }
    t_16 = r_ws * (2.0 / t_5) ^ (1.0 / 3.0)
    t_17 = sqrt(t_16)
    t_18 = t_16 ^ 1.5
    t_19 = t_16 ^ 2.0
    g_aux_6 = 7.5957 * t_17 + 3.5876 * t_16 + 1.6382 * t_18 + 0.49294 * t_19
    t_20 = 0.062182 * (1.0 + 0.2137 * t_16) * log(1.0 + 1.0 / (0.062182 * g_aux_6))
    g_6 = -t_20
    g_aux_7 = 14.1189 * t_17 + 6.1977 * t_16 + 3.3662 * t_18 + 0.62517 * t_19
    g_7 = -(0.03109 * (1.0 + 0.20548 * t_16) * log(1.0 + 1.0 / (0.03109 * g_aux_7)))
    g_aux_8 = 10.357 * t_17 + 3.6231 * t_16 + 0.88026 * t_18 + 0.49671 * t_19
    g_8 = -(0.033774 * (1.0 + 0.11125 * t_16) * log(1.0 + 1.0 / (0.033774 * g_aux_8)))
    f_pw_2 = g_6 + 1.0 * (g_7 + t_20 + g_8 / 1.709921) - 1.0 * g_8 / 1.709921
    xs1 = sqrt(sigma_bb) / rho_b ^ (4.0 / 3.0)
    tt_2 = xs1 / (4.000000000092399 * t_17)
    t_21 = tt_2 ^ 2.0
    a_2 = 2.697586091519874 / (exp(-(0.18 * f_pw_2 / 0.002226201069356093)) - 1.0)
    t_22 = tt_2 ^ 4.0
    h0_2 = 0.012367783718644963 * log(1.0 + 2.697586091519874 * (t_21 + a_2 * t_22) / (1.0 + a_2 * t_21 + a_2 ^ 2.0 * t_22))
    rg_c_xc_2 = (2.568 + 23.266 * t_16 + 0.007389 * t_19) / (1000.0 * (1.0 + 8.723 * t_16 + 0.472 * t_19))
    h1_2 = 15.755920349483144 * (rg_c_xc_2 - 0.002568 - -0.0007144285714285715) * 0.5000000000346496 * t_21 * exp(-66.34364396064501 * t_16 * 0.3968502630287184 * t_21)
    f_pw91_2 = f_pw_2 + h0_2 + h1_2
    if t_5 <= 2.220446049250313e-16 {
        opz_pow_n_5 = 2.220446049250313e-16
    }
    else {
        opz_pow_n_5 = t_5
    }
    optc_f2 = f_pw91_1 * opz_pow_n_4 / 2.0 + f_pw91_2 * opz_pow_n_5 / 2.0
    f = 1.1015 * f_pw91 + -0.43899999999999995 * optc_f2
    return f
}

#| the energy per volume, unpolarized: libxc's mf, whose gradient is [vrho, vsigma]
def _mf_unpol(x: Arr) -> Num {
    return x[0] * zk_unpol(x)
}

#| the energy per volume, spin-polarized
def _mf_pol(x: Arr) -> Num {
    return (x[0] + x[1]) * zk_pol(x)
}

#| libxc's xc_gga_exc_vxc, unpolarized: per point [zk, vrho, vsigma]
def eval_unpol(rho: Arr, sigma: Arr) -> Arr {
    n = len(rho)
    width = 3
    out = zeros(width * n)
    for i to n {
        if rho[i] >= DENS_THRESHOLD {
            x = gga_unpol_point(rho[i], sigma[i], DENS_THRESHOLD, SIGMA_THRESHOLD)
            g = grad(_mf_unpol, x)
            out[width * i] = zk_unpol(x)
            out[width * i + 1] = g[0]
            out[width * i + 2] = g[1]
        }
    }
    return out
}

#| libxc's xc_gga_exc_vxc, spin-polarized: rho = [a, b], sigma = [aa, ab, bb] per point;
#| out [zk, vrho_a, vrho_b, vsigma_aa, vsigma_ab, vsigma_bb]
def eval_pol(rho: Arr, sigma: Arr) -> Arr {
    nspin = 2
    nsigma = 3
    width = 6
    n = len(rho) // nspin
    out = zeros(width * n)
    for i to n {
        if rho[nspin * i] + rho[nspin * i + 1] >= DENS_THRESHOLD {
            x = gga_pol_point(rho[nspin * i], rho[nspin * i + 1], sigma[nsigma * i], sigma[nsigma * i + 1],
                              sigma[nsigma * i + 2], DENS_THRESHOLD, SIGMA_THRESHOLD)
            g = grad(_mf_pol, x)
            out[width * i] = zk_pol(x)
            for k to len(x) {
                out[width * i + 1 + k] = g[k]
            }
        }
    }
    return out
}
