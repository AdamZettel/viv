from xc.core import gga_pol_point, gga_unpol_point

#| GGA_C_PBE_VWN (libxc id 216): Perdew, Burke & Ernzerhof based on VWN correlation
#|| kind c, family gga, Maple script gga_exc/gga_c_pbe_vwn.mpl
#~ reference: E. Kraisler, G. Makov, and I. Kelson.,  Phys. Rev. A 82, 042516 (2010)
#~ reference: J. P. Perdew, K. Burke, and M. Ernzerhof.,  Phys. Rev. Lett. 77, 3865 (1996)
#~ reference: J. P. Perdew, K. Burke, and M. Ernzerhof.,  Phys. Rev. Lett. 78, 1396 (1997)

#: DENS_THRESHOLD  libxc's dens_threshold for this functional: smaller total densities give zero
DENS_THRESHOLD = 1.0e-12
#: SIGMA_THRESHOLD  libxc's sigma_threshold, dens_threshold^(4/3)
SIGMA_THRESHOLD = 1.0000000000000021e-16

#| the energy per particle, unpolarized: x = [rho, sigma]
def zk_unpol(x: Arr) -> Num {
    rho = x[0]
    sigma = x[1]
    r_ws = 0.6203504908994 / rho ^ (1.0 / 3.0)
    t = sqrt(r_ws)
    fx_vwn = r_ws + 3.72744 * t + 12.9352
    f_aux = 0.0310907 * (log(r_ws / fx_vwn) + 1.2474243062431214 * atan(6.15199081975908 / (2.0 * t + 3.72744)) - -0.031167608678943783 * log((t - -0.10498) ^ 2.0 / fx_vwn))
    xt = sqrt(sigma) / rho ^ (4.0 / 3.0)
    tt = xt / (5.039684199579493 * t)
    a = 0.06672455060314922 / (0.031090690869654894 * (exp(-(f_aux / 0.031090690869654894)) - 1.0))
    f1 = tt ^ 2.0 + a * tt ^ 4.0
    f2 = 0.06672455060314922 * f1 / (0.031090690869654894 * (1.0 + a * f1))
    fh = 0.031090690869654894 * log(1.0 + f2)
    f_pbe = f_aux + fh
    return f_pbe
}

#| the energy per particle, spin-polarized: x = [rho_a, rho_b, sigma_aa, sigma_ab, sigma_bb]
def zk_pol(x: Arr) -> Num {
    rho_a = x[0]
    rho_b = x[1]
    sigma_aa = x[2]
    sigma_ab = x[3]
    sigma_bb = x[4]
    dens = rho_a + rho_b
    r_ws = 0.6203504908994 / dens ^ (1.0 / 3.0)
    t = sqrt(r_ws)
    fx_vwn = r_ws + 3.72744 * t + 12.9352
    t_1 = 2.0 * t
    f_aux = 0.0310907 * (log(r_ws / fx_vwn) + 1.2474243062431214 * atan(6.15199081975908 / (t_1 + 3.72744)) - -0.031167608678943783 * log((t - -0.10498) ^ 2.0 / fx_vwn))
    fx_vwn_1 = r_ws + 1.13107 * t + 13.0045
    f_aux_1 = -0.01688686394038963 * (log(r_ws / fx_vwn_1) + 0.31770800474394145 * atan(7.123108917818118 / (t_1 + 1.13107)) - -0.00041403379428206277 * log((t - -0.0047584) ^ 2.0 / fx_vwn_1))
    zeta = (rho_a - rho_b) / dens
    t_2 = 1.0 + zeta
    if t_2 <= 2.220446049250313e-16 {
        opz_pow_n = 1.3445809915232009e-21
    }
    else {
        opz_pow_n = t_2 ^ (4.0 / 3.0)
    }
    t_3 = 1.0 - zeta
    if t_3 <= 2.220446049250313e-16 {
        opz_pow_n_1 = 1.3445809915232009e-21
    }
    else {
        opz_pow_n_1 = t_3 ^ (4.0 / 3.0)
    }
    f_zeta = (opz_pow_n + opz_pow_n_1 - 2.0) / 0.5198420997897464
    t_4 = zeta ^ 4.0
    fx_vwn_2 = r_ws + 7.06042 * t + 18.0578
    f_aux_2 = 0.01554535 * (log(r_ws / fx_vwn_2) + 3.3766620352569054 * atan(4.730926909560113 / (t_1 + 7.06042)) - -0.14460061018520726 * log((t - -0.325) ^ 2.0 / fx_vwn_2))
    dmc = f_aux_2 - f_aux
    f_vwn = f_aux + f_aux_1 * f_zeta * (1.0 - t_4) / 1.7099209341613657 + dmc * f_zeta * t_4
    if t_2 <= 2.220446049250313e-16 {
        opz_pow_n_2 = 3.6668528625010315e-11
    }
    else {
        opz_pow_n_2 = t_2 ^ (2.0 / 3.0)
    }
    if t_3 <= 2.220446049250313e-16 {
        opz_pow_n_3 = 3.6668528625010315e-11
    }
    else {
        opz_pow_n_3 = t_3 ^ (2.0 / 3.0)
    }
    mphi = (opz_pow_n_2 + opz_pow_n_3) / 2.0
    t_5 = 0.031090690869654894 * mphi ^ 3.0
    xt = sqrt(sigma_aa + 2.0 * sigma_ab + sigma_bb) / dens ^ (4.0 / 3.0)
    tt = xt / (5.039684199579493 * mphi * t)
    a = 0.06672455060314922 / (0.031090690869654894 * (exp(-(f_vwn / t_5)) - 1.0))
    f1 = tt ^ 2.0 + a * tt ^ 4.0
    f2 = 0.06672455060314922 * f1 / (0.031090690869654894 * (1.0 + a * f1))
    fh = t_5 * log(1.0 + f2)
    f_pbe = f_vwn + fh
    return f_pbe
}

#| the energy per volume, unpolarized: libxc's mf, whose gradient is [vrho, vsigma]
def _mf_unpol(x: Arr) -> Num {
    return x[0] * zk_unpol(x)
}

#| the energy per volume, spin-polarized
def _mf_pol(x: Arr) -> Num {
    return (x[0] + x[1]) * zk_pol(x)
}

#| libxc's xc_gga_exc_vxc, unpolarized: per point [zk, vrho, vsigma]
def eval_unpol(rho: Arr, sigma: Arr) -> Arr {
    n = len(rho)
    width = 3
    out = zeros(width * n)
    for i to n {
        if rho[i] >= DENS_THRESHOLD {
            x = gga_unpol_point(rho[i], sigma[i], DENS_THRESHOLD, SIGMA_THRESHOLD)
            g = grad(_mf_unpol, x)
            out[width * i] = zk_unpol(x)
            out[width * i + 1] = g[0]
            out[width * i + 2] = g[1]
        }
    }
    return out
}

#| libxc's xc_gga_exc_vxc, spin-polarized: rho = [a, b], sigma = [aa, ab, bb] per point;
#| out [zk, vrho_a, vrho_b, vsigma_aa, vsigma_ab, vsigma_bb]
def eval_pol(rho: Arr, sigma: Arr) -> Arr {
    nspin = 2
    nsigma = 3
    width = 6
    n = len(rho) // nspin
    out = zeros(width * n)
    for i to n {
        if rho[nspin * i] + rho[nspin * i + 1] >= DENS_THRESHOLD {
            x = gga_pol_point(rho[nspin * i], rho[nspin * i + 1], sigma[nsigma * i], sigma[nsigma * i + 1],
                              sigma[nsigma * i + 2], DENS_THRESHOLD, SIGMA_THRESHOLD)
            g = grad(_mf_pol, x)
            out[width * i] = zk_pol(x)
            for k to len(x) {
                out[width * i + 1 + k] = g[k]
            }
        }
    }
    return out
}
