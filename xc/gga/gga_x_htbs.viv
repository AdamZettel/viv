from xc.core import gga_pol_point, gga_unpol_point

#| GGA_X_HTBS (libxc id 191): Haas, Tran, Blaha, and Schwarz
#|| kind x, family gga, Maple script gga_exc/gga_x_htbs.mpl
#~ reference: P. Haas, F. Tran, P. Blaha, and K. Schwarz.,  Phys. Rev. B 83, 205117 (2011)

#: DENS_THRESHOLD  libxc's dens_threshold for this functional: smaller total densities give zero
DENS_THRESHOLD = 1.0e-15
#: SIGMA_THRESHOLD  libxc's sigma_threshold, dens_threshold^(4/3)
SIGMA_THRESHOLD = 1.0000000000000027e-20

#| the energy per particle, unpolarized: x = [rho, sigma]
def zk_unpol(x: Arr) -> Num {
    rho = x[0]
    sigma = x[1]
    t = rho / 2.0
    if t <= 1.0e-15 {
        branch = 0.0
    }
    else {
        r_ws = 0.6203504908994 / rho ^ (1.0 / 3.0)
        lda_x_spin = -0.3692793831910112 * 0.6203504908994 / r_ws
        xs0 = sqrt(sigma / 4.0) / t ^ (4.0 / 3.0)
        t_1 = 0.1282782438530422 * xs0
        if t_1 < 0.6 {
            t_2 = t_1 ^ 2.0
            t_3 = t_1 ^ 4.0
            wc_f0_aux = 0.804 + 0.12345679012345678 * t_2 + 0.09605818264106031 * t_2 * exp(-t_2) + log(1.0 + 0.00793746933516182 * t_3)
            wc_f0 = 1.0 + 0.804 * (1.0 - 0.804 / wc_f0_aux)
            htbs_f0 = wc_f0
        }
        else {
            if t_1 > 2.6 {
                t_4 = t_1 ^ 2.0
                rpbe_f0 = 1.0 + 0.804 * (1.0 - exp(-(0.21951497276451706 * t_4 / 0.804)))
                branch_1 = rpbe_f0
            }
            else {
                t_5 = t_1 ^ 2.0
                t_6 = t_1 ^ 4.0
                htbs_g = -0.40608 + 2.2815 * t_1 + -4.68 * t_5 + 4.175 * t_1 ^ 3.0 + -1.5 * t_6 + 0.1875 * t_1 ^ 5.0
                rpbe_f0_1 = 1.0 + 0.804 * (1.0 - exp(-(0.21951497276451706 * t_5 / 0.804)))
                wc_f0_aux_1 = 0.804 + 0.12345679012345678 * t_5 + 0.09605818264106031 * t_5 * exp(-t_5) + log(1.0 + 0.00793746933516182 * t_6)
                wc_f0_1 = 1.0 + 0.804 * (1.0 - 0.804 / wc_f0_aux_1)
                branch_1 = htbs_g * rpbe_f0_1 + (1.0 - htbs_g) * wc_f0_1
            }
            htbs_f0 = branch_1
        }
        branch = lda_x_spin * htbs_f0
    }
    gga_exchange = branch + branch
    return gga_exchange
}

#| the energy per particle, spin-polarized: x = [rho_a, rho_b, sigma_aa, sigma_ab, sigma_bb]
def zk_pol(x: Arr) -> Num {
    rho_a = x[0]
    rho_b = x[1]
    sigma_aa = x[2]
    sigma_ab = x[3]
    sigma_bb = x[4]
    if rho_a <= 1.0e-15 {
        branch = 0.0
    }
    else {
        dens = rho_a + rho_b
        t = 1.0 / dens
        if 2.0 * rho_a * t <= 2.220446049250313e-16 {
            z_thr = -0.9999999999999998
        }
        else {
            if 2.0 * rho_b * t <= 2.220446049250313e-16 {
                branch_1 = 0.9999999999999998
            }
            else {
                zeta = (rho_a - rho_b) / dens
                branch_1 = zeta
            }
            z_thr = branch_1
        }
        t_1 = 1.0 + z_thr
        if t_1 <= 2.220446049250313e-16 {
            opz_pow_n = 1.3445809915232009e-21
        }
        else {
            opz_pow_n = t_1 ^ (4.0 / 3.0)
        }
        r_ws = 0.6203504908994 / dens ^ (1.0 / 3.0)
        t_2 = 0.6203504908994 / r_ws
        lda_x_spin = -0.9305257363491001 * opz_pow_n * 0.3968502629920499 * t_2
        xs0 = sqrt(sigma_aa) / rho_a ^ (4.0 / 3.0)
        t_3 = 0.1282782438530422 * xs0
        if t_3 < 0.6 {
            t_4 = t_3 ^ 2.0
            t_5 = t_3 ^ 4.0
            wc_f0_aux = 0.804 + 0.12345679012345678 * t_4 + 0.09605818264106031 * t_4 * exp(-t_4) + log(1.0 + 0.00793746933516182 * t_5)
            wc_f0 = 1.0 + 0.804 * (1.0 - 0.804 / wc_f0_aux)
            htbs_f0 = wc_f0
        }
        else {
            if t_3 > 2.6 {
                t_6 = t_3 ^ 2.0
                rpbe_f0 = 1.0 + 0.804 * (1.0 - exp(-(0.21951497276451706 * t_6 / 0.804)))
                branch_2 = rpbe_f0
            }
            else {
                t_7 = t_3 ^ 2.0
                t_8 = t_3 ^ 4.0
                htbs_g = -0.40608 + 2.2815 * t_3 + -4.68 * t_7 + 4.175 * t_3 ^ 3.0 + -1.5 * t_8 + 0.1875 * t_3 ^ 5.0
                rpbe_f0_1 = 1.0 + 0.804 * (1.0 - exp(-(0.21951497276451706 * t_7 / 0.804)))
                wc_f0_aux_1 = 0.804 + 0.12345679012345678 * t_7 + 0.09605818264106031 * t_7 * exp(-t_7) + log(1.0 + 0.00793746933516182 * t_8)
                wc_f0_1 = 1.0 + 0.804 * (1.0 - 0.804 / wc_f0_aux_1)
                branch_2 = htbs_g * rpbe_f0_1 + (1.0 - htbs_g) * wc_f0_1
            }
            htbs_f0 = branch_2
        }
        branch = lda_x_spin * htbs_f0
    }
    if rho_b <= 1.0e-15 {
        branch_3 = 0.0
    }
    else {
        dens_1 = rho_a + rho_b
        t_9 = 1.0 / dens_1
        if 2.0 * rho_b * t_9 <= 2.220446049250313e-16 {
            z_thr_1 = -0.9999999999999998
        }
        else {
            if 2.0 * rho_a * t_9 <= 2.220446049250313e-16 {
                branch_4 = 0.9999999999999998
            }
            else {
                zeta_1 = (rho_a - rho_b) / dens_1
                branch_4 = -zeta_1
            }
            z_thr_1 = branch_4
        }
        t_10 = 1.0 + z_thr_1
        if t_10 <= 2.220446049250313e-16 {
            opz_pow_n_1 = 1.3445809915232009e-21
        }
        else {
            opz_pow_n_1 = t_10 ^ (4.0 / 3.0)
        }
        r_ws_1 = 0.6203504908994 / dens_1 ^ (1.0 / 3.0)
        t_11 = 0.6203504908994 / r_ws_1
        lda_x_spin_1 = -0.9305257363491001 * opz_pow_n_1 * 0.3968502629920499 * t_11
        xs1 = sqrt(sigma_bb) / rho_b ^ (4.0 / 3.0)
        t_12 = 0.1282782438530422 * xs1
        if t_12 < 0.6 {
            t_13 = t_12 ^ 2.0
            t_14 = t_12 ^ 4.0
            wc_f0_aux_2 = 0.804 + 0.12345679012345678 * t_13 + 0.09605818264106031 * t_13 * exp(-t_13) + log(1.0 + 0.00793746933516182 * t_14)
            wc_f0_2 = 1.0 + 0.804 * (1.0 - 0.804 / wc_f0_aux_2)
            htbs_f0_1 = wc_f0_2
        }
        else {
            if t_12 > 2.6 {
                t_15 = t_12 ^ 2.0
                rpbe_f0_2 = 1.0 + 0.804 * (1.0 - exp(-(0.21951497276451706 * t_15 / 0.804)))
                branch_5 = rpbe_f0_2
            }
            else {
                t_16 = t_12 ^ 2.0
                t_17 = t_12 ^ 4.0
                htbs_g_1 = -0.40608 + 2.2815 * t_12 + -4.68 * t_16 + 4.175 * t_12 ^ 3.0 + -1.5 * t_17 + 0.1875 * t_12 ^ 5.0
                rpbe_f0_3 = 1.0 + 0.804 * (1.0 - exp(-(0.21951497276451706 * t_16 / 0.804)))
                wc_f0_aux_3 = 0.804 + 0.12345679012345678 * t_16 + 0.09605818264106031 * t_16 * exp(-t_16) + log(1.0 + 0.00793746933516182 * t_17)
                wc_f0_3 = 1.0 + 0.804 * (1.0 - 0.804 / wc_f0_aux_3)
                branch_5 = htbs_g_1 * rpbe_f0_3 + (1.0 - htbs_g_1) * wc_f0_3
            }
            htbs_f0_1 = branch_5
        }
        branch_3 = lda_x_spin_1 * htbs_f0_1
    }
    gga_exchange = branch + branch_3
    return gga_exchange
}

#| the energy per volume, unpolarized: libxc's mf, whose gradient is [vrho, vsigma]
def _mf_unpol(x: Arr) -> Num {
    return x[0] * zk_unpol(x)
}

#| the energy per volume, spin-polarized
def _mf_pol(x: Arr) -> Num {
    return (x[0] + x[1]) * zk_pol(x)
}

#| libxc's xc_gga_exc_vxc, unpolarized: per point [zk, vrho, vsigma]
def eval_unpol(rho: Arr, sigma: Arr) -> Arr {
    n = len(rho)
    width = 3
    out = zeros(width * n)
    for i to n {
        if rho[i] >= DENS_THRESHOLD {
            x = gga_unpol_point(rho[i], sigma[i], DENS_THRESHOLD, SIGMA_THRESHOLD)
            g = grad(_mf_unpol, x)
            out[width * i] = zk_unpol(x)
            out[width * i + 1] = g[0]
            out[width * i + 2] = g[1]
        }
    }
    return out
}

#| libxc's xc_gga_exc_vxc, spin-polarized: rho = [a, b], sigma = [aa, ab, bb] per point;
#| out [zk, vrho_a, vrho_b, vsigma_aa, vsigma_ab, vsigma_bb]
def eval_pol(rho: Arr, sigma: Arr) -> Arr {
    nspin = 2
    nsigma = 3
    width = 6
    n = len(rho) // nspin
    out = zeros(width * n)
    for i to n {
        if rho[nspin * i] + rho[nspin * i + 1] >= DENS_THRESHOLD {
            x = gga_pol_point(rho[nspin * i], rho[nspin * i + 1], sigma[nsigma * i], sigma[nsigma * i + 1],
                              sigma[nsigma * i + 2], DENS_THRESHOLD, SIGMA_THRESHOLD)
            g = grad(_mf_pol, x)
            out[width * i] = zk_pol(x)
            for k to len(x) {
                out[width * i + 1 + k] = g[k]
            }
        }
    }
    return out
}
