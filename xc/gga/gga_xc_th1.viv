from xc.core import gga_pol_point, gga_unpol_point

#| GGA_XC_TH1 (libxc id 154): Tozer and Handy v. 1
#|| kind xc, family gga, Maple script gga_exc/gga_xc_th1.mpl
#~ reference: D. J. Tozer and N. C. Handy.,  J. Chem. Phys. 108, 2545 (1998)

#: DENS_THRESHOLD  libxc's dens_threshold for this functional: smaller total densities give zero
DENS_THRESHOLD = 1.0e-15
#: SIGMA_THRESHOLD  libxc's sigma_threshold, dens_threshold^(4/3)
SIGMA_THRESHOLD = 1.0000000000000027e-20

#| the energy per particle, unpolarized: x = [rho, sigma]
def zk_unpol(x: Arr) -> Num {
    rho = x[0]
    sigma = x[1]
    t = rho / 2.0
    t_1 = t ^ (7.0 / 6.0)
    t_2 = t ^ (4.0 / 3.0)
    t_3 = t_2 + t_2
    t_4 = t ^ (3.0 / 2.0)
    t_5 = t_4 + t_4
    t_6 = t ^ (5.0 / 3.0)
    t_7 = t_6 + t_6
    xs0 = sqrt(sigma / 4.0) / t_2
    xx = xs0 * 0.3968502629920499
    t_8 = xx + xx
    t_9 = t ^ (11.0 / 6.0)
    t_10 = t_9 + t_9
    t_11 = xx ^ 2.0
    t_12 = t_11 + t_11
    t_13 = t ^ 2.0
    t_14 = t_13 + t_13
    xt = sqrt(sigma) / rho ^ (4.0 / 3.0)
    yy = 2.0 * t_12 - xt ^ 2.0
    f_th = (-0.728255 * (t_1 + t_1) / 2.0 * 2.0 + 0.331699 * t_3 / 2.0 * 2.0 + -1.02946 * t_5 / 2.0 * 2.0 + 0.235703 * t_7 / 2.0 * 2.0 + -0.0876221 * t_3 / 2.0 * t_8 + 0.140854 * t_5 / 2.0 * t_8 + 0.0336982 * t_7 / 2.0 * t_8 + -0.0353615 * t_10 / 2.0 * t_8 + 0.0049793 * t_5 / 2.0 * t_12 + -0.06459 * t_7 / 2.0 * t_12 + 0.0461795 * t_10 / 2.0 * t_12 + -0.00757191 * t_14 / 2.0 * t_12 + -0.00242717 * t_5 / 2.0 * 2.0 * yy + 0.042814 * t_7 / 2.0 * 2.0 * yy + -0.0744891 * t_10 / 2.0 * 2.0 * yy + 0.0386577 * t_14 / 2.0 * 2.0 * yy + 0.128877 * (t + t) / 2.0 * 2.0) / rho
    return f_th
}

#| the energy per particle, spin-polarized: x = [rho_a, rho_b, sigma_aa, sigma_ab, sigma_bb]
def zk_pol(x: Arr) -> Num {
    rho_a = x[0]
    rho_b = x[1]
    sigma_aa = x[2]
    sigma_ab = x[3]
    sigma_bb = x[4]
    t = rho_a ^ (7.0 / 6.0) + rho_b ^ (7.0 / 6.0)
    t_1 = rho_a ^ (4.0 / 3.0)
    t_2 = rho_b ^ (4.0 / 3.0)
    t_3 = t_1 + t_2
    t_4 = rho_a ^ (3.0 / 2.0) + rho_b ^ (3.0 / 2.0)
    t_5 = rho_a ^ (5.0 / 3.0) + rho_b ^ (5.0 / 3.0)
    xs0 = sqrt(sigma_aa) / t_1
    dens = rho_a + rho_b
    zeta = (rho_a - rho_b) / dens
    t_6 = 1.0 + zeta
    if t_6 <= 2.220446049250313e-16 {
        opz_pow_n = 1.3445809915232009e-21
    }
    else {
        opz_pow_n = t_6 ^ (4.0 / 3.0)
    }
    xx = xs0 * opz_pow_n * 0.3968502629920499
    xs1 = sqrt(sigma_bb) / t_2
    t_7 = 1.0 - zeta
    if t_7 <= 2.220446049250313e-16 {
        opz_pow_n_1 = 1.3445809915232009e-21
    }
    else {
        opz_pow_n_1 = t_7 ^ (4.0 / 3.0)
    }
    xx_1 = xs1 * opz_pow_n_1 * 0.3968502629920499
    t_8 = xx + xx_1
    t_9 = rho_a ^ (11.0 / 6.0) + rho_b ^ (11.0 / 6.0)
    t_10 = xx ^ 2.0 + xx_1 ^ 2.0
    t_11 = rho_a ^ 2.0 + rho_b ^ 2.0
    xt = sqrt(sigma_aa + 2.0 * sigma_ab + sigma_bb) / dens ^ (4.0 / 3.0)
    yy = 2.0 * t_10 - xt ^ 2.0
    t_12 = zeta ^ 2.0
    f_th = (-0.728255 * t / 2.0 * 2.0 + 0.331699 * t_3 / 2.0 * 2.0 + -1.02946 * t_4 / 2.0 * 2.0 + 0.235703 * t_5 / 2.0 * 2.0 + -0.0876221 * t_3 / 2.0 * t_8 + 0.140854 * t_4 / 2.0 * t_8 + 0.0336982 * t_5 / 2.0 * t_8 + -0.0353615 * t_9 / 2.0 * t_8 + 0.0049793 * t_4 / 2.0 * t_10 + -0.06459 * t_5 / 2.0 * t_10 + 0.0461795 * t_9 / 2.0 * t_10 + -0.00757191 * t_11 / 2.0 * t_10 + -0.00242717 * t_4 / 2.0 * 2.0 * yy + 0.042814 * t_5 / 2.0 * 2.0 * yy + -0.0744891 * t_9 / 2.0 * 2.0 * yy + 0.0386577 * t_11 / 2.0 * 2.0 * yy + -0.352519 * t * t_12 / 2.0 * 2.0 + 2.19805 * t_3 * t_12 / 2.0 * 2.0 + -3.72927 * t_4 * t_12 / 2.0 * 2.0 + 1.94441 * t_5 * t_12 / 2.0 * 2.0 + 0.128877 * dens / 2.0 * 2.0) / dens
    return f_th
}

#| the energy per volume, unpolarized: libxc's mf, whose gradient is [vrho, vsigma]
def _mf_unpol(x: Arr) -> Num {
    return x[0] * zk_unpol(x)
}

#| the energy per volume, spin-polarized
def _mf_pol(x: Arr) -> Num {
    return (x[0] + x[1]) * zk_pol(x)
}

#| libxc's xc_gga_exc_vxc, unpolarized: per point [zk, vrho, vsigma]
def eval_unpol(rho: Arr, sigma: Arr) -> Arr {
    n = len(rho)
    width = 3
    out = zeros(width * n)
    for i to n {
        if rho[i] >= DENS_THRESHOLD {
            x = gga_unpol_point(rho[i], sigma[i], DENS_THRESHOLD, SIGMA_THRESHOLD)
            g = grad(_mf_unpol, x)
            out[width * i] = zk_unpol(x)
            out[width * i + 1] = g[0]
            out[width * i + 2] = g[1]
        }
    }
    return out
}

#| libxc's xc_gga_exc_vxc, spin-polarized: rho = [a, b], sigma = [aa, ab, bb] per point;
#| out [zk, vrho_a, vrho_b, vsigma_aa, vsigma_ab, vsigma_bb]
def eval_pol(rho: Arr, sigma: Arr) -> Arr {
    nspin = 2
    nsigma = 3
    width = 6
    n = len(rho) // nspin
    out = zeros(width * n)
    for i to n {
        if rho[nspin * i] + rho[nspin * i + 1] >= DENS_THRESHOLD {
            x = gga_pol_point(rho[nspin * i], rho[nspin * i + 1], sigma[nsigma * i], sigma[nsigma * i + 1],
                              sigma[nsigma * i + 2], DENS_THRESHOLD, SIGMA_THRESHOLD)
            g = grad(_mf_pol, x)
            out[width * i] = zk_pol(x)
            for k to len(x) {
                out[width * i + 1 + k] = g[k]
            }
        }
    }
    return out
}
