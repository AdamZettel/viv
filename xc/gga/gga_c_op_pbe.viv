from xc.core import gga_pol_point, gga_unpol_point

#| GGA_C_OP_PBE (libxc id 86): one-parameter progressive functional (PBE version)
#|| kind c, family gga, Maple script gga_exc/gga_c_op_pbe.mpl
#~ reference: T. Tsuneda, T. Suzumura, and K. Hirao.,  J. Chem. Phys. 110, 10664 (1999)
#~ reference: T. Tsuneda, T. Suzumura, and K. Hirao.,  J. Chem. Phys. 111, 5656-5667 (1999)

#: DENS_THRESHOLD  libxc's dens_threshold for this functional: smaller total densities give zero
DENS_THRESHOLD = 1.0e-14
#: SIGMA_THRESHOLD  libxc's sigma_threshold, dens_threshold^(4/3)
SIGMA_THRESHOLD = 2.1544346900318888e-19

#| the energy per particle, unpolarized: x = [rho, sigma]
def zk_unpol(x: Arr) -> Num {
    rho = x[0]
    sigma = x[1]
    t = rho / 2.0
    if t <= 1.0e-14 and t <= 1.0e-14 {
        op_f = 0.0
    }
    else {
        if t <= 1.0e-14 {
            branch = 0.0
        }
        else {
            xs0 = sqrt(sigma / 4.0) / t ^ (4.0 / 3.0)
            pbe_f0 = 1.0 + 0.804 * (1.0 - 0.804 / (0.804 + 0.2195149727645171 * (0.1282782438530422 * xs0) ^ 2.0))
            b88_r_f = 1.0 / (1.8610514726982001 * t ^ (1.0 / 3.0) * pbe_f0)
            branch = b88_r_f
        }
        b88_zab = branch + branch
        if b88_zab == 0.0 {
            op_b88_zab = 2.220446049250313e-16
        }
        else {
            op_b88_zab = b88_zab
        }
        op_beta = 2.3789 / op_b88_zab
        op_f_s = -(rho / 4.0 * (1.5214 * op_beta + 0.5764) / (op_beta ^ 4.0 + 1.1284 * op_beta ^ 3.0 + 0.3183 * op_beta ^ 2.0))
        op_f = op_f_s
    }
    return op_f
}

#| the energy per particle, spin-polarized: x = [rho_a, rho_b, sigma_aa, sigma_ab, sigma_bb]
def zk_pol(x: Arr) -> Num {
    rho_a = x[0]
    rho_b = x[1]
    sigma_aa = x[2]
    sigma_ab = x[3]
    sigma_bb = x[4]
    dens = rho_a + rho_b
    zeta = (rho_a - rho_b) / dens
    if 1.0 - abs(zeta) <= 2.220446049250313e-16 or rho_a <= 1.0e-14 and rho_b <= 1.0e-14 {
        op_f = 0.0
    }
    else {
        if 1.0 + zeta <= 2.220446049250313e-16 {
            z_thr = -0.9999999999999998
        }
        else {
            if 1.0 - zeta <= 2.220446049250313e-16 {
                branch = 0.9999999999999998
            }
            else {
                branch = zeta
            }
            z_thr = branch
        }
        t = 1.0 / dens
        if 2.0 * rho_a * t <= 2.220446049250313e-16 {
            z_thr_1 = -0.9999999999999998
        }
        else {
            if 2.0 * rho_b * t <= 2.220446049250313e-16 {
                branch_1 = 0.9999999999999998
            }
            else {
                branch_1 = zeta
            }
            z_thr_1 = branch_1
        }
        t_1 = 1.0 + z_thr_1
        n_spin = t_1 * dens / 2.0
        if n_spin <= 1.0e-14 {
            branch_2 = 0.0
        }
        else {
            if t_1 <= 2.220446049250313e-16 {
                z_thr_2 = -0.9999999999999998
            }
            else {
                t_2 = 1.0 - z_thr_1
                if t_2 <= 2.220446049250313e-16 {
                    branch_3 = 0.9999999999999998
                }
                else {
                    branch_3 = z_thr_1
                }
                z_thr_2 = branch_3
            }
            n_spin_1 = (1.0 + z_thr_2) * dens / 2.0
            xs0 = sqrt(sigma_aa) / rho_a ^ (4.0 / 3.0)
            pbe_f0 = 1.0 + 0.804 * (1.0 - 0.804 / (0.804 + 0.2195149727645171 * (0.1282782438530422 * xs0) ^ 2.0))
            b88_r_f = 1.0 / (1.8610514726982001 * n_spin_1 ^ (1.0 / 3.0) * pbe_f0)
            branch_2 = b88_r_f
        }
        t_3 = 1.0 - z_thr_1
        n_spin_2 = t_3 * dens / 2.0
        if n_spin_2 <= 1.0e-14 {
            branch_4 = 0.0
        }
        else {
            if t_3 <= 2.220446049250313e-16 {
                z_thr_3 = -0.9999999999999998
            }
            else {
                if t_1 <= 2.220446049250313e-16 {
                    branch_5 = 0.9999999999999998
                }
                else {
                    branch_5 = -z_thr_1
                }
                z_thr_3 = branch_5
            }
            n_spin_3 = (1.0 + z_thr_3) * dens / 2.0
            xs1 = sqrt(sigma_bb) / rho_b ^ (4.0 / 3.0)
            pbe_f0_1 = 1.0 + 0.804 * (1.0 - 0.804 / (0.804 + 0.2195149727645171 * (0.1282782438530422 * xs1) ^ 2.0))
            b88_r_f_1 = 1.0 / (1.8610514726982001 * n_spin_3 ^ (1.0 / 3.0) * pbe_f0_1)
            branch_4 = b88_r_f_1
        }
        b88_zab = branch_2 + branch_4
        if b88_zab == 0.0 {
            op_b88_zab = 2.220446049250313e-16
        }
        else {
            op_b88_zab = b88_zab
        }
        op_beta = 2.3789 / op_b88_zab
        op_f_s = -((1.0 - z_thr ^ 2.0) * dens / 4.0 * (1.5214 * op_beta + 0.5764) / (op_beta ^ 4.0 + 1.1284 * op_beta ^ 3.0 + 0.3183 * op_beta ^ 2.0))
        op_f = op_f_s
    }
    return op_f
}

#| the energy per volume, unpolarized: libxc's mf, whose gradient is [vrho, vsigma]
def _mf_unpol(x: Arr) -> Num {
    return x[0] * zk_unpol(x)
}

#| the energy per volume, spin-polarized
def _mf_pol(x: Arr) -> Num {
    return (x[0] + x[1]) * zk_pol(x)
}

#| libxc's xc_gga_exc_vxc, unpolarized: per point [zk, vrho, vsigma]
def eval_unpol(rho: Arr, sigma: Arr) -> Arr {
    n = len(rho)
    width = 3
    out = zeros(width * n)
    for i to n {
        if rho[i] >= DENS_THRESHOLD {
            x = gga_unpol_point(rho[i], sigma[i], DENS_THRESHOLD, SIGMA_THRESHOLD)
            g = grad(_mf_unpol, x)
            out[width * i] = zk_unpol(x)
            out[width * i + 1] = g[0]
            out[width * i + 2] = g[1]
        }
    }
    return out
}

#| libxc's xc_gga_exc_vxc, spin-polarized: rho = [a, b], sigma = [aa, ab, bb] per point;
#| out [zk, vrho_a, vrho_b, vsigma_aa, vsigma_ab, vsigma_bb]
def eval_pol(rho: Arr, sigma: Arr) -> Arr {
    nspin = 2
    nsigma = 3
    width = 6
    n = len(rho) // nspin
    out = zeros(width * n)
    for i to n {
        if rho[nspin * i] + rho[nspin * i + 1] >= DENS_THRESHOLD {
            x = gga_pol_point(rho[nspin * i], rho[nspin * i + 1], sigma[nsigma * i], sigma[nsigma * i + 1],
                              sigma[nsigma * i + 2], DENS_THRESHOLD, SIGMA_THRESHOLD)
            g = grad(_mf_pol, x)
            out[width * i] = zk_pol(x)
            for k to len(x) {
                out[width * i + 1 + k] = g[k]
            }
        }
    }
    return out
}
