from xc.core import gga_pol_point, gga_unpol_point

#| GGA_C_LM (libxc id 137): Langreth & Mehl
#|| kind c, family gga, Maple script gga_exc/gga_c_lm.mpl
#~ reference: D. C. Langreth and M. J. Mehl.,  Phys. Rev. Lett. 47, 446 (1981)
#~ reference: C. D. Hu and D. C. Langreth.,  Phys. Scr. 32, 391 (1985)

#: DENS_THRESHOLD  libxc's dens_threshold for this functional: smaller total densities give zero
DENS_THRESHOLD = 1.0e-12
#: SIGMA_THRESHOLD  libxc's sigma_threshold, dens_threshold^(4/3)
SIGMA_THRESHOLD = 1.0000000000000021e-16

#| the energy per particle, unpolarized: x = [rho, sigma]
def zk_unpol(x: Arr) -> Num {
    rho = x[0]
    sigma = x[1]
    t = rho ^ (1.0 / 3.0)
    r_ws = 0.6203504908994 / t
    hl_xx = r_ws / 30.0
    hl_f0 = -(0.0252 * ((1.0 + hl_xx ^ 3.0) * log(1.0 + 1.0 / hl_xx) - hl_xx ^ 2.0 + 1.0 / 2.0 * hl_xx - 1.0 / 3.0))
    xs0 = sqrt(sigma / 4.0) / (rho / 2.0) ^ (4.0 / 3.0)
    t_1 = xs0 ^ 2.0
    lm_t1 = -(0.2449846485906698 * (t_1 + t_1))
    xt = sqrt(sigma) / rho ^ (4.0 / 3.0)
    lm_t2 = 2.0 * exp(-(0.2618122659187686 * xt * rho ^ (1.0 / 6.0))) * xt ^ 2.0
    f = hl_f0 + 0.00214355792182506 * (lm_t1 + lm_t2) * t
    return f
}

#| the energy per particle, spin-polarized: x = [rho_a, rho_b, sigma_aa, sigma_ab, sigma_bb]
def zk_pol(x: Arr) -> Num {
    rho_a = x[0]
    rho_b = x[1]
    sigma_aa = x[2]
    sigma_ab = x[3]
    sigma_bb = x[4]
    dens = rho_a + rho_b
    t = dens ^ (1.0 / 3.0)
    r_ws = 0.6203504908994 / t
    hl_xx = r_ws / 30.0
    t_1 = 0.0252 * ((1.0 + hl_xx ^ 3.0) * log(1.0 + 1.0 / hl_xx) - hl_xx ^ 2.0 + 1.0 / 2.0 * hl_xx - 1.0 / 3.0)
    hl_f0 = -t_1
    zeta = (rho_a - rho_b) / dens
    t_2 = 1.0 + zeta
    if t_2 <= 2.220446049250313e-16 {
        opz_pow_n = 1.3445809915232009e-21
    }
    else {
        opz_pow_n = t_2 ^ (4.0 / 3.0)
    }
    t_3 = 1.0 - zeta
    if t_3 <= 2.220446049250313e-16 {
        opz_pow_n_1 = 1.3445809915232009e-21
    }
    else {
        opz_pow_n_1 = t_3 ^ (4.0 / 3.0)
    }
    f_zeta = (opz_pow_n + opz_pow_n_1 - 2.0) / 0.5198420997897464
    hl_xx_1 = r_ws / 75.0
    hl_f0_1 = -(0.0127 * ((1.0 + hl_xx_1 ^ 3.0) * log(1.0 + 1.0 / hl_xx_1) - hl_xx_1 ^ 2.0 + 1.0 / 2.0 * hl_xx_1 - 1.0 / 3.0))
    hl_f = hl_f0 + f_zeta * (hl_f0_1 + t_1)
    xs0 = sqrt(sigma_aa) / rho_a ^ (4.0 / 3.0)
    xs1 = sqrt(sigma_bb) / rho_b ^ (4.0 / 3.0)
    lm_t1 = -(0.2449846485906698 * (xs0 ^ 2.0 * opz_pow_n + xs1 ^ 2.0 * opz_pow_n_1))
    if t_2 <= 2.220446049250313e-16 {
        opz_pow_n_2 = 8.142048951722617e-27
    }
    else {
        opz_pow_n_2 = t_2 ^ (5.0 / 3.0)
    }
    if t_3 <= 2.220446049250313e-16 {
        opz_pow_n_3 = 8.142048951722617e-27
    }
    else {
        opz_pow_n_3 = t_3 ^ (5.0 / 3.0)
    }
    lm_d = sqrt(opz_pow_n_2 + opz_pow_n_3) / 1.4142135623730951
    xt = sqrt(sigma_aa + 2.0 * sigma_ab + sigma_bb) / dens ^ (4.0 / 3.0)
    lm_t2 = 2.0 / lm_d * exp(-(0.2618122659187686 * xt * dens ^ (1.0 / 6.0))) * xt ^ 2.0
    f = hl_f + 0.00214355792182506 * (lm_t1 + lm_t2) * t
    return f
}

#| the energy per volume, unpolarized: libxc's mf, whose gradient is [vrho, vsigma]
def _mf_unpol(x: Arr) -> Num {
    return x[0] * zk_unpol(x)
}

#| the energy per volume, spin-polarized
def _mf_pol(x: Arr) -> Num {
    return (x[0] + x[1]) * zk_pol(x)
}

#| libxc's xc_gga_exc_vxc, unpolarized: per point [zk, vrho, vsigma]
def eval_unpol(rho: Arr, sigma: Arr) -> Arr {
    n = len(rho)
    width = 3
    out = zeros(width * n)
    for i to n {
        if rho[i] >= DENS_THRESHOLD {
            x = gga_unpol_point(rho[i], sigma[i], DENS_THRESHOLD, SIGMA_THRESHOLD)
            g = grad(_mf_unpol, x)
            out[width * i] = zk_unpol(x)
            out[width * i + 1] = g[0]
            out[width * i + 2] = g[1]
        }
    }
    return out
}

#| libxc's xc_gga_exc_vxc, spin-polarized: rho = [a, b], sigma = [aa, ab, bb] per point;
#| out [zk, vrho_a, vrho_b, vsigma_aa, vsigma_ab, vsigma_bb]
def eval_pol(rho: Arr, sigma: Arr) -> Arr {
    nspin = 2
    nsigma = 3
    width = 6
    n = len(rho) // nspin
    out = zeros(width * n)
    for i to n {
        if rho[nspin * i] + rho[nspin * i + 1] >= DENS_THRESHOLD {
            x = gga_pol_point(rho[nspin * i], rho[nspin * i + 1], sigma[nsigma * i], sigma[nsigma * i + 1],
                              sigma[nsigma * i + 2], DENS_THRESHOLD, SIGMA_THRESHOLD)
            g = grad(_mf_pol, x)
            out[width * i] = zk_pol(x)
            for k to len(x) {
                out[width * i + 1 + k] = g[k]
            }
        }
    }
    return out
}
