#| LDA_C_ML2 (libxc id 23): Modified LSD (version 2) of Proynov and Salahub
#|| kind c, family lda, Maple script lda_exc/lda_c_ml1.mpl
#~ reference: E. I. Proynov and D. R. Salahub.,  Phys. Rev. B 49, 7874 (1994)
#~ reference: E. I. Proynov and D. R. Salahub.,  Phys. Rev. B 57, 12616–12616 (1998)

#: DENS_THRESHOLD  libxc's dens_threshold for this functional: smaller total densities give zero
DENS_THRESHOLD = 1.0e-15

#| the energy per particle, unpolarized: x = [rho]
def zk_unpol(x: Arr) -> Num {
    rho = x[0]
    ml1_k = 6.187335 * rho ^ (1.0 / 3.0) * 0.532 * 0.5
    ml1_q = -(2.763169 / (1.0 + 1.757515 * ml1_k)) + 1.741397 * log(1.0 + 0.568985 / ml1_k) / ml1_k + 1.572202 / ml1_k - 1.885389 / ml1_k ^ 2.0
    ml1_f = rho * 1.0 / 4.0 * ml1_q
    return ml1_f
}

#| the energy per particle, spin-polarized: x = [rho_a, rho_b]
def zk_pol(x: Arr) -> Num {
    rho_a = x[0]
    rho_b = x[1]
    dens = rho_a + rho_b
    zeta = (rho_a - rho_b) / dens
    if 1.0 - abs(zeta) <= 2.220446049250313e-16 {
        branch = 0.0
    }
    else {
        if 1.0 + zeta <= 2.220446049250313e-16 {
            z_thr = -0.9999999999999998
        }
        else {
            if 1.0 - zeta <= 2.220446049250313e-16 {
                branch_1 = 0.9999999999999998
            }
            else {
                branch_1 = zeta
            }
            z_thr = branch_1
        }
        t = 1.0 + z_thr
        t_1 = 1.0 - z_thr
        ml1_alpha = 0.266 * (t ^ 0.5 + t_1 ^ 0.5)
        ml1_beta = (1.0 - z_thr ^ 2.0) ^ (1.0 / 3.0) / (t ^ (1.0 / 3.0) + t_1 ^ (1.0 / 3.0))
        ml1_k = 6.187335 * dens ^ (1.0 / 3.0) * ml1_alpha * ml1_beta
        ml1_q = -(2.763169 / (1.0 + 1.757515 * ml1_k)) + 1.741397 * log(1.0 + 0.568985 / ml1_k) / ml1_k + 1.572202 / ml1_k - 1.885389 / ml1_k ^ 2.0
        branch = (1.0 - zeta ^ 2.0) / 4.0 * ml1_q
    }
    ml1_f = dens * branch
    return ml1_f
}

#| the energy per volume, unpolarized: libxc's mf, whose gradient is vrho
def _mf_unpol(x: Arr) -> Num {
    return x[0] * zk_unpol(x)
}

#| the energy per volume, spin-polarized
def _mf_pol(x: Arr) -> Num {
    return (x[0] + x[1]) * zk_pol(x)
}

#| libxc's xc_lda_exc_vxc, unpolarized: per point [zk, vrho]
def eval_unpol(rho: Arr) -> Arr {
    n = len(rho)
    width = 2
    out = zeros(width * n)
    for i to n {
        if rho[i] >= DENS_THRESHOLD {
            x = [max(DENS_THRESHOLD, rho[i])]
            g = grad(_mf_unpol, x)
            out[width * i] = zk_unpol(x)
            out[width * i + 1] = g[0]
        }
    }
    return out
}

#| libxc's xc_lda_exc_vxc, spin-polarized: rho = [rho_a, rho_b] per point, out [zk, vrho_a, vrho_b]
def eval_pol(rho: Arr) -> Arr {
    nspin = 2
    width = 3
    n = len(rho) // nspin
    out = zeros(width * n)
    for i to n {
        if rho[nspin * i] + rho[nspin * i + 1] >= DENS_THRESHOLD {
            x = [max(DENS_THRESHOLD, rho[nspin * i]), max(DENS_THRESHOLD, rho[nspin * i + 1])]
            g = grad(_mf_pol, x)
            out[width * i] = zk_pol(x)
            out[width * i + 1] = g[0]
            out[width * i + 2] = g[1]
        }
    }
    return out
}
