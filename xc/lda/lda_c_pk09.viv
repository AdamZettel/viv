    t_51 = k_dd ^ 2.0
    d_1_2 = 0.028359261614488256 * t_51 + 0.02262741699796952 * k_dd + 0.005317361552716548
    t_52 = atan(5.939656549519008 * k_dd + 2.369580128666418)
    d_2_2 = 0.1846304394851914 * t_51 + 0.1473137771194929 * k_dd + 0.0346182074034769
    d_3_2 = 0.09576892532004282 * t_51 + 0.07641254691754473 * k_dd + 0.01795667349750801
    t_53 = log(k_dd)
    d_4_2 = 0.1915378506400854 * t_51 + 0.1528250938350897 * k_dd + 0.03591334699501599
    q_1ud_2 = 1.0 / d_1_2 * (-(t_52 * d_2_2 / k_dd) - log(d_1_2) * d_3_2 / k_dd + t_53 * d_4_2 / k_dd - 0.05118886552595877 * k_dd + 1.0150830754383913 + 0.8985374602634734 / k_dd + 0.2220173534761558 / t_51)
    d_5_2 = 0.4010605239409601 * t_51 + 0.32 * k_dd + 0.07519884823893001
    d_6_2 = 1.0 / 2.0 * t_51 + 0.4107096967781855 * k_dd + 0.10532352447676886
    q_2ud_2 = -(132.47909028779435 / k_dd) - 32.40147085167714 / t_51 - 22.56644531625038 * t_53 / k_dd + 11.28322265812519 * log(d_5_2) / k_dd + 116.93504264748091 * t_52 / k_dd + 29.62400230469013 * log(k_dd + 0.4822571819944727) / k_dd - 0.24690398117909756 / k_dd * log(d_6_2)
    d_8_2 = sqrt(1.0 / 4.0 * t_51 + 0.2528829196169895 * k_dd + 0.07204858311271498)
    d_7_2 = 0.78125 * t_51 + 0.6233473131272386 * k_dd + 0.146484375
    q_3ud_2 = 111.81154810579778 * atan(0.16004110557090126 / (0.78125 * k_dd + 0.3208669506079574)) / k_dd - 13.284449507299843 * xc_atanh((0.26841867131910735 + 0.4710605979349919 * k_dd) / d_8_2) / k_dd - 14.565097171165966 * log(d_7_2) / k_dd - 42.64905448910311 * d_8_2 / t_51
    ec_par = opz_pow_n_2 / 8.0 * (q_1ud_1 + q_2ud_1 + q_3ud_1) + opz_pow_n_5 / 8.0 * (q_1ud_2 + q_2ud_2 + q_3ud_2)
    f = dens * (ec_opp + ec_par)
    return f
}

#| the energy per volume, unpolarized: libxc's mf, whose gradient is vrho
def _mf_unpol(x: Arr) -> Num {
    return x[0] * zk_unpol(x)
}

#| the energy per volume, spin-polarized
def _mf_pol(x: Arr) -> Num {
    return (x[0] + x[1]) * zk_pol(x)
}

#| libxc's xc_lda_exc_vxc, unpolarized: per point [zk, vrho]
def eval_unpol(rho: Arr) -> Arr {
    n = len(rho)
    width = 2
    out = zeros(width * n)
    for i to n {
        if rho[i] >= DENS_THRESHOLD {
            x = [max(DENS_THRESHOLD, rho[i])]
            g = grad(_mf_unpol, x)
            out[width * i] = zk_unpol(x)
            out[width * i + 1] = g[0]
        }
    }
    return out
}

#| libxc's xc_lda_exc_vxc, spin-polarized: rho = [rho_a, rho_b] per point, out [zk, vrho_a, vrho_b]
def eval_pol(rho: Arr) -> Arr {
    nspin = 2
    width = 3
    n = len(rho) // nspin
    out = zeros(width * n)
    for i to n {
        if rho[nspin * i] + rho[nspin * i + 1] >= DENS_THRESHOLD {
            x = [max(DENS_THRESHOLD, rho[nspin * i]), max(DENS_THRESHOLD, rho[nspin * i + 1])]
            g = grad(_mf_pol, x)
            out[width * i] = zk_pol(x)
            out[width * i + 1] = g[0]
            out[width * i + 2] = g[1]
        }
    }
    return out
}
