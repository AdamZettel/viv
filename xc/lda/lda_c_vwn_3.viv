#| LDA_C_VWN_3 (libxc id 30): Vosko, Wilk & Nusair (VWN3)
#|| kind c, family lda, Maple script lda_exc/lda_c_vwn_3.mpl
#~ reference: S. H. Vosko, L. Wilk, and M. Nusair.,  Can. J. Phys. 58, 1200 (1980)

#: DENS_THRESHOLD  libxc's dens_threshold for this functional: smaller total densities give zero
DENS_THRESHOLD = 1.0e-15

#| the energy per particle, unpolarized: x = [rho]
def zk_unpol(x: Arr) -> Num {
    rho = x[0]
    r_ws = 0.6203504908994 / rho ^ (1.0 / 3.0)
    t = sqrt(r_ws)
    fx_vwn = r_ws + 3.72744 * t + 12.9352
    f_aux = 0.0310907 * (log(r_ws / fx_vwn) + 1.2474243062431214 * atan(6.15199081975908 / (2.0 * t + 3.72744)) - -0.031167608678943783 * log((t - -0.10498) ^ 2.0 / fx_vwn))
    return f_aux
}

#| the energy per particle, spin-polarized: x = [rho_a, rho_b]
def zk_pol(x: Arr) -> Num {
    rho_a = x[0]
    rho_b = x[1]
    dens = rho_a + rho_b
    r_ws = 0.6203504908994 / dens ^ (1.0 / 3.0)
    t = sqrt(r_ws)
    fx_vwn = r_ws + 3.72744 * t + 12.9352
    t_1 = 2.0 * t
    f_aux = 0.0310907 * (log(r_ws / fx_vwn) + 1.2474243062431214 * atan(6.15199081975908 / (t_1 + 3.72744)) - -0.031167608678943783 * log((t - -0.10498) ^ 2.0 / fx_vwn))
    fx_vwn_1 = r_ws + 7.06042 * t + 18.0578
    f_aux_1 = 0.01554535 * (log(r_ws / fx_vwn_1) + 3.3766620352569054 * atan(4.730926909560113 / (t_1 + 7.06042)) - -0.14460061018520726 * log((t - -0.325) ^ 2.0 / fx_vwn_1))
    dmc = f_aux_1 - f_aux
    fx_vwn_2 = r_ws + 20.1231 * t + 101.578
    f_aux_2 = 0.01554535 * (log(r_ws / fx_vwn_2) + 39.80727547405535 * atan(1.171685277708993 / (t_1 + 20.1231)) - -0.17158249941450757 * log((t - -0.743294) ^ 2.0 / fx_vwn_2))
    fx_vwn_3 = r_ws + 13.072 * t + 42.7198
    f_aux_3 = 0.0310907 * (log(r_ws / fx_vwn_3) + 660.0678961180514 * atan(0.0448998886412873 / (t_1 + 13.072)) - -0.14253052416798395 * log((t - -0.409286) ^ 2.0 / fx_vwn_3))
    drpa = f_aux_2 - f_aux_3
    fx_vwn_4 = r_ws + 1.06835 * t + 11.4813
    f_aux_4 = -0.01688686394038963 * (log(r_ws / fx_vwn_4) + 0.32323836906055065 * atan(6.692072046645942 / (t_1 + 1.06835)) - -0.021608710360898266 * log((t - -0.228344) ^ 2.0 / fx_vwn_4))
    zeta = (rho_a - rho_b) / dens
    t_2 = 1.0 + zeta
    if t_2 <= 2.220446049250313e-16 {
        opz_pow_n = 1.3445809915232009e-21
    }
    else {
        opz_pow_n = t_2 ^ (4.0 / 3.0)
    }
    t_3 = 1.0 - zeta
    if t_3 <= 2.220446049250313e-16 {
        opz_pow_n_1 = 1.3445809915232009e-21
    }
    else {
        opz_pow_n_1 = t_3 ^ (4.0 / 3.0)
    }
    f_zeta = (opz_pow_n + opz_pow_n_1 - 2.0) / 0.5198420997897464
    t_4 = zeta ^ 4.0
    f_vwn = f_aux + dmc / drpa * f_aux_4 * f_zeta * (1.0 - t_4) / 1.7099209341613657 + dmc * f_zeta * t_4
    return f_vwn
}

#| the energy per volume, unpolarized: libxc's mf, whose gradient is vrho
def _mf_unpol(x: Arr) -> Num {
    return x[0] * zk_unpol(x)
}

#| the energy per volume, spin-polarized
def _mf_pol(x: Arr) -> Num {
    return (x[0] + x[1]) * zk_pol(x)
}

#| libxc's xc_lda_exc_vxc, unpolarized: per point [zk, vrho]
def eval_unpol(rho: Arr) -> Arr {
    n = len(rho)
    width = 2
    out = zeros(width * n)
    for i to n {
        if rho[i] >= DENS_THRESHOLD {
            x = [max(DENS_THRESHOLD, rho[i])]
            g = grad(_mf_unpol, x)
            out[width * i] = zk_unpol(x)
            out[width * i + 1] = g[0]
        }
    }
    return out
}

#| libxc's xc_lda_exc_vxc, spin-polarized: rho = [rho_a, rho_b] per point, out [zk, vrho_a, vrho_b]
def eval_pol(rho: Arr) -> Arr {
    nspin = 2
    width = 3
    n = len(rho) // nspin
    out = zeros(width * n)
    for i to n {
        if rho[nspin * i] + rho[nspin * i + 1] >= DENS_THRESHOLD {
            x = [max(DENS_THRESHOLD, rho[nspin * i]), max(DENS_THRESHOLD, rho[nspin * i + 1])]
            g = grad(_mf_pol, x)
            out[width * i] = zk_pol(x)
            out[width * i + 1] = g[0]
            out[width * i + 2] = g[1]
        }
    }
    return out
}
