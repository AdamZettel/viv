#| LDA_C_UPW92 (libxc id 683): Ruggeri, Rios, and Alavi unrestricted fit
#|| kind c, family lda, Maple script lda_exc/lda_c_pw.mpl
#~ reference: M. Ruggeri, P. L. Ríos, and A. Alavi.,  Phys. Rev. B 98, 161105 (2018)

#: DENS_THRESHOLD  libxc's dens_threshold for this functional: smaller total densities give zero
DENS_THRESHOLD = 1.0e-15

#| the energy per particle, unpolarized: x = [rho]
def zk_unpol(x: Arr) -> Num {
    rho = x[0]
    r_ws = 0.6203504908994 / rho ^ (1.0 / 3.0)
    g_aux = 7.5957 * sqrt(r_ws) + 3.5876 * r_ws + 1.76522 * r_ws ^ 1.5 + 0.523918 * r_ws ^ 2.0
    g = -(0.0621814 * (1.0 + 0.227012 * r_ws) * log(1.0 + 1.0 / (0.0621814 * g_aux)))
    return g
}

#| the energy per particle, spin-polarized: x = [rho_a, rho_b]
def zk_pol(x: Arr) -> Num {
    rho_a = x[0]
    rho_b = x[1]
    dens = rho_a + rho_b
    r_ws = 0.6203504908994 / dens ^ (1.0 / 3.0)
    t = sqrt(r_ws)
    t_1 = r_ws ^ 1.5
    t_2 = r_ws ^ 2.0
    g_aux = 7.5957 * t + 3.5876 * r_ws + 1.76522 * t_1 + 0.523918 * t_2
    t_3 = 0.0621814 * (1.0 + 0.227012 * r_ws) * log(1.0 + 1.0 / (0.0621814 * g_aux))
    g = -t_3
    zeta = (rho_a - rho_b) / dens
    t_4 = 1.0 + zeta
    if t_4 <= 2.220446049250313e-16 {
        opz_pow_n = 1.3445809915232009e-21
    }
    else {
        opz_pow_n = t_4 ^ (4.0 / 3.0)
    }
    t_5 = 1.0 - zeta
    if t_5 <= 2.220446049250313e-16 {
        opz_pow_n_1 = 1.3445809915232009e-21
    }
    else {
        opz_pow_n_1 = t_5 ^ (4.0 / 3.0)
    }
    f_zeta = (opz_pow_n + opz_pow_n_1 - 2.0) / 0.5198420997897464
    g_aux_1 = 14.1189 * t + 6.1977 * r_ws + 4.78287 * t_1 + 0.750424 * t_2
    g_1 = -(0.0310907 * (1.0 + 0.264193 * r_ws) * log(1.0 + 1.0 / (0.0310907 * g_aux_1)))
    g_aux_2 = 10.357 * t + 3.6231 * r_ws + 0.88026 * t_1 + 0.49671 * t_2
    g_2 = -(0.0337738 * (1.0 + 0.11125 * r_ws) * log(1.0 + 1.0 / (0.0337738 * g_aux_2)))
    f_pw = g + zeta ^ 4.0 * f_zeta * (g_1 + t_3 + g_2 / 1.7099209341613657) - f_zeta * g_2 / 1.7099209341613657
    return f_pw
}

#| the energy per volume, unpolarized: libxc's mf, whose gradient is vrho
def _mf_unpol(x: Arr) -> Num {
    return x[0] * zk_unpol(x)
}

#| the energy per volume, spin-polarized
def _mf_pol(x: Arr) -> Num {
    return (x[0] + x[1]) * zk_pol(x)
}

#| libxc's xc_lda_exc_vxc, unpolarized: per point [zk, vrho]
def eval_unpol(rho: Arr) -> Arr {
    n = len(rho)
    width = 2
    out = zeros(width * n)
    for i to n {
        if rho[i] >= DENS_THRESHOLD {
            x = [max(DENS_THRESHOLD, rho[i])]
            g = grad(_mf_unpol, x)
            out[width * i] = zk_unpol(x)
            out[width * i + 1] = g[0]
        }
    }
    return out
}

#| libxc's xc_lda_exc_vxc, spin-polarized: rho = [rho_a, rho_b] per point, out [zk, vrho_a, vrho_b]
def eval_pol(rho: Arr) -> Arr {
    nspin = 2
    width = 3
    n = len(rho) // nspin
    out = zeros(width * n)
    for i to n {
        if rho[nspin * i] + rho[nspin * i + 1] >= DENS_THRESHOLD {
            x = [max(DENS_THRESHOLD, rho[nspin * i]), max(DENS_THRESHOLD, rho[nspin * i + 1])]
            g = grad(_mf_pol, x)
            out[width * i] = zk_pol(x)
            out[width * i + 1] = g[0]
            out[width * i + 2] = g[1]
        }
    }
    return out
}
