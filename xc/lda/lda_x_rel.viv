from xc.core import xc_asinh

#| LDA_X_REL (libxc id 532): Slater exchange with relativistic corrections
#|| kind x, family lda, Maple script lda_exc/lda_x_rel.mpl
#~ reference: A. K. Rajagopal.,  J. Phys. C: Solid State Phys. 11, L943 (1978)
#~ reference: A. H. MacDonald and S. H. Vosko.,  J. Phys. C: Solid State Phys. 12, 2977 (1979)
#~ reference: E. Engel, S. Keller, A. F. Bonetti, H. Müller, and R. M. Dreizler.,  Phys. Rev. A 52, 2750–2764 (1995)

#: DENS_THRESHOLD  libxc's dens_threshold for this functional: smaller total densities give zero
DENS_THRESHOLD = 1.0e-15

#| the energy per particle, unpolarized: x = [rho]
def zk_unpol(x: Arr) -> Num {
    rho = x[0]
    if rho / 2.0 <= 1.0e-15 {
        branch = 0.0
    }
    else {
        r_ws = 0.6203504908994 / rho ^ (1.0 / 3.0)
        lda_x_spin = -0.3692793831910112 * 0.6203504908994 / r_ws
        branch = lda_x_spin
    }
    f_lda_x = branch + branch
    r_ws_1 = 0.6203504908994 / rho ^ (1.0 / 3.0)
    beta_1 = 1.919158292677513 / (r_ws_1 * 137.0359996287515)
    t = beta_1 ^ 2.0
    phi = 1.0 - 1.5 * (sqrt(1.0 + t) / beta_1 - xc_asinh(beta_1) / t) ^ 2.0
    f = f_lda_x * phi
    return f
}

#| the energy per particle, spin-polarized: x = [rho_a, rho_b]
def zk_pol(x: Arr) -> Num {
    rho_a = x[0]
    rho_b = x[1]
    if rho_a <= 1.0e-15 {
        branch = 0.0
    }
    else {
        dens = rho_a + rho_b
        t = 1.0 / dens
        t_1 = 2.0 * rho_a * t
        if t_1 <= 2.220446049250313e-16 {
            opz_pow_n = 1.3445809915232009e-21
        }
        else {
            opz_pow_n = t_1 ^ (4.0 / 3.0)
        }
        r_ws = 0.6203504908994 / dens ^ (1.0 / 3.0)
        t_2 = 0.6203504908994 / r_ws
        lda_x_spin = -0.9305257363491001 * opz_pow_n * 0.3968502629920499 * t_2
        branch = lda_x_spin
    }
    if rho_b <= 1.0e-15 {
        branch_1 = 0.0
    }
    else {
        dens_1 = rho_a + rho_b
        t_3 = 1.0 / dens_1
        t_4 = 2.0 * rho_b * t_3
        if t_4 <= 2.220446049250313e-16 {
            opz_pow_n_1 = 1.3445809915232009e-21
        }
        else {
            opz_pow_n_1 = t_4 ^ (4.0 / 3.0)
        }
        r_ws_1 = 0.6203504908994 / dens_1 ^ (1.0 / 3.0)
        t_5 = 0.6203504908994 / r_ws_1
        lda_x_spin_1 = -0.9305257363491001 * opz_pow_n_1 * 0.3968502629920499 * t_5
        branch_1 = lda_x_spin_1
    }
    f_lda_x = branch + branch_1
    dens_2 = rho_a + rho_b
    r_ws_2 = 0.6203504908994 / dens_2 ^ (1.0 / 3.0)
    beta_1 = 1.919158292677513 / (r_ws_2 * 137.0359996287515)
    t_6 = beta_1 ^ 2.0
    phi = 1.0 - 1.5 * (sqrt(1.0 + t_6) / beta_1 - xc_asinh(beta_1) / t_6) ^ 2.0
    f = f_lda_x * phi
    return f
}

#| the energy per volume, unpolarized: libxc's mf, whose gradient is vrho
def _mf_unpol(x: Arr) -> Num {
    return x[0] * zk_unpol(x)
}

#| the energy per volume, spin-polarized
def _mf_pol(x: Arr) -> Num {
    return (x[0] + x[1]) * zk_pol(x)
}

#| libxc's xc_lda_exc_vxc, unpolarized: per point [zk, vrho]
def eval_unpol(rho: Arr) -> Arr {
    n = len(rho)
    width = 2
    out = zeros(width * n)
    for i to n {
        if rho[i] >= DENS_THRESHOLD {
            x = [max(DENS_THRESHOLD, rho[i])]
            g = grad(_mf_unpol, x)
            out[width * i] = zk_unpol(x)
            out[width * i + 1] = g[0]
        }
    }
    return out
}

#| libxc's xc_lda_exc_vxc, spin-polarized: rho = [rho_a, rho_b] per point, out [zk, vrho_a, vrho_b]
def eval_pol(rho: Arr) -> Arr {
    nspin = 2
    width = 3
    n = len(rho) // nspin
    out = zeros(width * n)
    for i to n {
        if rho[nspin * i] + rho[nspin * i + 1] >= DENS_THRESHOLD {
            x = [max(DENS_THRESHOLD, rho[nspin * i]), max(DENS_THRESHOLD, rho[nspin * i + 1])]
            g = grad(_mf_pol, x)
            out[width * i] = zk_pol(x)
            out[width * i + 1] = g[0]
            out[width * i + 2] = g[1]
        }
    }
    return out
}
