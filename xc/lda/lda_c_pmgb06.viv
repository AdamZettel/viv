#| LDA_C_PMGB06 (libxc id 590): Long-range LDA correlation functional
#|| kind c, family lda, Maple script lda_exc/lda_c_pmgb06.mpl
#~ reference: S. Paziani, S. Moroni, P. Gori-Giorgi, and G. B. Bachelet.,  Phys. Rev. B 73, 155111 (2006)

#: DENS_THRESHOLD  libxc's dens_threshold for this functional: smaller total densities give zero
DENS_THRESHOLD = 1.0e-13

#| the energy per particle, unpolarized: x = [rho]
def zk_unpol(x: Arr) -> Num {
    rho = x[0]
    r_ws = 0.6203504908994 / rho ^ (1.0 / 3.0)
    t = sqrt(r_ws)
    t_1 = 0.3 * t
    t_2 = 1.0 + 5.84605 * t_1
    t_3 = t_1 ^ 2.0
    pmgb_q = -0.06218138173930979 * log((t_2 + 7.449525382634055 * t_3 + 3.91744 * t_1 ^ 3.0) / (t_2 + 3.44851 * t_3))
    pmgb_b0 = 0.784949 * r_ws
    t_4 = 4.0 * pmgb_b0 ^ 6.0
    t_5 = r_ws ^ 2.0
    t_6 = r_ws ^ 3.0
    pmgb_g0 = (1.0 - -0.020729952907284032 * r_ws + 0.08193 * t_5 + -0.01277 * t_6 + 0.001859 * r_ws ^ 4.0) * exp(-(0.7524 * r_ws)) / 2.0
    pmgb_c3 = -(pmgb_g0 / (2.5066282746310007 * t_6))
    t_7 = pmgb_b0 ^ 8.0
    t_8 = r_ws * 1.2599210498948732
    t_9 = t_8 ^ 2.0
    pmgb_gpp1 = 3.174802103936399 / (1.357526794913016 * t_9) * (1.0 - 0.02267 * t_8) / (1.0 + 0.4319 * t_8 + 0.04 * t_9)
    t_10 = 1.0 / 4.0 * pmgb_gpp1
    t_11 = t_10 + t_10
    pmgb_d3 = (-(4.95 * r_ws) + t_5) * exp(-(0.31 * r_ws)) / t_6
    pmgb_cc5 = t_11 + pmgb_d3
    pmgb_c5 = -(9.0 * pmgb_cc5 / (100.26513098524002 * t_6))
    pmgb_a1 = t_4 * pmgb_c3 + t_7 * pmgb_c5
    pmgb_gc0 = pmgb_g0 - 1.0 / 2.0
    pmgb_c2 = -(3.0 * pmgb_gc0 / (8.0 * t_6))
    pmgb_d2 = (-(0.388 * r_ws) + 0.676 * t_5) * exp(-(0.547 * r_ws)) / t_5
    pmgb_cc4 = t_11 + pmgb_d2 - 1.0 / (1.357526794913016 * t_5)
    pmgb_c4 = -(9.0 * pmgb_cc4 / (64.0 * t_6))
    g_aux = 7.5957 * t + 3.5876 * r_ws + 1.6382 * r_ws ^ 1.5 + 0.49294 * t_5
    g = -(0.0621814 * (1.0 + 0.2137 * r_ws) * log(1.0 + 1.0 / (0.0621814 * g_aux)))
    pmgb_a2 = t_4 * pmgb_c2 + t_7 * pmgb_c4 + 6.0 * pmgb_b0 ^ 4.0 * g
    pmgb_a3 = t_7 * pmgb_c3
    pmgb_a4 = t_7 * pmgb_c2 + t_4 * g
    pmgb_a5 = t_7 * g
    pmgb_ec_lr = (pmgb_q + pmgb_a1 * 0.026999999999999996 + pmgb_a2 * 0.0081 + pmgb_a3 * 0.0024299999999999994 + pmgb_a4 * 0.0007289999999999998 + pmgb_a5 * 6.560999999999998e-05) / (1.0 + pmgb_b0 ^ 2.0 * 0.09) ^ 4.0
    return pmgb_ec_lr
}

#| the energy per particle, spin-polarized: x = [rho_a, rho_b]
def zk_pol(x: Arr) -> Num {
    rho_a = x[0]
    rho_b = x[1]
    dens = rho_a + rho_b
    zeta = (rho_a - rho_b) / dens
    t = 1.0 + zeta
    if t <= 2.220446049250313e-16 {
        opz_pow_n = 3.6668528625010315e-11
    }
    else {
        opz_pow_n = t ^ (2.0 / 3.0)
    }
    t_1 = 1.0 - zeta
    if t_1 <= 2.220446049250313e-16 {
        opz_pow_n_1 = 3.6668528625010315e-11
    }
    else {
        opz_pow_n_1 = t_1 ^ (2.0 / 3.0)
    }
    pmgb_phi = (opz_pow_n + opz_pow_n_1) / 2.0
    r_ws = 0.6203504908994 / dens ^ (1.0 / 3.0)
    t_2 = sqrt(r_ws)
    t_3 = 0.3 * t_2 / pmgb_phi
    t_4 = 1.0 + 5.84605 * t_3
    t_5 = t_3 ^ 2.0
    pmgb_q = -0.06218138173930979 * log((t_4 + 7.449525382634055 * t_5 + 3.91744 * t_3 ^ 3.0) / (t_4 + 3.44851 * t_5))
    pmgb_b0 = 0.784949 * r_ws
    t_6 = 4.0 * pmgb_b0 ^ 6.0
    t_7 = 1.0 - zeta ^ 2.0
    t_8 = r_ws ^ 2.0
    t_9 = r_ws ^ 3.0
    pmgb_g0 = (1.0 - -0.020729952907284032 * r_ws + 0.08193 * t_8 + -0.01277 * t_9 + 0.001859 * r_ws ^ 4.0) * exp(-(0.7524 * r_ws)) / 2.0
    pmgb_c3 = -(t_7 * pmgb_g0 / (2.5066282746310007 * t_9))
    t_10 = pmgb_b0 ^ 8.0
    if t <= 2.220446049250313e-16 {
        opz_pow_n_2 = 4.930380657631324e-32
    }
    else {
        opz_pow_n_2 = t ^ 2.0
    }
    t_11 = r_ws * (2.0 / t) ^ (1.0 / 3.0)
    t_12 = t_11 ^ 2.0
    pmgb_gpp1 = 3.174802103936399 / (1.357526794913016 * t_12) * (1.0 - 0.02267 * t_11) / (1.0 + 0.4319 * t_11 + 0.04 * t_12)
    if t_1 <= 2.220446049250313e-16 {
        opz_pow_n_3 = 4.930380657631324e-32
    }
    else {
        opz_pow_n_3 = t_1 ^ 2.0
    }
    t_13 = r_ws * (2.0 / t_1) ^ (1.0 / 3.0)
    t_14 = t_13 ^ 2.0
    pmgb_gpp1_1 = 3.174802103936399 / (1.357526794913016 * t_14) * (1.0 - 0.02267 * t_13) / (1.0 + 0.4319 * t_13 + 0.04 * t_14)
    t_15 = opz_pow_n_2 / 4.0 * pmgb_gpp1 + opz_pow_n_3 / 4.0 * pmgb_gpp1_1
    pmgb_d3 = (-(4.95 * r_ws) + t_8) * exp(-(0.31 * r_ws)) / t_9
    pmgb_cc5 = t_15 + t_7 * pmgb_d3
    pmgb_c5 = -(9.0 * pmgb_cc5 / (100.26513098524002 * t_9))
    pmgb_a1 = t_6 * pmgb_c3 + t_10 * pmgb_c5
    pmgb_gc0 = pmgb_g0 - 1.0 / 2.0 * t_7
    pmgb_c2 = -(3.0 * t_7 * pmgb_gc0 / (8.0 * t_9))
    pmgb_d2 = (-(0.388 * r_ws) + 0.676 * t_8) * exp(-(0.547 * r_ws)) / t_8
    if t <= 2.220446049250313e-16 {
        opz_pow_n_4 = 1.8078980427655138e-42
    }
    else {
        opz_pow_n_4 = t ^ (8.0 / 3.0)
    }
    if t_1 <= 2.220446049250313e-16 {
        opz_pow_n_5 = 1.8078980427655138e-42
    }
    else {
        opz_pow_n_5 = t_1 ^ (8.0 / 3.0)
    }
    pmgb_phi_1 = (opz_pow_n_4 + opz_pow_n_5) / 2.0
    pmgb_cc4 = t_15 + t_7 * pmgb_d2 - pmgb_phi_1 / (1.357526794913016 * t_8)
    pmgb_c4 = -(9.0 * pmgb_cc4 / (64.0 * t_9))
    t_16 = r_ws ^ 1.5
    g_aux = 7.5957 * t_2 + 3.5876 * r_ws + 1.6382 * t_16 + 0.49294 * t_8
    t_17 = 0.0621814 * (1.0 + 0.2137 * r_ws) * log(1.0 + 1.0 / (0.0621814 * g_aux))
    g = -t_17
    if t <= 2.220446049250313e-16 {
        opz_pow_n_6 = 1.3445809915232009e-21
    }
    else {
        opz_pow_n_6 = t ^ (4.0 / 3.0)
    }
    if t_1 <= 2.220446049250313e-16 {
        opz_pow_n_7 = 1.3445809915232009e-21
    }
    else {
        opz_pow_n_7 = t_1 ^ (4.0 / 3.0)
    }
    f_zeta = (opz_pow_n_6 + opz_pow_n_7 - 2.0) / 0.5198420997897464
    g_aux_1 = 14.1189 * t_2 + 6.1977 * r_ws + 3.3662 * t_16 + 0.62517 * t_8
    g_1 = -(0.0310907 * (1.0 + 0.20548 * r_ws) * log(1.0 + 1.0 / (0.0310907 * g_aux_1)))
    g_aux_2 = 10.357 * t_2 + 3.6231 * r_ws + 0.88026 * t_16 + 0.49671 * t_8
    g_2 = -(0.0337738 * (1.0 + 0.11125 * r_ws) * log(1.0 + 1.0 / (0.0337738 * g_aux_2)))
    f_pw = g + zeta ^ 4.0 * f_zeta * (g_1 + t_17 + g_2 / 1.7099209341613657) - f_zeta * g_2 / 1.7099209341613657
    pmgb_a2 = t_6 * pmgb_c2 + t_10 * pmgb_c4 + 6.0 * pmgb_b0 ^ 4.0 * f_pw
    pmgb_a3 = t_10 * pmgb_c3
    pmgb_a4 = t_10 * pmgb_c2 + t_6 * f_pw
    pmgb_a5 = t_10 * f_pw
    pmgb_ec_lr = (pmgb_phi ^ 3.0 * pmgb_q + pmgb_a1 * 0.026999999999999996 + pmgb_a2 * 0.0081 + pmgb_a3 * 0.0024299999999999994 + pmgb_a4 * 0.0007289999999999998 + pmgb_a5 * 6.560999999999998e-05) / (1.0 + pmgb_b0 ^ 2.0 * 0.09) ^ 4.0
    return pmgb_ec_lr
}

#| the energy per volume, unpolarized: libxc's mf, whose gradient is vrho
def _mf_unpol(x: Arr) -> Num {
    return x[0] * zk_unpol(x)
}

#| the energy per volume, spin-polarized
def _mf_pol(x: Arr) -> Num {
    return (x[0] + x[1]) * zk_pol(x)
}

#| libxc's xc_lda_exc_vxc, unpolarized: per point [zk, vrho]
def eval_unpol(rho: Arr) -> Arr {
    n = len(rho)
    width = 2
    out = zeros(width * n)
    for i to n {
        if rho[i] >= DENS_THRESHOLD {
            x = [max(DENS_THRESHOLD, rho[i])]
            g = grad(_mf_unpol, x)
            out[width * i] = zk_unpol(x)
            out[width * i + 1] = g[0]
        }
    }
    return out
}

#| libxc's xc_lda_exc_vxc, spin-polarized: rho = [rho_a, rho_b] per point, out [zk, vrho_a, vrho_b]
def eval_pol(rho: Arr) -> Arr {
    nspin = 2
    width = 3
    n = len(rho) // nspin
    out = zeros(width * n)
    for i to n {
        if rho[nspin * i] + rho[nspin * i + 1] >= DENS_THRESHOLD {
            x = [max(DENS_THRESHOLD, rho[nspin * i]), max(DENS_THRESHOLD, rho[nspin * i + 1])]
            g = grad(_mf_pol, x)
            out[width * i] = zk_pol(x)
            out[width * i + 1] = g[0]
            out[width * i + 2] = g[1]
        }
    }
    return out
}
