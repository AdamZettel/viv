#| LDA_XC_TETER93 (libxc id 20): Teter 93
#|| kind xc, family lda, Maple script lda_exc/lda_xc_teter93.mpl
#~ reference: S. Goedecker, M. Teter, and J. Hutter.,  Phys. Rev. B 54, 1703 (1996)

#: DENS_THRESHOLD  libxc's dens_threshold for this functional: smaller total densities give zero
DENS_THRESHOLD = 1.0e-15

#| the energy per particle, unpolarized: x = [rho]
def zk_unpol(x: Arr) -> Num {
    rho = x[0]
    r_ws = 0.6203504908994 / rho ^ (1.0 / 3.0)
    t = r_ws ^ 2.0
    t_1 = r_ws ^ 3.0
    f = -((0.4581652932831429 + 2.217058676663745 * r_ws + 0.7405551735357053 * t + 0.01968227878617998 * t_1) / (r_ws + 4.504130959426697 * t + 1.110667363742916 * t_1 + 0.02359291751427506 * r_ws ^ 4.0))
    return f
}

#| the energy per particle, spin-polarized: x = [rho_a, rho_b]
def zk_pol(x: Arr) -> Num {
    rho_a = x[0]
    rho_b = x[1]
    dens = rho_a + rho_b
    zeta = (rho_a - rho_b) / dens
    t = 1.0 + zeta
    if t <= 2.220446049250313e-16 {
        opz_pow_n = 1.3445809915232009e-21
    }
    else {
        opz_pow_n = t ^ (4.0 / 3.0)
    }
    t_1 = 1.0 - zeta
    if t_1 <= 2.220446049250313e-16 {
        opz_pow_n_1 = 1.3445809915232009e-21
    }
    else {
        opz_pow_n_1 = t_1 ^ (4.0 / 3.0)
    }
    f_zeta = (opz_pow_n + opz_pow_n_1 - 2.0) / 0.5198420997897464
    r_ws = 0.6203504908994 / dens ^ (1.0 / 3.0)
    t_2 = r_ws ^ 2.0
    t_3 = r_ws ^ 3.0
    f = -((0.4581652932831429 + f_zeta * 0.119086804055547 + (2.217058676663745 + f_zeta * 0.6157402568883344) * r_ws + (0.7405551735357053 + f_zeta * 0.1574201515892867) * t_2 + (0.01968227878617998 + f_zeta * 0.003532336663397157) * t_3) / (r_ws + (4.504130959426697 + f_zeta * 0.2673612973836267) * t_2 + (1.110667363742916 + f_zeta * 0.2052004607777787) * t_3 + (0.02359291751427506 + f_zeta * 0.004200005045691381) * r_ws ^ 4.0))
    return f
}

#| the energy per volume, unpolarized: libxc's mf, whose gradient is vrho
def _mf_unpol(x: Arr) -> Num {
    return x[0] * zk_unpol(x)
}

#| the energy per volume, spin-polarized
def _mf_pol(x: Arr) -> Num {
    return (x[0] + x[1]) * zk_pol(x)
}

#| libxc's xc_lda_exc_vxc, unpolarized: per point [zk, vrho]
def eval_unpol(rho: Arr) -> Arr {
    n = len(rho)
    width = 2
    out = zeros(width * n)
    for i to n {
        if rho[i] >= DENS_THRESHOLD {
            x = [max(DENS_THRESHOLD, rho[i])]
            g = grad(_mf_unpol, x)
            out[width * i] = zk_unpol(x)
            out[width * i + 1] = g[0]
        }
    }
    return out
}

#| libxc's xc_lda_exc_vxc, spin-polarized: rho = [rho_a, rho_b] per point, out [zk, vrho_a, vrho_b]
def eval_pol(rho: Arr) -> Arr {
    nspin = 2
    width = 3
    n = len(rho) // nspin
    out = zeros(width * n)
    for i to n {
        if rho[nspin * i] + rho[nspin * i + 1] >= DENS_THRESHOLD {
            x = [max(DENS_THRESHOLD, rho[nspin * i]), max(DENS_THRESHOLD, rho[nspin * i + 1])]
            g = grad(_mf_pol, x)
            out[width * i] = zk_pol(x)
            out[width * i + 1] = g[0]
            out[width * i + 2] = g[1]
        }
    }
    return out
}
