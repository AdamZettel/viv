#| LDA_K_GDS08_WORKER (libxc id 100001): Combined analytical theory with Monte Carlo sampling
#|| kind k, family lda, Maple script lda_exc/lda_k_gds08_worker.mpl
#~ reference: L. M. Ghiringhelli and L. Delle Site.,  Phys. Rev. B 77, 073104 (2008)

#: DENS_THRESHOLD  libxc's dens_threshold for this functional: smaller total densities give zero
DENS_THRESHOLD = 1.0e-15

#| the energy per particle, unpolarized: x = [rho]
def zk_unpol(x: Arr) -> Num {
    rho = x[0]
    t = rho / 2.0
    if t <= 1.0e-15 {
        branch = 0.0
    }
    else {
        gds08_fs = 1.0 / 2.0 * (0.86 + 0.224 * log(2.0 * t))
        branch = gds08_fs
    }
    gds08_f = branch + branch
    return gds08_f
}

#| the energy per particle, spin-polarized: x = [rho_a, rho_b]
def zk_pol(x: Arr) -> Num {
    rho_a = x[0]
    rho_b = x[1]
    if rho_a <= 1.0e-15 {
        branch = 0.0
    }
    else {
        dens = rho_a + rho_b
        zeta = (rho_a - rho_b) / dens
        if 1.0 + zeta <= 2.220446049250313e-16 {
            z_thr = -0.9999999999999998
        }
        else {
            if 1.0 - zeta <= 2.220446049250313e-16 {
                branch_1 = 0.9999999999999998
            }
            else {
                branch_1 = zeta
            }
            z_thr = branch_1
        }
        t = 1.0 / dens
        if 2.0 * rho_a * t <= 2.220446049250313e-16 {
            z_thr_1 = -0.9999999999999998
        }
        else {
            if 2.0 * rho_b * t <= 2.220446049250313e-16 {
                branch_2 = 0.9999999999999998
            }
            else {
                branch_2 = zeta
            }
            z_thr_1 = branch_2
        }
        n_spin = (1.0 + z_thr_1) * dens / 2.0
        gds08_fs = (1.0 + z_thr) / 2.0 * (0.86 + 0.224 * log(2.0 * n_spin))
        branch = gds08_fs
    }
    if rho_b <= 1.0e-15 {
        branch_3 = 0.0
    }
    else {
        dens_1 = rho_a + rho_b
        zeta_1 = (rho_a - rho_b) / dens_1
        if 1.0 - zeta_1 <= 2.220446049250313e-16 {
            z_thr_2 = -0.9999999999999998
        }
        else {
            if 1.0 + zeta_1 <= 2.220446049250313e-16 {
                branch_4 = 0.9999999999999998
            }
            else {
                branch_4 = -zeta_1
            }
            z_thr_2 = branch_4
        }
        t_1 = 1.0 / dens_1
        if 2.0 * rho_b * t_1 <= 2.220446049250313e-16 {
            z_thr_3 = -0.9999999999999998
        }
        else {
            if 2.0 * rho_a * t_1 <= 2.220446049250313e-16 {
                branch_5 = 0.9999999999999998
            }
            else {
                branch_5 = -zeta_1
            }
            z_thr_3 = branch_5
        }
        n_spin_1 = (1.0 + z_thr_3) * dens_1 / 2.0
        gds08_fs_1 = (1.0 + z_thr_2) / 2.0 * (0.86 + 0.224 * log(2.0 * n_spin_1))
        branch_3 = gds08_fs_1
    }
    gds08_f = branch + branch_3
    return gds08_f
}

#| the energy per volume, unpolarized: libxc's mf, whose gradient is vrho
def _mf_unpol(x: Arr) -> Num {
    return x[0] * zk_unpol(x)
}

#| the energy per volume, spin-polarized
def _mf_pol(x: Arr) -> Num {
    return (x[0] + x[1]) * zk_pol(x)
}

#| libxc's xc_lda_exc_vxc, unpolarized: per point [zk, vrho]
def eval_unpol(rho: Arr) -> Arr {
    n = len(rho)
    width = 2
    out = zeros(width * n)
    for i to n {
        if rho[i] >= DENS_THRESHOLD {
            x = [max(DENS_THRESHOLD, rho[i])]
            g = grad(_mf_unpol, x)
            out[width * i] = zk_unpol(x)
            out[width * i + 1] = g[0]
        }
    }
    return out
}

#| libxc's xc_lda_exc_vxc, spin-polarized: rho = [rho_a, rho_b] per point, out [zk, vrho_a, vrho_b]
def eval_pol(rho: Arr) -> Arr {
    nspin = 2
    width = 3
    n = len(rho) // nspin
    out = zeros(width * n)
    for i to n {
        if rho[nspin * i] + rho[nspin * i + 1] >= DENS_THRESHOLD {
            x = [max(DENS_THRESHOLD, rho[nspin * i]), max(DENS_THRESHOLD, rho[nspin * i + 1])]
            g = grad(_mf_pol, x)
            out[width * i] = zk_pol(x)
            out[width * i + 1] = g[0]
            out[width * i + 2] = g[1]
        }
    }
    return out
}
