/target
**/*.rs.bk
.DS_Store
.claude/

# generated wasm artifact for the Skein browser page (rebuild with lang/skein/web/build.sh)
lang/skein/web/skein.wasm

# generated C from the examples (rebuild with: cargo run -p viv -- <file>.viv -o out.c)
lang/viv/examples/*.c

# the browser compiler artifact (rebuild with www/build-wasm.sh)
www/public/viv/viv.wasm
www/public/embed/viv.wasm

# website
# staged from node_modules by scripts/stage-monaco.mjs
www/public/monaco/
# staged from lang/viv/ by scripts/stage.mjs
www/public/programs/
# generated by scripts/llms-build.mjs from the docs, builtins and reference
www/public/llms.txt
www/public/llms-full.txt
www/public/viv-prompt-pack.md
www/node_modules
www/dist/
www/.astro/
# runs cached by scripts/claims-build.mjs, keyed by the hash of the post
www/.claims-cache/

# python bytecode
__pycache__/

# numpy reference results, remembered by dft/ref/make_deck.py
dft/ref/.cache/
# staged by scripts/dft-precompute.mjs: deck + engine + checks, one program per material
www/public/dft/
# staged by www/scripts/engine-build.mjs: engine programs, modules and example inputs
www/public/engines/

# the feed server's database, and its WAL
server/*.sqlite
server/*.sqlite-*
tools/.nistcache

# site test output (www/scripts/sitetest.mjs)
www/sitetest-report.json

# the server's dev dependency (the MCP SDK client its tests use)
server/node_modules

# temporary copies made by dft/lens.sh while it runs the lens tools
dft/.lens.*/
# staged by www/scripts/explore-build.mjs: one bundle per program in www/src/data/explorables.mjs
www/public/explore/
# the runs' call graphs, kept by www/scripts/explore-build.mjs by the program's hash
www/.explore-cache/
# showcase runs, kept by www/scripts/show-build.mjs by the program's hash
www/.show-cache/
www/.explore-build.log
www/.explore-build.pid

# py2viv check_rules.py: differential runs cached by content
tools/py2viv/.rule_cache/
tools/algo/.work-*/

# the inventory (tools/inventory.mjs), written by www's `npm run stage`; `node tools/inventory.mjs ls` builds it fresh
/inventory.json
/INVENTORY.md

# the maintainer's release notes, kept out of the published tree
/study/release/AUDIT.md
/study/release/CHECKLIST.md
