#| Prices the digits lens reads (`viv digits examples/options/digits_prices.viv`):
#| a European call by Black-Scholes, the same call and an American put on a
#| 500-step binomial tree, and the implied volatility recovered from the
#| Black-Scholes price.
from bs import bs_price, implied_vol
from crr import crr_price

S = 100.0
K = 105.0
T = 0.5
r = 0.03
q = 0.0
sigma = 0.25
steps: Int = 500
call = bs_price(S, K, T, r, q, sigma, true)
print("Black-Scholes call ", call)
print("binomial call      ", crr_price(S, K, T, r, q, sigma, steps, true, false))
print("binomial American put ", crr_price(S, K, T, r, q, sigma, steps, false, true))
print("implied volatility ", implied_vol(call, S, K, T, r, q, true))

