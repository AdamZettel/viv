#| A sum of n terms of 0.1 by a loop, by Kahan's compensated loop, and
#| by the built-in sum (pairwise). The loop's error grows with the count;
#| the compensated sum carries the lost low bits forward.
n = 100000
x = zeros(n)
fill(x, 0.1)
naive = 0.0
for i to n {
    naive = naive + x[i]
}
total = 0.0
carry = 0.0
for i to n {
    y = x[i] - carry
    t = total + y
    carry = (t - total) - y
    total = t
}
print("loop  ", naive)
print("kahan ", total)
print("sum   ", sum(x))

