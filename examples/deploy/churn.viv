#| The model on `rows` rows: see the top of the file.
def score(xf: Arr, xi: [Int], rows: Int) -> Arr {
    if numel(xf) != rows * NF or len(xi) != rows * NI {
        stop(f"score: {rows} rows need {rows * NF} floats and {rows * NI} integers; got {numel(xf)} and {len(xi)}")
    }
    card = int_zeros(rows)
    ts = int_zeros(rows)
    declined = int_zeros(rows)
    chargeback = int_zeros(rows)
    for i to rows {
        card[i] = xi[i * NI + 0]
        ts[i] = xi[i * NI + 1]
        declined[i] = xi[i * NI + 3]
        chargeback[i] = xi[i * NI + 4]
    }
    #: features: features.card_features(card, ts, declined, chargeback)
    f0 = features.card_features(card, ts, declined, chargeback)
    out = zeros(rows, NOUT)
    #: row by row: the transformers, then the estimator
    for i to rows {
        r_card: Int = xi[i * NI + 0]
        r_ts: Int = xi[i * NI + 1]
        r_amount = xf[i, 0]
        if r_amount != r_amount {
            stop(f"row {i}: column amount is NaN, which this pipeline refuses (scikit-learn raises ValueError)")
        }
        if abs(r_amount) == inf {
            stop(f"row {i}: column amount is infinite, which this pipeline refuses (scikit-learn raises ValueError)")
        }
        r_merchant: Int = xi[i * NI + 2]
        r_declined: Int = xi[i * NI + 3]
        r_chargeback: Int = xi[i * NI + 4]
        r_n_prev_1h: Int = f0.n_prev_1h[i]
        r_status: Int = f0.status[i]
        #: num
        #: StandardScaler on amount, n_prev_1h: (x - mean) / scale
        v1 = (r_amount - 60.068621083333326) / 42.48865694585739
        v2 = (float(r_n_prev_1h) - 0.292725) / 0.5177229706850953
        #: cat
        #: OneHotEncoder on merchant: 6 categories, unknown -> all zeros
        v3 = 1.0 if r_merchant == 0 else 0.0
        v4 = 1.0 if r_merchant == 1 else 0.0
        v5 = 1.0 if r_merchant == 2 else 0.0
        v6 = 1.0 if r_merchant == 3 else 0.0
        v7 = 1.0 if r_merchant == 4 else 0.0
        v8 = 1.0 if r_merchant == 5 else 0.0
        #: OneHotEncoder on status: 3 categories, unknown -> all zeros
        code9: Int = -1
        if float(r_status) == 0.0 {
            code9 = 0
        }
        if float(r_status) == 1.0 {
            code9 = 1
        }
        if float(r_status) == 2.0 {
            code9 = 2
        }
        v10 = 1.0 if code9 == 0 else 0.0
        v11 = 1.0 if code9 == 1 else 0.0
        v12 = 1.0 if code9 == 2 else 0.0
        #: the features the trees read
        z0 = v1
        z1 = v2
        z2 = v3
        z3 = v4
        z4 = v5
        z5 = v6
        z6 = v7
        z7 = v8
        z8 = v10
        z9 = v11
        z10 = v12
        #: the estimator
        raw13 = INIT_RAW[0]
        #: each stage adds learning_rate * the leaf's value, fused into one rounding as scikit-learn's compiled loop does on this machine
        raw13 = fma(LEARNING_RATE, _tree0(z0, z1, z10), raw13)
        raw13 = fma(LEARNING_RATE, _tree1(z0, z1, z10), raw13)
        raw13 = fma(LEARNING_RATE, _tree2(z0, z1, z7, z8), raw13)
        raw13 = fma(LEARNING_RATE, _tree3(z0, z1, z10), raw13)
        raw13 = fma(LEARNING_RATE, _tree4(z0, z1, z7, z8), raw13)
        raw13 = fma(LEARNING_RATE, _tree5(z0, z1, z7, z8), raw13)
        raw13 = fma(LEARNING_RATE, _tree6(z0, z1, z10), raw13)
        raw13 = fma(LEARNING_RATE, _tree7(z0, z1, z7, z8), raw13)
        raw13 = fma(LEARNING_RATE, _tree8(z0, z1, z5, z8), raw13)
        raw13 = fma(LEARNING_RATE, _tree9(z0, z1, z7, z10), raw13)
        raw13 = fma(LEARNING_RATE, _tree10(z0, z1, z7, z8), raw13)
        raw13 = fma(LEARNING_RATE, _tree11(z0, z1, z7, z8), raw13)
        raw13 = fma(LEARNING_RATE, _tree12(z0, z1, z10), raw13)
        raw13 = fma(LEARNING_RATE, _tree13(z0, z7, z8), raw13)
        raw13 = fma(LEARNING_RATE, _tree14(z0, z1, z5, z8), raw13)
        raw13 = fma(LEARNING_RATE, _tree15(z0, z1, z10), raw13)
        raw13 = fma(LEARNING_RATE, _tree16(z0, z7, z8), raw13)
        raw13 = fma(LEARNING_RATE, _tree17(z0, z1, z7, z10), raw13)
