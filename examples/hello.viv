# Newton's method for a square root, the program on viv-lang.org's home page
# written as a def, so Python can call it too (vp.load("examples/hello.viv")).
# deriv() is exact: the compiler differentiates the expression.
NEWTON_STEPS = 6

def newton_sqrt(a: Num) -> Num {
    x = 1.0
    for i to NEWTON_STEPS {
        x = x - (x * x - a) / deriv(fn(t) -> t * t - a, x)
    }
    return x
}

x = newton_sqrt(2.0)
# sixteen digits: the default six would hide how close it is
show fmt(x, ".16g")

test "x squared is 2, within one unit in the last place of 2" {
    assert_near(x * x, 2.0, 4.5e-16)
}
