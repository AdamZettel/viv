#| One explicit step of the heat equation as a `parallel for`: one GPU
#| thread per grid point. `viv cuda heat.viv`
#| writes the loop as a CUDA kernel. The reference is the same step written
#| with slices, whose operations are the loop's in the same order.

def heat_loop(u: Arr, r: Num) -> Arr {
    n = len(u)
    out = zeros(n)
    parallel for i to n {
        if i == 0 or i == n - 1 {
            out[i] = u[i]
        }
        else {
            out[i] = u[i] + r * (u[i - 1] - 2.0 * u[i] + u[i + 1])
        }
    }
    return out
}

def heat_slices(u: Arr, r: Num) -> Arr {
    n = len(u)
    out = copy(u)
    out[1:n - 1] = u[1:n - 1] + r * (u[0:n - 2] - 2.0 * u[1:n - 1] + u[2:n])
    return out
}

contract heat_step(u: Arr, r: Num) -> v: Arr {
    intent "one explicit Euler step of u_t = u_xx with the ends held, r = dt / dx^2"
    methods heat_slices, heat_loop
    agree v exactly
}

N: Int = 101
R = 0.4
STEPS: Int = 50
u = zeros(N)
for i to N {
    u[i] = exp(-((i - 50.0) / 8.0) ^ 2)
}
for s to STEPS {
    u = heat_loop(u, R)
}
show u[50]
show sum(u)

test "the loop equals the slices bit for bit, every step" {
    v = zeros(N)
    for i to N {
        v[i] = exp(-((i - 50.0) / 8.0) ^ 2)
    }
    for s to STEPS {
        v = heat_step(v, R) using every method
    }
    assert_near(max(abs(v - u)), 0.0, 0.0)
}

