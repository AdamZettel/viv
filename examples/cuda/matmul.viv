#| The matrix product C = A B in float64 on a GPU, exact mode: two kernels
#| whose every entry is the CPU's `@` bit for bit (lang/viv/src/interp/matmul.rs).
#| Each entry is the sum over p in ascending order,
#|
#|     c[i, j] = (((0 + a[i, 0] b[0, j]) + a[i, 1] b[1, j]) + ...) + a[i, k-1] b[k-1, j]
#|
#| with a product and an addition each rounded (no fused multiply-add), and a
#| term left out where a[i, p] is zero, as `@` does. Matrices are flat arrays,
#| row by row: A is m by k, B is k by n, C is m by n.

#| The side of a square tile of C: one block computes TILE x TILE entries.
TILE: Int = 16
TILE_AREA: Int = TILE * TILE
#| The threads of a block of the naive kernel: NX along a row of C, NY rows.
NX: Int = 16
NY: Int = 16

#| One thread per entry of C, reading A and B from global memory.
kernel def matmul_naive(a: Arr, b: Arr, c: Arr, m: Int, k: Int, n: Int) {
    col = block_id(0) * block_size(0) + thread_id(0)
    row = block_id(1) * block_size(1) + thread_id(1)
    if row < m and col < n {
        acc = 0.0
        for p to k {
            x = a[row * k + p]
            if x != 0.0 {
                acc = acc + x * b[p * n + col]
            }
        }
        c[row * n + col] = acc
    }
}
schedule matmul_naive(threads = [NX, NY], cover = [n, m])

#| One thread per entry of C, a block per TILE x TILE tile of it. The depth is
#| taken a tile at a time: the block copies a tile of A and a tile of B into
#| shared memory, then each thread adds that tile's TILE terms to its entry,
#| in the order of p. Past the edges of A and B the tiles hold zeros, which
#| the zero rule leaves out, so the sum is the naive kernel's term for term.
#| An entry's running sum is kept in shared memory between tiles: a thread's
#| own variables do not survive a barrier.
kernel def matmul_tiled(a: Arr, b: Arr, c: Arr, m: Int, k: Int, n: Int) {
    sa = shared(TILE_AREA)
    sb = shared(TILE_AREA)
    sc = shared(TILE_AREA)
    tx = thread_id(0)
    ty = thread_id(1)
    me = ty * TILE + tx
    col = block_id(0) * TILE + tx
    row = block_id(1) * TILE + ty
    sc[me] = 0.0
    for q to (k + TILE - 1) // TILE {
        p0 = q * TILE
        if row < m and p0 + tx < k {
            sa[me] = a[row * k + p0 + tx]
        }
        else {
            sa[me] = 0.0
        }
        if p0 + ty < k and col < n {
            sb[me] = b[(p0 + ty) * n + col]
        }
        else {
            sb[me] = 0.0
        }
        barrier()
        acc = sc[me]
        for p to TILE {
            x = sa[ty * TILE + p]
            if x != 0.0 {
                acc = acc + x * sb[p * TILE + tx]
            }
        }
        sc[me] = acc
        barrier()
    }
    if row < m and col < n {
        c[row * n + col] = sc[me]
    }
}
schedule matmul_tiled(threads = [TILE, TILE], cover = [n, m])

#| Entries in [-1, 1) from whole-number arithmetic and one division, so the
#| GPU host program makes the same bits;
#| one entry in MODULUS is zero, which exercises the zero rule.
MODULUS: Int = 2003
HALF = 1001.0
A_MULT: Int = 7919
B_MULT: Int = 104729

def filled(rows: Int, cols: Int, mult: Int) -> Arr {
    x = zeros(rows * cols)
    for i to rows * cols {
        x[i] = ((i * mult) % MODULUS) / HALF - 1.0
    }
    return x
}

#| The reference: the CPU's `@`.
def reference(m: Int, k: Int, n: Int) -> Arr {
    a = reshape(filled(m, k, A_MULT), m, k)
    b = reshape(filled(k, n, B_MULT), k, n)
    return ravel(a @ b)
}

def product_naive(m: Int, k: Int, n: Int) -> Arr {
    return matmul_naive(filled(m, k, A_MULT), filled(k, n, B_MULT), zeros(m * n), m, k, n)
}

def product_tiled(m: Int, k: Int, n: Int) -> Arr {
    return matmul_tiled(filled(m, k, A_MULT), filled(k, n, B_MULT), zeros(m * n), m, k, n)
}

#| Shapes that leave partial tiles along every axis, and one of whole tiles.
SHAPES = [[20, 13, 29], [33, 40, 17], [32, 32, 32]]
worst = 0.0
for s to len(SHAPES) {
    m: Int = int(SHAPES[s, 0])
    k: Int = int(SHAPES[s, 1])
    n: Int = int(SHAPES[s, 2])
    want = reference(m, k, n)
    worst = max(worst, max(abs(product_naive(m, k, n) - want)))
    worst = max(worst, max(abs(product_tiled(m, k, n) - want)))
}
show worst

test "both kernels equal the CPU's @ bit for bit" {
    assert_near(worst, 0.0, 0.0)
}

