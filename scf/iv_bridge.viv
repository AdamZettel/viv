def ivb_mp_idx() -> Arr {
    return [231, 404, 102, 2, 395, 87, 140, 306, 70, 322, 25, 48, 362, 352, 28, 337, 402, 145, 396, 173, 73, 17, 166, 71, 86, 157, 301, 380, 260, 321, 363, 348, 156, 154, 126, 248, 64, 274, 340, 281, 298, 229, 31, 3, 259, 359, 273, 205, 199, 131, 33, 230, 95, 366, 137, 262, 211, 292, 347, 349, 234, 149, 79, 135, 195, 8, 336, 62, 39, 299, 6, 90, 111, 343, 114, 290, 261, 51, 81, 193, 13, 370, 389, 316, 101, 309, 109, 209, 130, 314, 356, 251, 42, 263, 232, 125, 317, 212, 153, 305]
}

#| The entries where PySCF's value lies outside the enclosures, as flat
#| indices: 8 of V, then 2 positions in the ERI sample.
def ivb_pyscf_off_v() -> Arr {
    return [11, 12, 13, 29, 36, 41, 43, 47]
}
def ivb_pyscf_off_eri() -> Arr {
    return [12, 82]
}

#| PySCF's values with the listed entries replaced by the 40-digit ones.
def ivb_fixed(ref: Arr, mpv: Arr, off: Arr) {
    R = copy(ref)
    for k to len(off) {
        R[off[k]] = mpv[off[k]]
    }
    return R
}

#| What ivb_stage finds for one stage's two enclosures: the entries where
#| they miss each other; the point values, 40-digit values and fixed-PySCF
#| values outside either; the listed entries where PySCF's value is inside
#| the common part (each listed entry must be one PySCF misses); the widest
#| relative width among enclosures that exclude 0 and the widest absolute
#| width of those that contain 0; the widest relative width of the common
#| part of MD and OS where it excludes 0.
record IvbStage {
    miss: Num
    point: Num
    mp: Num
    fixed: Num
    listed: Num
    relw: Num
    absw: Num
    common: Num
}

#| Checks one stage's two enclosures (flat, `N` entries each) against point
#| values and references.
def ivb_stage(A: Arr, B: Arr, P: Arr, np, N, mpv: Arr, ref: Arr, off: Arr) -> IvbStage {
    miss = 0
    point = 0
    mp = 0
    nfixed = 0
    listed = 0
    relw = 0.0
    absw = 0.0
    common = 0.0
    fixed = ivb_fixed(ref, mpv, off)
    for k to N {
        IA = iv_get(A, k)
        IB = iv_get(B, k)
        miss = miss + 1 - iv_overlaps(IA, IB)
        for m to np {
            point = point + 2 - iv_contains(IA, P[m, k]) - iv_contains(IB, P[m, k])
        }
        MAB = iv_meet(IA, IB)
        if MAB[0] > 0.0 or MAB[1] < 0.0 {
            common = max(common, iv_relw(MAB))
        }
        mp = mp + 2 - iv_contains(IA, mpv[k]) - iv_contains(IB, mpv[k])
        nfixed = nfixed + 2 - iv_contains(IA, fixed[k]) - iv_contains(IB, fixed[k])
        for j to 2 {
            I = IA
            if j == 1 {
                I = IB
            }
            if I[0] > 0.0 or I[1] < 0.0 {
                relw = max(relw, iv_relw(I))
            }
            else {
                absw = max(absw, iv_width(I))
            }
        }
    }
    for k to len(off) {
        # PySCF is outside the common part at every listed entry
        M = iv_meet(iv_get(A, off[k]), iv_get(B, off[k]))
        listed = listed + iv_contains(M, ref[off[k]])
        assert_lt(abs(ref[off[k]] - mpv[off[k]]), 3.0e-14)
    }
    return IvbStage { miss: miss, point: point, mp: mp, fixed: nfixed, listed: listed, relw: relw, absw: absw, common: common }
}

#| The point members' results stacked `[np, N]`.
def ivb_points(ms, N) {
    at = watersto3g_atoms()
    sh = watersto3g_shells()
    pr = watersto3g_prims()
    P = zeros(len(ms), N)
    for m to len(ms) {
        setslab(P, m, iv_flat(apply(ms[m], at, sh, pr), N))
    }
    return P
}

#| One stage end to end: the two enclosures, the checks of `ivb_stage`, and
#| the asserting `sweep_iv3` with its report. Returns the `ivb_stage` record.
def ivb_run(ms, ivs, N, mpv: Arr, ref: Arr, off: Arr) -> IvbStage {
    at = watersto3g_atoms()
    sh = watersto3g_shells()
    pr = watersto3g_prims()
    A = iv_flat(apply(ivs[0], at, sh, pr), 2 * N)
    B = iv_flat(apply(ivs[1], at, sh, pr), 2 * N)
    r = ivb_stage(A, B, ivb_points(ms, N), len(ms), N, mpv, ref, off)
    rep = sw_rep_new()
    C = iv_flat(sweep_iv3(ms, ivs, at, sh, pr, N, N, 1.0e-12, rep), N)
    k = round(rep[SW_REP_INDEX])
    assert_true(rep[SW_REP_LO] <= C[k] and C[k] <= rep[SW_REP_HI])
    assert_near(rep[SW_REP_NSTRAT], len(ms), 0)
    return r
}

#| The assertions every stage shares.
def ivb_assert(r: IvbStage, noff) {
    assert_near(r.miss, 0, 0)
    assert_near(r.point, 0, 0)
    assert_near(r.mp, 0, 0)
    assert_near(r.fixed, 0, 0)
    assert_near(r.listed, 0, 0)
    assert_lt(r.relw, 1.0e-10)
    assert_lt(r.absw, 1.0e-14)
    return noff
}

test "the ERI sample is the one the 40-digit values were computed for" {
    ivb_si = iv_eri_sample_idx(watersto3g_shells())
    ivb_sm = ivb_mp_idx()
    assert_near(len(ivb_si), 100, 0)
    assert_true(all(ivb_si == ivb_sm))
}

test "S: md1, os and gh inside the MD and OS enclosures, which hold PySCF and mpmath" {
    ivb_rs = ivb_run([md1_s, os_overlap, gh_overlap], [iv_md_s, iv_os_s], 49, ivb_mp_s(), iv_flat(watersto3g_s_unit(), 49), zeros(0))
    ivb_assert(ivb_rs, 0)
    # common part of MD and OS: measured 1.9e-14
    assert_lt(ivb_rs.common, 1.0e-13)
    # measured 1.9e-14 at the widest
    assert_lt(ivb_rs.relw, 1.0e-13)
}

test "T: md1, os and gh inside the MD and OS enclosures, which hold PySCF and mpmath" {
    ivb_rt = ivb_run([md1_t, os_kinetic, gh_kinetic], [iv_md_t, iv_os_t], 49, ivb_mp_t(), iv_flat(watersto3g_t_unit(), 49), zeros(0))
    ivb_assert(ivb_rt, 0)
    # common part of MD and OS: measured 2.33e-13
    assert_lt(ivb_rt.common, 2.4e-13)
    # measured 5.0e-12, MD's enclosure of T(O 1s, H 1s) = -0.00256
    assert_lt(ivb_rt.relw, 1.0e-11)
}

test "V: md1 and os inside; PySCF inside except 8 entries it rounds off by up to 2.6e-14" {
    ivb_rv = ivb_run([md1_v, os_nuclear], [iv_md_v, iv_os_v], 49, ivb_mp_v(), iv_flat(watersto3g_v_unit(), 49), ivb_pyscf_off_v())
    ivb_assert(ivb_rv, 8)
    # common part of MD and OS: measured 2.5e-14
    assert_lt(ivb_rv.common, 1.0e-13)
    assert_lt(ivb_rv.relw, 1.0e-13)
}

test "100 ERIs: mderi, hgp and rys inside; PySCF inside except 2 it rounds off" {
    ivb_re = ivb_run([ivb_mderi_sample, ivb_hgp_sample, ivb_rys_sample], [iv_md_eri_sample, iv_os_eri_sample], 100, ivb_mp_eri(), take(watersto3g_eri8_cart(), ivb_mp_idx()), ivb_pyscf_off_eri())
    ivb_assert(ivb_re, 2)
    # common part of MD and OS: measured 6.1e-14
    assert_lt(ivb_re.common, 1.0e-13)
    assert_lt(ivb_re.relw, 1.0e-12)
}

test "a point strategy corrupted by 1e-9 is reported by strategy and flat index" {
    ivb_cat = watersto3g_atoms()
    ivb_csh = watersto3g_shells()
    ivb_cpr = watersto3g_prims()
    ivb_crep = sw_rep_new()
    ivb_cout = zeros(49)
    # against the enclosure, with a tolerance the median check would pass
    ivb_cv = iv_check3([md1_s, os_overlap, ivb_bad_s], [iv_md_s, iv_os_s], ivb_cat, ivb_csh, ivb_cpr, 49, 49, 1.0e-6, ivb_crep, ivb_cout)
    assert_near(ivb_cv, 0, 0)
    assert_near(ivb_crep[SW_REP_STRAT], 2, 0)
    assert_near(ivb_crep[SW_REP_INDEX], 12, 0)
    assert_true(ivb_crep[SW_REP_LO] <= ivb_cout[12] and ivb_cout[12] <= ivb_crep[SW_REP_HI])
    # with two point members the median cannot choose; the enclosure can
    ivb_cv2 = iv_check3([ivb_bad_s, os_overlap], [iv_md_s, iv_os_s], ivb_cat, ivb_csh, ivb_cpr, 49, 49, 1.0e-6, ivb_crep, ivb_cout)
    assert_near(ivb_cv2, 0, 0)
    assert_near(ivb_crep[SW_REP_STRAT], 0, 0)
    assert_near(ivb_crep[SW_REP_INDEX], 12, 0)
    # the median check of lib/hf/sweep also names it, at the contract tolerance
    ivb_cv3 = sw_check3_arr([md1_s, os_overlap, ivb_bad_s], ivb_cat, ivb_csh, ivb_cpr, 49, 49, 1.0e-12, ivb_crep, ivb_cout)
    assert_near(ivb_cv3, 0, 0)
    assert_near(ivb_crep[SW_REP_STRAT], 2, 0)
    assert_near(ivb_crep[SW_REP_INDEX], 12, 0)
}

