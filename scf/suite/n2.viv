# PySCF's N2 rows (test_rhf.py and test_uhf.py, the module molecule
# `n2sym`: N2 at 1 A in cc-pVDZ, 28 spherical AOs): RHF and UHF on the
# closed shell, the energy of the converged density against the SCF energy,
# a custom core Hamiltonian handed to UHF, the one-electron energy, and the
# N2+ cation with UHF and ROHF.
#
# The packs come from scf/suite/ref/stb (generated by scf/suite/gen_ref.py);
# lib/hfref has no N2 in cc-pVDZ. `n2sym` has symmetry=1; the SCF here builds
# no symmetry-adapted orbitals and must land on the same states.
#
#     tools/both-engines.sh scf/suite n2
from hf.hf import hf_gap, hf_scf, hf_setup, hf_setup_of, hf_step
from hf.molecule import Molecule, molecule_packs
from hf.scf_loop import scf_opts, scf_setup, ScfResult, ScfSetup
from hf.opts import scf_checked, SCF_ROHF, SCF_UHF, ScfOptions
from hf.guess import GS_AVG, GS_CORE
from hfref.pyscf_tests import (
    PST_FILE_RHF, PST_FILE_UHF, pst_n2_atoms, PST_RHF_301, PST_RHF_301_P, PST_RHF_516,
    PST_RHF_516_P, PST_RHF_523, PST_RHF_523_P, PST_UHF_207, PST_UHF_207_P, PST_UHF_213,
    PST_UHF_213_P, PST_UHF_387, PST_UHF_387_P, PST_UHF_465, PST_UHF_465_P, PST_UHF_471,
    PST_UHF_471_P,
)
from scf.suite.ref.sts import sts_eig, sts_row
from scf.suite.ref.stb import stb_n2_atoms, STB_N2_NAO_SPH, stb_n2_prims, stb_n2_shells


#| One SCF; asserts convergence.
def sn2_run(p: ScfSetup) -> ScfResult {
    r = hf_scf(p)
    assert_near(r.converged, 1.0, 0.0)
    return r
}

#| N2 with `charge`, `spin`, `method` and guess `g`, on the integrals below.
def sn2_setup(p: ScfSetup, mol: Molecule, charge, spin, method, g) -> ScfSetup {
    return hf_setup_of(Molecule { charge: charge, spin: spin, ..mol }, p.h, p.s, p.eri, ScfOptions { method: method, guess: g, ..scf_checked() })
}

sn2_m = molecule_packs(stb_n2_atoms(), stb_n2_shells(), stb_n2_prims())
sn2_p = hf_setup(sn2_m, scf_checked())

test "N2 RHF -108.9298383856092, and the energy of its density is the SCF energy (test_rhf.py:516, 301)" {
    assert_lt(hf_gap(sn2_m.atoms, pst_n2_atoms(), 8), 1.0e-15)
    assert_near(STB_N2_NAO_SPH, 28, 0.0)
    sn2_r = sn2_run(sn2_p)
    assert_near(sts_row(PST_FILE_RHF, 516, sn2_r.energy, PST_RHF_516, PST_RHF_516_P), 1.0, 0.0)
    # energy_tot(make_rdm1()): E recomputed from the converged density
    sn2_f = hf_step(sn2_p, sn2_r.alpha.density, sn2_r.beta.density)
    assert_near(sts_row(PST_FILE_RHF, 301, sn2_f.energy, PST_RHF_301, PST_RHF_301_P), 1.0, 0.0)
}

test "N2 UHF on the closed shell, its density's energy, and UHF given (h, h) as the core Hamiltonian (test_uhf.py:207, 387, 465)" {
    sn2_u = sn2_setup(sn2_p, sn2_m, 0, 0, SCF_UHF, GS_AVG)
    sn2_r = sn2_run(sn2_u)
    assert_near(sts_row(PST_FILE_UHF, 207, sn2_r.energy, PST_UHF_207, PST_UHF_207_P), 1.0, 0.0)
    sn2_f = hf_step(sn2_u, sn2_r.alpha.density, sn2_r.beta.density)
    assert_near(sts_row(PST_FILE_UHF, 387, sn2_f.energy, PST_UHF_387, PST_UHF_387_P), 1.0, 0.0)
    # test_custom_h1e hands UHF the pair (h, h): one core Hamiltonian per
    # spin, the same for both, which is what this UHF uses anyway
    assert_near(sts_row(PST_FILE_UHF, 465, sn2_r.energy, PST_UHF_465, PST_UHF_465_P), 1.0, 0.0)
}

test "one electron with UHF: the lowest eigenvalue of h C = S C e plus E_nuc (test_uhf.py:471)" {
    # PySCF's HF1e diagonalizes the core Hamiltonian once. The SCF here
    # starts from the same core guess; with one electron J and K cancel on the
    # occupied orbital and raise the others, so the start is already the
    # fixed point. (The production guess mixes 1 sigma_g and 1 sigma_u, which
    # are nearly degenerate, and settles on a stationary point above it.)
    sn2_u = sn2_setup(sn2_p, sn2_m, 0, 0, SCF_UHF, GS_CORE)
    sn2_one = scf_setup(sn2_u.h, sn2_u.s, sn2_u.eri, 1, 0, sn2_u.enuc, sn2_u.options)
    sn2_r = sn2_run(sn2_one)
    sn2_R = sts_eig(sn2_p.h, sn2_p.s, scf_opts(sn2_one))
    assert_lt(abs(sn2_r.energy - sn2_R[0, 0] - sn2_one.enuc), 1.0e-11)
    assert_near(sts_row(PST_FILE_UHF, 471, sn2_r.energy, PST_UHF_471, PST_UHF_471_P), 1.0, 0.0)
}

test "N2+ from the core guess: UHF -108.34691774091894 and ROHF -108.33899076078299 (test_uhf.py:213, test_rhf.py:523)" {
    # N2+ has more than one SCF state. PySCF's minao, 1e and atom guesses all
    # land on these two (measured with PySCF 2.5.0, conv_tol 1e-10); its 1e
    # guess is this code's core guess, so the rows start from it. The
    # production guess here (spin-averaged, from the GWH matrix) lands on
    # another state 19.3 mEh (UHF) and 13.6 mEh (ROHF) higher; that is asserted
    # below so a change in where it lands shows up.
    sn2_r = sn2_run(sn2_setup(sn2_p, sn2_m, 1, 1, SCF_UHF, GS_CORE))
    assert_near(sts_row(PST_FILE_UHF, 213, sn2_r.energy, PST_UHF_213, PST_UHF_213_P), 1.0, 0.0)
    sn2_x = sn2_run(sn2_setup(sn2_p, sn2_m, 1, 1, SCF_UHF, GS_AVG))
    assert_lt(sn2_r.energy + 0.015, sn2_x.energy)
    sn2_r = sn2_run(sn2_setup(sn2_p, sn2_m, 1, 1, SCF_ROHF, GS_CORE))
    assert_near(sts_row(PST_FILE_RHF, 523, sn2_r.energy, PST_RHF_523, PST_RHF_523_P), 1.0, 0.0)
    sn2_x = sn2_run(sn2_setup(sn2_p, sn2_m, 1, 1, SCF_ROHF, GS_AVG))
    assert_lt(sn2_r.energy + 0.010, sn2_x.energy)
}
