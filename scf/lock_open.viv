# Open shells on computed integrals: OH and O2 in 6-31G*, UHF and ROHF, each
# at the state PySCF 2.5.0 labels (lib/hfref/oh_631gs, o2_631gs).
#
# Every integral here is computed from the basis packs by lib/hf, with MD and
# HGP swept against each other over the whole set, and held to PySCF's
# integrals: the full sets for OH (17 Cartesian AOs), checksums, the pair
# diagonal and 256 samples for O2 (30). Then the SCF runs on them.
#
# O2 has two ROHF states. From every guess in lib/hf/guess the SCF lands on
# the one PySCF's minao guess reaches (`_DEFAULT`, -149.59185715618136). The
# lower, stable one (-149.59202183229573) is reached here by importing
# PySCF's density for it: one plain step from that density must give it back
# (the fixed-point check), and an SCF started there must stay there.
#
#     tools/both-engines.sh scf lock_open
from hf.hf import (
    hf_c2s, hf_eri_oracle, hf_gap, hf_hcore, hf_lock_assert, hf_lock_report, hf_oracle_assert,
    hf_overlap, hf_scf_from, hf_setup, hf_setup_of, hf_step,
)
from hf.molecule import mol_enuc, Molecule, molecule_packs
from hf.scf_loop import scf_density_gap, scf_setup_with, ScfSetup
from hf.opts import scf_checked, SCF_ROHF, SCF_UHF, ScfOptions
from hf.integrals import int_eri, INT_ERI_PAIR, int_sph4
from hf.sweep import sw_rep_new, SW_REP_NSTRAT
from hfref.oh_631gs import (
    oh_631gs_atoms, OH_631GS_E_NUC, OH_631GS_E_ROHF, OH_631GS_E_ROHF_CART, OH_631GS_E_UHF,
    OH_631GS_E_UHF_CART, oh_631gs_eri8_cart, OH_631GS_ERI8_CART_LEN, oh_631gs_eri8_sph,
    OH_631GS_ERI8_SPH_LEN, oh_631gs_prims, oh_631gs_rohf_da, oh_631gs_rohf_db, oh_631gs_s_sph,
    oh_631gs_shells, oh_631gs_t_sph, oh_631gs_uhf_da, oh_631gs_uhf_db, OH_631GS_UHF_S2,
    oh_631gs_v_sph,
)
from hfref.o2_631gs import (
    o2_631gs_atoms, O2_631GS_E_ROHF_DEFAULT, O2_631GS_E_ROHF_STABLE, O2_631GS_E_UHF,
    o2_631gs_eri8_cart_diag, o2_631gs_eri8_cart_idx, O2_631GS_ERI8_CART_SUMSQ,
    o2_631gs_eri8_cart_val, O2_631GS_ERI8_CART_WSUM, o2_631gs_eri8_sph_diag,
    o2_631gs_eri8_sph_idx, O2_631GS_ERI8_SPH_SUMSQ, o2_631gs_eri8_sph_val,
    O2_631GS_ERI8_SPH_WSUM, o2_631gs_prims, o2_631gs_s_sph, O2_631GS_SEED_WSUM, o2_631gs_shells,
    o2_631gs_t_sph, O2_631GS_UHF_S2, o2_631gs_v_sph,
)

#| The setup `p` running method `m`.
def lko_method(p: ScfSetup, m) -> ScfSetup {
    return scf_setup_with(p, ScfOptions { method: m, ..p.options })
}

test "OH 6-31G* 5D: integrals are PySCF's; UHF -75.38093753158927 and ROHF -75.37702555164822" {
    lko_m = molecule_packs(oh_631gs_atoms(), oh_631gs_shells(), oh_631gs_prims())
    assert_near(mol_enuc(lko_m), OH_631GS_E_NUC, 1.0e-13)
    lko_rep = sw_rep_new()
    lko_Gc = int_eri(lko_m.atoms, lko_m.shells, lko_m.prims, INT_ERI_PAIR, lko_rep)
    assert_near(lko_rep[SW_REP_NSTRAT], 2, 0.0)
    assert_lt(hf_gap(lko_Gc, oh_631gs_eri8_cart(), OH_631GS_ERI8_CART_LEN), 1.0e-12)
    lko_Gs = int_sph4(lko_Gc, hf_c2s(lko_m), lko_m.shells, lko_rep)
    assert_lt(hf_gap(lko_Gs, oh_631gs_eri8_sph(), OH_631GS_ERI8_SPH_LEN), 1.0e-12)
    lko_o = scf_checked()
    lko_S = hf_overlap(lko_m, lko_o)
    lko_H = hf_hcore(lko_m, lko_o)
    assert_lt(hf_gap(lko_S, oh_631gs_s_sph(), 256), 1.0e-12)
    assert_lt(hf_gap(lko_H, oh_631gs_t_sph() + oh_631gs_v_sph(), 256), 1.0e-12)
    lko_p = hf_setup_of(lko_m, lko_H, lko_S, lko_Gs, lko_o)
    lko_up = lko_method(lko_p, SCF_UHF)
    lko_u = hf_lock_report(lko_up, OH_631GS_E_UHF)
    hf_lock_assert(lko_u, lko_up)
    assert_lt(abs(lko_u.s2 - OH_631GS_UHF_S2), 1.0e-6)
    # PySCF's own UHF densities have PySCF's energy on these integrals
    lko_f = hf_step(lko_up, oh_631gs_uhf_da(), oh_631gs_uhf_db())
    assert_lt(abs(lko_f.energy - OH_631GS_E_UHF), 1.0e-10)
    lko_rp = lko_method(lko_p, SCF_ROHF)
    lko_r = hf_lock_report(lko_rp, OH_631GS_E_ROHF)
    hf_lock_assert(lko_r, lko_rp)
    lko_f = hf_step(lko_rp, oh_631gs_rohf_da(), oh_631gs_rohf_db())
    assert_lt(abs(lko_f.energy - OH_631GS_E_ROHF), 1.0e-10)
    # the variational ordering
    assert_lt(OH_631GS_E_UHF + lko_u.de, OH_631GS_E_ROHF + lko_r.de)
}

test "OH 6-31G* 6D: UHF -75.38214937611997 and ROHF -75.3782251872344" {
    lko_m = Molecule { cart: 1, ..molecule_packs(oh_631gs_atoms(), oh_631gs_shells(), oh_631gs_prims()) }
    lko_p = hf_setup(lko_m, scf_checked())
    lko_up = lko_method(lko_p, SCF_UHF)
    lko_u = hf_lock_report(lko_up, OH_631GS_E_UHF_CART)
    hf_lock_assert(lko_u, lko_up)
    lko_rp = lko_method(lko_p, SCF_ROHF)
    lko_r = hf_lock_report(lko_rp, OH_631GS_E_ROHF_CART)
    hf_lock_assert(lko_r, lko_rp)
}

test "O2 6-31G* 5D: integrals match PySCF's samples; UHF, ROHF default, and the stable ROHF state by import" {
    lko_m = molecule_packs(o2_631gs_atoms(), o2_631gs_shells(), o2_631gs_prims())
    assert_near(lko_m.spin, 0, 0.0)
    lko_m = Molecule { spin: 2, ..lko_m }
    lko_rep = sw_rep_new()
    lko_Gc = int_eri(lko_m.atoms, lko_m.shells, lko_m.prims, INT_ERI_PAIR, lko_rep)
    assert_near(lko_rep[SW_REP_NSTRAT], 2, 0.0)
    hf_oracle_assert(hf_eri_oracle(lko_Gc, o2_631gs_eri8_cart_idx(), o2_631gs_eri8_cart_val(), o2_631gs_eri8_cart_diag(), O2_631GS_ERI8_CART_SUMSQ, O2_631GS_ERI8_CART_WSUM, O2_631GS_SEED_WSUM))
    lko_Gs = int_sph4(lko_Gc, hf_c2s(lko_m), lko_m.shells, lko_rep)
    hf_oracle_assert(hf_eri_oracle(lko_Gs, o2_631gs_eri8_sph_idx(), o2_631gs_eri8_sph_val(), o2_631gs_eri8_sph_diag(), O2_631GS_ERI8_SPH_SUMSQ, O2_631GS_ERI8_SPH_WSUM, O2_631GS_SEED_WSUM))
    lko_o = scf_checked()
    lko_S = hf_overlap(lko_m, lko_o)
    lko_H = hf_hcore(lko_m, lko_o)
    assert_lt(hf_gap(lko_S, o2_631gs_s_sph(), 784), 1.0e-12)
    assert_lt(hf_gap(lko_H, o2_631gs_t_sph() + o2_631gs_v_sph(), 784), 1.0e-12)
    lko_p = hf_setup_of(lko_m, lko_H, lko_S, lko_Gs, lko_o)
    lko_up = lko_method(lko_p, SCF_UHF)
    lko_u = hf_lock_report(lko_up, O2_631GS_E_UHF)
    hf_lock_assert(lko_u, lko_up)
    assert_lt(abs(lko_u.s2 - O2_631GS_UHF_S2), 1.0e-6)
    lko_rp = lko_method(lko_p, SCF_ROHF)
    lko_r = hf_lock_report(lko_rp, O2_631GS_E_ROHF_DEFAULT)
    hf_lock_assert(lko_r, lko_rp)
    assert_lt(O2_631GS_E_UHF + lko_u.de, O2_631GS_E_ROHF_DEFAULT + lko_r.de)
    # the stable state: PySCF's step from lko_o2_stable_da/db moves them by
    # 1.409719507794449e-09, and so must ours
    lko_Da = lko_o2_stable_da()
    lko_Db = lko_o2_stable_db()
    lko_f = hf_step(lko_rp, lko_Da, lko_Db)
    assert_lt(abs(lko_f.energy - O2_631GS_E_ROHF_STABLE), 1.0e-9)
    assert_lt(max(max(abs(lko_f.alpha.density - lko_Da)), max(abs(lko_f.beta.density - lko_Db))), 1.0e-8)
    # an SCF started there converges there, below the default state
    lko_s = hf_scf_from(lko_rp, lko_Da, lko_Db)
    assert_near(lko_s.converged, 1.0, 0.0)
    assert_lt(abs(lko_s.energy - O2_631GS_E_ROHF_STABLE), 1.0e-9)
    assert_lt(lko_s.energy, O2_631GS_E_ROHF_DEFAULT - 1.0e-4)
    assert_lt(O2_631GS_E_UHF + lko_u.de, lko_s.energy)
    lko_g = hf_step(lko_rp, lko_s.alpha.density, lko_s.beta.density)
    assert_lt(max(abs(lko_g.energy - lko_s.energy), scf_density_gap(lko_g, lko_s)), 1.0e-8)
}

# ---- PySCF 2.5.0's stable O2 6-31G* ROHF densities (spherical AOs) ----
# gto.M(atom="O 0 0 0; O 0 0 1.2075", basis="6-31g*", spin=2), scf.ROHF:
# the minao state, restarted from mf.stability() orbitals (the procedure of
# tools/hf_reference.py), then from that density with conv_tol 1e-13,
# conv_tol_grad 1e-10 and max_cycle 300. PySCF leaves converged False there
# (its orbital gradient stops at 1.5e-9) with E = -149.5920218322958; its
# own step (get_fock, eig, get_occ, make_rdm1) moves the pair by
# 1.409719507794449e-09.
