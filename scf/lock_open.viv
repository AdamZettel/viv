def lko_o2_stable_da() -> Arr {
    v = zeros(28, 28)
    c = lko_o2_stable_da_c0()
    for i to len(c) {
        k = 0 + i
        v[floor(k / 28), mod(k, 28)] = c[i]
    }
    c = lko_o2_stable_da_c1()
    for i to len(c) {
        k = 512 + i
        v[floor(k / 28), mod(k, 28)] = c[i]
    }
    return v
}

