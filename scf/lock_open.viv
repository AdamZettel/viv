        -4.766018378968377e-17, -0.00015954817239915414, 9.813027264776318e-18, -2.826528153169497e-17,
        -4.946116400859322e-05, 2.2829512069159145e-08, -4.723653092566599e-18, -2.049770437108145e-05,
