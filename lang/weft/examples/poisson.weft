# Poisson  -laplacian(u) = f  on the unit square, u = 0 on the boundary,
# linear (P1) triangles. Manufactured solution u = x(1-x) y(1-y), so that
# f = 2[x(1-x) + y(1-y)]. weft compiles this weak form to Knot, then to C.
#
# Compile + run:
#   cargo run -p weft -- lang/weft/examples/poisson.weft -o /tmp/poisson.c
#   cc -std=c99 -O2 -Wno-unknown-pragmas /tmp/poisson.c -lm -o /tmp/poisson && /tmp/poisson

mesh: unit_square(8)
coefficient f = 2.0 * (x * (1.0 - x) + y * (1.0 - y))
bilinear: dot(grad(u), grad(v))
linear: f * v
dirichlet: 0.0
exact: x * (1.0 - x) * y * (1.0 - y)
