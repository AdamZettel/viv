record Atom {
    z: Num
    pos: Arr
}
record Molecule {
    atoms: [Atom]
}
atoms = [Atom { z: 8.0, pos: [0.0, 0.0, 0.0] }]
atoms = append(atoms, Atom { z: 1.0, pos: [0.0, 0.76, 0.59] })
mol = Molecule { atoms: atoms }
mol.atoms[1].z = 2.0
zsum = sum([a.z for a in mol.atoms])
show len(mol.atoms), zsum, atoms[1].z
test "an array of records is a value" {
    assert_near(zsum, 10.0, 0.0)
    assert_near(atoms[1].z, 1.0, 0.0)
}

