def loss(w: Arr, X: Arr, y: Arr) {
    r = X @ w - y
    return sum(r * r)
}
X = [[1.0, 0.0], [1.0, 1.0], [1.0, 2.0]]
y = [1.0, 3.0, 5.0]
w = [0.0, 0.0]
g = grad(loss, w, X, y)
show g
test "the gradient of a def with respect to its first argument" {
    assert_allclose(g, 2.0 * (transpose(X) @ (X @ w - y)), 1.0e-14)
}

