# A test block is the unit that passes or fails: it prints one PASS or FAIL
# line under its name, however many asserts are inside.
def mean(xs) {
    return sum(xs) / len(xs)
}

test "the mean of 1, 2, 6 is 3" {
    m = mean([1.0, 2.0, 6.0])
    assert_near(m, 3.0, 0.0)
}
test "the mean of one number is that number" {
    assert_near(mean([7.5]), 7.5, 0.0)
}

