record Grid {
    n: Int
    h: Num
}
def spacing(g: Grid, scale: Num) -> Num {
    return g.h * scale
}
def make_grid(n: Int) -> Grid {
    return Grid { n: n, h: 1.0 / float(n) }
}
g = make_grid(4)
label: Str = "coarse"
show spacing(g, 2.0), g.n, label
test "annotations fix the types" {
    assert_near(spacing(g, 2.0), 0.5, 0.0)
}

