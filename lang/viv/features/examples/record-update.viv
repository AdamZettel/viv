record Options {
    tol: Num
    max_iter: Num
    verbose: Bool
}
def defaults() -> Options {
    return Options { tol: 1.0e-8, max_iter: 50.0, verbose: false }
}
o = Options { max_iter: 200.0, ..defaults() }
show o.tol, o.max_iter, o.verbose
test "the update replaces only the fields written" {
    assert_near(o.max_iter, 200.0, 0.0)
    assert_near(o.tol, 1.0e-8, 0.0)
}

