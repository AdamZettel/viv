###
post: The area of a circle
kind: problem
summary: Write `area` so that both tests pass.
###

def area(r) {
    return 0.0
}

test "a circle of radius 1 has area pi" {
    assert_near(area(1.0), 3.141592653589793, 1.0e-12)
}
test "a circle of radius 2 has area 4 pi" {
    assert_near(area(2.0), 4.0 * 3.141592653589793, 1.0e-12)
}

