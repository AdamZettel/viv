s = "héllo, world"
head = s[:5]
parts = split(s, ", ")
show len(s), head, upper(head), parts, s.find("world"), s[-5:]
test "strings count code points, as Python does" {
    assert_near(len(s), 12.0, 0.0)
    assert_true(replace(s, "world", "viv") == "héllo, viv")
}

