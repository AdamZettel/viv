xs = [3.0, -7.0, 4.0]
words = ["ccc", "a", "bb"]
show max(xs, key=abs), sorted(words, key=len), argsort(xs, key=abs, reverse=true)
test "the key decides the order" {
    assert_near(max(xs, key=abs), -7.0, 0.0)
    assert_true(sorted(words, key=len)[0] == "a")
}

