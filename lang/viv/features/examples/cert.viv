# The `.cert` lens file: `viv check --phrases --cert` writes cert.cert, one
# stamped entry per phrase, and reports an entry whose phrase changed.
c = 2.0
root = solve x^2 = c between 0 and 2 using bisection
show root
test "the root of x^2 = 2" {
    assert_near(root, sqrt(2.0), 1.0e-9)
}

