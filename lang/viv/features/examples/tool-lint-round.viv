# `viv lint --round` flags a round(...) used as an index, a bound or a size.
order = [2.0, 0.0, 1.0]
v = [10.0, 20.0, 30.0]
k = round(order[0])
show v[k]
test "the rounded index" {
    assert_near(v[k], 30.0, 0.0)
}

