words = split("the cat and the hat")
uniq = unique(words)
long = [w for w in words if len(w) > 2]
show uniq, join("-", long), "cat" in words, sorted(words)[0]
test "a list of strings has len, in, sorted, unique and join" {
    assert_near(len(uniq), 4.0, 0.0)
}

