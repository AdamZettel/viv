# lib/xyz reads atoms from XYZ or PySCF-style text; lib/basis holds the basis sets.
from xyz import parse_xyz

g = parse_xyz("O 0 0 0; H 0 -0.757 0.587; H 0 0.757 0.587")
show g.symbols, g.z
test "water's atomic numbers" {
    assert_allclose(g.z, [8.0, 1.0, 1.0], 0.0)
}
test "positions are one row per atom" {
    assert_near(g.xyz[2, 1], 0.757, 0.0)
}

