record Particle {
    x: Num
    v: Arr
}
def kinetic(p: Particle) -> Num {
    return 0.5 * dot(p.v, p.v)
}
p = Particle { x: 1.0, v: [3.0, 4.0] }
show p.x, kinetic(p)
test "a record bundles named fields" {
    assert_near(kinetic(p), 12.5, 0.0)
}

