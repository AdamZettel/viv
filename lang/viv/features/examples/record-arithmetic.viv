record Params {
    W: Arr
    b: Arr
}
p = Params { W: [1.0, 2.0], b: [0.5] }
g = Params { W: [0.1, 0.2], b: [1.0] }
p2 = p - 0.5 * g
z = zeros_like(p)
show p2.W, p2.b, sum(p2), z.W
test "arithmetic acts on each array of the record" {
    assert_allclose(p2.W, [0.95, 1.9], 1.0e-15)
}

