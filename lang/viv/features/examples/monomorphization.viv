def apply_twice(f, x) {
    return f(f(x))
}
def triple(x) {
    return 3.0 * x
}
a = apply_twice(triple, 2.0)
b = apply_twice(fn(x) -> x + 1.0, 2.0)
show a, b
test "a function value passed to a def is specialized for C and wasm" {
    assert_near(a, 18.0, 0.0)
    assert_near(b, 4.0, 0.0)
}

