# The story of a run: calls, steps and loop passes in the intent's words
# (story.intent), as the debug build recorded them.
def newton_sqrt(a, tol) {
    step guess {
        x = a
    }
    while abs(x * x - a) > tol {
        step update {
            x = (x + a / x) / 2.0
        }
    }
    return x
}

def hypotenuse(p, q) {
    return newton_sqrt(p * p + q * q, 1.0e-12)
}

h = hypotenuse(3.0, 4.0)
show h
test "a 3-4-5 triangle" {
    assert_near(h, 5.0, 1.0e-12)
}

