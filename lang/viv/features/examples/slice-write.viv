a = zeros(5)
a[1:3] = [5.0, 6.0]
a[3:] = 7.0
M = zeros(2, 2)
M[:, 1] = [1.0, 2.0]
a[0:2] += 1.0
show a, M
test "a slice write changes the array in place" {
    assert_allclose(a, [1.0, 6.0, 6.0, 7.0, 7.0], 0.0)
}

