def scatter(perm: Arr, out: Arr) {
    parallel for i to len(perm) {
        out[perm[i]] = 10.0 * i
    }
}
perm = [2.0, 0.0, 3.0, 1.0]
out = zeros(4)
scatter(perm, out)
show out
test "a pinned loop writes through a permutation" {
    assert_allclose(out, [10.0, 30.0, 0.0, 20.0], 0.0)
}

