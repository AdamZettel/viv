#| The mean of a vector.
#: n  the number of entries
def avg(v) {
    n = len(v)
    return sum(v) / n
}

#| The root-mean-square distance from the mean.
#: m  the mean of v
def spread(v) {
    m = avg(v)
    return sqrt(sum((v - m) ^ 2) / len(v))
}

x = [1.0, 2.0, 3.0, 4.0]
show avg(x), spread(x)
test "the mean of 1 to 4" {
    assert_near(avg(x), 2.5, 1.0e-12)
}

