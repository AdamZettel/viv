# `viv graph` prints the program as defs, steps and the loops that hold them.
def relax(u) {
    step smooth "average each interior point with its neighbors" {
        for i from 1 to len(u) - 1 {
            u[i] = 0.5 * (u[i - 1] + u[i + 1])
        }
    }
    return u
}

def solve(n) {
    u = zeros(n)
    u[n - 1] = 1.0
    for sweep to 200 {
        u = relax(u)
    }
    return u
}

u = solve(5)
show u
test "the line between the ends" {
    assert_near(u[2], 0.5, 1.0e-6)
}

