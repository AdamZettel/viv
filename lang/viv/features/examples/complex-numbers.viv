z = 3.0 + 4.0i
w = z * (1.0 - 2.0i) / 2.0
u = czeros(3)
u[1] = 1.0 + 1.0i
show abs(z), w, re(w), im(w), conj(z), u[1]
test "complex arithmetic" {
    assert_near(abs(z), 5.0, 0.0)
    assert_near(im(w), -1.0, 0.0)
}

