idx: [Int] = [2, 0, 1]
counts = int_zeros(3)
for k to len(idx) {
    counts[idx[k]] += 1
}
data = [10.0, 20.0, 30.0]
show idx, counts, data[idx[0]]
test "an [Int] indexes directly" {
    assert_near(data[idx[0]], 30.0, 0.0)
}

