def square(x) {
    return x * x
}
def cube(x) {
    return x * x * x
}
def integrate_mid(f, a, b, n) {
    h = (b - a) / n
    s = 0.0
    for k to n {
        s += f(a + (k + 0.5) * h)
    }
    return s * h
}
show integrate_mid(square, 0.0, 1.0, 100.0), integrate_mid(cube, 0.0, 1.0, 100.0)
test "a def name is a value" {
    assert_near(integrate_mid(square, 0.0, 1.0, 100.0), 1.0 / 3.0, 1.0e-4)
}

