def loss(w: Arr, X: Arr, y: Arr) {
    r = X @ w - y
    return sum(r * r)
}
X = [[1.0, 0.0], [1.0, 1.0], [1.0, 2.0]]
y = [1.0, 3.0, 5.0]
w = [0.0, 0.0]
for step to 200 {
    l, g = value_and_grad(loss, w, X, y)
    w = w - 0.05 * g
}
show w
test "gradient descent fits the line y = 1 + 2x" {
    assert_allclose(w, [1.0, 2.0], 1.0e-6)
}

