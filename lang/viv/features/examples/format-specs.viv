x = -1.5
n: Int = 1234567
print(f"[{x:06.2f}] [{x:+.3e}] [{2.0:*^9.2f}] [{0.125:.1%}] [{1e-10:G}]")
print(f"[{n:,}] [{n:+012_d}] [{n:>10}] [{1234.5:010,.1f}]")
w = 8
p: Int = 3
name = "x"
print(f"[{name:>{w}}] [{3.14159:.{p}f}]", fmt(2.0 / 3.0, f".{p}g"))
test "Python's format flags" {
    assert_true(fmt(x, "06.2f") == "-01.50")
    assert_true(fmt(2.0, "05d") == "00002")
    assert_true(f"{n:,}" == "1,234,567")
    assert_true(f"{x:<8.2f}|" == "-1.50   |")
    assert_true(f"{x:{w}.{p}f}" == "  -1.500")
}

