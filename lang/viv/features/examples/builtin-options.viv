X = [[1.0, 5.0, 2.0], [3.0, 2.0, 8.0]]
rowmax = amax(X, axis=-1, keepdims=true)
show rowmax
cols = sum(X, axis=0)
show cols
show triu([[1.0, 2.0], [3.0, 4.0]], k=1)
show linspace(0, 1, 4, endpoint=false)
show take(X, [1, 0], axis=1)
test "an option by name is the option" {
    assert_near(cols[2], 10.0, 0.0)
    assert_near(rowmax[1, 0], 8.0, 0.0)
}

