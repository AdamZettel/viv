labels = []
for k, w in enumerate(["x", "y"], 1) {
    labels = append(labels, f"{k:d}:{w}")
}
pairs = [i for i, w in enumerate(["p", "q"], start=10)]
show labels, pairs
test "enumerate counts from its start" {
    assert_allclose(pairs, [10.0, 11.0], 0.0)
}

