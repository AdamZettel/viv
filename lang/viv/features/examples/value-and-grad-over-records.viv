record Model { W: Arr, b: Arr }
def loss(m: Model, x: Arr, y: Arr) {
    r = m.W @ x + m.b - y
    return sum(r * r)
}
m = Model { W: [[1.0, 0.0], [0.0, 1.0]], b: [0.0, 0.0] }
l, g = value_and_grad(loss, m, [1.0, 2.0], [0.0, 0.0])
show l, g.W, g.b
test "the gradient is a record of the same type" {
    assert_allclose(g.b, [2.0, 4.0], 0.0)
    assert_allclose(g.W, [[2.0, 4.0], [4.0, 8.0]], 0.0)
}

