down = [i for i from 10 to 0 by -3]
up = [i for i from 1 to 4]
back = [t for t to 4 reversed]
show down, up, back
test "from, by and reversed" {
    assert_allclose(down, [10.0, 7.0, 4.0, 1.0], 0.0)
    assert_allclose(back, [3.0, 2.0, 1.0, 0.0], 0.0)
}

