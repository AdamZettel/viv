w = float32_zeros(4)
for i to len(w) {
    w[i] = float32(i) / 3
}
h = bfloat16(w)
show w, h
print(fmt(sum(w)), fmt(dot(w, w)), fmt(h[1]))
q = int8_zeros(3)
q[0] = 100
q[1] = -100
k = int32(int64(q))
show q, sum(k)
test "packed arrays read back what was stored" {
    assert_near(float(h[1]), 0.333984375, 0.0)
    total: Int = sum(q)
    assert_near(float(total), 0.0, 0.0)
}

