v = [3.0, -7.0, 4.0, 1.0]
order = argsort(v)
by_size = sorted(v, key=abs, reverse=true)
w = copy(v)
sort(w)
show order, w, by_size
test "argsort, sort and sorted agree" {
    assert_allclose(take(v, order), w, 0.0)
    assert_allclose(by_size, [-7.0, 4.0, 3.0, 1.0], 0.0)
}

