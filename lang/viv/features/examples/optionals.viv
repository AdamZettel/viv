def find(xs: Arr, v: Num) -> Int? {
    for i to len(xs) {
        if xs[i] == v {
            return Some(int(i))
        }
    }
    return None
}
def describe(r: Int?) -> Str {
    match r {
        Some(i) => { return f"at {i}" }
        None => { return "absent" }
    }
}
xs = [4.0, 5.0, 6.0]
show describe(find(xs, 5.0)), describe(find(xs, 9.0))
test "None is a value, not a sentinel" {
    assert_true(describe(find(xs, 9.0)) == "absent")
}

