# lib/params: a model's matrices in one flat vector, with a layout table.
from params import param_count, param_declare, param_get, param_set, param_table, param_zeros

model = param_table(2)
EMBED = param_declare(model, 3, 4)
OUT = param_declare(model, 4, 2)
theta = param_zeros(model)
param_set(theta, model, OUT, ones(4, 2))
show param_count(model), sum(param_get(theta, model, OUT))
test "the layout counts every entry" {
    assert_near(param_count(model), 20.0, 0.0)
}

