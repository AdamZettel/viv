# The assert builtins. Inside a test block they report under the test's name.
a = [1.0, 2.0, 3.0]
b = a * 1.0000000001
test "the five asserts" {
    assert_near(sum(a), 6.0, 1.0e-12)
    assert_allclose(a, b, 1.0e-9)
    assert_gt(len(a), 2.0)
    assert_lt(amax(a - b), 0.0)
    assert_true(all(a < 4.0))
}

