counts = map()
for w in split("the cat and the hat") {
    counts[w] = get(counts, w, 0) + 1
}
show counts, keys(counts), has(counts, "dog")
test "a map keeps its keys in the order first stored" {
    assert_near(counts["the"], 2.0, 0.0)
    assert_true(keys(counts)[1] == "cat")
}

