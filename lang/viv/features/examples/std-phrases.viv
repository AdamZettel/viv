# std/phrases: the defs a phrase calls that are not builtins, added to the
# program only when a phrase needs them. Here the Newton phrase brings r_newton.
c = 2.0
r = solve x^2 = c starting at 1 using newton
show r
test "Newton finds the square root of 2" {
    assert_near(r, sqrt(2.0), 1.0e-15)
}

