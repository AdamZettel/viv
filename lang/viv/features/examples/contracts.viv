from lang.viv.std.contracts import find_root, integrate
def two_less(x) {
    return x * x - 2.0
}

root = find_root(two_less, 0.0, 2.0)
area = integrate(fn(x) -> x * x, 0.0, 1.0)
show root, area
test "find_root and integrate agree with the closed forms" {
    assert_near(root, sqrt(2.0), 1.0e-9)
    assert_near(area, 1.0 / 3.0, 1.0e-12)
}
test "every method agrees" {
    assert_near(find_root(two_less, 0.0, 2.0) using every method, sqrt(2.0), 1.0e-9)
    assert_near(integrate(fn(x) -> x * x, 0.0, 1.0) using every method, 1.0 / 3.0, 1.0e-12)
}

