x = [-2.0, 0.5, 3.0, -1.0]
relu = where(x > 0.0, x, 0.0)
big = extract(x > 0.0, x)
y = copy(x)
putmask(y, x < 0.0, 0.0)
show relu, big, y, count_nonzero(x > 0.0), flatnonzero(x > 0.0)
test "a comparison gives a mask of 1.0 and 0.0" {
    assert_allclose(relu, [0.0, 0.5, 3.0, 0.0], 0.0)
    assert_allclose(big, [0.5, 3.0], 0.0)
    assert_true(any(x > 2.0) and not all(x > 0.0))
}

