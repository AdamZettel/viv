A = [[1.0, 2.0], [3.0, 4.0]]
B = [[5.0, 6.0], [7.0, 8.0]]
C = einsum("ij,jk->ik", A, B)
tr = einsum("ii", A)
show C, tr
test "einsum writes a contraction by its indices" {
    assert_allclose(C, A @ B, 0.0)
    assert_near(tr, 5.0, 0.0)
}

