# @ is cache-blocked; each entry still adds its terms in the order of the
# inner index, so it gives the same bits as the plain loop
srand(7.0)
A = randn(13, 17)
B = randn(17, 11)
C = A @ B
m, k, n = shape(A)[0], shape(A)[1], shape(B)[1]
P = zeros(m, n)
for i to m {
    for p to k {
        for j to n {
            P[i, j] = P[i, j] + A[i, p] * B[p, j]
        }
    }
}
show amax(abs(C - P))
test "the blocked product equals the i-p-j loop bit for bit" {
    assert_true(all(C == P))
}

