#| The kinetic energy of a particle.
#|| Half the mass times the speed squared.
#: m  the mass, kg
#: v  the speed, m/s
def kinetic(m, v) {
    "The kinetic energy, in joules."
    return 0.5 * m * v * v
}
show kinetic(2.0, 3.0)
test "comments and docstrings compile to nothing" {
    assert_near(kinetic(2.0, 3.0), 9.0, 0.0)
}

