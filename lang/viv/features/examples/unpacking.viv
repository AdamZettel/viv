a = 1.0
b = 2.0
a, b = b, a
v = [10.0, 20.0, 30.0]
v[0], v[2] = v[2], v[0]
rows_n, cols_n = shape(zeros(2, 3))
show a, b, v, rows_n, cols_n
test "the right side is computed first" {
    assert_near(a, 2.0, 0.0)
    assert_allclose(v, [30.0, 20.0, 10.0], 0.0)
}

