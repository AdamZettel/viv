def residual(x: Arr, y: Arr) {
    step diff "the difference": d = x - y
    step size: r = norm(d)
    return r
}
show residual([3.0, 4.0], [0.0, 0.0])
test "a one-line step is a step of one statement" {
    assert_near(residual([3.0, 4.0], [0.0, 0.0]), 5.0, 0.0)
}

