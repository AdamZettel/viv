# Two layers in one module would be a contradiction, so the lens below puts
# this one module in one layer and gives two of its defs budgets.
def mean_of(xs) {
    return sum(xs) / len(xs)
}

def centered(xs) {
    return xs - mean_of(xs)
}

c = centered([1.0, 2.0, 6.0])
show c
test "the centered values sum to zero" {
    assert_near(sum(c), 0.0, 1.0e-15)
}

