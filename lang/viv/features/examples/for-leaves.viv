record Model { W: Arr, b: Arr }
def sgd_step(p: Arr, g: Arr, lr) {
    p[:] = p - lr * g
}
m = Model { W: [[1.0, 2.0]], b: [0.5] }
g = Model { W: [[0.1, 0.2]], b: [1.0] }
for_leaves(sgd_step, m, g, 0.5)
z = zeros_like(m)
show m.W, m.b, sum(z)
test "for_leaves calls a def on each array of the records at once" {
    assert_allclose(m.W, [[0.95, 1.9]], 1.0e-15)
    assert_allclose(m.b, [0.0], 0.0)
}

