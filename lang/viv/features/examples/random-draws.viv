srand(42.0)
u = rand(2, 3)
g = randn(4)
show shape(u), numel(g)
test "shaped draws come from one seeded generator" {
    srand(42.0)
    u2 = rand(2, 3)
    assert_allclose(u, u2, 0.0)
    assert_true(amax(u) < 1.0 and amin(u) >= 0.0)
}

