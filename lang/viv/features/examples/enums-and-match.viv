enum Shape {
    Circle(Num)
    Rect(Num, Num)
    Empty
}
def area(s: Shape) -> Num {
    match s {
        Circle(r) => { return 3.0 * r * r }
        Rect(w, h) => { return w * h }
        Empty => { return 0.0 }
    }
}
shapes_total = area(Shape.Circle(1.0)) + area(Shape.Rect(2.0, 3.0)) + area(Shape.Empty)
show shapes_total
test "match covers every variant" {
    assert_near(area(Shape.Rect(2.0, 3.0)), 6.0, 0.0)
}

