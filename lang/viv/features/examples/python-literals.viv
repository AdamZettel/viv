mask: Int = 0xff
n = 1_000_000
x = .5
s = 'it' + "\x21"
inside = 0 <= x < 1
print(mask, n, x, 2.e3, s, inside)
test "Python's literals" {
    assert_true(mask == 255)
    assert_near(n, 1e6, 0.0)
    assert_true(s == "it!")
    assert_true(inside)
}

