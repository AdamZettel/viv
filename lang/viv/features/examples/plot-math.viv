# Labels with math: the $...$ parts of a title, an axis label, a legend entry,
# a tick or a label mark are set as TeX; text outside the dollars stays as it
# is. In a Viv string a backslash is written \\.
N = 6
t = linspace(0.0, 5.0, N)
TAU = 2.0
figure("Decay at rate $1/\\tau$", "$t/\\tau$", "$E/E_0$")
plot(t / TAU, exp(-t / TAU), "$e^{-t/\\tau}$")
plot(t / TAU, exp(-2.0 * t / TAU), "$\\frac{1}{2}\\,e^{-2t/\\tau}$ (half rate)")

test "the curves start at 1" {
    assert_near(exp(-t[0] / TAU), 1.0, 0.0)
}

