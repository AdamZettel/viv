s = [0.5, -1.0, 2.0, -3.0]
kept = []
for x in s {
    if x > 0.0 {
        kept = append(kept, x)
    }
}
kept = extend(kept, [7.0, 8.0])
M = []
M = append(M, [1.0, 2.0])
M = append(M, [3.0, 4.0])
show kept, M
test "append grows a vector, or a matrix by a row" {
    assert_allclose(kept, [0.5, 2.0, 7.0, 8.0], 0.0)
    assert_near(shape(M)[0], 2.0, 0.0)
}

