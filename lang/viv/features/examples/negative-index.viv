a = [10.0, 20.0, 30.0, 40.0]
A = [[1.0, 2.0], [3.0, 4.0]]
show a[-1], a[-3:], A[-1, :]
test "a negative index counts from the end" {
    assert_near(a[-1], 40.0, 0.0)
    assert_near(len(a[:-1]), 3.0, 0.0)
}

