record Head { Wq: Arr, Wk: Arr }
record Block { heads: [Head], Wo: Arr }
def Head(width) -> Head {
    return Head { Wq: randn(width, 2), Wk: randn(width, 2) }
}
def Block(width, heads) -> Block {
    return Block { heads: [Head(width) for h to heads], Wo: randn(width, width) }
}
srand(1)
b = Block(4, 3)
srand(1)
first = randn(4, 2)
show len(b.heads), shape(b.Wo)
test "the fields are drawn in the order written, the heads in order" {
    assert_near(sum(abs(b.heads[0].Wq - first)), 0.0, 0.0)
}

