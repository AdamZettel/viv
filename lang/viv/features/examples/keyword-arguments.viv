def init(rows, cols, scale = 1.0 / sqrt(rows)) {
    return scale * ones(rows, cols)
}
show init(4, 2)
show init(4, 2, scale=0.5)
X = [[1.0, 5.0], [3.0, 2.0]]
show amax(X, axis=-1, keepdims=true)
test "a default reads the parameters before it" {
    assert_near(init(16, 1)[0, 0], 0.25, 0.0)
}

