record Layer {
    W: Arr
    scale: Num
}
record Model {
    first: Layer
    last: Layer
}
m = Model { first: Layer { W: zeros(2), scale: 1.0 }, last: Layer { W: zeros(2), scale: 1.0 } }
q = m
m.first.scale = 2.0
m.last.W[1] = 5.0
show m.first.scale, q.first.scale, m.last.W
test "a field write changes only the variable written" {
    assert_near(q.first.scale, 1.0, 0.0)
    assert_near(m.last.W[1], 5.0, 0.0)
}

