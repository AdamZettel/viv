X = 2.0
H = 0.1

rung "The slope of a secant" {
    def slope(f, x, h) {
        return (f(x + h) - f(x)) / h
    }
    test "the slope of a line is exact" {
        assert_near(slope(fn(t) -> 3.0 * t, X, H), 3.0, 1.0e-12)
    }
}

rung "A secant centered on the point" {
    def slope(f, x, h) {
        return (f(x + h) - f(x - h)) / (2.0 * h)
    }
    test "the centered slope of x^2 is exact" {
        assert_near(slope(fn(t) -> t * t, X, H), 2.0 * X, 1.0e-12)
    }
}

show slope(fn(t) -> t * t, X, H)

