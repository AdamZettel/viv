# Square roots by Newton's method.
#| The square root of a, to an absolute residual tol.
#|| Newton's iteration on x^2 - a, which averages x and a / x.
#||| Each pass doubles the number of correct digits once x is close to the root.
#: a  the number whose root is wanted
#: tol  the largest accepted |x^2 - a|
#: x  the current estimate of the root
def newton_sqrt(a, tol) {
    step guess "start from the number itself" {
        x = a
    }
    #| repeat until x * x is within tol of a
    while abs(x * x - a) > tol {
        step update "average x and a / x" {
            x = (x + a / x) / 2.0
        }
    }
    return x
}

r = newton_sqrt(2.0, 1.0e-12)
show r
test "the root squares back to two" {
    assert_near(r * r, 2.0, 1.0e-12)
}
