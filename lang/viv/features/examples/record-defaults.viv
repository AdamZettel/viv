record GptConfig { vocab: Int, context: Int = 8, width: Int = 16, scale: Num = 1.0 / 4.0 }
cfg = GptConfig { vocab: 9 }
small = GptConfig { vocab: 9, width: 4 }
short = GptConfig { context: 2, ..small }
print(cfg.context, cfg.width, cfg.scale, small.width, short.context, short.width)
test "a literal that leaves a field out gets its default" {
    assert_true(cfg.width == 16 and small.width == 4 and short.width == 4)
}

