# Restricted Hartree-Fock for H2 in STO-3G, as PySCF's gto.M + scf.RHF.
import basis.sto3g
from hf.mole import molecule
from hf.scf import rhf

mol = molecule("H 0 0 0; H 0 0 0.74", "sto-3g")
r = rhf(mol)
print("E(RHF) =", fmt(r.energy, ".8f"))
test "H2 STO-3G energy" {
    assert_near(r.energy, -1.116759, 1.0e-5)
}

