# The interpreter, C and wasm print the same bytes: the same libm (Viv's own),
# the same summation orders and the same formatting.
x = sin(1.0) * exp(0.5) + pow(2.0, 0.3)
s = sum(linspace(0.0, 1.0, 11) * 0.1)
print(fmt(x, 17), fmt(s, 17))
test "the value is reproducible to the last bit" {
    assert_near(x, sin(1.0) * exp(0.5) + pow(2.0, 0.3), 0.0)
}

