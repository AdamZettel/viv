# What Viv accepts in place of the forms it refuses (see the entry's text for
# the refusals and their messages).
x = 2.0
y = 2.0 * x
a = [1.0, 2.0]
b = [1.0, 2.0]
same = all(a == b)
if same {
    print("a and b agree:", y)
}
test "explicit products and all() on a mask" {
    assert_true(same)
    assert_near(y, 4.0, 0.0)
}

