def normalize(a: Arr) {
    step center "subtract the mean" {
        c = a - mean(a)
    }
    step scale "divide by the norm" {
        c = c / norm(c)
    }
    return c
}
u = normalize([1.0, 2.0, 3.0])
show u
test "a step is a block, not a scope" {
    assert_near(norm(u), 1.0, 1.0e-15)
}

