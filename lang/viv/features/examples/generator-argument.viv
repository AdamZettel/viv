xs = [3.0, -1.0, 4.0]
total = sum(x * x for x in xs)
all_pos = all(x > 0.0 for x in xs)
show total, all_pos
test "a generator is the only argument" {
    assert_near(total, 26.0, 0.0)
    assert_true(not all_pos)
}

