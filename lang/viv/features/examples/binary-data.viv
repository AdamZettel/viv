# the first bytes of a GGUF file, then a half 1.0 and the smallest subnormal half
b: [Int] = [71, 71, 85, 70, 0, 60, 1, 0]
magic = le_u32(b, 0)
show magic, le_f16(b, 4), le_f16(b, 6), le_i16(b, 4)
test "little-endian readings of bytes" {
    assert_true(magic == 1179993927)
    assert_near(le_f16(b, 4), 1.0, 0.0)
    assert_near(le_f16(b, 6), 5.960464477539063e-08, 0.0)
}

