def fib(n: Int) -> Int {
    a: Int = 0
    b: Int = 1
    for k to n {
        t = a + b
        a = b
        b = t
    }
    return a
}
n: Int = 10
fibs = [fib(k) for k to n]
evens: [Int] = []
for k to n // 2 {
    evens = append(evens, 2 * k)
}
seen = map()
seen[n] = sqrt(n)
half = int(n / 3)
for i, w in enumerate(["x", "y"], start=1) {
    print(i, chr(96 + i), w)
}
print(fibs, evens, seen[10], half)
test "Ints go where numbers go" {
    assert_near(sum(fibs), 88.0, 0.0)
    assert_true(len(evens) == 5)
    assert_true(fib(half) == 2)
}

