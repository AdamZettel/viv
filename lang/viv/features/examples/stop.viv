def checked_sqrt(x) {
    if x < 0.0 {
        stop(f"checked_sqrt: {x} is negative")
    }
    return sqrt(x)
}
show checked_sqrt(9.0)
test "stop is not reached for a valid input" {
    assert_near(checked_sqrt(4.0), 2.0, 0.0)
}

