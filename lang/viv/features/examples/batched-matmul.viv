X = reshape(arange(12.0), 2, 2, 3)
W = ones(3, 2)
Y = X @ W
show shape(Y), Y
test "a matrix multiplies every matrix of a stack" {
    assert_allclose(Y[1, 0, :], [21.0, 21.0], 0.0)
    assert_allclose(shape(Y), [2.0, 2.0, 2.0], 0.0)
}

