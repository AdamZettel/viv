def gcd(a: Int, b: Int) -> Int {
    while b != 0 {
        t = b
        b = a % b
        a = t
    }
    return abs(a)
}
two: Int = 2
n = two ^ 62
g = gcd(84, 36)
show g, n, -7 // 2, float(g) / 4.0
test "Int arithmetic is exact and checked" {
    assert_true(g == 12)
    assert_true(n // 2 * 2 == n)
}

