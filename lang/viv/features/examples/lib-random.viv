# lib/random: draws over the one generator rand(), so every engine draws the same.
from random import randint, randperm

srand(7.0)
p = randperm(5)
k = randint(10, 20)
show p, k
test "a permutation holds each index once" {
    q = copy(p)
    sort(q)
    assert_allclose(q, [0.0, 1.0, 2.0, 3.0, 4.0], 0.0)
}
test "randint stays in [lo, hi)" {
    assert_true(k >= 10 and k < 20)
}

