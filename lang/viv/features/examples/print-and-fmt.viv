loss = 0.6931471805599453
print("loss", loss)
print("loss", fmt(loss))
print("x =", fmt(0.1, 17))
print("[", fmt(1.5, "8.3f"), "]", sep="")
print(1.0, 2.0, 3.0, sep=", ")
test "fmt gives the format's text" {
    assert_true(fmt(2.0e-5, ".2e") == "2.00e-05")
}

