from math import pi
import math
r = 2.0
area = pi * r ^ 2
xs = [5.0, 1.0, 4.0]
del xs[0]
print(fmt(area), fmt(math.e), -inf, math.sqrt(16.0), xs)
test "pi, e and inf are Python's" {
    assert_near(area, 12.566370614359172, 0.0)
    assert_true(fmt(e) == "2.718281828459045")
    assert_true(inf > 1e308)
    assert_allclose(xs, [1.0, 4.0], 0.0)
}

