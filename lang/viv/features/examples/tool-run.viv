# `viv run --set steps=8 tool-run.viv` replaces the line `steps = 4` before the run.
steps = 4
h = 1.0 / steps
total = 0.0
for i to steps {
    x = h * (i + 0.5)
    total += h * x * x
}
show steps, total
test "the midpoint rule is close to 1/3" {
    assert_near(total, 1.0 / 3.0, 0.01)
}

