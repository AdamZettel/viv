A = [[4.0, 1.0], [1.0, 3.0]]
x = lin_solve(A, [1.0, 2.0])
vals, vecs = eig_sym(A)
L = cholesky(A)
U, s, Vt = svd(A)
show x, vals, s
test "the solvers return what they compute" {
    assert_allclose(A @ x, [1.0, 2.0], 1.0e-14)
    assert_allclose(L @ transpose(L), A, 1.0e-14)
    assert_near(vals[0] + vals[1], 7.0, 1.0e-14)
}

