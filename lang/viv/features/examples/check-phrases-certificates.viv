# Each phrase with a closed form, held to lib/cas's exact value by
# `viv check --phrases`.
area = take the integral of x^2 from 1 to 2
slope = take the derivative of x^3 at 2
show area, slope
test "the phrases give 7/3 and 12" {
    assert_near(area, 7.0 / 3.0, 1.0e-12)
    assert_near(slope, 12.0, 1.0e-12)
}

