x = 2.0
x *= 3.0
x -= 1.0
n = 17.0
n //= 2
a = [1.0, 2.0]
a[1] += 10.0
counts = zeros(3)
for v in [0.0, 2.0, 2.0] {
    counts[v] += 1.0
}
show x, n, a, counts
test "compound forms" {
    assert_near(x, 5.0, 0.0)
    assert_near(n, 8.0, 0.0)
    assert_allclose(counts, [1.0, 0.0, 2.0], 0.0)
}

