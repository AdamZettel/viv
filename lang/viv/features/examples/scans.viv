v = [1.0, 2.0, 3.0, 4.0]
show cumsum(v), cumprod(v), diff(v), clip(v, 1.5, 3.5)
test "scans run left to right" {
    assert_allclose(cumsum(v), [1.0, 3.0, 6.0, 10.0], 0.0)
    assert_allclose(diff(v), [1.0, 1.0, 1.0], 0.0)
}

