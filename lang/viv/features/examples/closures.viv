# a lambda inside a def captures the def's locals by value
def apply(f, x) {
    return f(x)
}
def score(a, xs: Arr) {
    total = fn(k) -> sum(a * x + k for x in xs)
    index = fn(ws) -> {w: i for i, w in enumerate(ws)}
    clip = fn(x) -> x if x < a else a
    a = 100.0
    return total(1.0) + apply(total, 0.0) + index(["p", "q"])["q"] + clip(5.0)
}
show score(2.0, [1.0, 2.0, 3.0])
test "a closure keeps the value its local had when it was made" {
    assert_near(score(2.0, [1.0, 2.0, 3.0]), 30.0, 0.0)
}

