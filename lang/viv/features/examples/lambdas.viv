def apply_twice(f, x) {
    return f(f(x))
}
def half(t) {
    return t / 2.0
}
c = 3.0
add_c = fn(t) -> t + c
show apply_twice(add_c, 1.0), apply_twice(half, 16.0)
test "a lambda is a value that reads the program's variables" {
    assert_near(apply_twice(add_c, 1.0), 7.0, 0.0)
}

