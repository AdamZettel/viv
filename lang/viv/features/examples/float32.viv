x: Float32 = 0.1
y = x * 3.0 + 1
show y
print(fmt(x), fmt(float(x)))
r = sqrt(y)
e = exp(x)
print(fmt(r), fmt(e), fmt(bfloat16(e)), fmt(float16(e)))
test "a Float32 is rounded once per operation" {
    assert_near(float(y), 1.2999999523162842, 0.0)
    assert_near(float(r), 1.1401754617691040, 0.0)
}

