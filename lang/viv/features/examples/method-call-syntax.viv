line = "O  0.000  0.757"
parts = line.split()
z = float(parts[2])
show parts, z, "abc".upper(), [3.0, 4.0].norm()
test "a.f(b) is f(a, b)" {
    assert_near(z, 0.757, 0.0)
    assert_true(split(line)[0] == parts[0])
}

