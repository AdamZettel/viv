# `viv check` runs the checks `viv run` makes before it runs, and nothing
# else: silent and exit 0 for this program.
def area(r: Num) -> Num {
    return 3.141592653589793 * r * r
}
show area(2.0)
test "the area of a circle of radius 2" {
    assert_near(area(2.0), 4.0 * 3.141592653589793, 1.0e-12)
}

