# lib/nprandom: NumPy's generators, bit for bit. np.random.default_rng(0).random()
# twice gives 0.6369616873214543 and 0.2697867137638703.
import nprandom.generator
from nprandom.pcg64 import npr_pcg_double, npr_pcg_from_entropy

rng = npr_pcg_from_entropy([0])
a = npr_pcg_double(rng)
b = npr_pcg_double(rng)
print(fmt(a), fmt(b))
test "default_rng(0) draws what NumPy draws" {
    assert_allclose([a, b], [0.6369616873214543, 0.2697867137638703], 0.0)
}

