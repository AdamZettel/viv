# Collatz steps from 27: a while loop, with break and continue.
n = 27.0
steps = 0.0
odd = 0.0
while n != 1.0 {
    steps += 1.0
    if n % 2.0 == 0.0 {
        n = n / 2.0
        continue
    }
    odd += 1.0
    n = 3.0 * n + 1.0
}
first_big = 0.0
for k to 10 {
    if k * k > 20.0 {
        first_big = k
        break
    }
}
show steps, odd, first_big
test "27 takes 111 steps, 41 of them odd" {
    assert_near(steps, 111.0, 0.0)
    assert_near(odd, 41.0, 0.0)
    assert_near(first_big, 5.0, 0.0)
}

