a = [1.0, 2.0, 3.0]
b = a
c = copy(a)
d = a[0:2]
b[0] = 9.0
def zero_first(v: Arr) {
    v[0] = 0.0
}
zero_first(c)
show a, c, d
test "assignment aliases; copy and slices do not" {
    assert_near(a[0], 9.0, 0.0)
    assert_near(d[0], 1.0, 0.0)
    assert_near(c[0], 0.0, 0.0)
}

