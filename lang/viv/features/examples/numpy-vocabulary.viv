X = reshape(arange(6.0), 2, 3)
show X, transpose(X), eye(2), diag([1.0, 2.0])
show shape(ravel(X)), trace(eye(3)), outer([1.0, 2.0], [3.0, 4.0])
test "NumPy's names give NumPy's results" {
    assert_allclose(X[1, :], [3.0, 4.0, 5.0], 0.0)
    assert_near(trace(eye(3)), 3.0, 0.0)
}

