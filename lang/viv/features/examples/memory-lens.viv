# What each def does with the arrays it is given and makes, as the compiler
# infers it (viv view --lens memory). Nothing here is written by hand.
def scale_into(out, a, s) {
    for i to len(a) {
        out[i] = s * a[i]
    }
}

def doubled(a) {
    return 2.0 * a
}

a = [1.0, 2.0, 3.0]
out = zeros(3)
scale_into(out, a, 3.0)
b = doubled(a)
show out, b
test "scale_into writes the caller's array, doubled returns a new one" {
    assert_allclose(out, [3.0, 6.0, 9.0], 0.0)
    assert_allclose(a, [1.0, 2.0, 3.0], 0.0)
}

