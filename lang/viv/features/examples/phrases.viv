M = [[4.0, 1.0], [1.0, 3.0]]
area = take the integral of x^2 from 0 to 3
off = take the off-diagonal row sums of M
r = solve x^2 = 2 between 0 and 2 using bisection
show area, off, r
test "a phrase is the call it lowers to" {
    assert_near(area, 9.0, 1.0e-12)
    assert_allclose(off, [1.0, 1.0], 0.0)
    assert_near(r, sqrt(2.0), 1.0e-9)
}

