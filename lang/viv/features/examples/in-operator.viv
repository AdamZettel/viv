m = map()
m["h"] = 1.0
words = ["alpha", "beta"]
show 3.0 in [1.0, 2.0, 3.0], "h" in m, "ph" in "alpha", "gamma" not in words
test "in tests membership" {
    assert_true("beta" in words)
    assert_true(5.0 not in [1.0, 2.0])
}

