primes = [
    2.0,
    3.0,
    5.0,
]
def report(x) {
    if x < 0 {
        print("negative")
        return
    }
    print(f"{x} is not negative")
}
report(-1.0)
report(primes[2])
test "a bare return leaves the def" {
    assert_near(report(-2.0), 0.0, 0.0)
    assert_true(len(primes) == 3)
}

