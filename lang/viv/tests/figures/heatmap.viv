# A figure-record probe: a heatmap's settings.
# origin("lower") puts row 0 at the bottom, colormap("diverging") centers the
# colors on zero, clim(lo, hi) fixes the color limits and levels(values)
# draws contour lines at those values.
Z = zeros(3, 4)
for i to 3 {
    for j to 4 {
        Z[i, j] = (j - 1.5) * (i + 1.0)
    }
}
figure("A signed field", "x", "y", 0.0, 1.0, 0.0, 0.75)
origin("lower")
colormap("diverging")
clim(-6.0, 6.0)
levels([-3.0, 0.0, 3.0])
plot2d(Z, "u")

test "the field is signed" {
    assert_near(Z[2, 0] + Z[2, 3], 0.0, 0.0)
}

