# A figure-record probe: a nan or an inf in an array is
# printed as `nan`, `inf` or `-inf`, and a chart draws it as a gap in the line
# or an empty cell. The series is never dropped.
x = linspace(0.0, 1.0, 5)
y = x * x
y[2] = 0.0 / 0.0
y[4] = -1.0 / 0.0
z = zeros(2, 3)
z[1, 1] = 1.0 / 0.0
z[0, 2] = 2.5
figure("A gap", "x", "y")
plot(x, y, "with a nan")
bars(x, x, "bars")
figure("A cell", "column", "row")
plot2d(z, "field")

test "a nan and an inf are in the arrays" {
    assert_near(z[0, 2], 2.5, 0.0)
}

