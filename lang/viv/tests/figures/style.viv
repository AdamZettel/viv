# A figure-record probe: style("label", "words")
# chooses how the series of that label are drawn, from a closed list of words
# (line, color slot, marker, width); xtick and ytick label ticks, in any
# script (the C runtime writes a non-ASCII literal as octal escapes).
x = linspace(0.0, 1.0, 5)
figure("Exact against computed", "x", "u")
plot(x, x * x, "exact")
plot(x, x * x + 0.01, "computed")
style("exact", "dash s2")
style("computed", "noline ring")
ytick("zero", 0.0)
ytick("one", 1.0)
xtick("L", 0.0)
xtick("Γ", 0.5)
xtick("X", 1.0)
figure("Points", "x", "y")
scatter(x, x, "samples")
style("samples", "square s4")

test "the computed curve is a hundredth above the exact one" {
    assert_near(x[4] * x[4] + 0.01, 1.01, 1.0e-15)
}

