# A figure-record probe: plot, bars and plot2d carry
# their data at full precision, the shortest of %.15g, %.16g and %.17g that
# reads back as the same double, so a chart's numbers are the program's.
x = linspace(0.0, 1.0, 4)
y = [0.1 + 0.2, 1.0 / 3.0, 1.0e-300, 1.0e300]
figure("Round trip", "x", "y")
plot(x, y, "values")
bars(x, [3.141592653589793, -0.0, 4.9e-324, 123456789012345680.0], "more")
figure("Cells", "column", "row")
plot2d([[2.0 / 3.0, 1.0e-5], [100000.0, 1.0e15]], "field")

test "a third reads back as a third" {
    assert_near(y[1] * 3.0, 1.0, 1.0e-15)
}

