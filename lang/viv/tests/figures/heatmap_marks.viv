# A figure-record probe: marks on a heatmap. With a
# window the marks are in its units, ylo at the bottom whichever row is
# there; with no window they are in cell coordinates (x the column, y the
# row), and origin("lower") puts row 0 at the bottom.
Z = zeros(2, 3)
for i to 2 {
    for j to 3 {
        Z[i, j] = i + 0.5 * j
    }
}
figure("With a window", "x", "y", 0.0, 3.0, 0.0, 2.0)
origin("lower")
hline("middle", 1.0)
plot2d(Z, "u")
segment("diagonal", 0.0, 0.0, 3.0, 2.0)
label("peak", "top right", 2.5, 1.5)

figure("In cells", "column", "row")
plot2d(Z, "v")
vline("second column", 1.0)
rect("first row", 1.0, 0.0, 3.0, 1.0)
xtick("j = 0", 0.0)
ytick("i = 1", 1.0)

