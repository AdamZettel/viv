# A diagram: two boxes, an arrow between
# them and notes, one unit to a pixel, no axes. Text may be a string value.
figure("two boxes", "", "", 0.0, 200.0, -100.0, 0.0, "diagram")
box("a", "s1 tint", 10.0, -40.0, 90.0, -10.0)
note("a#head", "first", "ink left top mono bold", 16.0, -16.0)
name = "second"
style = "s2 clear dash square"
box("b", style, 110.0, -90.0, 190.0, -60.0)
note("b#head", name, "", 150.0, -75.0)
arrow("a>b", "ink curved", [90.0, 100.0, 110.0], [-25.0, -50.0, -75.0])
arrow("b>a", "s5 dash thin nohead", [110.0, 50.0], [-90.0, -40.0])
note("label", "values", "s5 right bottom small", 100.0, -95.0)

