# A figure-record probe: grid("title", rows, cols)
# makes the next rows * cols figures its panels, filled row by row; share("x")
# gives the panels of a column one x range. yright("label", "axis") draws the
# series of that label against a second y axis on the right. The figure after
# the last panel stands alone again.
N = 5
t = linspace(0.0, 1.0, N)
grid("One swing, two panels", 2, 1)
share("x")
figure("Angle", "", "degrees")
plot(t, t * 90.0, "angle")
figure("Torque and energy", "seconds", "newton meters")
plot(t, t * 2.0, "torque")
plot(t, t * t * 40.0, "energy")
yright("energy", "joules")
figure("After the grid", "x", "y")
plot(t, t, "alone")

test "the last angle is ninety degrees" {
    assert_near(t[N - 1] * 90.0, 90.0, 0.0)
}

