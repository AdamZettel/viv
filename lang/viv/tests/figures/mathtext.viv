# A figure-record probe: labels with math. A label's
# $...$ parts are a TeX subset that `viv plot` sets as math (src/mathtext.rs)
# and the site's charts set alike; the records carry the text as written. In a
# Viv string a backslash is written \\.
N = 5
x = linspace(0.0, 4.0, N)
figure("Binding energy", "$A$", "$E/A$ (MeV)")
plot(x, x * 0.5, "$\\lVert Q^\\top Q - I \\rVert$")
plot(x, x * 0.25, "$\\kappa(A)$")
ytick("$10^{-14}$", 1.0)
ytick("$10^{-6}$", 2.0)
figure("Growth rate $\\gamma(k)$", "$\\omega/\\omega_{pe}$", "$\\frac{dE}{dt}$")
plot(x, x * x - 5.0 * x + 6.0, "$x^2 - 5x + 6$")
plot(x, sqrt(x), "$\\sqrt{\\varepsilon}\\,N$")
label("root", "$x = 2$", 2.0, 0.0)

test "the parabola has its roots at 2 and 3" {
    assert_near(x[2] * x[2] - 5.0 * x[2] + 6.0, 0.0, 0.0)
}

