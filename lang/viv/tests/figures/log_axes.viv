# A figure-record probe: xscale("log") and
# yscale("log") set the axes of the open figure, wherever in it they are
# called. A value a log axis cannot show (zero, negative) is a gap.
h = [0.1, 0.01, 0.001, 0.0001, 1.0e-5, 1.0e-6]
figure("Error against step size", "step h", "error")
xscale("log")
yscale("log")
plot(h, h * h, "second order")
plot(h, h, "first order")
hline("round-off", 1.0e-12)
figure("Growth", "t", "N")
t = linspace(0.0, 4.0, 5)
plot(t, [0.0, 10.0, 100.0, -1.0, 10000.0], "counts")
yscale("log")

test "the smallest step squared is the round-off line" {
    assert_near(h[5] * h[5], 1.0e-12, 1.0e-27)
}

