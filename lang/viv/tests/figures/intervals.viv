# A figure-record probe: fill_between("label", x, lo,
# hi) shades the band from lo to hi over x; rangebars("label", x, lo, hi) draws
# an interval from lo to hi at each x. The ends are the program's numbers, so
# an asymmetric interval is no different from a symmetric one. Their arrays are
# a chart's data, printed at full precision like plot's.
N = 5
x = linspace(0.0, 1.0, N)
mean = x * x + 0.1
err = zeros(N) + 0.05
figure("Mean and spread", "x", "y")
fill_between("two errors either side", x, mean - 2.0 * err, mean + 2.0 * err)
plot(x, mean, "mean")
rangebars("mean", x, mean - err, mean + 3.0 * err)
figure("An interval with a gap", "x", "y")
lo = [0.9, 1.9, 2.95]
hi = [1.1, 2.1, 3.05]
lo[1] = 0.0 / 0.0
rangebars("measured", [1.0, 2.0, 3.0], lo, hi)
scatter([1.0, 2.0, 3.0], [1.0, 2.0, 3.0], "measured")

test "the band is four errors wide" {
    assert_near((mean[2] + 2.0 * err[2]) - (mean[2] - 2.0 * err[2]), 0.2, 1.0e-15)
}

