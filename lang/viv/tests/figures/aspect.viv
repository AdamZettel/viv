# A figure-record probe: aspect("equal") makes one unit
# of x as long on the screen as one unit of y, so a circle is drawn round. Like
# xscale it is a setting of the open figure, wherever in the figure it is.
N = 9
TWO_PI = 8.0 * atan(1.0)
th = linspace(0.0, TWO_PI, N)
figure("A circle of radius 1", "x", "y")
aspect("equal")
plot(cos(th), sin(th), "orbit")
figure("Default", "x", "y")
plot(th, sin(th), "wave")
aspect("auto")

test "the circle closes" {
    assert_near(cos(th[N - 1]), 1.0, 1.0e-15)
}

