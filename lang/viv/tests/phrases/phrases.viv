}
test "take the value and gradient of ph_quad(q, M) with respect to q" {
    ph_value, ph_grad = take the value and gradient of ph_quad(q, M) with respect to q
    assert_near(ph_value, 19.75, 2.075e-11)
    assert_allclose(ph_grad, [9.5, 4.25, 19.5], 2.05e-11)
}
