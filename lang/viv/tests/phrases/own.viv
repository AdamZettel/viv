# A program's own phrases: `phrase "<words>"
# -> <expr>` at the top level. A word of the phrase that is a name the body
# reads is a hole; the others are the words a use must have. A use may come
# before the declaration.

M = [[4.0, 1.0, 2.0], [1.5, 5.0, 3.0], [2.0, 3.5, 6.0]]
v = [3.0, 1.0, 4.0, 1.5, 5.0, 9.0, 2.0, 6.0]

phrase "the spread of v" -> amax(v) - amin(v)
phrase "the Rayleigh quotient of A at x" -> dot(x, A @ x) / dot(x, x)
phrase "the gap between a and b relative to b" -> abs(a - b) / abs(b)

print(take the spread of v)
e = [1.0, 1.0, 1.0]
q = take the Rayleigh quotient of M at e
print(q)
print(take the gap between q and 9.0 relative to 9.0)
print(take the Rayleigh quotient of M at take the unit vector along e)

test "the spread is the max minus the min" {
    assert_near(take the spread of v, 8.0, 0.0)
}
test "the Rayleigh quotient at the all-ones vector is the mean row sum" {
    assert_near(take the Rayleigh quotient of M at e, 28.0 / 3.0, 1.0e-15)
}
test "a phrase in a phrase's hole" {
    assert_near(take the Rayleigh quotient of M at take the unit vector along e, 28.0 / 3.0, 1.0e-15)
}

