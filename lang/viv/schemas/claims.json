{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://viv-lang.org/schemas/claims.json",
 "type": "object",
 "properties": {
  "claims": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "slug": {
      "type": "string"
     },
     "status": {
      "enum": [
       "pass",
       "fail",
       "mismatch",
       "stale",
       "unrun"
      ]
     },
     "topic": {
      "type": [
       "string",
       "null"
      ]
     },
     "claim": {
      "type": "string"
     },
     "viv": {
      "type": "string"
     },
     "twin": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "slug",
     "status",
     "claim",
     "viv",
     "twin"
    ]
   }
  }
 },
 "required": [
  "claims"
 ],
 "title": "viv claims --json: result"
}
