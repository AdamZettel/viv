{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://viv-lang.org/schemas/map.json",
 "type": "object",
 "properties": {
  "root": {
   "type": "string"
  },
  "entry": {
   "type": "string"
  },
  "defsInProgram": {
   "type": "integer"
  },
  "modules": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "name": {
      "type": "string"
     },
     "path": {
      "type": "string"
     },
     "lines": {
      "type": "integer"
     }
    },
    "required": [
     "name",
     "path",
     "lines"
    ]
   }
  },
  "defs": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "module": {
      "type": "integer"
     },
     "line": {
      "type": "integer"
     },
     "intent": {
      "type": "string"
     },
     "dist": {
      "type": "integer"
     },
     "from": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "id",
     "module",
     "line",
     "dist",
     "from"
    ]
   }
  },
  "contracts": {
   "type": "array",
   "items": {
    "type": "object"
   }
  }
 },
 "required": [
  "root",
  "entry",
  "defsInProgram",
  "modules",
  "defs",
  "contracts"
 ],
 "title": "viv map --json: result"
}
