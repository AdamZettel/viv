{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://viv-lang.org/schemas/envelope.json",
 "type": "object",
 "properties": {
  "viv": {
   "const": 1
  },
  "cmd": {
   "type": "string"
  },
  "ok": {
   "type": "boolean"
  },
  "exit": {
   "enum": [
    0,
    1,
    2,
    3,
    4,
    5,
    6,
    70
   ]
  },
  "diagnostics": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "severity": {
      "enum": [
       "error",
       "warning",
       "note"
      ]
     },
     "rule": {
      "type": "string"
     },
     "message": {
      "type": "string"
     },
     "file": {
      "type": [
       "string",
       "null"
      ]
     },
     "line": {
      "type": [
       "integer",
       "null"
      ]
     },
     "col": {
      "type": [
       "integer",
       "null"
      ]
     },
     "end_line": {
      "type": "integer"
     },
     "end_col": {
      "type": "integer"
     },
     "label": {
      "type": "string"
     },
     "source": {
      "type": "string"
     },
     "notes": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "fix": {
      "type": "object",
      "properties": {
       "message": {
        "type": "string"
       },
       "edits": {
        "type": "array",
        "items": {
         "type": "object",
         "properties": {
          "file": {
           "type": "string"
          },
          "line": {
           "type": "integer"
          },
          "col": {
           "type": "integer"
          },
          "end_line": {
           "type": "integer"
          },
          "end_col": {
           "type": "integer"
          },
          "text": {
           "type": "string"
          }
         },
         "required": [
          "file",
          "line",
          "col",
          "end_line",
          "end_col",
          "text"
         ]
        }
       }
      },
      "required": [
       "message",
       "edits"
      ]
     }
    },
    "required": [
     "severity",
     "rule",
     "message",
     "file",
     "line",
     "col",
     "notes"
    ]
   }
  },
  "result": {},
  "truncated": {
   "type": "boolean"
  },
  "more": {
   "type": [
    "string",
    "null"
   ]
  }
 },
 "required": [
  "viv",
  "cmd",
  "ok",
  "exit",
  "diagnostics",
  "result",
  "truncated",
  "more"
 ],
 "title": "the --json envelope every agent-facing viv command prints on stdout"
}
