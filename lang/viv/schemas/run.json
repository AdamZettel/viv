{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://viv-lang.org/schemas/run.json",
 "type": "object",
 "properties": {
  "file": {
   "type": "string"
  },
  "stdout": {
   "type": "string"
  },
  "stdout_lines": {
   "type": "integer"
  },
  "tests": {
   "type": "object",
   "properties": {
    "pass": {
     "type": "integer"
    },
    "fail": {
     "type": "integer"
    },
    "failed": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   },
   "required": [
    "pass",
    "fail",
    "failed"
   ]
  },
  "holds_failed": {
   "type": "integer"
  }
 },
 "required": [
  "file",
  "stdout",
  "stdout_lines",
  "tests",
  "holds_failed"
 ],
 "title": "viv run --json: result (null when the program does not compile)"
}
