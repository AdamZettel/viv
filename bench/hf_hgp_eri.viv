# Water 6-31G two-electron integrals by Head-Gordon-Pople (lib/hf/hgp_eri):
# the whole packed-8 build, 4186 values over 13 AOs, then the two checksums
# the reference generator uses. It builds the same integrals as
# bench/hf_md_eri.viv by a different algorithm, and prints the same line
# under the same name, so tools/race.sh shows at a glance that the two agree.
#
#     tools/race.sh bench/hf_hgp_eri.viv bench/hf_md_eri.viv
from hf.hgp_eri import hgp_eri
from hf.eri_store import es_checksums
from hfref.water_631g import water631g_atoms, water631g_prims, WATER631G_SEED_WSUM, water631g_shells

hfb_Gp = hgp_eri(water631g_atoms(), water631g_shells(), water631g_prims())
hfb_cs = es_checksums(hfb_Gp, WATER631G_SEED_WSUM)
show hfb_cs

