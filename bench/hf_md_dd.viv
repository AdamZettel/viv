# 10,000 (dd|dd) primitive quartets, one integral each: every function is the
# xx component, which is how the legacy lib/gto_md cost per primitive
# quartet was measured (9.67 us at (dd|dd), 1.11 us at (pp|pp), a ratio of
# 8.7). Each quartet goes through mderi_prim1: E tables for the two pairs,
# one Boys evaluation, the R entries inside the box the powers need, and the
# Hermite sum. The pairs come from two seeded pools of 100, so the bra and
# ket pools make 100 x 100 quartets; the printed sum is a checksum.
#
#     tools/race.sh bench/hf_md_dd.viv bench/hf_md_pp.viv
from hf.md_eri import mderi_prim1, mderi_prim1_size
from hf.eri_store import es_rng
from hf.hermite import herm_grid

hfbdd_L = 2
hfbdd_st = zeros(1)
hfbdd_st[0] = 20260923
# a pool row: (a, Ax, Ay, Az, b, Bx, By, Bz), exponents in (0.2, 3.2), centers in a 2-bohr box
hfbdd_pool = zeros(200, 8)
for hfbdd_r to 200 {
    hfbdd_pool[hfbdd_r, 0] = 0.2 + 3.0 * es_rng(hfbdd_st)
    hfbdd_pool[hfbdd_r, 4] = 0.2 + 3.0 * es_rng(hfbdd_st)
    for hfbdd_k to 3 {
        hfbdd_pool[hfbdd_r, 1 + hfbdd_k] = 2.0 * es_rng(hfbdd_st) - 1.0
        hfbdd_pool[hfbdd_r, 5 + hfbdd_k] = 2.0 * es_rng(hfbdd_st) - 1.0
    }
}
hfbdd_PQ = zeros(4, 7)
for hfbdd_f to 4 {
    hfbdd_PQ[hfbdd_f, 4] = hfbdd_L
}
hfbdd_G = herm_grid(4 * hfbdd_L, 40.0)
hfbdd_W = zeros(mderi_prim1_size(hfbdd_L))
hfbdd_F = zeros(4 * hfbdd_L + 1)
hfbdd_acc = 0.0
for hfbdd_i to 100 {
    for hfbdd_j to 100 {
        for hfbdd_k to 4 {
            hfbdd_PQ[0, hfbdd_k] = hfbdd_pool[hfbdd_i, hfbdd_k]
            hfbdd_PQ[1, hfbdd_k] = hfbdd_pool[hfbdd_i, 4 + hfbdd_k]
            hfbdd_PQ[2, hfbdd_k] = hfbdd_pool[100 + hfbdd_j, hfbdd_k]
            hfbdd_PQ[3, hfbdd_k] = hfbdd_pool[100 + hfbdd_j, 4 + hfbdd_k]
        }
        hfbdd_acc = hfbdd_acc + mderi_prim1(hfbdd_PQ, hfbdd_G, hfbdd_W, hfbdd_F)
    }
}
show hfbdd_acc

