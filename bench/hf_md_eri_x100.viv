# bench/hf_md_eri.viv built 100 times over: one build takes about 3 ms
# compiled, too short to time a few-percent cost against the noise of
# starting a process. The printed checksum is one build's, the same as
# hf_md_eri's first number (WATER631G_ERI8_CART_SUMSQ = 98.3908).
#
#     tools/bounds-cost.sh bench/hf_md_eri_x100.viv
from hf.md_eri import mderi_screened
from hf.eri_store import es_checksums
from hfref.water_631g import water631g_atoms, water631g_prims, WATER631G_SEED_WSUM, water631g_shells

hfb_atoms = water631g_atoms()
hfb_shells = water631g_shells()
hfb_prims = water631g_prims()
hfb_sum = 0.0
for hfb_rep to 100 {
    hfb_Gp = mderi_screened(hfb_atoms, hfb_shells, hfb_prims)
    hfb_cs = es_checksums(hfb_Gp, WATER631G_SEED_WSUM)
    hfb_sum = hfb_sum + hfb_cs[0]
}
show hfb_sum / 100

