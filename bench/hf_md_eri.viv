# Water 6-31G two-electron integrals by McMurchie-Davidson (lib/hf/md_eri):
# the whole packed-8 build, 4186 values over 13 AOs, then the two checksums
# the reference generator uses. The printed checksums should equal
# WATER631G_ERI8_CART_SUMSQ = 98.3908 and _WSUM = 94.9032.
#
#     tools/race.sh bench/hf_md_eri.viv
from hf.md_eri import mderi_screened
from hf.eri_store import es_checksums
from hfref.water_631g import water631g_atoms, water631g_prims, WATER631G_SEED_WSUM, water631g_shells

hfb_Gp = mderi_screened(water631g_atoms(), water631g_shells(), water631g_prims())
hfb_cs = es_checksums(hfb_Gp, WATER631G_SEED_WSUM)
show hfb_cs

