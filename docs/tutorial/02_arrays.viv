# Arrays broadcast like NumPy; @ is always the matrix product.
x = linspace(0.0, 1.0, 5)
y = 2.0 * x + 1.0
show x
show y
show sum(y), mean(y)

A = [[2.0, 1.0], [1.0, 3.0]]
b = [1.0, 2.0]
s = lin_solve(A, b)
show s
show A @ s

squares = [i * i for i to 6]
show squares

test "the solve satisfies A s = b" {
    assert_allclose(A @ s, b, 1e-12)
}

