# The sum of the first n squares, three ways.
def sum_squares(n) {
    total = 0
    for i from 1 to n + 1 {
        total += i * i
    }
    return total
}

n = 10
print(f"sum of squares to {n:.0f}: {sum_squares(n):.0f}")
show sum([i * i for i from 1 to n + 1])
show n * (n + 1) * (2 * n + 1) / 6

test "the loop matches the closed form" {
    assert_true(sum_squares(n) == 385)
}

